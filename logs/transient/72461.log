  test "returns smallest index when distances are tied" do
    assert Solution.nearest_valid_point(0, 0, [[0, 2], [2, 0]]) == 0
  end

  test "returns -1 for empty list" do
    assert Solution.nearest_valid_point(1, 1, []) == -1
  end

  test "point with matching x only" do
    assert Solution.nearest_valid_point(5, 10, [[5, 0]]) == 0
  end

  test "point with matching y only" do
    assert Solution.nearest_valid_point(5, 10, [[0, 10]]) == 0
  end
end
