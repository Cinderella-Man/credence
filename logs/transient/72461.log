---MODULE---
@doc """
  Given an integer point (x, y) and a list of integer points, find the index
  of the nearest valid point in the list. A point is valid if it has the same
  x-coordinate or the same y-coordinate as the given point. The distance is
  the Manhattan distance: |x1 - x2| + |y1 - y2|. If multiple valid points
  share the smallest distance, return the smallest index. If there are no
  valid points, return -1.
"""
@spec nearest_valid_point(integer(), integer(), list(list(integer()))) ::
        integer()
def nearest_valid_point(target_x, target_y, points) do
  points
  |> Enum.with_index()
  |> Enum.filter(fn
    [px, py], _index -> px == target_x or py == target_y
    _point, _index -> false
  end)
  |> Enum.reduce_while({-1, :max_integer}, fn [px, py], {best_index, min_distance}, index ->
    distance = abs(px - target_x) + abs(py - target_y)
    case best_index do
      -1 ->
        {:halt, {index, distance}}

      _ when distance < min_distance ->
        {:halt, {index, distance}}

      _ ->
        {:cont, {best_index, min_distance}}
    end
  end)
  |> then(fn {best_index, _min_distance} -> best_index end)
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "returns 0 for a single valid point at the same coordinates" do
    assert Solution.nearest_valid_point(3, 4, [[3, 4]]) == 0
  end

  test "returns -1 when no valid point exists" do
    assert Solution.nearest_valid_point(3, 4, [[2, 3]]) == -1
  end

  test "returns the index of the nearest valid point among multiple candidates" do
    assert Solution.nearest_valid_point(3, 4, [[1, 2], [3, 1], [2, 4], [2, 3], [4, 4]]) == 2
  end

  test "returns smallest index when distances are tied" do
    assert Solution.nearest_valid_point(0, 0, [[0, 2], [2, 0]]) == 0
  end

  test "returns -1 for empty list" do
    assert Solution.nearest_valid_point(1, 1, []) == -1
  end

  test "point with matching x only" do
    assert Solution.nearest_valid_point(5, 10, [[5, 0]]) == 0
  end

  test "point with matching y only" do
    assert Solution.nearest_valid_point(5, 10, [[0, 10]]) == 0
  end
end
