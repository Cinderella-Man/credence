@doc """
  Given an integer point (x, y) and a list of integer points, find the index
  of the nearest valid point in the list. A point is valid if it has the same
  x-coordinate or the same y-coordinate as the given point. The distance is
  the Manhattan distance: |x1 - x2| + |y1 - y2|. If multiple valid points
  share the smallest distance, return the smallest index. If there are no
  valid points, return -1.
"""
@spec nearest_valid_point(integer(), integer(), list(list(integer()))) ::
        integer()
def nearest_valid_point(x, y, points) do
  points
  |> Enum.with_index()
  |> Enum.filter(fn [px, py] -> px == x or py == y end)
  |> Enum.map(fn [px, py] ->
    distance = abs(px - x) + abs(py - y)
    {distance, px, py}
  end)
  |> case do
    [] -> -1
    distances ->
      {min_distance, _, _} =
        Enum.min_by(distances, fn {dist, _px, _py} -> dist end)
      
      Enum.find_index(distances, fn {dist, _px, _py} -> dist == min_distance end)
  end
end
