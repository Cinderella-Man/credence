defmodule Solution do
  def count_good_numbers(n) do
    1..n
    |> Enum.count(&good_number?/1)
  end

  defp good_number?(num) do
    rotate_map = %{
      "0" => "0",
      "1" => "1",
      "8" => "8",
      "2" => "5",
      "5" => "2",
      "6" => "9",
      "9" => "6"
    }

    original = Integer.to_string(num)

    rotated =
      Enum.reduce_while(String.graphemes(original), "", fn digit, acc ->
        case rotate_map do
          %{^digit => rotated} -> {:cont, acc <> rotated}
          _ -> {:halt, :invalid}
        end
      end)

    case rotated do
      :invalid -> false
      rotated_string -> original != rotated_string
    end
  end
end
