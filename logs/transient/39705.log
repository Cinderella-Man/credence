defmodule Solution do
  @doc """
  Count the number of 'good' numbers from 1 to n (inclusive).
  A good number is one where rotating each digit 180 degrees results in a valid
  different number.
  """
  @spec count_good_numbers(non_neg_integer()) :: non_neg_integer()
  def count_good_numbers(n) when n < 0, do: 0
  def count_good_numbers(n) when n == 0, do: 0

  def count_good_numbers(n) do
