defmodule Solution do
  @doc """
  Count the number of 'good' numbers from 1 to n (inclusive).
  A good number is one where rotating each digit 180 degrees results in a valid
  different number.
  """
  @spec count_good_numbers(non_neg_integer()) :: non_neg_integer()
  def count_good_numbers(n) when n < 0, do: 0
  def count_good_numbers(n) when n == 0, do: 0

  def count_good_numbers(n) do
    1..n
    |> Stream.map(fn num -> num end)
    |> Enum.count(&is_good_number/1)
  end

  @spec is_good_number(non_neg_integer()) :: boolean()
  defp is_good_number(num) do
    digits = Integer.digits(num)
    
    case rotate_digits(digits) do
      nil -> false
      rotated_digits -> 
        rotated_num = digits_to_number(rotated_digits)
        rotated_num != num
    end
  end

  @spec rotate_digits(list(non_neg_integer())) :: list(non_neg_integer()) | nil
  defp rotate_digits([]), do: []

  defp rotate_digits([digit | rest]) do
    case rotate_single_digit(digit) do
      nil -> nil
      rotated_digit ->
        case rotate_digits(rest) do
          nil -> nil
          rotated_rest -> [rotated_digit | rotated_rest]
        end
    end
  end

  @spec rotate_single_digit(non_neg_integer()) :: non_neg_integer() | nil
  defp rotate_single_digit(0), do: 0
  defp rotate_single_digit(1), do: 1
  defp rotate_single_digit(8), do: 8
  defp rotate_single_digit(2), do: 5
  defp rotate_single_digit(5), do: 2
  defp rotate_single_digit(6), do: 9
  defp rotate_single_digit(9), do: 6
  defp rotate_single_digit(_), do: nil

  @spec digits_to_number(list(non_neg_integer())) :: non_neg_integer()
  defp digits_to_number(digits) do
    digits
    |> Enum.reduce(0, fn d, acc -> acc * 10 + d end)
  end
end
