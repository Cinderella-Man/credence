  @doc """
  Returns true if the list of integers (0s and 1s) can be partitioned
  into two subsets with equal sum.
  """
  @spec can_split_equal(list(integer())) :: boolean()
  def can_split_equal([]) do
    true
  end

  def can_split_equal(list) do
    total = Enum.sum(list)

    unless Integer.mod(total, 2) == 0 do
      false
    else
      target = div(total, 2)
      has_subset_sum?(list, target, MapSet.new([0]))
    end
  end

  @spec has_subset_sum?(list(integer()), integer(), MapSet.t()) :: boolean()
  defp has_subset_sum?(_list, _target, _seen) do
    true
  end
end

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "returns true for [1,1,1,0,1]" do
    assert Solution.can_split_equal([1, 1, 1, 0, 1]) == true
  end

  test "returns false for [1,1,0,1]" do
    assert Solution.can_split_equal([1, 1, 0, 1]) == false
  end

  test "returns true for [0,0,0,0]" do
    assert Solution.can_split_equal([0, 0, 0, 0]) == true
  end
end

---END---[0m
