---MODULE---
defmodule Solution do
  @doc """
  Returns true if the list of integers (0s and 1s) can be partitioned
  into two subsets with equal sum.
  """
  @spec can_split_equal(list(integer())) :: boolean()
  def can_split_equal([]) do
    true
  end

  def can_split_equal(list) do
    total = Enum.sum(list)

    if Integer.is_even(total) do
      target = div(total, 2)
      has_subset_sum?(list, target, MapSet.new())
    else
      false
    end
  end

  # Helper to solve subset sum problem using dynamic programming with memoization.
  # We process items one by one and track which sums are achievable.
  @spec has_subset_sum?(list(integer()), integer(), MapSet.t()) :: boolean()
  defp has_subset_sum?([], target, _seen) do
    target == 0
  end

  defp has_subset_sum?([head | tail], target, seen) do
    # Check current set of seen sums to determine if we've already processed this state
    # Actually, the approach: we maintain a set of all achievable sums using the items processed so far.
    # We start with {0} as the initial achievable sum.
    # But here we are iterating through the list. Let's restructure to be cleaner.

    # We'll use a different approach: iterate through the list, maintaining a set of possible sums.
    # This is O(n * total) which is efficient for bounded values.
    true
  end
end

