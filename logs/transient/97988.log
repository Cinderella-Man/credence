  test "returns true for [1,1,1,0,1]" do
    assert Solution.can_split_equal([1, 1, 1, 0, 1]) == true
  end

  test "returns false for [1,1,0,1]" do
    assert Solution.can_split_equal([1, 1, 0, 1]) == false
  end

  test "returns true for [0,0,0,0]" do
