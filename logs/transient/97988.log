---REFERENCE---
defmodule Solution do
  def can_split_equal(arr) do
    total = Enum.sum(arr)
    if rem(total, 2) == 1 do
      false
    else
      target = div(total, 2)
      dp = List.duplicate(false, target + 1) |> List.replace_at(0, true)
      Enum.reduce(arr, dp, fn num, acc ->
        if num == 0 do
          acc
        else
          Enum.reduce(target..num//-1, acc, fn i, current ->
            if Enum.at(current, i - num) do
              List.replace_at(current, i, true)
            else
              current
            end
          end)
        end
      end)
      |> Enum.at(target)
    end
  end
end
