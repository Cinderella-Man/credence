            name_str = Atom.to_string(name)

          if String.starts_with?(name_str, "_") do
            String.to_atom(String.trim_leading(name_str, "_"))
          else
            name
          end

          {node, actual_name == var_name}

        node, acc ->
          {node, acc}
      end)

    found?
  end

  # Remove unused parameters from all clauses and call sites in the module body
  defp remove_params_from_module_body(body, fun_name, indices) do
    case body do
      {:__block__, meta, stmts} ->
        new_stmts =
          Enum.map(stmts, fn stmt ->
            transform_statement(stmt, fun_name, indices)
          end)

        {:__block__, meta, new_stmts}

      single ->
        transform_statement(single, fun_name, indices)
    end
  end

  # Transform a single statement, updating defp clauses and call sites
  defp transform_statement(stmt, fun_name, indices) do
    Macro.postwalk(stmt, fn
      # Transform defp clause definitions
      {:defp, meta, [head | rest]} ->
        case head do
          {:when, when_meta, [{^fun_name, fun_meta, args} | guard_parts]} ->
            new_args = remove_indices(args, indices)
