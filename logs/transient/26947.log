defmodule Fibonacci do
  def fib(0), do: 0
  def fib(1), do: 1

  def fib(num) when is_integer(num) and num > 1 do
    fib_loop(num, 0, 1)
  end

  defp fib_loop(1, _prev, curr), do: curr
  defp fib_loop(num, prev, curr), do: fib_loop(num - 1, curr, prev + curr)
end
