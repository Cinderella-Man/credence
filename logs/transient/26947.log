defmodule TestVarOnly do
  def normalize_var_name(name) do
    name_str = Atom.to_string(name)
    if String.starts_with?(name_str, "_") do
      real_name = String.trim_leading(name_str, "_")
      if real_name == "", do: :_unnamed, else: String.to_atom(real_name)
    else
      name
    end
  end

  def check_var_usage(ast, var_name, fun_name) do
    case ast do
      {^fun_name, _meta, args} when is_list(args) ->
        IO.puts("  Matched recursive call to #{fun_name}")
        true

      {name, _, ctx} when is_atom(name) and is_atom(ctx) ->
        normalized = normalize_var_name(name)
        is_same = normalized == var_name
        IO.puts("  Variable node: #{name} -> #{normalized}, same? #{is_same}")
        not is_same

      {form, _meta, args} when is_list(args) ->
        IO.puts("  3-tuple: #{inspect(form)}, checking #{length(args)} args")
        Enum.all?(args, &check_var_usage(&1, var_name, fun_name))

      {left, right} ->
        check_var_usage(left, var_name, fun_name) and
          check_var_usage(right, var_name, fun_name)

      list when is_list(list) ->
        IO.puts("  List with #{length(list)} elements")
        Enum.all?(list, &check_var_usage(&1, var_name, fun_name))

      _ ->
        true
    end
  end
end

