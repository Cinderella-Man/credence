  @moduledoc """
  Detects unused parameters threaded through all clauses of a private helper.

  When a `defp` function has a parameter that is never read in any clause's
  body, guard, or pattern (beyond the parameter position itself), it is dead
  code that should be removed for clarity.

  ## Bad

      defp do_add_lists([f | rest_first], [s | rest_second], index) do
        [f + s | do_add_lists(rest_first, rest_second, index)]
      end

      defp do_add_lists([], remaining, _index) do
        remaining
      end

      defp do_add_lists(remaining, [], _index) do
        remaining
      end

  ## Good

      defp do_add_lists([f | rest_first], [s | rest_second]) do
        [f + s | do_add_lists(rest_first, rest_second)]
      end

      defp do_add_lists([], remaining) do
        remaining
      end

      defp do_add_lists(remaining, []) do
        remaining
      end
  """

  use Credence.Pattern.Rule
  alias Credence.Issue
  alias Credence.RuleHelpers

  @impl true
  def check(ast, _opts) do
    {_ast, issues} =
      Macro.prewalk(ast, [], fn node, acc ->
        case node do
          {:defmodule, _, _} ->
            {node, detect_issues(node) ++ acc}

          _ ->
            {node, acc}
        end
      end)

    Enum.reverse(issues)
  end

  @impl true
  def fix_patches(ast, opts) do
    source = Keyword.get(opts, :source, "")

    RuleHelpers.patches_from_ast_transform(ast, source, fn ast ->
      Macro.prewalk(ast, fn
        {:defmodule, mod_meta, [alias_node, do_kw]} = node ->
          case do_kw do
            [{{:__block__, do_meta, [:do]}, body}] ->
              case find_unused_param_indices(body) do
                {fun_name, indices} when indices != [] ->
                  new_body = remove_params_from_module_body(body, fun_name, indices)
                  {:defmodule, mod_meta, [alias_node, [{{:__block__, do_meta, [:do]}, new_body}]]}

                _ ->
                  node
              end

            _ ->
              node
          end

        node ->
          node
      end)
    end)
  end

  # Find which parameter indices are unused across all clauses of a defp function
  defp find_unused_param_indices(body) do
    case body do
      {:__block__, _, stmts} ->
        # Group defp clauses by function name
        defp_groups = collect_defp_groups(stmts)

        # Find the first group with unused params
        Enum.find_value(defp_groups, {nil, []}, fn {fun_name, clauses} ->
          case find_unused_indices(clauses) do
            [] -> nil
            indices -> {fun_name, indices}
          end
        end)

      _ ->
        {nil, []}
    end
  end

  # Collect all defp clauses grouped by function name
  defp collect_defp_groups(stmts) do
    stmts
    |> Enum.filter(fn
      {:defp, _, _} -> true
      _ -> false
    end)
    |> Enum.group_by(fn {:defp, _, [head | _]} ->
      case head do
        {:when, _, [{name, _, _} | _]} -> name
        {name, _, _} -> name
        _ -> nil
      end
    end)
    |> Enum.reject(fn {name, _} -> is_nil(name) end)
  end

  # Find parameter indices that are unused across ALL clauses of a function
  defp find_unused_indices(clauses) do
    # Get arity from first clause
    first_clause = hd(clauses)
    arity = clause_arity(first_clause)

    if arity == 0 do
      []
    else
      # Check each parameter index
      for idx <- 0..(arity - 1),
          all_clauses_unused?(clauses, idx) do
        idx
      end
    end
  end

  # Get the arity of a defp clause
  defp clause_arity({:defp, _, [head | _]}) do
    case head do
      {:when, _, [{_, _, args} | _]} when is_list(args) -> length(args)
      {_, _, args} when is_list(args) -> length(args)
      _ -> 0
    end
  end

  # Check if a parameter at given index is unused in ALL clauses
  defp all_clauses_unused?(clauses, param_idx) do
    Enum.all?(clauses, fn clause ->
      param_unused_in_clause?(clause, param_idx)
    end)
  end

  # Check if a parameter at given index is unused in a single clause
  defp param_unused_in_clause?({:defp, _, [head | rest]}, param_idx) do
    # Extract the function args and guard
    {args, guard} =
      case head do
        {:when, _, [{_, _, args} | guard_parts]} -> {args, guard_parts}
        {_, _, args} -> {args, []}
      end

    # Get the parameter name at the given index (if it exists)
    param_name = get_param_name(args, param_idx)

    case param_name do
      nil ->
        # Complex pattern or underscore - can't determine name, assume used
        false

      :_unnamed ->
        # Bare underscore - skip, not a real parameter
        false

      name ->
        # Check if the param is used in body or guard
        body = extract_do_body(rest)
        used_in_body? = var_used_in_ast?(name, body)
        used_in_guard? = Enum.any?(guard, &var_used_in_ast?(name, &1))
        not used_in_body? and not used_in_guard?
    end
  end

  # Get parameter name at a given index
  defp get_param_name(args, idx) when is_list(args) and idx < length(args) do
    param = Enum.at(args, idx)

    case param do
      # Bare underscore - unnamed parameter
      {:_, _, _} ->
        :_unnamed

      # Underscore-prefixed variable - extract the real name
      {name, _, ctx} when is_atom(name) and is_atom(ctx) ->
        name_str = Atom.to_string(name)

        if String.starts_with?(name_str, "_") do
          # This is an underscore-prefixed variable like `_index`
          # Extract the real name for checking usage
          real_name_str = String.trim_leading(name_str, "_")

          if real_name_str == "" do
            # Just underscore with nothing after
            :_unnamed
          else
            String.to_atom(real_name_str)
          end
        else
          name
        end

      # Complex pattern - can't determine name
      _ ->
        nil
    end
  end

  defp get_param_name(_, _), do: nil

  # Extract the do body from a clause
  defp extract_do_body(rest) when is_list(rest) do
    # Handle nested list structure from Sourceror
    case rest do
      [kw_list | _] when is_list(kw_list) ->
        # Try keyword list format first (do: body)
        case Keyword.fetch(kw_list, :do) do
          {:ok, body} -> body
          :error ->
            # Try block format {{:__block__, _, [:do]}, body}
            case kw_list do
              [{{:__block__, _, [:do]}, body} | _] -> body
              _ -> nil
            end
        end

      _ ->
        nil
    end
  end

  defp extract_do_body(_), do: nil

  # Check if a variable is used in an AST subtree
  defp var_used_in_ast?(var_name, ast) do
    {_ast, found?} =
      Macro.prewalk(ast, false, fn
        node, true ->
