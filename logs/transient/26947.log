ast = Sourceror.parse_string!(source)

# Debug
Macro.prewalk(ast, nil, fn
  {:defmodule, _, [_alias_node, [{{:__block__, _, [:do]}, body}]]}, acc ->
    IO.puts("=== Module body ===")
    
    case body do
      {:__block__, _, stmts} ->
        defp_groups = stmts
        |> Enum.filter(fn {:defp, _, _} -> true; _ -> false end)
        |> Enum.group_by(fn {:defp, _, [head | _]} ->
          case head do
            {:when, _, [{name, _, _} | _]} -> name
            {name, _, _} -> name
            _ -> nil
          end
        end)
        |> Enum.reject(fn {name, _} -> is_nil(name) end)
        
        IO.inspect(defp_groups, label: "defp_groups")
        
        Enum.each(defp_groups, fn {fun_name, clauses} ->
          IO.puts("\\n=== #{fun_name} ===")
          IO.puts("Arity: #{length(elem(elem(hd(clauses), 2) |> hd(), 2))}")
          
          # Check each param
          first_clause = hd(clauses)
          {:defp, _, [first_head | _]} = first_clause
          {_, _, first_args} = first_head
          arity = length(first_args)
          
          for idx <- 0..(arity-1) do
            IO.puts("\\nParam index #{idx}:")
            Enum.each(clauses, fn {:defp, _, [head | rest]} ->
              {args, guard} = case head do
                {:when, _, [{_, _, a} | g]} -> {a, g}
                {_, _, a} -> {a, []}
              end
              
              param = Enum.at(args, idx)
              IO.puts("  Clause param: #{inspect(param)}")
            end)
          end
        end)
      _ ->
        IO.puts("Not a block")
    end
    
    {body, acc}
  node, acc ->
    {node, acc}
end)
