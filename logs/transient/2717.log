defmodule Solution do
  @doc """
  Returns the maximum integer in a list.

  Returns `nil` if the list is empty or contains any non-integer elements.
  """
  @spec find_max_integer(list(any())) :: integer() | nil
  def find_max_integer([]), do: nil

  def find_max_integer([head | tail]) when not is_integer(head) do
    nil
  end

  def find_max_integer([head | tail]) do
    case find_max_integer(tail) do
      nil -> nil
      max -> max(head, max)
    end
  end
end
