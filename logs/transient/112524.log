---MODULE---
@doc """
Returns the largest integer in the list that is a perfect square.
Returns `nil` if the list contains no perfect squares.

## Examples

    iex> Solution.largest_perfect_square([16, 25, 36, 49, 50])
    49

    iex> Solution.largest_perfect_square([25, 5, 100, 2000, 121])
    121

    iex> Solution.largest_perfect_square([1, 2, 3])
    1

    iex> Solution.largest_perfect_square([])
    nil

    iex> Solution.largest_perfect_square([-4, -9, -16])
    nil
"""
@spec largest_perfect_square([integer()]) :: integer() | nil
def largest_perfect_square(numbers) when is_list(numbers) do
  numbers
  |> Enum.filter(&is_perfect_square?/1)
  |> largest()
end

@spec largest([integer()]) :: integer() | nil
defp largest([]), do: nil

defp largest(list) do
  Enum.max(list)
end

@spec is_perfect_square?(integer()) :: boolean()
defp is_perfect_square?(number) when number < 0, do: false

defp is_perfect_square?(number) do
  if number >= 0 do
    root = Float.round(:math.sqrt(number), 0)
    root * root == number
  else
    false
  end
end
