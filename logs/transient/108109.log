defmodule Solution do
  @doc """
  Returns the k-th symbol in the n-th row of the grammar.

  The grammar starts with row 1 being "0". Each subsequent row is generated by
  replacing every "0" with "01" and every "1" with "10".

  ## Examples

      iex> Solution.kth_grammar(1, 1)
      0

      iex> Solution.kth_grammar(2, 1)
      0

      iex> Solution.kth_grammar(2, 2)
      1

      iex> Solution.kth_grammar(4, 5)
      1

  """
  @spec kth_grammar(pos_integer(), pos_integer()) :: 0 | 1
  def kth_grammar(1, _k) do
    0
  end

  def kth_grammar(n, k) when k <= div(2, 2) do
    # This clause won't match since for n > 1, the first half is determined by the parent
    # Actually, let's think recursively:
    # Row n has 2^(n-1) elements.
    # The first half of row n is the same as row n-1.
    # The second half of row n is the bitwise NOT of row n-1.
    # For k in the first half: kth_grammar(n, k) = kth_grammar(n-1, k)
    # For k in the second half: kth_grammar(n, k) = 1 - kth_grammar(n-1, k - 2^(n-2))
    # Wait, let me reconsider. Let's use a cleaner recursive approach.
    # 
    # Base case: n=1, k=1, return 0.
    # For n > 1:
    #   The parent in row n-1 is at position ceil(k/2).
    #   If the parent is 0, then:
    #     - if k is odd (left child), the child is 0
    #     - if k is even (right child), the child is 1
    #   If the parent is 1, then:
    #     - if k is odd (left child), the child is 1
    #     - if k is even (right child), the child is 0
    #
    # So: kth_grammar(n, k) = kth_grammar(n-1, ceil(k/2)) XOR (k rem 2)
    # Wait, let's verify:
    # kth_grammar(2, 1): parent = kth_grammar(1, 1) = 0. k=1, 1 rem 2 = 1. 0 XOR 1 = 1? But expected is 0.
    # Hmm, let me re-check.
    # Row 1: 0
    # Row 2: 01
    # Row 3: 0110
    # Row 4: 01101001
    #
    # kth_grammar(2, 1) should be 0. Parent is kth_grammar(1, 1) = 0. k=1 (odd). If parent is 0, left child is 0. Correct.
    # kth_grammar(2, 2) should be 1. Parent is kth_grammar(1, 1) = 0. k=2 (even). If parent is 0, right child is 1. Correct.
    #
    # So the rule is:
    #   If k is odd (left child): result = parent
    #   If k is even (right child): result = 1 - parent
    #
    # Which is: result = parent XOR (k rem 2)
    # Let's verify: 
    #   k=1 (odd): k rem 2 = 1. parent XOR 1. For kth_grammar(2,1): 0 XOR 1 = 1. But expected is 0. 
    # That's wrong. Let me re-think.
    #
    # Actually: if k is odd (left child), result = parent. If k is even (right child), result = 1 - parent.
    # So: result = if k is odd, parent, else 1 - parent.
    # This can be written as: result = parent XOR (if k is even then 1 else 0) = parent XOR (1 - (k rem 2))
    # Or simpler: result = parent XOR (k rem 2) doesn't work as shown.
    # Let's try: result = parent XOR ((k - 1) rem 2)
    # k=1: (1-1) rem 2 = 0. parent XOR 0 = parent. Correct for left child.
    # k=2: (2-1) rem 2 = 1. parent XOR 1. Correct for right child (bit flip).
    # Yes! So: kth_grammar(n, k) = kth_grammar(n-1, ceil(k/2)) XOR ((k - 1) rem 2)
    
    parent = kth_grammar(n - 1, ceil_k(k))
    parent XOR ((k - 1) rem 2)
  end

  defp ceil_k(k) do
    div(k + 1, 2)
  end
end
---TEST---
