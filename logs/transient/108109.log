  end

  test "kth_grammar(1, 1) returns 0" do
    assert Solution.kth_grammar(1, 1) == 0
  end

  test "kth_grammar(4, 5) returns 1" do
    assert Solution.kth_grammar(4, 5) == 1
  end

  test "kth_grammar(2, 1) returns 0" do
    assert Solution.kth_grammar(2, 1) == 0
  end
end
