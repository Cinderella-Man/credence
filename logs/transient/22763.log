    assert Solution.lengthoflongestsubstringkdistinct("aabbcc", 1) == 2
  end
end
---REFERENCE---
defmodule Solution do
  @spec lengthoflongestsubstringkdistinct(String.t(), integer()) :: integer()
  def lengthoflongestsubstringkdistinct(s, k) do
    if k == 0 do
      0
    else
      len = String.length(s)
      {_, _, max} =
        Enum.reduce(0..(len - 1), {0, %{}, 0}, fn r, {left, map, max} ->
          c = String.at(s, r)
          map = Map.update(map, c, 1, &(&1 + 1))
          {left, map} = shrink(s, left, map, k)
          current_max = max(max, r - left + 1)
          {left, map, current_max}
        end)

      max
    end
  end

  defp shrink(s, left, map, k) do
    if map_size(map) > k do
      c_left = String.at(s, left)
      new_count = Map.get(map, c_left) - 1

      new_map =
        if new_count == 0 do
          Map.delete(map, c_left)
        else
          Map.put(map, c_left, new_count)
        end

      shrink(s, left + 1, new_map, k)
    else
      {left, map}
    end
  end
end
