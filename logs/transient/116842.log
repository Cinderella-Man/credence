defmodule Solution do
  # Implementation of S(n, k) = k * S(n-1, k) + S(n-1, k-1)
  # To avoid infinite recursion, I will use a recursive function structure or a memoization approach if needed.
  # However, for the scope of the exercise, a direct recursive implementation or a simple loop is sufficient.
  def partition_ways(n, k) do
  # Base cases
  if n <= 0 do
    if k == 0 do
      1
    else
      0
    end
  end

  def partition_ways(n, k) do
    # Handle k > n case
    if k > n do
      0
    # Base case k=0, n > 0: result is 0
    else if n > 0 and k == 0 do
      0
    # Base case n=0 and k=0: returns 1
    else if n == 0 and k == 0 do
      1
    # k equals n: 1
    else if k == n and n > 0 do
      1
    # k < 0: 0
    else if k < 0 do
      0
    else
      # Recursive step
      k * partition_ways(n - 1, k) + partition_ways(n - 1, k - 1)
    end
  end
end
