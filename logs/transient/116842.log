---REFERENCE---
defmodule Solution do
  @spec partition_ways(non_neg_integer(), non_neg_integer()) :: non_neg_integer()
  def partition_ways(0, 0), do: 1
  def partition_ways(n, k) when k > n, do: 0
  def partition_ways(n, k) when k == 0 and n > 0, do: 0
  def partition_ways(n, k) when k == n, do: 1

  def partition_ways(n, k) do
    # Build up a map {(i,j) => S(i,j)} row by row
    initial = %{{0, 0} => 1}

    Enum.reduce(1..n, initial, fn i, acc ->
      Enum.reduce(0..i, acc, fn j, inner_acc ->
        val =
          cond do
            j == 0 -> 0
            j == i -> 1
            true ->
              (j * Map.get(inner_acc, {i - 1, j}, 0)) +
                Map.get(inner_acc, {i - 1, j - 1}, 0)
          end

        Map.put(inner_acc, {i, j}, val)
      end)
    end)
    |> Map.get({n, k})
  end
end

