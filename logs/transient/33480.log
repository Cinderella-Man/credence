---MODULE---
defmodule Solution do
  @doc """
  Checks if a binary tree is height-balanced.
  """
  @spec balanced_binary_tree?(any()) :: boolean()
  def balanced_binary_tree?(nil), do: true

  def balanced_binary_tree?({value, left, right}) do
    case check_balance({value, left, right}) do
      :unbalanced -> false
      {height, _} -> true
    end
  end

  # Internal function to check balance and return height
  # If unbalanced, returns {:error, message} instead of height
  defp check_balance(nil), do: {0, :ok}

  defp check_balance({_value, left, right}) do
    case check_balance(left) do
      {:error, _} = error -> error
      {left_height, :ok} ->
        case check_balance(right) do
          {:error, _} = error -> error
          {right_height, :ok} ->
            diff = abs(left_height - right_height)
            if diff > 1 do
              {:error, :unbalanced}
            else
              {max(left_height, right_height) + 1, :ok}
            end
        end
    end
  end
end
