---REFERENCE---
defmodule Solution do
  def balanced_binary_tree?(tree) do
    check_height(tree) != :unbalanced
  end

  defp check_height(nil), do: 0

  defp check_height({_value, left, right}) do
    case check_height(left) do
      :unbalanced -> :unbalanced
      left_height ->
        case check_height(right) do
          :unbalanced -> :unbalanced
          right_height ->
            if abs(left_height - right_height) > 1 do
              :unbalanced
            else
              max(left_height, right_height) + 1
            end
        end
    end
  end
end
