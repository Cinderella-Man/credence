def max_subarray_sum(arr, k) do
  if k <= 0 or length(arr) < k do
    raise "invalid input"
  end

  {initial_sum, _rest} = sliding_window_max(arr, k, [], k)
  initial_sum
end

defp sliding_window_max(window, _k, _initial, count) when count == 0 do
  max_sum = Enum.sum(window)
  {max_sum, Enum.sum(window)}
end

defp sliding_window_max([head | tail], k, initial_window, remaining) do
  current_sum = Enum.sum(initial_window) + head - hd(initial_window)
  new_max = max(Enum.sum(initial_window), current_sum)
  sliding_window_max(tail, k, tl(initial_window) ++ [head], remaining - 1)
end
