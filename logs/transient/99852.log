defmodule Solution do
  def max_subarray_sum(arr, k) do
    cond do
      k <= 0 or k > length(arr) -> 0
      true -> 
        window_sum = Enum.sum(Enum.take(arr, k))
        do_slide(arr, k, window_sum, window_sum, 0)
    end
  end

  defp do_slide(arr, k, current_sum, max_sum, start_index) do
    if start_index + k >= length(arr) do
      max_sum
    else
      next_sum = current_sum - Enum.at(arr, start_index) + Enum.at(arr, start_index + k)
      do_slide(arr, k, next_sum, max(max_sum, next_sum), start_index + 1)
    end
  end
end
