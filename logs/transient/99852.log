```elixir
defmodule Solution do
  def max_subarray_sum(_list, k) when k <= 0, do: nil
  def max_subarray_sum(list, k) when length(list) < k, do: nil
  def max_subarray_sum(list, k) do
    window = Enum.take(list, k)
    initial_sum = Enum.sum(window)

    Enum.reduce(k..length(list), {initial_sum, initial_sum, window, list}, fn _, {current_sum, max_sum, current_window, remaining} ->
      new_sum = current_sum - hd(current_window) + hd(remaining)
      new_window = tl(current_window) ++ [hd(remaining)]
      new_max = max(max_sum, new_sum)

      {new_sum, new_max, new_window, tl(remaining)}
    end)
    |> elem(1)
  end
end
```
