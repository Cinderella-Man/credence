defmodule Solution do
  @doc """
  Find the maximum sum of any contiguous subarray of exactly length k.
  Uses a sliding window approach for O(n) time complexity.
  """
  @spec max_subarray_sum(list(integer()), integer()) :: integer()
  def max_subarray_sum(arr, k) when k <= 0 or k > length(arr) do
    0
  end

  def max_subarray_sum(arr, k) do
    initial_window = Enum.slice(arr, 0, k)
    current_sum = Enum.sum(initial_window)
    max_sum = current_sum

    {remaining, _removed} = Enum.split(arr, k)
    do_max_subarray_sum(remaining, k, current_sum, max_sum)
  end

  @spec do_max_subarray_sum(list(integer()), integer(), integer(), integer()) :: integer()
  defp do_max_subarray_sum(_window_items, _k, current_sum, max_sum)
       when current_sum == 0 and max_sum == 0 do
    0
  end

  defp do_max_subarray_sum([], _k, _current_sum, max_sum) do
    max_sum
  end

  defp do_max_subarray_sum([outgoing | rest], k, current_sum, max_sum) do
    entering = Enum.at(rest, k - 1)

    new_sum =
      case entering do
        nil -> current_sum
        val -> current_sum - outgoing + val
      end

    new_max = max(max_sum, new_sum)
    do_max_subarray_sum(rest, k, new_sum, new_max)
  end
end
