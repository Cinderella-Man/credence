@spec max_subarray_sum(list(integer()), integer()) :: integer()
def max_subarray_sum(arr, k) when k <= 0 or k > length(arr) do
  0
end

def max_subarray_sum(arr, k) do
  current_sum = Enum.sum(Enum.slice(arr, 0, k))
  max_sum = current_sum
  max_subarray_sum_tail(arr, k, current_sum, max_sum, k)
end

@spec max_subarray_sum_tail(list(integer()), integer(), integer(), integer(), integer()) :: integer()
defp max_subarray_sum_tail(arr, _k, current_sum, max_sum, index) when index >= length(arr) do
  max_sum
end

defp max_subarray_sum_tail(arr, k, current_sum, max_sum, index) do
  leaving = Enum.at(arr, index - 1)
  entering = Enum.at(arr, index + k - 1)
  new_sum = current_sum - leaving + entering
  new_max = max(max_sum, new_sum)
  max_subarray_sum_tail(arr, k, new_sum, new_max, index + 1)
end
