---REFERENCE---
defmodule Solution do
  @spec top_k_strings([String.t()], non_neg_integer()) :: [String.t()]
  def top_k_strings(str_list, k) do
    str_list
    |> Enum.with_index()
    |> Enum.sort(fn {s1, i1}, {s2, i2} ->
      len1 = String.length(s1)
      len2 = String.length(s2)
      len1 > len2 or (len1 == len2 and i1 < i2)
    end)
    |> Enum.take(k)
    |> Enum.map(&elem(&1, 0))
  end
end
