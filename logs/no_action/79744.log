@doc """
Returns a list of at most `k` strings from `strings`, ordered by descending length.
Strings of equal length retain their original order (stable sort).
"""
@spec top_k_strings([String.t()], non_neg_integer()) :: [String.t()]
def top_k_strings(strings, k) when is_list(strings) and is_integer(k) and k >= 0 do
  if k == 0 or length(strings) == 0 do
    []
  else
    strings
    |> Enum.with_index()
    |> Enum.sort_by(fn {_string, index} ->
      {length(_string), -index}
    end)
    |> Enum.take(k)
    |> Enum.map(fn {string, _index} ->
      string
    end)
  end
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "top_k_strings with example 1" do
    assert Solution.top_k_strings(["hello", "world", "python", "code"], 2) == ["python", "hello"]
  end

  test "top_k_strings with example 2" do
    assert Solution.top_k_strings(["a", "ab", "abc", "abcd"], 3) == ["abcd", "abc", "ab"]
  end

  test "top_k_strings with example 3" do
    assert Solution.top_k_strings(["one", "two", "three", "four"], 1) == ["three"]
  end
end
