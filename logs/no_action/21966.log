defmodule Solution do
  @spec num_combinations(integer) :: integer
  def num_combinations(n) when n >= 0 do
    dp = [1] ++ List.duplicate(0, n)
    Enum.reduce(1..n, dp, fn i, acc ->
      sum = Enum.reduce(0..(i-1), 0, fn j, s ->
        s + Enum.at(acc, j) * Enum.at(acc, i - j - 1)
      end)
      List.replace_at(acc, i, sum)
    end)
    |> List.last()
  end
end
