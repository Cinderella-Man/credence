where you can take 1, 2, or 3 steps at a time.
"""
@spec jump_ways(non_neg_integer()) :: non_neg_integer()
def jump_ways(0), do: 1
def jump_ways(1), do: 1
def jump_ways(2), do: 2

def jump_ways(n) when is_integer(n) and n > 2 do
  iterate(3, n, {1, 1, 2})
end

defp iterate(current, target, {prev2, prev1, prev0}) when current < target do
  next = prev0 + prev1 + prev2
  iterate(current + 1, target, {prev1, prev0, next})
end

defp iterate(_current, _target, {_prev2, _prev1, prev0}) do
  prev0
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "jump_ways for 0 steps" do
    assert Solution.jump_ways(0) == 1
  end

  test "jump_ways for 1 step" do
    assert Solution.jump_ways(1) == 1
  end

  test "jump_ways for 2 steps" do
    assert Solution.jump_ways(2) == 2
  end

  test "jump_ways for 3 steps" do
    assert Solution.jump_ways(3) == 4
  end

  test "jump_ways for 4 steps" do
    assert Solution.jump_ways(4) == 7
  end

  test "jump_ways for 5 steps" do
    assert Solution.jump_ways(5) == 13
  end

  test "jump_ways for a larger step count" do
    assert Solution.jump_ways(10) == 274
  end
end
