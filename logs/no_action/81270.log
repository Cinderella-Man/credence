defmodule Solution do
  @doc """
  Finds the kth largest element in a list using a min-heap approach.

  Maintains a min-heap of size k that holds the k largest elements seen so far.
  The smallest of those k elements (the root of the min-heap) is at the top.
  After processing all elements, the root is the kth largest element.

  Time complexity: O(n log k)
  Space complexity: O(k)
  """
  @spec findkthlargestelement(list(integer()), integer()) :: integer()
  def findkthlargestelement(list, k) when is_list(list) and is_integer(k) and k > 0 do
    case list do
      [] ->
        raise ArgumentError, "Cannot find kth largest of empty list"

      _ ->
        # Use a min-heap approach with :gb_trees or a simple sorted list
        # Since Elixir doesn't have a built-in min-heap, we'll use a list
        # and keep it sorted to simulate min-heap behavior
        # For efficiency, we use a list of at most k elements, kept sorted
        # Actually, let's use a simpler approach: maintain a list of k elements
        # sorted in ascending order (min at head)

        # Process elements and maintain a min-heap of size k
        # We'll use a list and keep it sorted for simplicity
        result =
          list
          |> Enum.reduce([], fn element, heap ->
            add_to_heap(heap, element, k)
          end)
          |> List.first()

        result
    end
  end

  # Helper function to add an element to the min-heap of size k
  # The heap is maintained as a sorted list in ascending order
  # The smallest element is at the head
  defp add_to_heap(heap, element, k) when is_list(heap) and is_integer(element) and is_integer(k) do
    case heap do
      [] ->
        # Empty heap, add the element
        [element]

      _ ->
        # Check if heap has reached size k
        if length(heap) < k do
          # Insert element into sorted position
          insert_sorted(heap, element)
        else
          # Heap is at capacity k
          # Get the minimum (head of sorted list)
          [min_val | _rest] = heap
          # If new element is larger than minimum, replace minimum
          if element > min_val do
            # Remove the minimum and insert the new element in sorted position
            remove_and_insert(heap, element, k)
          else
            # New element is not larger than minimum, keep heap as is
            heap
          end
        end
    end
  end

  # Insert element into a sorted list
  defp insert_sorted([], element), do: [element]

  defp insert_sorted([head | rest], element) when element <= head do
    [element | [head | rest]]
  end

  defp insert_sorted([head | rest], element) when element > head do
    [head | insert_sorted(rest, element)]
  end

  # Remove the minimum element from sorted list and insert new element in sorted position
  defp remove_and_insert(heap, new_element, _k) do
    # heap is sorted ascending, so head is minimum
    [_min | rest] = heap
    insert_sorted(rest, new_element)
  end
end
