defmodule Solution do
  @spec findkthlargestelement(list(integer()), integer()) :: integer()
  def findkthlargestelement(nums, k) do
    {init, rest} = Enum.split(nums, k)
    heap = Enum.sort(init)

    Enum.reduce(rest, heap, fn x, acc ->
      if x > hd(acc) do
        insert_sorted(tl(acc), x)
      else
        acc
      end
    end)
    |> hd()
  end

  defp insert_sorted([], x), do: [x]
  defp insert_sorted([h | _t] = list, x) when x <= h, do: [x | list]
  defp insert_sorted([h | t], x), do: [h | insert_sorted(t, x)]
end
