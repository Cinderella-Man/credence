defmodule Solution do
  @spec findkthlargestelement([integer], integer) :: integer
  def findkthlargestelement(nums, k) when k > 0 do
    indexed = Enum.with_index(nums)
    {init, rest} = Enum.split(indexed, k)

    heap =
      Enum.reduce(init, :gb_sets.new(), fn {val, idx}, acc ->
        :gb_sets.add_element({val, idx}, acc)
      end)

    heap =
      Enum.reduce(rest, heap, fn {val, idx}, acc ->
        {min_val, _} = :gb_sets.first(acc)

        if val > min_val do
          acc
          |> :gb_sets.delete(:gb_sets.first(acc))
          |> :gb_sets.add_element({val, idx})
        else
          acc
        end
      end)

    {result, _} = :gb_sets.first(heap)
    result
  end
end
