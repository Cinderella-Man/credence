  end

  test "kth largest in small list" do
    assert Solution.findkthlargestelement([3, 2, 1, 5, 6, 4], 2) == 5
  end

  test "kth largest in sorted list" do
    assert Solution.findkthlargestelement([1, 2, 3, 4, 5], 3) == 3
  end
end
