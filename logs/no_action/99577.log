defmodule Solution do
  @doc """
  Returns the first character in the string that does not repeat.
  If every character repeats or the string is empty, returns nil.
  The function is case-sensitive.
  """
  @spec non_repeating(String.t()) :: String.t() | nil
  def non_repeating(<<>>), do: nil

  def non_repeating(string) do
    char_counts =
      string
      |> String.graphemes()
      |> Enum.reduce(%{}, fn char, acc ->
        Map.update(acc, char, 1, &(&1 + 1))
      end)

    string
    |> String.graphemes()
    |> Enum.find_value(nil, fn char ->
      if char_counts[char] == 1, do: char
    end)
  end
end
