defmodule Solution do
  @spec num_of_ways_to_traverse_grid(integer(), integer()) :: integer()
  def num_of_ways_to_traverse_grid(m, n) do
    # Build a 2D grid using dynamic programming
    # grid[i][j] = number of ways to reach cell (i, j) from (1, 1)
    grid = for _ <- 0..m, do: for(_ <- 0..n, do: 0)

    grid =
      grid
      |> List.update_at(1, fn row ->
        List.update_at(row, 1, fn _ -> 1 end)
      end)

    for i <- 1..m, j <- 1..n, !(i == 1 and j == 1), reduce: grid do
      acc ->
        value = Enum.at(Enum.at(acc, i - 1), j) + Enum.at(Enum.at(acc, i), j - 1)

        acc
        |> List.update_at(i, fn row ->
          List.update_at(row, j, fn _ -> value end)
        end)
    end
    |> Enum.at(m)
    |> Enum.at(n)
  end
end

