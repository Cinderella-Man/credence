---MODULE---
@doc """
  Calculates the number of ways to traverse a grid from top-left to bottom-right,
  moving only right or down at each step.

  ## Parameters
    - rows: A positive integer representing the number of rows.
    - cols: A positive integer representing the number of columns.

  ## Examples

      iex> Solution.num_of_ways_to_traverse_grid(3, 3)
      6

      iex> Solution.num_of_ways_to_traverse_grid(2, 2)
      2

      iex> Solution.num_of_ways_to_traverse_grid(1, 5)
      1
"""
@spec num_of_ways_to_traverse_grid(pos_integer(), pos_integer()) :: non_neg_integer()
def num_of_ways_to_traverse_grid(rows, cols) do
  # The number of ways is C(rows + cols - 2, rows - 1)
  # or equivalently C(rows + cols - 2, cols - 1)
  # because we need to make (rows - 1) down moves and (cols - 1) right moves,
  # for a total of (rows + cols - 2) moves.

  total_moves = rows + cols - 2
  down_moves = rows - 1

  combinations(total_moves, down_moves)
end

defp combinations(_n, _r) when _r < 0, do: 0
defp combinations(_n, 0), do: 1
defp combinations(_n, 1), do: 1
defp combinations(n, r) when r > div(n, 2), do: combinations(n, n - r)

defp combinations(n, r) do
  # Calculate C(n, r) = n! / (r! * (n-r)!)
  # We compute it iteratively to avoid large intermediate factorials
  # C(n, r) = n * (n-1) * ... * (n-r+1) / r!
  
  numerator = Enum.reduce((n - r + 1)..n, 1, fn i, acc -> acc * i end)
  denominator = factorial(r)

  div(numerator, denominator)
end

defp factorial(0), do: 1
defp factorial(n) when n > 0 do
  Enum.reduce(1..n, 1, fn i, acc -> acc * i end)
end
