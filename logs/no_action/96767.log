defmodule Solution do
  def pascalstriangle(n) do
    row = List.duplicate(1, n + 1)
    Enum.reduce(1..n, row, fn i, current_row ->
      Enum.reduce((i - 1)..1//-1, current_row, fn j, acc ->
        List.replace_at(acc, j, Enum.at(acc, j) + Enum.at(acc, j - 1))
      end)
    end)
  end
end
