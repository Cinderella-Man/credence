defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "empty list returns empty list" do
    assert Solution.longest_consecutive_sublist([]) == []
  end

  test "single element list returns that element as a list" do
    assert Solution.longest_consecutive_sublist([5]) == [5]
  end

  test "multiple singletons returns the smallest singleton" do
    assert Solution.longest_consecutive_sublist([10, 5, 12, 3]) == [3]
  end

  test "longest consecutive sublist with multiple runs" do
    assert Solution.longest_consecutive_sublist([1, 9, 3, 10, 4, 20, 2]) == [1, 2, 3, 4]
  end

  test "longest consecutive sublist with unsorted input" do
    assert Solution.longest_consecutive_sublist([100, 4, 200, 1, 3, 2]) == [1, 2, 3, 4]
  end

  test "handles duplicates correctly" do
    assert Solution.longest_consecutive_sublist([1, 1, 2, 2, 3]) == [1, 2, 3]
  end

  test "handles negative numbers" do
    assert Solution.longest_consecutive_sublist([-5, -4, -3, 0, 1]) == [-5, -4, -3]
  end
end
