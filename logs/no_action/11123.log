---INSTRUCTION---
Write an Elixir function that, given a list of integers, returns the longest sublist of consecutive integers. The sublist should be sorted in ascending order. If there are multiple sublists of the same maximum length, return the one that appears first when the input is sorted. Duplicate values should be ignored when forming consecutive sequences. If the input list is empty, return an empty list. The function should have the name `longest_consecutive_sublist/1` and be defined in a module named `Solution`.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "empty list returns empty list" do
    assert Solution.longest_consecutive_sublist([]) == []
  end

  test "single element list returns that element as a list" do
    assert Solution.longest_consecutive_sublist([5]) == [5]
  end

  test "multiple singletons returns the smallest singleton" do
    assert Solution.longest_consecutive_sublist([10, 5, 12, 3]) == [3]
  end

  test "longest consecutive sublist with multiple runs" do
    assert Solution.longest_consecutive_sublist([1, 9, 3, 10, 4, 20, 2]) == [1, 2, 3, 4]
  end

  test "longest consecutive sublist with unsorted input" do
    assert Solution.longest_consecutive_sublist([100, 4, 200, 1, 3, 2]) == [1, 2, 3, 4]
  end

  test "handles duplicates correctly" do
    assert Solution.longest_consecutive_sublist([1, 1, 2, 2, 3]) == [1, 2, 3]
  end

  test "handles negative numbers" do
    assert Solution.longest_consecutive_sublist([-5, -4, -3, 0, 1]) == [-5, -4, -3]
  end
end

---REFERENCE---
defmodule Solution do
  def longest_consecutive_sublist([]), do: []
  def longest_consecutive_sublist(lst) do
    [head | tail] = Enum.sort(lst)
    {current, _, longest} =
      Enum.reduce(tail, {[head], head, [head]}, fn x, {current, current_last, longest} ->
        cond do
          x == current_last + 1 ->
            {current ++ [x], x, longest}
          x != current_last ->
            if length(current) > length(longest) do
              {[x], x, current}
            else
              {[x], x, longest}
            end
          true ->
            {current, current_last, longest}
        end
      end)

    if length(current) > length(longest) do
      current
    else
      longest
    end
  end
end

