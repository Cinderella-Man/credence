---MODULE---
defmodule Solution do
  @doc """
  Returns the longest sublist of consecutive integers from the given list.
  The sublist is sorted in ascending order.
  If there are multiple sublists of the same maximum length, returns the one
  that appears first when the input is sorted (i.e., the one starting with the smallest number).
  Duplicates are ignored.
  If the input list is empty, returns an empty list.
  """
  @spec longest_consecutive_sublist([integer()]) :: [integer()]
  def longest_consecutive_sublist([]), do: []
  def longest_consecutive_sublist(nums) do
    unique_sorted = nums |> Enum.uniq() |> Enum.sort()

    # Group into consecutive sequences
    sequences = build_consecutive_sequences(unique_sorted)

    # Find the longest sequence; if tie, the one that starts first (smallest start)
    longest = find_longest_sequence(sequences)

    longest
  end

  defp build_consecutive_sequences([]), do: []

  defp build_consecutive_sequences([head | tail]) do
    # Group consecutive elements starting from head
    {sequence, remaining} = extract_consecutive(tail, [head])
    [sequence | build_consecutive_sequences(remaining)]
  end

  defp extract_consecutive([], current), do: {current, []}

  defp extract_consecutive([next_num | rest], current) do
    last = List.last(current)
    if next_num == last + 1 do
      extract_consecutive(rest, current ++ [next_num])
    else
      {current, [next_num | rest]}
    end
  end

  defp find_longest_sequence([]), do: []

  defp find_longest_sequence([head | tail]) do
    max_len = length(head)
    find_longest_in(tail, head, max_len)
  end

  defp find_longest_in([], best, _best_len), do: best

  defp find_longest_in([candidate | rest], best, best_len) do
    cand_len = length(candidate)
    if cand_len > best_len do
      find_longest_in(rest, candidate, cand_len)
    else
      find_longest_in(rest, best, best_len)
    end
  end
end
