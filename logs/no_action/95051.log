---REFERENCE---
defmodule Solution do
  @spec numberofsubarrays([integer()], integer()) :: integer()
  def numberofsubarrays(nums, k) do
    nums
    |> Enum.reduce({0, %{0 => 1}, 0}, fn num, {cur_odd, odd_counts, ans} ->
      new_cur_odd = if rem(num, 2) == 1, do: cur_odd + 1, else: cur_odd
      target = new_cur_odd - k
      add = Map.get(odd_counts, target, 0)
      updated_counts = Map.update(odd_counts, new_cur_odd, 1, &(&1 + 1))
      {new_cur_odd, updated_counts, ans + add}
    end)
    |> elem(2)
  end
end
