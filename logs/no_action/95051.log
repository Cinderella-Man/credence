---MODULE---
@doc """
Returns the count of contiguous subarrays containing exactly k odd numbers.
"""
defmodule Solution do
  @spec numberofsubarrays(list(integer), integer) :: non_neg_integer()
  def numberofsubarrays(nums, k) do
    odd_indices = get_odd_indices(nums)
    odd_count = length(odd_indices)

    if odd_count < k do
      0
    else
      odd_count_minus_k = odd_count - k
      # We need to iterate through windows of k odd numbers.
      # The window starts at index i in odd_indices (0-based)
      # The window ends at index i + k - 1 in odd_indices.
      
      # For each valid window i (from 0 to odd_count - k):
      # The start index in nums can be anywhere from (previous odd index + 1) to (current odd index)
      # The end index in nums can be anywhere from (current last odd index) to (next odd index - 1)
      # If no previous odd, start can go back to 0.
      # If no next odd, end can go forward to len(nums) - 1.

      Enum.reduce(0..odd_count_minus_k, 0, fn i, acc ->
        last_odd_in_window_idx = Enum.at(odd_indices, i + k - 1)
        first_odd_in_window_idx = Enum.at(odd_indices, i)

        # Calculate number of choices for the start position
        # The subarray must include first_odd_in_window_idx.
        # The element before first_odd_in_window_idx must NOT be included (it's an even or out of bounds)
        # Actually, the constraint is that the subarray contains exactly k odds.
        # So the subarray starts at some index s and ends at some index e.
        # It must include all odds from i to i+k-1.
        # It cannot include the odd at i-1 (if exists) or the odd at i+k (if exists).
        # So s can be anything from (prev_odd_idx + 1) to first_odd_in_window_idx.
        # e can be anything from last_odd_in_window_idx to (next_odd_idx - 1).

        prev_odd_idx = if i == 0 do
          -1
        else
          Enum.at(odd_indices, i - 1)
        end

        next_odd_idx = if i + k == odd_count do
          length(nums)
        else
          Enum.at(odd_indices, i + k)
        end

        # Number of start positions: first_odd_in_window_idx - prev_odd_idx
        # Number of end positions: next_odd_idx - 1 - last_odd_in_window_idx + 1 = next_odd_idx - last_odd_in_window_idx
        
        start_choices = first_odd_in_window_idx - prev_odd_idx
        end_choices = next_odd_idx - last_odd_in_window_idx

        acc + start_choices * end_choices
      end)
    end
  end

  defp get_odd_indices(nums) do
    nums
    |> Enum.with_index()
    |> Enum.filter(fn {num, _} -> rem(abs(num), 2) != 0 end)
    |> Enum.map(fn {_num, idx} -> idx end)
  end
end
