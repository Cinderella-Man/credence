---MODULE---
defmodule Solution do
  @doc """
  Returns the count of contiguous subarrays containing exactly k odd numbers.
  """
  @spec numberofsubarrays([integer], integer) :: non_neg_integer()
  def numberofsubarrays(nums, k) when is_integer(k) and k >= 0 do
    odd_indices = Enum.find_index(nums, fn x -> rem(abs(x), 2) != 0 end) |> fix_odd_indices(nums)
    
    count_subarrays_with_exactly_k(odds, k)
  end

  defp fix_odd_indices(nil, _) do
    []
  end

  defp fix_odd_indices(indices, nums) do
    # indices is already a list of indices where odd numbers occur
    indices
  end

  defp count_subarrays_with_exactly_k(odds, k) do
    if length(odds) < k do
      0
    else
      count_with_at_most_k(odds, k) - count_with_at_most_k(odds, k - 1)
    end
  end

  defp count_with_at_most_k(odds, k) do
    # Count subarrays with at most k odd numbers
    # This is equivalent to summing (even_segment_length + 1) for each group of odds separated by evens
    # But we need to account for the prefix and suffix evens
    
    # Let's think differently:
    # We have k odd numbers at indices: o0, o1, ..., o_{k-1} (0-indexed in the odds list)
    # For each window of k consecutive odds, the number of subarrays that contain exactly these k odds
    # and no others is:
    # (number of evens before o0) * (number of evens after o_{k-1})
    
    # But we need to consider all possible windows of k odds.
    # Actually, a simpler approach:
    # Let odds = [o0, o1, ..., o_{m-1}]
    # For each i from 0 to m-k, consider the window of k odds: o_i, ..., o_{i+k-1}
    # The number of subarrays containing exactly these k odds is:
    # (number of evens before o_i) * (number of evens after o_{i+k-1})
    
    # Number of evens before o_i:
    # If i == 0: evens before o_0 = o_0 (since o_0 is the index of the first odd)
    # Wait, the odds are indices in the original array.
    # So evens before o_0 = o_0 (indices 0 to o_0-1 are evens, count is o_0)
    # Evens between o_i and o_{i+1} = o_{i+1} - o_i - 1
    # Evens after o_{m-1} = length(nums) - o_{m-1} - 1
    
    # For a window of k odds starting at index i in the odds list (0-indexed):
    # o_i is the first odd in the window
    # o_{i+k-1} is the last odd in the window
    # Evens before o_i: 
    #   if i == 0: o_0
    #   else: o_i - o_{i-1} - 1  (but we need evens before o_i, which includes evens between o_{i-1} and o_i? No)
    # Actually, the subarray must start at or after the first even after o_{i-1} (if i>0) or at index 0 (if i==0)
    # And the subarray must end at or before the last even before o_{i+k} (if i+k-1 < m-1) or at the end of the array
    
    # Let me reconsider:
    # The subarray must contain exactly the k odds from o_i to o_{i+k-1}.
    # The subarray can start at any index from (start_bound) to o_i
    # where start_bound is:
    #   if i == 0: 0
    #   else: o_{i-1} + 1
    
    # The subarray can end at any index from o_{i+k-1} to (end_bound)
    # where end_bound is:
    #   if i+k-1 == m-1: length(nums) - 1
    #   else: o_{i+k} - 1
    
    # Number of choices for start: o_i - start_bound + 1 = o_i - (if i==0 then 0 else o_{i-1}+1) + 1
    # = o_i - o_{i-1} if i > 0, or o_i + 1 if i == 0
    
    # Number of choices for end: end_bound - o_{i+k-1} + 1
    # = (if i+k-1 == m-1 then length(nums)-1 else o_{i+k}-1) - o_{i+k-1} + 1
    
    # So for each window i from 0 to m-k:
    #   start_choices = if i == 0, do: o_i + 1, else: o_i - o_{i-1}
    #   end_choices = if i+k-1 == m-1, do: length(nums) - o_{i+k-1}, else: o_{i+k} - o_{i+k-1}
    #   count += start_choices * end_choices
    
    nums_len = length(nums)
    m = length(odds)
    if m < k do
      0
    else
      Enum.reduce(0..(m-k), fn i, acc ->
        start_choices = if i == 0 do
          hd(List.first([odds] ++ [])) + 1
        else
          Enum.at(odds, i) - Enum.at(odds, i-1)
        end
        
        last_odd_idx = Enum.at(odds, i + k - 1)
        
        end_choices = if i + k - 1 == m - 1 do
          nums_len - last_odd_idx
        else
          Enum.at(odds, i + k) - last_odd_idx
        end
        
        acc + start_choices * end_choices
      end)
    end
  end

  # Helper to get odd indices
  defp get_odd_indices(nums) do
    nums
    |> Enum.with_index()
    |> Enum.filter(fn {x, _} -> rem(abs(x), 2) != 0 end)
    |> Enum.map(fn {_, idx} -> idx end)
  end
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "empty list" do
    assert Solution.numberofsubarrays([], 0) == 0
    assert Solution.numberofsubarrays([], 1) == 0
  end

  test "no odd numbers" do
    assert Solution.numberofsubarrays([2, 4, 6], 1) == 0
  end

  test "multiple matches" do
    assert Solution.numberofsubarrays([1, 1, 2, 1, 1], 3) == 2
  end

  test "complex case" do
    assert Solution.numberofsubarrays([2, 2, 2, 1, 2, 2, 1, 2, 2, 2], 2) == 16
  end
end
