defmodule Solution do
  @doc """
  Returns the count of contiguous subarrays containing exactly k odd numbers.
  """
  @spec numberofsubarrays(list(integer), integer) :: non_neg_integer()
  def numberofsubarrays(nums, k) when k == 0 do
    # For k=0, we need subarrays with 0 odd numbers.
    # These are subarrays of contiguous even numbers.
    # We can find all maximal contiguous segments of even numbers,
    # and for each segment of length L, there are L*(L+1)/2 subarrays.
    even_segments = find_even_segments(nums)
    Enum.sum(even_segments, fn seg ->
      len = length(seg)
      div(len * (len + 1), 2)
    end)
  end

  def numberofsubarrays(nums, k) do
    odd_indices = Enum.reduce_while(nums, [], fn
      x, acc when rem(abs(x), 2) != 0 ->
        :cont
      x, acc when rem(abs(x), 2) == 0 ->
        :cont
    end)

    # Better approach: collect indices of odd numbers
    odd_indices =
      nums
      |> Enum.with_index()
      |> Enum.filter(fn {x, _} -> rem(abs(x), 2) != 0 end)
      |> Enum.map(fn {_x, idx} -> idx end)

    odd_count = length(odd_indices)

    if odd_count < k do
      0
    else
      # For each window of k odd numbers, calculate how many subarrays
      # can be formed that include exactly these k odd numbers.
      # The subarray must start after the previous odd number (or start of array)
      # and end before the next odd number (or end of array).
      
      odd_count_minus_k = odd_count - k
      
      Enum.reduce(0..odd_count_minus_k, 0, fn i, acc ->
        # Window of k odd numbers starts at odd_indices[i] and ends at odd_indices[i + k - 1]
        first_odd_idx = Enum.at(odd_indices, i)
        last_odd_idx = Enum.at(odd_indices, i + k - 1)
        
        # Previous odd number index (for determining start choices)
        prev_odd_idx = if i == 0 do
          -1
        else
          Enum.at(odd_indices, i - 1)
        end
        
        # Next odd number index (for determining end choices)
        next_odd_idx = if i + k == odd_count do
          length(nums)
        else
          Enum.at(odd_indices, i + k)
        end
        
        # Number of starting points: from prev_odd_idx + 1 to first_odd_idx
        start_choices = first_odd_idx - prev_odd_idx
        
        # Number of ending points: from last_odd_idx to next_odd_idx - 1
        end_choices = next_odd_idx - last_odd_idx
        
        acc + (start_choices * end_choices)
      end)
    end
  end

  defp find_even_segments(nums) do
    Enum.chunk_by(nums, &rem(abs(&1), 2) == 0)
    |> Enum.map(fn segment ->
      if Enum.all?(segment, &rem(abs(&1), 2) == 0) do
        segment
      else
        []
      end
    end)
  end
end

