  end

  test "example 2" do
    assert Solution.str_length_dict(["hello", "world"]) == %{"hello" => 5, "world" => 5}
  end

  test "example 3" do
    assert Solution.str_length_dict(["dog", "cat", "elephant"]) == %{"dog" => 3, "cat" => 3, "elephant" => 8}
  end
end
```

