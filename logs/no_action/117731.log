@moduledoc """
Solution for finding the minimum number of days to make m bouquets.
"""

defmodule Solution do
  @doc """
  Returns the minimum number of days needed to make exactly m bouquets,
  each containing k flowers from consecutive bloomed flowers.
  Returns -1 if it's impossible.
  """
  @spec min_days_bouquets([pos_integer()], pos_integer(), pos_integer()) :: non_neg_integer() | -1
  def min_days_bouquets(bloom_day, m, k) when is_list(bloom_day) and is_integer(m) and is_integer(k) do
    total_flowers_needed = m * k

    if length(bloom_day) < total_flowers_needed do
      -1
    else
      max_bloom = Enum.max(bloom_day)
      min_bloom = Enum.min(bloom_day)
      do_binary_search(bloom_day, m, k, min_bloom, max_bloom)
    end
  end

  defp do_binary_search(_bloom_day, _m, _k, low, high) when low > high do
    high
  end

  defp do_binary_search(bloom_day, m, k, low, high) do
    mid = floor((low + high) / 2)

    if can_make_bouquets?(bloom_day, m, k, mid) do
      if low == mid do
        low
      else
        do_binary_search(bloom_day, m, k, low, mid - 1)
      end
    else
      do_binary_search(bloom_day, m, k, mid + 1, high)
    end
  end

  defp can_make_bouquets?(bloom_day, m, k, day) do
    do_count_bouquets(bloom_day, m, k, day, 0, 0)
  end

  defp do_count_bouquets([], _m, _k, _day, bouquets_made, _consecutive) do
    bouquets_made >= _m
  end

  defp do_count_bouquets([bloom | rest], m, k, day, bouquets_made, consecutive) do
    if bloom <= day do
      new_consecutive = consecutive + 1
      if new_consecutive >= k do
        new_bouquets = bouquets_made + 1
        if new_bouquets >= m do
          true
        else
          do_count_bouquets(rest, m, k, day, new_bouquets, 0)
        end
      else
        do_count_bouquets(rest, m, k, day, bouquets_made, new_consecutive)
      end
    else
      do_count_bouquets(rest, m, k, day, bouquets_made, 0)
    end
  end
end[0m
