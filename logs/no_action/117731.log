---REFERENCE---
```elixir
defmodule Solution do
  def min_days_bouquets(bloom_day, m, k) do
    if m * k > length(bloom_day) do
      -1
    else
      low = Enum.min(bloom_day)
      high = Enum.max(bloom_day)
      binary_search(bloom_day, m, k, low, high)
    end
  end

  defp binary_search(_bloom_day, _m, _k, low, high) when low >= high, do: low

  defp binary_search(bloom_day, m, k, low, high) do
    mid = div(low + high, 2)

    if can_make(bloom_day, m, k, mid) do
      binary_search(bloom_day, m, k, low, mid)
    else
      binary_search(bloom_day, m, k, mid + 1, high)
    end
  end

  defp can_make(bloom_day, m, k, days) do
    {bouquets, _} =
      Enum.reduce(bloom_day, {0, 0}, fn day, {bouquets, flowers} ->
        if day > days do
          {bouquets, 0}
        else
          new_count = flowers + 1
          {bouquets + div(new_count, k), rem(new_count, k)}
        end
      end)

    bouquets >= m
  end
end
```

