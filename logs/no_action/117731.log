@moduledoc """
Solution for finding the minimum number of days to make m bouquets.
"""

defmodule Solution do
  @doc """
  Returns the minimum number of days needed to make exactly m bouquets,
  each containing k flowers from consecutive bloomed flowers.
  Returns -1 if it's impossible.
  """
  @spec min_days_bouquets([pos_integer()], pos_integer(), pos_integer()) :: non_neg_integer() | -1
  def min_days_bouquets(bloomDay, m, k) when is_list(bloomDay) and is_integer(m) and is_integer(k) do
    total_flowers_needed = m * k

    # If we don't have enough flowers total, it's impossible
    if length(bloomDay) < total_flowers_needed do
      -1
    else
      # Find the range of possible days
      max_bloom = Enum.max(bloomDay)
      min_bloom = Enum.min(bloomDay)

      # Binary search on the number of days
      do_binary_search(bloomDay, m, k, min_bloom, max_bloom)
    end
  end

  defp do_binary_search(_bloomDay, _m, _k, low, high) when low > high do
    high
  end

  defp do_binary_search(bloomDay, m, k, low, high) do
    mid = floor((low + high) / 2)

    if can_make_bouquets?(bloomDay, m, k, mid) do
      # Try a smaller number of days
      result = do_binary_search(bloomDay, m, k, low, mid - 1)
      # But we need the minimum, so if low was already valid, we should return low
      # Actually, let's rethink: if mid works, the answer is <= mid
      # We want the smallest day where it works.
      # Standard binary search for first true:
      if low == mid do
        low
      else
        result
      end
    else
      # mid doesn't work, need more days
      do_binary_search(bloomDay, m, k, mid + 1, high)
    end
  end

  defp can_make_bouquets?(bloomDay, m, k, day) do
    do_count_bouquets(bloomDay, m, k, day, 0, 0)
  end

  defp do_count_bouquets([], _m, _k, _day, bouquets_made, _consecutive), do: bouquets_made >= _m

  defp do_count_bouquets([blooms | rest], m, k, day, bouquets_made, consecutive) do
    if blooms <= day do
      new_consecutive = consecutive + 1
      if new_consecutive >= k do
        # We can form a bouquet
        new_bouquets = bouquets_made + 1
        if new_bouquets >= m do
          true
        else
          # Reset consecutive count
          do_count_bouquets(rest, m, k, day, new_bouquets, 0)
        end
      else
        do_count_bouquets(rest, m, k, day, bouquets_made, new_consecutive)
      end
    else
      # Flower hasn't bloomed, reset consecutive count
      do_count_bouquets(rest, m, k, day, bouquets_made, 0)
    end
  end

  defp do_count_bouquets([], _m, _k, _day, bouquets_made, _consecutive) do
    bouquets_made >= _m
  end
end
