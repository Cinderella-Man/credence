defmodule Solution do
  @doc """
  Computes the product of all integers from 1 to n.
  Returns 1 when n is 0.
  """
  def product_series(0), do: 1
  def product_series(n) when is_integer(n) and n > 0 do
    Enum.reduce(1..n, 1, &*/2)
  end
end

