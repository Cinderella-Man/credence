defmodule Solution do
  def reverse_odd_sublist(list_of_lists) do
    Enum.map(list_of_lists, fn sublist ->
      if rem(length(sublist), 2) != 0 do
        Enum.reverse(sublist)
      else
        sublist
      end
    end)
  end
end
