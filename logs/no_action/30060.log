    assert Solution.max_meetings([{1,2}, {2,3}, {3,4}, {4,5}]) == 4
  end

  test "max_meetings with non-ordered input" do
    assert Solution.max_meetings([{6,7}, {2,4}, {8,10}, {1,3}]) == 3
  end
end

