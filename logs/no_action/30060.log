defmodule Solution do
  def max_meetings([]), do: 0
  def max_meetings(meetings) do
    meetings = Enum.sort_by(meetings, fn {s, _} -> s end)
    {first, rest} = List.pop_at(meetings, 0)
    {_, first_end} = first
    tree = :gb_trees.insert({first_end, 0}, nil, :gb_trees.empty())
    do_max_meetings(rest, tree, 1, 1)
  end

  defp do_max_meetings([], _tree, _index, count), do: count
  defp do_max_meetings([{start_i, end_i} | tail], tree, index, count) do
    {min_end_tuple, _} = :gb_trees.smallest(tree)
    {min_end, _} = min_end_tuple
    if start_i >= min_end do
      tree = :gb_trees.delete(tree, min_end_tuple)
      tree = :gb_trees.insert({end_i, index}, nil, tree)
      do_max_meetings(tail, tree, index + 1, count + 1)
    else
      tree = :gb_trees.insert({end_i, index}, nil, tree)
      do_max_meetings(tail, tree, index + 1, count)
    end
  end
end
```

