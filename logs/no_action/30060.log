defmodule Solution do
  @doc """
  Returns the maximum number of meetings that can be accommodated in a single meeting room.
  """
  def max_meetings(meetings) do
    sorted = Enum.sort_by(meetings, &elem(&1, 0))
    {first, rest} = List.pop_at(sorted, 0)
    heap = [elem(first, 1)]
    count = 1
    Enum.reduce(rest, {heap, count}, fn {start_time, end_time}, {heap, acc} ->
      min_end = Enum.min(heap)
      if start_time >= min_end do
        new_heap = List.delete(heap, min_end) ++ [end_time]
        {new_heap, acc + 1}
      else
        {heap ++ [end_time], acc}
      end
    end) |> elem(1)
  end
end
```
