defmodule Solution do
  @doc """
  Returns the maximum number of overlapping meetings.

  Meetings that end at time T and start at time T are considered overlapping
  (i.e., the interval is inclusive on both ends).
  """
  @spec max_meetings(list({non_neg_integer(), non_neg_integer()})) :: non_neg_integer()
  def max_meetings(meetings) do
    events =
      Enum.flat_map(meetings, fn {start, end_time} ->
        [{:start, start}, {:end, end_time}]
      end)
      |> Enum.sort(fn
        {:start, start_time}, {:start, other_start} -> start_time <= other_start
        {:end, end_time}, {:end, other_end} -> end_time <= other_end
        {:start, _start_time}, {:end, _end_time} -> true
        {:end, _end_time}, {:start, _start_time} -> false
      end)

    {_current, max_concurrent} =
      Enum.reduce(events, {0, 0}, fn
        {:start, _}, {current, max_count} ->
          new_current = current + 1
          {new_current, max(max_count, new_current)}

        {:end, _}, {current, max_count} ->
          new_current = current - 1
          {new_current, max(max_count, new_current)}
      end)

    max_concurrent
  end
end
