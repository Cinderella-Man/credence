---MODULE---
defmodule Solution do
  @doc """
  Returns the maximum number of overlapping meetings.

  This is equivalent to finding the maximum number of concurrent intervals.

  ## Examples

      iex> Solution.max_meetings([{1,4}, {2,5}, {7,9}])
      2

      iex> Solution.max_meetings([{1,2}, {2,3}, {3,4}, {4,5}])
      3

      iex> Solution.max_meetings([{6,7}, {2,4}, {8,10}, {1,3}])
      3
  """
  @spec max_meetings(list({non_neg_integer(), non_neg_integer()})) :: non_neg_integer()
  def max_meetings(meetings) do
    events =
      Enum.flat_map(meetings, fn {start, end_time} ->
        [{:start, start}, {:end, end_time}]
      end)
      |> Enum.sort_by(fn {type, time} ->
        # Sort by time, then by type: ends before starts at the same time
        # This means if one meeting ends at 2 and another starts at 2,
        # the end event is processed first, so they don't count as overlapping.
        case compare_type(type) do
          :end -> -1
          :start -> 1
        end
        |> then(fn sign ->
          {time, sign}
        end)
      end)

    {max_concurrent, _} =
      Enum.reduce(events, {0, 0}, fn
        {:start, _}, {current, max} ->
          new_current = current + 1
          {new_current, max(max, new_current)}

        {:end, _}, {current, max} ->
          new_current = current - 1
          {new_current, max}
      end)

    max_concurrent
  end

  defp compare_type(:start), do: :start
  defp compare_type(:end), do: :end
end

---TEST---
