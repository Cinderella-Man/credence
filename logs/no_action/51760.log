---REFERENCE---
defmodule Solution do
  @spec ways_to_climb_stairs(integer) :: integer
  def ways_to_climb_stairs(n) when n < 0, do: 0
  def ways_to_climb_stairs(0), do: 1
  def ways_to_climb_stairs(1), do: 1
  def ways_to_climb_stairs(2), do: 2
  def ways_to_climb_stairs(n) do
    Enum.reduce(3..n, {1, 1, 2}, fn _step, {a, b, c} -> {b, c, a + b + c} end)
    |> elem(2)
  end
end
