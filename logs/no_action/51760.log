defmodule Solution do
  @doc """
  Returns the number of distinct ways to climb to the top of a staircase
  with `n` steps, taking 1, 2, or 3 steps at a time.
  """
  def ways_to_climb_stairs(0), do: 1
  def ways_to_climb_stairs(n) when n < 0, do: 0
  def ways_to_climb_stairs(n) when n == 1, do: 1
  def ways_to_climb_stairs(n) when n == 2, do: 2

  def ways_to_climb_stairs(n) do
    {a, b, c} = {1, 1, 2}
    ways_to_climb_stairs(n, a, b, c)
  end

  defp ways_to_climb_stairs(2, _a, b, c), do: b
  defp ways_to_climb_stairs(current, a, b, c) when current > 2 do
    next_c = a + b + c
    next_a = b
    next_b = c
    ways_to_climb_stairs(current + 1, next_a, next_b, next_c)
    next_c
  end

  # This approach is not iterative in the traditional sense, let's fix it.
  # We want O(1) space and O(n) time.
  # Let's rewrite with an accumulator loop.
  def ways_to_climb_stairs(n) do
    do_ways(n, 1, 1, 1)
  end

  defp do_ways(2, _a, b, _c), do: b
  defp do_ways(current, a, b, c) do
    next_val = a + b + c
    do_ways(current + 1, b, c, next_val)
  end
  # Wait, the above is tail recursive but not using the accumulator correctly to return.
  # Let's use a simple loop with a counter.

  def ways_to_climb_stairs(n) do
    {ways, _} = loop_ways(n, 0, 1, 1, 1)
    ways
  end

  defp loop_ways(current_n, acc, a, b, c) when current_n == 0 do
    {acc, acc}
  end

  defp loop_ways(current_n, acc, a, b, c) when current_n > 0 do
    # The pattern is:
    # ways(0) = 1
    # ways(1) = 1
    # ways(2) = 2
    # ways(3) = 4
    # ...
    # We need to calculate up to n.
    # Let's restart with a cleaner implementation.
    {_, _} = {0, 0}
    raise "Not implemented"
  end

  # Clean Implementation
  def ways_to_climb_stairs(n) when n < 0 do
    0
  end

  def ways_to_climb_stairs(n) when n == 0 do
    1
  end

  def ways_to_climb_stairs(n) when n == 1 do
    1
  end

  def ways_to_climb_stairs(n) when n == 2 do
    2
  end

  def ways_to_climb_stairs(n) do
    # iterative approach using tuple for a, b, c representing ways(n-2), ways(n-1), ways(n-3)
    # Wait, let's just use a standard loop.
    {ways, _} = compute_ways(n, 1, 1, 1, 2)
    ways
  end

  # This is getting messy. Let's write a simple loop.
  def ways_to_climb_stairs(n) do
    # Base cases
    cond
    n < 0 -> 0
    n == 0 -> 1
    n == 1 -> 1
    n == 2 -> 2
    true ->
      # Compute iteratively
      a = 1  # ways(0)
      b = 1  # ways(1)
      c = 2  # ways(2)
      ways_to_climb_stairs_iter(3, n, a, b, c)
  end

  defp ways_to_climb_stairs_iter(current, target, a, b, c) when current <= target do
    next_val = a + b + c
    if current == target do
      next_val
    else
      # Shift: new a = b, new b = c, new c = next_val
      ways_to_climb_stairs_iter(current + 1, target, b, c, next_val)
    end
  end
end

