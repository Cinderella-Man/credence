---MODULE---
defmodule Solution do
  @doc """
  Returns the number of distinct paths from the top-left cell to the
  bottom-right cell of a grid of the given `width` and `height`,
  moving only right or down.

  Both `width` and `height` must be positive integers (>= 1).

  The problem is equivalent to choosing how many steps to go right
  (`width - 1`) and how many to go down (`height - 1`), for a total of
  `(width - 1) + (height - 1)` steps.  The number of distinct paths is:

      C(width + height - 2, width - 1)
  """
  @spec grid_traversal(pos_integer(), pos_integer()) :: non_neg_integer()
  def grid_traversal(width, height) when is_integer(width) and width >= 1 and
                                        is_integer(height) and height >= 1 do
    rows = height - 1
    cols = width - 1
    total = rows + cols

    binomial(total, min(rows, cols))
  end

  @doc """
  Raises an error if `value` is not a positive integer.
  """
  @spec validate_positive(integer()) :: integer()
  defp validate_positive(value)
  defp validate_positive(v) when is_integer(v) and v >= 1, do: v
  defp validate_positive(_), do: raise ArgumentError, "both dimensions must be positive integers"

  @doc """
  Computes the binomial coefficient C(n, k) for non-negative integers.
  """
  @spec binomial(non_neg_integer(), non_neg_integer()) :: non_neg_integer()
  defp binomial(n, k) when k < 0 or k > n, do: 0

  defp binomial(_n, 0), do: 1
  defp binomial(n, k), do: binomial(n, k, 1)

  defp binomial(_remaining, 0, acc), do: acc

  defp binomial(remaining, k, acc) do
    next_acc = div(acc * remaining, k)
    binomial(remaining - 1, k - 1, next_acc)
  end

  defp min(a, b) when a <= b, do: a
  defp min(_a, b), do: b
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "grid_traversal 2 2" do
    assert Solution.grid_traversal(2, 2) == 2
  end

  test "grid_traversal 1 1" do
    assert Solution.grid_traversal(1, 1) == 1
  end

  test "grid_traversal 3 3" do
    assert Solution.grid_traversal(3, 3) == 6
  end
end
---END---[0m
