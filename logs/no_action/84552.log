defmodule Solution do
  def grid_traversal(width, height) when width < 1 or height < 1 do
    raise ArgumentError, "Grid dimensions must be positive integers."
  end

  def grid_traversal(width, height) do
    total = width + height - 2
    choices = width - 1
    div(factorial(total), factorial(choices) * factorial(total - choices))
  end

  defp factorial(0), do: 1
  defp factorial(n) when n > 0 do
    n * factorial(n - 1)
  end
end
