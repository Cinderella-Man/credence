---MODULE---
@doc """
Finds the index of a peak element in a list of numbers.

A peak element is strictly greater than its adjacent neighbors.
Boundary elements only need to be greater than their single neighbor.
Uses binary search for O(log n) time complexity.

## Examples

    iex> Solution.find_peak_element([1, 2, 1, 3, 5, 6, 4])
    5

    iex> Solution.find_peak_element([1, 3, 20, 4, 1, 0])
    2

    iex> Solution.find_peak_element([1, 2, 3, 1])
    2

    iex> Solution.find_peak_element([5])
    0

    iex> Solution.find_peak_element([])
    nil
"""
@spec find_peak_element(list(number())) :: non_neg_integer() | nil
def find_peak_element([]), do: nil

def find_peak_element([_]), do: 0

def find_peak_element([first, second | _rest]) when first > second, do: 0

def find_peak_element(list) do
  last_index = length(list) - 1
  last_element = List.last(list)
  prev_element = Enum.at(list, last_index - 1)

  if last_element > prev_element do
    last_index
  else
    find_peak_element_recursive(list, 0, last_index)
  end
end

defp find_peak_element_recursive(_list, left, right) when left >= right, do: left

defp find_peak_element_recursive(list, left, right) do
  mid = trunc((left + right) / 2)
  current = Enum.at(list, mid)
  next_elem = Enum.at(list, mid + 1)

  if current < next_elem do
    find_peak_element_recursive(list, mid + 1, right)
  else
    find_peak_element_recursive(list, left, mid)
  end
end
