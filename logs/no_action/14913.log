defmodule Solution do
  def find_peak_element([]), do: nil
  def find_peak_element([_]), do: 0

  def find_peak_element(nums) do
    tuple = List.to_tuple(nums)
    do_find_peak(tuple, 0, tuple_size(tuple) - 1)
  end

  defp do_find_peak(tuple, left, right) when left < right do
    mid = div(left + right, 2)
    if elem(tuple, mid) > elem(tuple, mid + 1) do
      do_find_peak(tuple, left, mid)
    else
      do_find_peak(tuple, mid + 1, right)
    end
  end

  defp do_find_peak(_tuple, left, _right), do: left
end
