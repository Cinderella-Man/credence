---MODULE---
defmodule Solution do
  @doc """
  Calculates the product of the elements on the main diagonal of a square matrix.

  The matrix is represented as a list of lists of numbers.
  The function runs in O(n) time where n is the dimension of the matrix.
  """
  @spec diagonal_product(list(list(number()))) :: number()
  def diagonal_product(matrix) do
    do_diagonal_product(matrix, 0, 1)
  end

  defp do_diagonal_product(_matrix, row, product) when row >= length(_matrix) do
    product
  end

  defp do_diagonal_product(matrix, row, product) do
    element = Enum.at(Enum.at(matrix, row), row)
    do_diagonal_product(matrix, row + 1, product * element)
  end
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "diagonal product of 2x2 matrix with zeros" do
    assert Solution.diagonal_product([[2, 0], [0, 2]]) == 4
  end

  test "diagonal product of 2x2 matrix" do
    assert Solution.diagonal_product([[1, 2], [3, 4]]) == 4
  end

  test "diagonal product of 3x3 matrix" do
    assert Solution.diagonal_product([[1, 2, 3], [4, 5, 6], [7, 8, 9]]) == 45
  end
end
