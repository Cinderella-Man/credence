defmodule Solution do
  @doc """
  Calculates the maximum profit achievable by buying and selling stock.
  You can make as many transactions as you like.
  """
  @spec max_profit([non_neg_integer()]) :: non_neg_integer()
  def max_profit([]), do: 0
  def max_profit([_]), do: 0

  def max_profit(prices) do
    Enum.zip(prices, tl(prices))
    |> Enum.reduce(0, fn {prev_price, curr_price}, acc ->
      if curr_price > prev_price,
        do: acc + (curr_price - prev_price),
        else: acc
     end)
  end
end
