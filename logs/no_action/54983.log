---INSTRUCTION---
Write a function that generates the first n numbers of the Fibonacci sequence. The function should accept a single integer argument n and return a list containing the first n Fibonacci numbers. The Fibonacci sequence starts with 0 and 1, and each subsequent number is the sum of the two preceding ones. For n = 0, return an empty list. For n = 1, return a list containing only 0. For n ≥ 2, the list begins with [0, 1] and continues with n-2 additional computed values. The function must handle n ≤ 0 as an edge case and return an empty list.

---TEST---
defmodule Test do
  use ExUnit.Case, async: false

  test "returns first 7 Fibonacci numbers" do
    assert Solution.fibo_sequence(7) == [0, 1, 1, 2, 3, 5, 8]
  end

  test "returns first 6 Fibonacci numbers" do
    assert Solution.fibo_sequence(6) == [0, 1, 1, 2, 3, 5]
  end

  test "returns first 5 Fibonacci numbers" do
    assert Solution.fibo_sequence(5) == [0, 1, 1, 2, 3]
  end

  test "returns empty list for n = 0" do
    assert Solution.fibo_sequence(0) == []
  end

  test "returns [0] for n = 1" do
    assert Solution.fibo_sequence(1) == [0]
  end

  test "returns empty list for negative n" do
    assert Solution.fibo_sequence(-5) == []
  end
end

---REFERENCE---
defmodule Solution do
  @spec fibo_sequence(integer()) :: [integer()]
  def fibo_sequence(n) when n <= 0, do: []
  def fibo_sequence(1), do: [0]
  def fibo_sequence(n) when n >= 2 do
    do_fibo(n - 2, [1, 0]) |> Enum.reverse()
  end

  defp do_fibo(0, acc), do: acc
  defp do_fibo(remaining, [b, a | _] = acc) do
    do_fibo(remaining - 1, [a + b | acc])
  end
end

