defmodule Solution do
  def special_number?(n) do
    n
    |> Integer.digits()
    |> has_repeated_digits?(MapSet.new())
  end

  defp has_repeated_digits?([], _seen), do: false
  defp has_repeated_digits?([digit | rest], seen) do
    if MapSet.member?(seen, digit) do
      true
    else
      has_repeated_digits?(rest, MapSet.put(seen, digit))
    end
  end
end
