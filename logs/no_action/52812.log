defmodule Solution do
  @doc """
  Decodes a Run-Length Encoded string.

  The encoded string consists of pairs of a count (positive integer)
  followed by a single character. Returns the uncompressed string.

  ## Examples

      iex> Solution.decode_rle("4a2b1c3d")
      "aaaabbcddd"

      iex> Solution.decode_rle("")
      ""

      iex> Solution.decode_rle("10a")
      "aaaaaaaaaa"
  """
  @spec decode_rle(String.t()) :: String.t()
  def decode_rle("") do
    ""
  end

  def decode_rle(encoded_string) do
    {count, rest} = parse_count(encoded_string)
    <<char::binary-size(1), remaining::binary>> = rest
    repeated = String.duplicate(char, count)
    repeated <> decode_rle(remaining)
  end

  defp parse_count(<<digit, rest::binary>>) when digit in ?0..?9 do
    {inner_count, inner_rest} = parse_count(rest)
    {inner_count * 10 + (digit - ?0), inner_rest}
  end

  defp parse_count(<<char, rest::binary>>) when char not in ?0..?9 do
    {0, <<char, rest::binary>>}
  end

  defp parse_count("") do
    {0, ""}
  end
end
