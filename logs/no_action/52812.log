defmodule Solution do
  @spec decode_rle(String.t()) :: String.t()
  def decode_rle(encoded_str) do
    do_decode(encoded_str, "")
  end

  defp do_decode("", acc), do: acc

  defp do_decode(<<>>, acc), do: acc

  defp do_decode(encoded, acc) do
