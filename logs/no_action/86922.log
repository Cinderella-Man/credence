defmodule Solution do
  @spec substring_counter(String.t(), String.t()) :: non_neg_integer()
  def substring_counter(string, substring) do
    if substring == "" do
      String.length(string) + 1
    else
      do_count(string, substring, 0, 0)
    end
  end

  defp do_count(string, substring, start, count) do
    remaining_length = String.length(string) - start
    substring_length = String.length(substring)

    if remaining_length < substring_length do
      count
    else
      current_slice = String.slice(string, start, substring_length)
      if current_slice == substring do
        do_count(string, substring, start + 1, count + 1)
      else
        do_count(string, substring, start + 1, count)
      end
    end
  end
end
