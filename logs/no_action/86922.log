@doc """
Counts how many times a substring appears in a string, including overlapping occurrences.

If the substring is empty, returns the length of the string plus one.
"""
@spec substring_counter(String.t(), String.t()) :: non_neg_integer()
def substring_counter(_string, "") do
  String.length(_string) + 1
end

def substring_counter(string, substring) do
  if substring == "" do
    String.length(string) + 1
  else
    count_substrings(string, substring, 0)
  end
end

defp count_substrings(string, substring, count) do
  case String.split(string, substring, global: false) do
    [^string | _rest] ->
      # No match found
      count

    [_first | rest] ->
      # At least one match found
      new_count = count + 1
      # Recurse on the remainder after the first occurrence
      # We need to check if there are more occurrences in the rest
      # But wait: String.split removes the delimiter. We need to account for overlapping.
      # Actually, let's use a different approach for overlapping counts.
      
      # Let's restart with a simpler sliding window approach
      count_overlapping(String.slice(string, 0..-1), substring, 0)
  end
end

defp count_overlapping(string, substring, count) when is_nil(substring) or substring == "" do
  count
end

defp count_overlapping(string, substring, count) do
  case String.starts_with?(string, substring) do
    true ->
      new_count = count + 1
      # Move forward by 1 character to allow overlapping matches
      count_overlapping(
        case string do
          <<_char::binary-size(1), rest::binary>> -> rest
          _ -> ""
        end,
        substring,
        new_count
      )

    false ->
      case string do
        <<_char::binary-size(1), rest::binary>> ->
          count_overlapping(rest, substring, count)

        _ ->
          count
      end
  end
end

