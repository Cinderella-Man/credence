---REFERENCE---
defmodule Solution do
  def case_shifter(input_string) do
    input_string
    |> String.graphemes()
    |> Enum.map(fn grapheme ->
      if String.match?(grapheme, ~r/^[a-zA-Z]$/) do
        if String.downcase(grapheme) == grapheme do
          String.upcase(grapheme)
        else
          String.downcase(grapheme)
        end
      else
        grapheme
      end
    end)
    |> Enum.join()
  end
end
