defmodule Solution do
  def cantor_sequence(n) do
    {num, den} = cantor_iter(n - 1, {1, 1}, :right)
    "#{num}/#{den}"
  end

  defp cantor_iter(0, pos, _dir), do: pos

  defp cantor_iter(remaining, {num, den}, :right) do
    if num == 1 do
      cantor_iter(remaining - 1, {num, den + 1}, :left)
    else
      cantor_iter(remaining - 1, {num - 1, den + 1}, :right)
    end
  end

  defp cantor_iter(remaining, {num, den}, :left) do
    if den == 1 do
      cantor_iter(remaining - 1, {num + 1, den}, :right)
    else
      cantor_iter(remaining - 1, {num + 1, den - 1}, :left)
    end
  end
end
