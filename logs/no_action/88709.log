assert cantor_sequence(3) == '2/1'
assert cantor_sequence(4) == '3/1'
assert cantor_sequence(2) == '1/2'
assert cantor_sequence(8) == '2/3'
assert cantor_sequence(9) == '3/2'
assert cantor_sequence(6) == '1/3'
assert cantor_sequence(7) == '1/4'
assert cantor_sequence(10) == '4/1'

