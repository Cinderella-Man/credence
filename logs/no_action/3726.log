---MODULE---
defmodule Solution do
  @doc """
  Computes the maximum number of characters from `s` that can be "matched"
  using the letters available across all the dictionary words.

  Each word in the list can appear multiple times, but we treat the union
  of all characters in all words as a pool of available characters.
  For each unique character in `s`, we take the minimum of:
    - how many times it appears in `s`
    - how many times it appears in total across all words
  The result is the sum of these minimums over all characters in `s`.
  """
  @spec max_formed(String.t(), [String.t()]) :: non_neg_integer()
  def max_formed(s, words) do
    # Count character frequencies in the target string
    s_freq = count_chars(s)

    # Count total character frequencies across all words
    words_freq = count_chars_in_words(words)

    # For each unique character in s, take min of its count in s and in words
    s_freq
    |> Map.keys()
    |> Enum.sum_reduce(0, fn char, acc ->
      s_count = Map.get(s_freq, char, 0)
      w_count = Map.get(words_freq, char, 0)
      minimum = min(s_count, w_count)
      {char, acc + minimum}
    end)
    |> elem(1)
  end

  @spec count_chars(String.t()) :: %{required(String.Chars.t()) => non_neg_integer()}
  defp count_chars(""), do: %{}

  defp count_chars(string) do
    string
    |> String.graphemes()
    |> Enum.reduce(%{}, fn char, acc ->
      Map.update(acc, char, 1, &(&1 + 1))
    end)
  end

  @spec count_chars_in_words([String.t()]) :: %{required(String.Chars.t()) => non_neg_integer()}
  defp count_chars_in_words([]), do: %{}

  defp count_chars_in_words(words) do
    words
    |> Enum.map(fn word -> count_chars(word) end)
    |> Enum.reduce(%{}, fn word_freq, acc ->
      Enum.reduce(word_freq, acc, fn {char, count}, inner_acc ->
        Map.update(inner_acc, char, count, &(&1 + count))
      end)
    end)
  end
end
