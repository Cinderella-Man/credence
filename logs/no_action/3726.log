```elixir
defmodule Solution do
  def max_formed(s, words) do
    s_freq = frequency(s)

    words_freq =
      Enum.reduce(words, %{}, fn word, acc ->
        word
        |> String.graphemes()
        |> Enum.reduce(acc, fn char, inner ->
          Map.update(inner, char, 1, &(&1 + 1))
        end)
      end)

    Enum.reduce(s_freq, 0, fn {char, count}, acc ->
      acc + min(count, Map.get(words_freq, char, 0))
    end)
  end

  defp frequency(str) do
    str
    |> String.graphemes()
    |> Enum.reduce(%{}, fn char, acc ->
      Map.update(acc, char, 1, &(&1 + 1))
    end)
  end
end
```
