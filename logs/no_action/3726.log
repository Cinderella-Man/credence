    |> Map.keys()
    |> Enum.reduce(0, fn char, acc ->
      s_count = Map.get(s_freq, char, 0)
      w_count = Map.get(words_freq, char, 0)
      acc + min(s_count, w_count)
    end)
  end

  @spec count_chars(String.t()) :: %{required(String.Chars.t()) => non_neg_integer()}
  defp count_chars(""), do: %{}

  defp count_chars(string) do
    Enum.frequencies(
      string
      |> String.graphemes()
    )
  end

  @spec count_chars_in_words([String.t()]) :: %{required(String.Chars.t()) => non_neg_integer()}
  defp count_chars_in_words([]), do: %{}

  defp count_chars_in_words(words) do
    words
    |> Enum.map(fn word -> count_chars(word) end)
    |> Enum.reduce(%{}, fn word_freq, acc ->
      Enum.reduce(word_freq, acc, fn {char, count}, inner_acc ->
        Map.update(inner_acc, char, count, &(&1 + count))
      end)
    end)
  end
end
