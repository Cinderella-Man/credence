---INSTRUCTION---
Write a function `reduction_operations/1` that takes a list of integers and returns the minimum number of reduction operations needed to sort the list in non-decreasing order. In one reduction operation, you can select any two elements from the list; if one of them is smaller than the other, you can increment the smaller element by 1. The function should return the total number of such operations required.

For example, given the list [1,1,2,2,3], the function should return 4.

Edge cases: an empty list should return 0, and a single-element list should also return 0.

Note: The input list may contain duplicate values.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "all equal" do
    assert Solution.reduction_operations([1,1,1]) == 0
  end

  test "reverse sorted" do
    assert Solution.reduction_operations([5,4,3,2,1]) == 10
  end

  test "mixed" do
    assert Solution.reduction_operations([1,1,2,2,3]) == 4
  end

  test "empty list" do
    assert Solution.reduction_operations([]) == 0
  end

  test "single element" do
    assert Solution.reduction_operations([42]) == 0
  end
end
---REFERENCE---
defmodule Solution do
  @spec reduction_operations([integer]) :: non_neg_integer
  def reduction_operations([]), do: 0
  def reduction_operations([_]), do: 0
  def reduction_operations(nums) do
    [first | rest] = Enum.sort(nums)
    {total, _count, _prev} =
      Enum.reduce(rest, {0, 0, first}, fn current, {total, count, prev} ->
        new_count = if current > prev, do: count + 1, else: count
        new_total = total + new_count
        {new_total, new_count, current}
      end)
    total
  end
end
---END---[0m
