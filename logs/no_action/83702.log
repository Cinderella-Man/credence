defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "all equal" do
    assert Solution.reduction_operations([1,1,1]) == 0
  end

  test "reverse sorted" do
    assert Solution.reduction_operations([5,4,3,2,1]) == 10
  end

  test "mixed" do
    assert Solution.reduction_operations([1,1,2,2,3]) == 4
  end

  test "empty list" do
    assert Solution.reduction_operations([]) == 0
  end

  test "single element" do
    assert Solution.reduction_operations([42]) == 0
  end
end
