---MODULE---
defmodule Solution do
  @doc """
  Calculates the minimum number of reduction operations to sort a list.
  """
  @spec reduction_operations(non_neg_integer()) :: non_neg_integer()
  def reduction_operations(list) when is_list(list) do
    if list == [] do
      0
    else
      sorted_list = Enum.sort(list)
      _calculate_operations(sorted_list, 0, 0)
    end
  end

  defp _calculate_operations([], _, acc), do: acc

  defp _calculate_operations([val], _, acc) do
    # No more elements, return the accumulated operations
    acc
  end

  defp _calculate_operations([first, second | tail], _, acc) do
    diff = second - first
    # If diff > 0, we need 'diff' operations to bring 'first' up to 'second'
    new_acc = if diff > 0, do: acc + diff, else: acc
    _calculate_operations([second | tail], second, new_acc)
  end
end
