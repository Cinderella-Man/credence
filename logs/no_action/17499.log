---MODULE---
defmodule Solution do
  @doc """
  Finds the first integer that appears more than once in a list.
  
  The "first duplicate" is defined as the element whose second occurrence
  appears earliest when traversing the list from left to right.
  
  ## Examples
      
      iex> Solution.findduplicate([1, 3, 4, 2, 2])
      2
      
      iex> Solution.findduplicate([3, 1, 3, 4, 2])
      3
      
      iex> Solution.findduplicate([1, 2, 3])
      nil
  """
  @spec findduplicate([integer()]) :: integer() | nil
  def findduplicate(list) do
    case do_find_duplicate(list, MapSet.new()) do
      {:found, duplicate} -> duplicate
      :not_found -> nil
    end
  end

  defp do_find_duplicate([], _seen), do: :not_found

  defp do_find_duplicate([head | tail], seen) do
    if MapSet.member?(seen, head) do
      {:found, head}
    else
      do_find_duplicate(tail, MapSet.put(seen, head))
    end
  end
end
---TEST---
