  test "find duplicate in [3,1,3,4,2]" do
    assert Solution.findduplicate([3, 1, 3, 4, 2]) == 3
  end

  test "find duplicate in [1,1]" do
    assert Solution.findduplicate([1, 1]) == 1
  end
end
