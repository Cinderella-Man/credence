assert table_to_dict(['name age gender', 'John 25 M', 'Jane 30 F', 'Jack 35 M']) == [{'name': 'John', 'age': '25', 'gender': 'M'}, {'name': 'Jane', 'age': '30', 'gender': 'F'}, {'name': 'Jack', 'age': '35', 'gender': 'M'}]
