Returns a list of maps with column names as keys and data as values.
"""
@spec table_to_dict([String.t()]) :: [map()]
def table_to_dict([]), do: []

def table_to_dict([header | rows]) do
  keys = String.split(header)

  Enum.map(rows, fn row ->
