defmodule Solution do
  def table_to_dict(table) do
    [headers_row | data_rows] = table
    headers = String.split(headers_row)

    Enum.map(data_rows, fn row ->
      values = String.split(row)
      Enum.zip(headers, values) |> Map.new()
    end)
  end
end
```

