Given a list of non-negative integers and a non-negative integer limit, find the maximum count of elements that can be selected from the list such that their sum does not exceed the limit. Elements may be chosen in any order, but the goal is to maximize the count. If the list is empty, return 0.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "returns 2 for [2,2,2,2,2,2] with limit 5" do
    assert Solution.max_elements_within_limit([2, 2, 2, 2, 2, 2], 5) == 2
  end

  test "returns 5 for [1,2,3,4,5,6,7] with limit 15" do
    assert Solution.max_elements_within_limit([1, 2, 3, 4, 5, 6, 7], 15) == 5
  end

  test "returns 3 for [1,3,5,8,9,2] with limit 10" do
    assert Solution.max_elements_within_limit([1, 3, 5, 8, 9, 2], 10) == 3
  end

  test "returns 0 for empty list" do
    assert Solution.max_elements_within_limit([], 100) == 0
  end

  test "returns 0 when limit is 0" do
    assert Solution.max_elements_within_limit([1, 2, 3], 0) == 0
  end

  test "handles case where all elements can be taken" do
    assert Solution.max_elements_within_limit([1, 1, 1], 10) == 3
  end
end

---REFERENCE---
defmodule Solution do
  @spec max_elements_within_limit(list(non_neg_integer()), non_neg_integer()) :: non_neg_integer()
  def max_elements_within_limit(list, limit) do
    list
    |> Enum.sort()
    |> Enum.reduce_while({0, 0}, fn x, {current_sum, count} ->
      if current_sum + x <= limit do
        {:cont, {current_sum + x, count + 1}}
      else
        {:halt, {current_sum, count}}
      end
    end)
    |> elem(1)
  end
end

