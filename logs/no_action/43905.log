---MODULE---
@doc """
Multiplies elements at even indices in a list by 2.

Elements at odd indices remain unchanged.
Empty lists are returned as-is.
"""
@spec even_index_doubler([integer()]) :: [integer()]
def even_index_doubler(list) do
  list
  |> Enum.with_index()
  |> Enum.map(fn
     {value, index} when rem(index, 2) == 0 -> value * 2
     {value, _index} -> value
   end)
end

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "multiplies elements at even indices by 2" do
    assert Solution.even_index_doubler([1, 2, 3, 4, 5]) == [2, 2, 6, 4, 10]
  end

  test "works with multiples of 10" do
    assert Solution.even_index_doubler([10, 20, 30, 40, 50]) == [20, 20, 60, 40, 100]
  end

  test "works with zero at an even index" do
    assert Solution.even_index_doubler([0, 1, 2, 3, 4, 5]) == [0, 1, 4, 3, 8, 5]
  end
end

