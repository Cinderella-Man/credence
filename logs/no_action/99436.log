  defp fix_list(tuple, i, n) do
    val = elem(tuple, i)

    if val >= 1 and val <= n and elem(tuple, val - 1) != val do
      other_val = elem(tuple, val - 1)
      new_tuple =
        tuple
        |> put_elem(val - 1, val)
        |> put_elem(i, other_val)
      fix_list(new_tuple, i, n)
    else
      fix_list(tuple, i + 1, n)
    end
  end

  defp check_missing(tuple, i, n) when i >= n, do: n + 1

  defp check_missing(tuple, i, n) do
    if elem(tuple, i) != i + 1, do: i + 1, else: check_missing(tuple, i + 1, n)
  end
