---MODULE---
defmodule Solution do
  @doc """
  Finds the smallest missing positive integer in a list of integers.
  """
  @spec find_firstmissingpositive(list(integer())) :: pos_integer()
  def find_firstmissingpositive([]), do: 1

  def find_firstmissingpositive(list) do
    # To achieve O(n) time complexity, we can use a set for O(1) lookups.
    # The problem asks for the smallest missing positive integer.
    # Let n be the length of the list. The answer is at most n + 1.
    # So we only need to check numbers from 1 to n + 1.

    n = length(list)
    set = MapSet.new(list)

    # We check 1, 2, ..., n+1 to find the first one not in the set.
    # Since we want the smallest, we can iterate from 1 upwards.
    # However, iterating from 1 to n+1 is O(n), and checking set membership is O(1).
    # Total time is O(n).

    1..(n + 1)
    |> Enum.find(1, fn i ->
      not MapSet.member?(set, i)
    end)
  end
end
