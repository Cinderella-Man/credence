defmodule Solution do
  @doc """
  Given a target sum `target` and a list of integers `nums`, returns the length of
  the smallest contiguous subarray whose sum is at least `target`. If no such
  subarray exists, returns 0.
  """
  @spec minsubarraysum(non_neg_integer(), [integer()]) :: non_neg_integer()
  def minsubarraysum(target, nums) when is_integer(target) and is_list(nums) do
    min_len = min_length_sliding_window(target, nums, 0, 0, 0, length(nums) + 1)
    if min_len > length(nums), do: 0, else: min_len
  end

  # Base case: right pointer has gone past the end of the list
  defp min_length_sliding_window(_target, nums, _left, right, _current_sum, min_len)
       when right >= length(nums) do
    min_len
  end

  # Expand the window by including nums[right], then shrink from left while valid
  defp min_length_sliding_window(target, nums, left, right, current_sum, min_len) do
    new_sum = current_sum + Enum.at(nums, right)

    # Shrink the window from the left while the sum is >= target
    {new_left, new_min} = shrink_until_invalid(target, nums, left, right, new_sum, min_len)

    min_length_sliding_window(target, nums, new_left, right + 1, new_sum, new_min)
  end

  # When sum is less than target or left > right, we can't shrink further
  defp shrink_until_invalid(target, _nums, left, right, current_sum, min_len)
       when current_sum < target or left > right do
    {left, min_len}
  end

  # Shrink from the left: update min_len, remove nums[left], and recurse
  defp shrink_until_invalid(target, nums, left, right, current_sum, min_len) do
    new_min = min(min_len, right - left + 1)
    new_sum = current_sum - Enum.at(nums, left)
    shrink_until_invalid(target, nums, left + 1, right, new_sum, new_min)
  end
end
