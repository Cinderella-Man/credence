@doc """
Given a target sum `target` and a list of integers `nums`, returns the length of
the smallest contiguous subarray whose sum is at least `target`. If no such
subarray exists, returns 0.
"""
@spec minsubarraysum(integer(), [integer()]) :: non_neg_integer()
def minsubarraysum(target, nums) when is_integer(target) and is_list(nums) do
  do_sliding_window(target, nums, 0, 0, 0, length(nums) + 1)
end

defp do_sliding_window(_target, _nums, _left, right, _current_sum, min_len)
     when right >= length(_nums) do
  min_len
end

defp do_sliding_window(target, nums, left, right, current_sum, min_len) do
  # We need to handle the case where the window is valid (sum >= target)
  # before adding the next element. But the standard sliding window approach
  # is: expand right, then shrink left while valid.
  # Let's restructure: add nums[right] to sum, then shrink.
  
  new_sum = current_sum + Enum.at(nums, right)
  
  # Now try to shrink from the left
  {new_left, new_min} = shrink_window(target, nums, left, right, new_sum, min_len)
  
  do_sliding_window(target, nums, new_left, right + 1, new_sum, new_min)
end

defp shrink_window(_target, _nums, left, right, current_sum, min_len)
     when current_sum < _target or left > right do
  {left, min_len}
end

defp shrink_window(target, nums, left, right, current_sum, min_len) do
  new_min = min(min_len, right - left + 1)
  new_sum = current_sum - Enum.at(nums, left)
  shrink_window(target, nums, left + 1, right, new_sum, new_min)
end[0m
