      current_sum = current_sum + Enum.at(nums, right)
      {left, current_sum, min_len} = shrink_window(s, nums, left, current_sum, right, min_len)
      do_min_subarray(s, nums, left, current_sum, right + 1, min_len)
    else
      # Finished iterating through the list.
      if min_len > length(nums) do
        0
      else
        min_len
      end
    end
  end

  defp shrink_window(s, nums, left, current_sum, right, min_len) do
    if current_sum >= s and left <= right do
      current_length = right - left + 1
      min_len = min(min_len, current_length)
      current_sum = current_sum - Enum.at(nums, left)
      shrink_window(s, nums, left + 1, current_sum, right, min_len)
    else
      {left, current_sum, min_len}
    end
  end
