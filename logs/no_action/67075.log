defmodule Solution do
  @spec minsubarraysum(integer(), [integer()]) :: non_neg_integer()
  def minsubarraysum(s, nums) do
    do_min_subarray(s, nums, 0, 0, 0, length(nums) + 1)
  end

  defp do_min_subarray(s, [], _left, current_sum, _right, min_len) do
    if current_sum >= s do
      # Edge case: empty list but sum already >= s? Not possible since list is empty.
      min_len
    else
      if min_len == 0 do
        # This condition can't be reached because min_len is initialized to length+1.
        # But we handle the case when no subarray found.
        0
      else
        if min_len == 0 do
