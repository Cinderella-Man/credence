"""
@spec minsubarraysum(integer(), [integer()]) :: non_neg_integer()
def minsubarraysum(target, nums) when is_integer(target) and is_list(nums) do
  do_sliding_window(target, nums, 0, 0, 0, length(nums) + 1)
end

