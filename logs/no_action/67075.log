  min_len
end

defp do_sliding_window(target, nums, left, right, current_sum, min_len) do
  # We need to handle the case where the window is valid (sum >= target)
  # before adding the next element. But the standard sliding window approach
  # is: expand right, then shrink left while valid.
  # Let's restructure: add nums[right] to sum, then shrink.
  
  new_sum = current_sum + Enum.at(nums, right)
  
  # Now try to shrink from the left
  {new_left, new_min} = shrink_window(target, nums, left, right, new_sum, min_len)
  
  do_sliding_window(target, nums, new_left, right + 1, new_sum, new_min)
end

defp shrink_window(_target, _nums, left, right, current_sum, min_len)
     when current_sum < _target or left > right do
  {left, min_len}
end

