defmodule Solution do
  @spec minsubarraysum(number, [number]) :: non_neg_integer
  def minsubarraysum(s, nums) do
    tuple = List.to_tuple(nums)
    size = tuple_size(tuple)
    case size do
      0 -> 0
      _ ->
        {_left, _sum, ans} =
          Enum.reduce(0..(size - 1), {0, 0, size + 1}, fn right, {left, sum, ans} ->
            sum = sum + elem(tuple, right)
            {left, sum, ans} = shrink(left, sum, ans, right, tuple, s)
            {left, sum, ans}
          end)
        if ans == size + 1, do: 0, else: ans
    end
  end

  defp shrink(left, sum, ans, right, tuple, s) do
    if sum >= s do
      ans = min(ans, right - left + 1)
      sum = sum - elem(tuple, left)
      left = left + 1
      shrink(left, sum, ans, right, tuple, s)
    else
      {left, sum, ans}
    end
  end
end
