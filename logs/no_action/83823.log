---MODULE---
@doc """
Rotates a 2D array clockwise by 90 degrees, n times.
"""
@spec rotate_2d_array(list(list(any())), non_neg_integer()) :: list(list(any()))
def rotate_2d_array(array, n) when is_list(array) and is_integer(n) and n >= 0 do
  # Normalize n to be within [0, 3] since rotating 4 times is the same as 0
  normalized_n = rem(n, 4)
  
  if normalized_n == 0 do
    array
  else
    do_rotate(array, normalized_n)
  end
end

defp do_rotate(array, 1) do
  # Rotate once clockwise:
  # Step 1: Transpose the matrix
  # Step 2: Reverse each row
  transpose = array |> Enum.map(&Enum.unzip/1) |> Enum.map(fn {a, b} -> [a, b] end)
  # Actually, let's do it properly for any size
  
  # Transpose: rows become columns
  # For a 3x3 matrix: [[1,2,3],[4,5,6],[7,8,9]]
  # Transpose: [[1,4,7],[2,5,8],[3,6,9]]
  # Then reverse each row to get clockwise rotation:
  # [[7,4,1],[8,5,2],[9,6,3]]
  
  transpose_matrix = transpose_matrix(array)
  transpose_matrix |> Enum.map(&Enum.reverse/1)
end

defp do_rotate(array, n) when n > 1 do
  # Rotate once, then rotate the result n-1 times
  once_rotated = rotate_2d_array(array, 1)
  rotate_2d_array(once_rotated, n - 1)
end

# Helper function to transpose a 2D list
defp transpose_matrix(matrix) do
  # Handle empty matrix or matrix with empty rows
  if Enum.empty?(matrix) or Enum.empty?(hd(matrix)) do
    []
  else
    # Get the first column of each row, then recursively transpose the rest
    # Using Enum.map with index might not work directly, so use Enum.with_index
    # Actually, a simpler approach: transpose by mapping over columns
    
    # Find number of columns
    num_cols = length(hd(matrix))
    
    # For each column index, extract all elements in that column
    0..(num_cols - 1)
    |> Enum.map(fn col_idx ->
      Enum.map(matrix, &Enum.at(&1, col_idx))
    end)
    |> Enum.to_list()
  end
end

