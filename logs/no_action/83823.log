defmodule Solution do
  def rotate_2d_array(matrix, n) do
    n
    |> rem(4)
    |> then(fn times -> Enum.reduce(1..times, matrix, fn _, acc -> rotate_once(acc) end) end)
  end

  defp rotate_once(matrix) do
    matrix
    |> Enum.reverse()
    |> Enum.zip()
    |> Enum.map(fn tuple -> Tuple.to_list(tuple) end)
  end
end

