---INSTRUCTION---
Write a function to find the most frequent character in a string. If there are multiple characters with the same maximum frequency, return all of them in a list.

- **Function name**: `frequent_chars`
- **Module name**: `Solution`
- **Input**: A string (may be empty).
- **Output**: A list of single-character strings (graphemes) with the highest frequency. If multiple characters share the same maximum frequency, return all of them in the order of their first appearance in the input string. If the input is empty, return an empty list.
- **Complexity**: Linear time relative to the length of the input string.
- **Edge cases**: Empty string returns an empty list. Spaces and punctuation are treated as characters and should be counted if they occur.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "single most frequent character" do
    assert Solution.frequent_chars("hello") == ["l"]
  end

  test "multiple most frequent characters" do
    result = Solution.frequent_chars("google")
    assert Enum.sort(result) == Enum.sort(["g", "o"])
    # Check that both characters appear exactly once in the result
    assert length(result) == 2
  end

  test "single character with multiple occurrences" do
    assert Solution.frequent_chars("apple") == ["p"]
  end

  test "empty string" do
    assert Solution.frequent_chars("") == []
  end

  test "all characters same frequency" do
    assert Solution.frequent_chars("aabbcc") |> Enum.sort() == ["a", "b", "c"] |> Enum.sort()
  end

  test "includes spaces and punctuation" do
    assert Solution.frequent_chars("!!") == ["!"]
  end

  test "order of first appearance preserved" do
    assert Solution.frequent_chars("banana") == ["a"]
  end
end

---REFERENCE---
defmodule Solution do
  def frequent_chars(s) do
    if s == "" do
      []
    else
      graphemes = String.graphemes(s)
      frequencies = Enum.frequencies(graphemes)
      max_freq = frequencies |> Map.values() |> Enum.max()

      Enum.uniq(graphemes)
      |> Enum.filter(fn char -> Map.get(frequencies, char) == max_freq end)
    end
  end
end
