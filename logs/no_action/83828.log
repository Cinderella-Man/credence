defmodule Solution do
  @doc """
  Searches for a target value in a 2D matrix that is sorted row-wise and column-wise.
  """
  @spec searchmatrix(list(list(integer())), integer()) :: boolean()
  def searchmatrix([], _target) do
    false
  end

  def searchmatrix(matrix, _target) when length(matrix) == 0 do
    false
  end

  def searchmatrix(matrix, target) do
    # Check if any row is empty
    if Enum.any?(matrix, &(&1 == [])) do
      false
    else
      num_rows = length(matrix)
    num_cols = length(hd(matrix))

    # Start from the top-right corner
    row = 0
    col = num_cols - 1

    search_row_col(matrix, row, col, target, num_rows, num_cols)
  end

  defp search_row_col(_matrix, row, col, _target, num_rows, _num_cols)
      when row >= num_rows or col < 0 do
    false
  end

  defp search_row_col(matrix, row, col, target, num_rows, _num_cols) do
    value = elem(matrix, row) |> elem(col)
    # Accessing matrix as a list of lists, so we need to use Enum.at or pattern matching
    # Since we are using list of lists, let's use Enum.at
    value = Enum.at(matrix, row) |> Enum.at(col)

    if value == target do
      true
    end
  end

  defp search_row_col(matrix, row, col, target, num_rows, num_cols) do
    value = Enum.at(matrix, row) |> Enum.at(col)

    if value > target do
      # Move left
      search_row_col(matrix, row, col - 1, target, num_rows, num_cols)
    else
      # Move down
      search_row_col(matrix, row + 1, col, target, num_rows, num_cols)
    end
  end
end[0m
