defmodule Solution do
  def searchmatrix(matrix, target) do
    case matrix do
      [] -> false
      [head | _] when head == [] -> false
      _ ->
        m = length(matrix)
        n = length(hd(matrix))
        do_search(matrix, target, 0, n - 1, m, n)
    end
  end

  defp do_search(_, _, i, j, m, _) when i >= m or j < 0, do: false
  defp do_search(matrix, target, i, j, m, n) do
    row = Enum.at(matrix, i)
    value = Enum.at(row, j)
    cond do
      value == target -> true
      value > target -> do_search(matrix, target, i, j - 1, m, n)
      value < target -> do_search(matrix, target, i + 1, j, m, n)
    end
  end
end
