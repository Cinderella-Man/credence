defmodule Solution do
  def maximum_subarray_sum([]), do: 0
  def maximum_subarray_sum([head | tail]) do
    Enum.reduce(tail, {head, head}, fn x, {current, max_sum} ->
      new_current = max(x, current + x)
      new_max = max(max_sum, new_current)
      {new_current, new_max}
    end)
    |> elem(1)
  end
end

