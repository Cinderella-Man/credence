---INSTRUCTION---
Write an Elixir function that finds the most frequent element in a list. If multiple elements share the same highest frequency, return the one that appears first in the original list.

Function name: `frequent_element`
Input: a list (may contain any comparable terms)
Output: the most frequent element (first occurrence in case of a tie)

The list is guaranteed to be non-empty. Assume the elements are comparable for use as map keys.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "most frequent is unique" do
    assert Solution.frequent_element([1, 2, 3, 4, 4, 5, 5, 5, 6, 6, 6, 6]) == 6
  end

  test "most frequent with tie, returns first occurrence" do
    assert Solution.frequent_element([1, 1, 2, 2, 3, 3, 3]) == 3
  end

  test "large numbers" do
    assert Solution.frequent_element([10, 10, 20, 30, 30, 30, 40, 40, 40, 40]) == 40
  end

  test "single element" do
    assert Solution.frequent_element([5]) == 5
  end

  test "all same" do
    assert Solution.frequent_element([7, 7, 7, 7]) == 7
  end
end

---REFERENCE---
defmodule Solution do
  def frequent_element(list) do
    {result, _count} =
      Enum.reduce(list, {%{}, nil}, fn x, {freq_map, max_info} ->
        count = Map.get(freq_map, x, 0) + 1
        updated_map = Map.put(freq_map, x, count)
        max_info = update_max(max_info, x, count, list)
        {updated_map, max_info}
      end)
      |> elem(1)
    result
  end

  defp update_max(nil, element, count, _list), do: {element, count}

  defp update_max({current_best, current_count} = max_info, element, count, list) do
    cond do
      count > current_count ->
        {element, count}

      count == current_count ->
        # Element with higher frequency or first occurrence wins
        # Since counts are equal, choose the one that appears first in the list
        best_index = Enum.find_index(list, &(&1 == current_best))
        element_index = Enum.find_index(list, &(&1 == element))

        if element_index < best_index do
          {element, count}
        else
          max_info
        end

      true ->
        max_info
    end
  end
end

