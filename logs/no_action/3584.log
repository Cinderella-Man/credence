---MODULE---
@moduledoc """
Finds the most frequent element in a list.

If multiple elements share the same highest frequency, returns the one that
appears first in the original list.
"""
defmodule Solution do
  @doc """
  Returns the most frequent element in the given list.

  In case of a tie (multiple elements with the same highest frequency),
  returns the element that appeared first in the original list.

  ## Examples

      iex> Solution.frequent_element([1, 2, 2, 3, 3])
      2

      iex> Solution.frequent_element([1, 1, 2, 2, 3])
      3
  """
  @spec frequent_element(list(any())) :: any()
  def frequent_element(list) when is_list(list) and length(list) > 0 do
    frequency = Enum.reduce(list, %{}, fn item, counts ->
      Map.update(counts, item, 1, &(&1 + 1))
    end)

    max_count = Enum.max(Map.values(frequency))

    list
    |> Enum.uniq()
    |> Enum.find(fn item ->
      frequency[item] == max_count
    end)
  end
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "most frequent is unique" do
    assert Solution.frequent_element([1, 2, 3, 4, 4, 5, 5, 5, 6, 6, 6, 6]) == 6
  end

  test "most frequent with tie, returns first occurrence" do
    assert Solution.frequent_element([1, 1, 2, 2, 3, 3, 3]) == 3
  end

  test "large numbers" do
    assert Solution.frequent_element([10, 10, 20, 30, 30, 30, 40, 40, 40, 40]) == 40
  end

  test "single element" do
    assert Solution.frequent_element([5]) == 5
  end

  test "all same" do
    assert Solution.frequent_element([7, 7, 7, 7]) == 7
  end
end
