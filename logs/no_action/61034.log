---MODULE---
defmodule Solution do
  @doc """
  Converts a time given in 24-hour format to a time in 12-hour format along with AM/PM.
  """
  @spec time_conversion(String.t()) :: String.t()
  def time_conversion(time_string) do
    # Split the input string by ":"
    [hour_str, minute_str] = String.split(time_string, ":")

    # Convert hour to integer
    hour_int = String.to_integer(hour_str)
    # Keep minute as string for formatting
    minute = minute_str

    # Determine if it's AM or PM and adjust hour
    {converted_hour, am_pm} =
      if hour_int == 0 do
        # Midnight
        {12, "AM"}
      else
        if hour_int < 12 do
          {hour_int, "AM"}
        else
          # Afternoon or evening
          {hour_int - 12, "PM"}
        end
      end

    # Format the output string
    # The hour should not have a leading zero unless it is 12 (but our converted_hour
    # is 12 for midnight and noon, and we want "12" not "12" with no leading zero issue).
    # Actually, the requirement is: "The hour in the output does not have a leading zero (except when it is 12)."
    # Since our converted_hour is an integer, inspect will format it without leading zeros.
    # For 12, inspect(12) is "12". For 7, inspect(7) is "7".
    # The minutes are always two digits, which minute_str already is if input is valid.
    # However, to be safe, we can format the minutes with leading zero if needed.
    # The input minutes are two digits, so they are fine.

    "#{inspect(converted_hour)}:#{minute} #{am_pm}"
  end
end

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "converts morning time" do
    assert Solution.time_conversion("07:15") == "7:15 AM"
  end

  test "converts evening time" do
    assert Solution.time_conversion("20:45") == "8:45 PM"
  end

  test "converts noon time" do
    assert Solution.time_conversion("13:00") == "1:00 PM"
  end

  test "converts midnight" do
    assert Solution.time_conversion("00:00") == "12:00 AM"
  end
end

