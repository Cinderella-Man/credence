---INSTRUCTION---
Write a function to convert a time given in 24-hour format to a time in 12-hour format along with AM/PM.

The function takes a string representing time in the format "HH:MM" (e.g., "07:15", "20:45") and returns a string in the format "h:MM AM" or "h:MM PM". The hour in the output does not have a leading zero (except when it is 12). The minutes are always two digits. For midnight (00:00), output "12:00 AM". For noon (12:00), output "12:00 PM".
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "converts morning time" do
    assert Solution.time_conversion("07:15") == "7:15 AM"
  end

  test "converts evening time" do
    assert Solution.time_conversion("20:45") == "8:45 PM"
  end

  test "converts noon time" do
    assert Solution.time_conversion("13:00") == "1:00 PM"
  end

  test "converts midnight" do
    assert Solution.time_conversion("00:00") == "12:00 AM"
  end
end
---REFERENCE---
defmodule Solution do
  @spec time_conversion(String.t()) :: String.t()
  def time_conversion(time) do
    [hours_str, minutes_str] = String.split(time, ":")
    hours = String.to_integer(hours_str)
    minutes = String.to_integer(minutes_str)

    {new_hours, suffix} = cond do
      hours == 0 -> {12, "AM"}
      hours < 12 -> {hours, "AM"}
      hours == 12 -> {12, "PM"}
      hours > 12 -> {hours - 12, "PM"}
    end

    minutes_formatted = String.pad_leading(Integer.to_string(minutes), 2, "0")
    "#{new_hours}:#{minutes_formatted} #{suffix}"
  end
end
---END---[0m
