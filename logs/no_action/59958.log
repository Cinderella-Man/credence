defmodule Solution do
  @doc """
  Separates a string into tokens of letters, integers, and floats.

  Letters are returned as strings.
  Digits-only sequences are returned as integers.
  Sequences with a decimal point are returned as floats.
  """
  @spec separate_string_number(String.t()) :: list(String.t() | integer() | float())
  def separate_string_number(""), do: []

  def separate_string_number(input) when is_binary(input) do
    tokens = do_tokenize(input, "", :letter, [])
    Enum.reverse(tokens)
  end

  # Base case: empty input, no accumulator
  defp do_tokenize(<<>>, "", _, tokens), do: tokens

  # Base case: empty input, has accumulator
  defp do_tokenize(<<>>, char_acc, :letter, tokens) when char_acc != "" do
    [char_acc | tokens]
  end

  defp do_tokenize(<<>>, char_acc, :integer, tokens) when char_acc != "" do
    [String.to_integer(char_acc) | tokens]
  end

  defp do_tokenize(<<>>, char_acc, :decimal, tokens) when char_acc != "" do
    [String.to_float(char_acc) | tokens]
  end

  # Main recursive step
  defp do_tokenize(<<char, rest::binary>>, char_acc, state, tokens) do
    case char do
      ?a..?z -> handle_letter(char, char_acc, state, rest, tokens)
      ?A..?Z -> handle_letter(char, char_acc, state, rest, tokens)
      ?0..?9 -> handle_digit(char, char_acc, state, rest, tokens)
      ?. -> handle_dot(char, char_acc, state, rest, tokens)
      _ -> handle_letter(char, char_acc, state, rest, tokens)
    end
  end

  # Handle letter character
  defp handle_letter(_char, "", _state, rest, tokens) do
    # Start a new letter token
    do_tokenize(rest, <<_char>>, :letter, tokens)
  end

  defp handle_letter(new_char, char_acc, :letter, rest, tokens) do
    # Extend current letter token
    do_tokenize(rest, char_acc <> <<new_char>>, :letter, tokens)
  end

  defp handle_letter(new_char, char_acc, :integer, rest, tokens) do
    # Finalize integer, start new letter token
    do_tokenize(rest, <<new_char>>, :letter, [String.to_integer(char_acc) | tokens])
  end

  defp handle_letter(new_char, char_acc, :decimal, rest, tokens) do
    # Finalize float, start new letter token
    do_tokenize(rest, <<new_char>>, :letter, [String.to_float(char_acc) | tokens])
  end

  # Handle digit character
  defp handle_digit(_char, "", _state, rest, tokens) do
    # Start a new integer token
    do_tokenize(rest, <<_char>>, :integer, tokens)
  end

  defp handle_digit(new_char, char_acc, :integer, rest, tokens) do
    # Extend current integer token
    do_tokenize(rest, char_acc <> <<new_char>>, :integer, tokens)
  end

  defp handle_digit(new_char, char_acc, :letter, rest, tokens) do
    # Finalize letter, start new integer token
    do_tokenize(rest, <<new_char>>, :integer, [char_acc | tokens])
  end

  defp handle_digit(new_char, char_acc, :decimal, rest, tokens) do
    # Extend decimal token
    do_tokenize(rest, char_acc <> <<new_char>>, :decimal, tokens)
  end

  # Handle dot character
  defp handle_dot(_char, "", _state, rest, tokens) do
    # Dot at start or after whitespace/empty. Start decimal.
    do_tokenize(rest, ".", :decimal, tokens)
  end

  defp handle_dot(_char, char_acc, :integer, rest, tokens) do
    # Integer followed by dot -> become decimal
    do_tokenize(rest, char_acc <> ".", :decimal, tokens)
  end

  defp handle_dot(_char, char_acc, :decimal, rest, tokens) do
    # Already decimal, another dot. Treat as end of number or error? 
