  @spec separate_string_number(String.t()) :: list(String.t() | integer() | float())
  def separate_string_number(""), do: []

  def separate_string_number(input) when is_binary(input) do
    tokens = do_tokenize(input, "", :letter, [])
    Enum.reverse(tokens)
