@doc """
Separates a string into tokens of letters, integers, and floats.

Letters are returned as strings.
Digits-only sequences are returned as integers.
Sequences with a decimal point are returned as floats.
"""
@spec separate_string_number(String.t()) :: list(String.t() | integer() | float())
def separate_string_number(<<>>) do
  []
end

def separate_string_number(input) do
  do_tokenize(input, "", :letter, [])
  |> Enum.reverse()
end

# Internal state machine for tokenization
# States: :letter, :integer, :decimal
# We accumulate characters and convert to proper types when the token ends

defp do_tokenize(<<>>, <<>>, _, tokens), do: tokens

defp do_tokenize(<<>>, char_acc, :letter, tokens) when byte_size(char_acc) > 0 do
  [char_acc | tokens]
end

defp do_tokenize(<<>>, char_acc, :integer, tokens) when byte_size(char_acc) > 0 do
  [String.to_integer(char_acc) | tokens]
end

defp do_tokenize(<<>>, char_acc, :decimal, tokens) when byte_size(char_acc) > 0 do
  [String.to_float(char_acc) | tokens]
end

defp do_tokenize(<<char, rest::binary>>, char_acc, state, tokens) do
  case char do
    ?a..?z -> process_char(char, char_acc, state, rest, tokens)
    ?A..?Z -> process_char(char, char_acc, state, rest, tokens)
    ?0..?9 -> process_digit(char, char_acc, state, rest, tokens)
    ?. -> process_decimal_point(char, char_acc, state, rest, tokens)
    _ -> process_char(char, char_acc, state, rest, tokens)
  end
end

# When we encounter a new character that doesn't match the current state,
# we finalize the previous token and start a new one

defp process_char(_char, <<>>, _state, rest, tokens) do
  # No accumulated char, just start accumulating
  do_tokenize(rest, <<_char>>, :letter, tokens)
end

defp process_char(new_char, char_acc, :letter, rest, tokens) do
  # Current state is letter, new char is also letter -> extend current token
  do_tokenize(rest, char_acc <> <<new_char>>, :letter, tokens)
end

defp process_char(new_char, char_acc, :integer, rest, tokens) do
  # Current state is integer, new char is letter -> finalize integer, start letter
  do_tokenize(rest, <<new_char>>, :letter, [String.to_integer(char_acc) | tokens])
end

defp process_char(new_char, char_acc, :decimal, rest, tokens) do
  # Current state is decimal, new char is letter -> finalize float, start letter
  do_tokenize(rest, <<new_char>>, :letter, [String.to_float(char_acc) | tokens])
end

defp process_digit(_char, <<>>, _state, rest, tokens) do
  # No accumulated char, just start accumulating
  do_tokenize(rest, <<_char>>, :integer, tokens)
end

defp process_digit(new_char, char_acc, :integer, rest, tokens) do
  # Current state is integer, new char is digit -> extend current token
  do_tokenize(rest, char_acc <> <<new_char>>, :integer, tokens)
end

defp process_digit(new_char, char_acc, :letter, rest, tokens) do
  # Current state is letter, new char is digit -> finalize letter, start integer
  do_tokenize(rest, <<new_char>>, :integer, [char_acc | tokens])
end

defp process_digit(new_char, char_acc, :decimal, rest, tokens) do
  # Current state is decimal, new char is digit -> extend decimal token
  do_tokenize(rest, char_acc <> <<new_char>>, :decimal, tokens)
end

defp process_decimal_point(_char, <<>>, :letter, rest, tokens) do
  # Letter state, but we have a dot. This shouldn't happen based on problem statement
  # but handle it by treating the dot as part of a number starting after the letter
  # Actually, per spec, dots only appear within numeric tokens, so a letter before a dot
  # means the letter token ends and a number starts. But the dot itself isn't a valid start.
  # We'll treat this as: finalize letter, and the dot will be handled next.
  # Since the next call will have the dot, let's just finalize the letter and process the dot.
  do_tokenize(rest, "", :letter, [char_acc | tokens])
end

defp process_decimal_point(_char, char_acc, :integer, rest, tokens) do
  # Integer state, see a dot -> start decimal
  do_tokenize(rest, char_acc <> ".", :decimal, tokens)
end

defp process_decimal_point(_char, char_acc, :decimal, rest, tokens) do
  # Decimal state, another dot -> extend decimal (though this shouldn't happen per spec)
  do_tokenize(rest, char_acc <> ".", :decimal, tokens)
end

defp process_decimal_point(new_char, char_acc, :letter, rest, tokens) do
  # Letter state, see a dot -> this means the letter token ends.
  # The dot starts a decimal/number sequence.
  # We need to start accumulating the number. The dot is the start.
  do_tokenize(rest, ".", :decimal, [char_acc | tokens])
end

defp process_char(_char, <<>>, _state, rest, tokens) do
  # Fallback: no char acc, new char is a letter-like char
  do_tokenize(rest, <<_char>>, :letter, tokens)
end[0m
