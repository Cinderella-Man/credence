```elixir
defmodule Solution do
  def separate_string_number(s) do
    Regex.scan(~r/[a-zA-Z]+|\d+\.?\d*|\.?\d+/, s)
    |> List.flatten()
    |> Enum.map(fn token ->
      cond do
        Regex.match?(~r/^[a-zA-Z]+$/, token) ->
          token

        String.contains?(token, ".") ->
          {float, _} = Float.parse(token)
          float

        true ->
          {int, _} = Integer.parse(token)
          int
      end
    end)
  end
end
