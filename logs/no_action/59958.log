  use ExUnit.Case, async: false

  test "separates string with integer and float" do
    assert Solution.separate_string_number("a1b2.3c") == ["a", 1, "b", 2.3, "c"]
  end

  test "starts with number then letters then float" do
    assert Solution.separate_string_number("45abc67.8") == [45, "abc", 67.8]
  end

  test "letters then float then letters" do
    assert Solution.separate_string_number("hello123.4world") == ["hello", 123.4, "world"]
  end

  test "empty string" do
    assert Solution.separate_string_number("") == []
  end

  test "only letters" do
    assert Solution.separate_string_number("abc") == ["abc"]
  end

  test "only integer" do
    assert Solution.separate_string_number("123") == [123]
  end

  test "only float" do
    assert Solution.separate_string_number("123.456") == [123.456]
  end

  test "multiple consecutive integers" do
    assert Solution.separate_string_number("1a2b3") == [1, "a", 2, "b", 3]
  end

  test "integer with trailing dot" do
    assert Solution.separate_string_number("123.") == [123.0]
  end

  test "float with leading dot" do
    assert Solution.separate_string_number(".456") == [0.456]
  end

  test "mixed case letters" do
    assert Solution.separate_string_number("AbCd1eF2.3G") == ["AbCd", 1, "eF", 2.3, "G"]
  end
end
