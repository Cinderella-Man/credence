  test "example 1" do
    assert Solution.separate_string_number("a1b2.3c") == ["a", 1, "b", 2.3, "c"]
  end

  test "example 2" do
    assert Solution.separate_string_number("45abc67.8") == [45, "abc", 67.8]
  end

  test "example 3" do
    assert Solution.separate_string_number("hello123.4world") == ["hello", 123.4, "world"]
  end
end
