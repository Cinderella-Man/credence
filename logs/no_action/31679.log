---REFERENCE---
defmodule Solution do
  def num_squares(0), do: 0

  def num_squares(n) when n > 0 do
    visited = MapSet.new()
    queue = :queue.new()
    queue = :queue.in({n, 0}, queue)
    do_bfs(queue, visited)
  end

  defp do_bfs(queue, visited) do
    case :queue.out(queue) do
      {{:value, {number, step}}, rest_queue} ->
        targets = 
          for i <- 1..trunc(:math.sqrt(number)) do
            number - i * i
          end
        
        Enum.reduce_while(targets, {rest_queue, visited}, fn target, {q, v} ->
          cond do
            target == 0 ->
              {:halt, step + 1}
            MapSet.member?(v, target) ->
              {:cont, {q, v}}
            true ->
              new_queue = :queue.in({target, step + 1}, q)
              new_visited = MapSet.put(v, target)
              {:cont, {new_queue, new_visited}}
          end
        end)
        |> case do
             result when is_integer(result) -> result
             {updated_queue, updated_visited} -> do_bfs(updated_queue, updated_visited)
           end

      {:empty, _} ->
        0
    end
  end
end
