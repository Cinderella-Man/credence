@doc """
Calculates the product of all unique elements in a list of integers.

If the list is empty, returns 1.
Duplicates are ignored; each distinct integer is multiplied only once.
"""
@spec product_unique_elements(list(integer())) :: integer()
def product_unique_elements(numbers) do
  unique_elements = Enum.uniq(numbers)

  Enum.reduce(unique_elements, 1, fn element, acc ->
    acc * element
  end)
end
