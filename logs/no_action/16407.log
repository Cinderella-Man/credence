defmodule Solution do
  @doc """
  Converts a camelCase string to snake_case.

  ## Examples
      iex> Solution.camel_to_snake("CamelCase")
      "camel_case"

      iex> Solution.camel_to_snake("camelCaseTest")
      "camel_case_test"

      iex> Solution.camel_to_snake("ThisIsATestString")
      "this_is_a_test_string"
  """
  @spec camel_to_snake(String.t()) :: String.t()
  def camel_to_snake(""), do: ""

  def camel_to_snake(str) when is_binary(str) do
    str
    |> String.graphemes()
    |> Enum.reduce("", fn
      char, acc when char in ?A..?Z -> acc <> "_" <> String.downcase(char)
      char, acc -> acc <> String.downcase(char)
    end)
  end
end
