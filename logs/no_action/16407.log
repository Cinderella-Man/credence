defmodule Solution do
  @doc """
  Converts a camelCase string to snake_case.

  ## Examples
      iex> Solution.camel_to_snake("CamelCase")
      "camel_case"

      iex> Solution.camel_to_snake("camelCaseTest")
      "camel_case_test"

