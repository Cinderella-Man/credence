      "this_is_a_test_string"
  """
  @spec camel_to_snake(String.t()) :: String.t()
  def camel_to_snake(""), do: ""

  def camel_to_snake(str) when is_binary(str) do
    str
    |> String.graphemes()
    |> Enum.reduce("", &convert_char/2)
  end

  defp convert_char(char, acc) do
    case char do
      char when char in ?A..?Z ->
        acc <> "_" <> String.downcase(char)

      char ->
        acc <> String.downcase(char)
    end
  end
end
