  end
end
---REFERENCE---
defmodule Solution do
  def camel_to_snake(str) do
    str
    |> String.graphemes()
    |> Enum.flat_map(fn
      <<c>> when c >= ?A and c <= ?Z -> ["_", <<c + 32>>]
      other -> [other]
    end)
    |> Enum.join()
    |> remove_leading_underscore()
  end

  defp remove_leading_underscore("_" <> rest), do: rest
  defp remove_leading_underscore(str), do: str
end
