---REFERENCE---
```elixir
defmodule Solution do
  def find_longest_nondecreasing_subsequence([]), do: 0

  def find_longest_nondecreasing_subsequence(nums) do
    n = length(nums)
    nums_tuple = List.to_tuple(nums)

    dp =
      Enum.reduce(1..(n - 1), List.to_tuple(List.duplicate(1, n)), fn i, dp ->
        Enum.reduce(0..(i - 1), dp, fn j, dp ->
          if elem(nums_tuple, i) >= elem(nums_tuple, j) do
            put_elem(dp, i, max(elem(dp, i), elem(dp, j) + 1))
          else
            dp
          end
        end)
      end)

    dp |> Tuple.to_list() |> Enum.max()
  end
end
```
