defmodule Solution do
  @doc """
  Returns the length of the longest non-decreasing subsequence.
  Uses O(n²) dynamic programming approach.
  """
  def find_longest_nondecreasing_subsequence(nums) when is_list(nums) do
    case nums do
      [] -> 0
      _ -> find_longest_nondecreasing_subsequence_dp(nums)
    end
  end

  defp find_longest_nondecreasing_subsequence_dp(nums) do
    n = length(nums)
    # Initialize dp array with 1s
    dp = List.duplicate(1, n)

    # Convert list to a tuple for efficient indexing
    tuple_nums = List.to_tuple(nums)

    # Compute DP using recursion instead of nested loops with side effects
    dp_result = compute_dp(tuple_nums, dp, 0, n - 1)

    # Find the maximum value in the dp array
    Enum.max(dp_result)
  end

  defp compute_dp(_tuple_nums, dp, current_i, max_i) when current_i > max_i do
    dp
  end

  defp compute_dp(tuple_nums, dp, current_i, max_i) do
    # Inner loop: j from 0 to current_i - 1
    dp_after_inner = inner_loop(tuple_nums, dp, current_i, current_i - 1)

    # Recurse to next i
    compute_dp(tuple_nums, dp_after_inner, current_i + 1, max_i)
  end

  defp inner_loop(_tuple_nums, _dp, _i, j) when j < 0 do
    # No more j to process for this i
    :ok
  end

  defp inner_loop(tuple_nums, dp, i, j) do
    elem_j = elem(tuple_nums, j)
    elem_i = elem(tuple_nums, i)

    # We need to check if dp[i] should be updated.
    # The dp array is being updated in place in the original logic, but in Elixir
    # we must pass the updated dp along the recursion.
    # However, the inner loop updates dp[i] based on dp[j] + 1.
    # This is tricky because dp[i] depends on the current dp[i] and dp[j].
    # Let's rewrite the inner loop to accumulate the new dp[i].

    new_dp_i = elem(dp, i)

    if elem_i >= elem_j do
