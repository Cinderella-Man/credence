defmodule Solution do
  @doc """
  Returns the length of the longest non-decreasing subsequence.
  Uses O(n²) dynamic programming approach.
  """
  @spec find_longest_nondecreasing_subsequence(list(non_neg_integer)) :: non_neg_integer
  def find_longest_nondecreasing_subsequence(nums) when is_list(nums) do
    case nums do
      [] -> 0
      _ ->
        n = length(nums)
        # Initialize dp array with 1s. dp[i] = length of longest non-decreasing subseq ending at index i.
        dp = List.duplicate(1, n)

        # Convert list to a tuple for efficient indexing
        nums_tuple = List.to_tuple(nums)

        # Iterate through each element starting from index 1
        compute_dp(nums_tuple, dp, 0, n - 1)
    end
  end

  # Base case for recursion: when current index exceeds max index, return dp array
  defp compute_dp(_nums_tuple, dp, current_i, max_i) when current_i > max_i do
    # Find the maximum value in the dp array
    Enum.max(dp)
  end

  # Recursive step: process current index i
  defp compute_dp(nums_tuple, dp, current_i, max_i) do
    # Inner loop: j from 0 to current_i - 1
    dp_result = inner_loop(nums_tuple, dp, current_i, current_i - 1)

    # Recurse to next i
    compute_dp(nums_tuple, dp_result, current_i + 1, max_i)
  end

  # Base case for inner loop: when j < 0, no more j to process
  defp inner_loop(_nums_tuple, dp, _i, _j) when j < 0 do
    dp
  end

  # Recursive step: process inner loop index j
  defp inner_loop(nums_tuple, dp, i, j) do
    elem_j = elem(nums_tuple, j)
    elem_i = elem(nums_tuple, i)

    new_dp_i = elem(dp, i)
    dp_j = elem(dp, j)

    # If nums[i] >= nums[j], we can extend the subsequence ending at j to i
    # dp[i] = max(dp[i], dp[j] + 1)
    new_val = max(new_dp_i, dp_j + 1)
    if elem_i >= elem_j do
      inner_loop(nums_tuple, put_elem(dp, i, new_val), i, j - 1)
    else
      inner_loop(nums_tuple, dp, i, j - 1)
    end
  end
end[0m
