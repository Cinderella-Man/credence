---MODULE---
@doc """
Finds the length of the longest non-decreasing subsequence in a list of numbers.
"""
defmodule Solution do
  @doc """
  Returns the length of the longest non-decreasing subsequence.
  Uses O(n²) dynamic programming approach.
  """
  def find_longest_nondecreasing_subsequence(nums) when is_list(nums) do
    case nums do
      [] -> 0
      _ -> find_longest_nondecreasing_subsequence_dp(nums)
    end
  end

  defp find_longest_nondecreasing_subsequence_dp(nums) do
    n = length(nums)
    # Initialize dp array with 1s
    dp = List.duplicate(1, n)

    # Convert list to a tuple for efficient indexing
    tuple_nums = List.to_tuple(nums)

    # Compute DP
    Enum.each(0..(n - 1) do |i|
      Enum.each(0..(i - 1) do |j|
        elem_j = elem(tuple_nums, j)
        elem_i = elem(tuple_nums, i)
        if elem_i >= elem_j do
          new_val = max(elem(dp, i), elem(dp, j) + 1)
          put_elem(dp, i, new_val)
        end
        {:ok, {dp, i, j}}
      end)
    end)

    # Find the maximum value in the dp array
    Enum.max(dp)
  end
end

