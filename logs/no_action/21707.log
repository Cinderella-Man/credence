defmodule Solution do
  @spec max_sum_subarray_of_size_k(list(integer()), integer()) :: integer()
  def max_sum_subarray_of_size_k(list, k) when k <= 0 or list == [], do: 0

  def max_sum_subarray_of_size_k(list, k) do
    if length(list) < k do
      0
    else
      list
      |> Enum.chunk_every(k, 1, :discard)
      |> Enum.map(&Enum.sum/1)
      |> Enum.max()
    end
  end
end
