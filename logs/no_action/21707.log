defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "example 1" do
    assert Solution.max_sum_subarray_of_size_k([2, 1, 5, 1, 3, 2], 3) == 9
  end

  test "example 2" do
    assert Solution.max_sum_subarray_of_size_k([1, 2, 3, 4, 5], 1) == 5
  end

  test "example 3" do
    assert Solution.max_sum_subarray_of_size_k([2, 3, 4, 1, 5], 2) == 7
  end

  test "empty list" do
    assert Solution.max_sum_subarray_of_size_k([], 3) == 0
  end

  test "k larger than list" do
    assert Solution.max_sum_subarray_of_size_k([1, 2], 3) == 0
  end

  test "k equals length of list" do
    assert Solution.max_sum_subarray_of_size_k([1, 2, 3], 3) == 6
  end

  test "k is zero" do
    assert Solution.max_sum_subarray_of_size_k([1, 2, 3], 0) == 0
  end

  test "negative numbers" do
    assert Solution.max_sum_subarray_of_size_k([-1, -2, -3, -4, -5], 2) == -3
  end
