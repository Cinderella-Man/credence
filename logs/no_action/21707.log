defmodule Solution do
  @moduledoc """
  Provides functionality to find the maximum sum of a contiguous subarray of exactly k elements.
  """

  @doc """
  Returns the maximum sum of any contiguous subarray of exactly `k` elements in `numbers`.
  Returns 0 if no such subarray exists (e.g., list is empty, k is 0, or k is greater than the list length).
  """
  @spec max_sum_subarray_of_size_k(list(integer()), integer()) :: integer()
  def max_sum_subarray_of_size_k(_numbers, k) when k <= 0, do: 0
  def max_sum_subarray_of_size_k(numbers, k) when length(numbers) < k, do: 0

  def max_sum_subarray_of_size_k(numbers, k) do
    # Get the first window
    first_window = Enum.take(numbers, k)
    current_sum = Enum.sum(first_window)
    max_sum = current_sum

    # Slide the window: start from index 1 up to (length - k)
    # The window starting at index i includes numbers[i] ... numbers[i+k-1]
    # We've already computed window starting at 0.
    # Next window starts at 1: remove numbers[0], add numbers[k]
    # Last window starts at length(numbers) - k: remove numbers[length-k-1], add numbers[end]
    
    last_start_index = length(numbers) - k
    
    new_sum = Enum.reduce(1..last_start_index, current_sum, fn window_start, running_sum ->
      outgoing_index = window_start - 1
      incoming_index = window_start + k - 1
      outgoing = Enum.at(numbers, outgoing_index)
      incoming = Enum.at(numbers, incoming_index)
      running_sum - outgoing + incoming
    end)

    # We need to track the max across all windows.
    # The approach above only returns the sum of the last window.
    # Let's use a proper reduce with an accumulator for {current_sum, max_sum}
    do_max_sum(numbers, k, current_sum, current_sum)
  end

  defp do_max_sum(_numbers, _k, current_sum, max_sum) when current_sum == max_sum and _k == length(_numbers) do
    max_sum
  end

  defp do_max_sum(numbers, k, current_sum, max_sum) do
    last_start_index = length(numbers) - k
    
    if last_start_index < 1 do
      max_sum
    else
      {new_last_sum, final_max_sum} = Enum.reduce(1..last_start_index, {current_sum, max_sum}, fn window_start, {running_sum, current_max} ->
        outgoing_index = window_start - 1
        incoming_index = window_start + k - 1
        outgoing = Enum.at(numbers, outgoing_index)
        incoming = Enum.at(numbers, incoming_index)
        new_sum = running_sum - outgoing + incoming
        {new_sum, max(new_sum, current_max)}
      end)
