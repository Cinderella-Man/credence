defmodule Solution do
  @moduledoc """
  Provides functionality to find the maximum sum of a contiguous subarray of exactly k elements.
  """

  @doc """
  Returns the maximum sum of any contiguous subarray of exactly `k` elements in `numbers`.
  Returns 0 if no such subarray exists (e.g., list is empty, k is 0, or k is greater than the list length).
  """
  @spec max_sum_subarray_of_size_k(list(integer()), integer()) :: integer()
  def max_sum_subarray_of_size_k(numbers, k) when k <= 0, do: 0
  def max_sum_subarray_of_size_k(numbers, _k) when length(numbers) < _k, do: 0
  def max_sum_subarray_of_size_k(numbers, k) do
    # Calculate the sum of the first window
    first_window = Enum.slice(numbers, 0, k)
    current_sum = Enum.sum(first_window)
    max_sum = current_sum

    # Slide the window across the list
    max_sum = Enum.reduce(1..(length(numbers) - k), max_sum, fn i, current_max ->
      # Remove the element going out of the window and add the new element coming in
      outgoing = Enum.at(numbers, i - 1)
      incoming = Enum.at(numbers, i + k - 1)
      new_sum = current_sum - outgoing + incoming
      
      # Update current_sum and current_max for the next iteration
      # We need to update the state in the reduce accumulator, but here we just update the variable
      # Since reduce doesn't update external variables, we need a different approach or accumulator
      true
    end)
    
    # Actually, let's use a proper reduce with an accumulator for (current_sum, max_sum)
    do_max_sum(numbers, k)
  end

  defp do_max_sum(numbers, k) when length(numbers) == k do
    Enum.sum(numbers)
  end

  defp do_max_sum(numbers, k) do
    # Initialize with the first window
    first_window = Enum.slice(numbers, 0, k)
    current_sum = Enum.sum(first_window)
    
    # Start sliding from index 1 to (length - k)
    # The window slides one step at a time.
    # At step i (0-indexed relative to slide starts), the window is numbers[i..i+k-1]
    # We've computed window starting at 0. Now we want windows starting at 1..(n-k)
    
    Enum.reduce(1..(length(numbers) - k), {current_sum, current_sum}, fn i, {curr_sum, max_so_far} ->
      outgoing = Enum.at(numbers, i - 1)
      incoming = Enum.at(numbers, i + k - 1)
      new_sum = curr_sum - outgoing + incoming
      new_max = max(new_sum, max_so_far)
      {new_sum, new_max}
    end)
    |> elem(1)
  end
end
