---REFERENCE---
defmodule Solution do
  def match?(s, p) do
    s_len = String.length(s)
    p_len = String.length(p)
    dp = for _ <- 0..s_len, do: List.duplicate(false, p_len + 1)
    dp = dp |> List.update_at(s_len, fn row -> List.update_at(row, p_len, fn _ -> true end) end)

    dp =
      for i <- s_len..0, reduce: dp do
        dp ->
          for j <- (p_len - 1)..0, reduce: dp do
            dp ->
              s_char = if i < s_len, do: String.at(s, i)
              p_char = String.at(p, j)

              new_val =
                cond do
                  p_char == "*" ->
                    dp_i_j_plus1 = dp |> Enum.at(i) |> Enum.at(j + 1)
                    dp_i_plus1_j = i < s_len and (dp |> Enum.at(i + 1) |> Enum.at(j))
                    dp_i_j_plus1 or dp_i_plus1_j

                  i < s_len and (p_char == "?" or p_char == s_char) ->
                    dp |> Enum.at(i + 1) |> Enum.at(j + 1)

                  true ->
                    false
                end

              dp |> List.update_at(i, fn row -> List.update_at(row, j, fn _ -> new_val end) end)
          end
      end

    dp |> Enum.at(0) |> Enum.at(0)
  end
end
