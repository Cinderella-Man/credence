---MODULE---
@doc """
Check if a given string matches a given wildcard pattern.
The pattern can contain '?' and '*' where:
'?' Matches any single character.
'*' Matches any sequence of characters (including the empty sequence).
"""
@spec match?(String.t(), String.t()) :: boolean()
def match?(text, pattern) do
  do_match(String.to_charlist(text), String.to_charlist(pattern))
end

defp do_match([], []), do: true
defp do_match([], pattern), do: has_wildcard?(pattern)
defp do_match([_char | text_rest], pattern) when pattern == [], do: false

defp do_match([char | text_rest], [pattern_char | pattern_rest]) when pattern_char == '?' do
  do_match(text_rest, pattern_rest)
end

defp do_match(text, [pattern_char | pattern_rest]) when pattern_char == '*' do
  # Try matching zero characters, then one, then two, etc.
  match_star(text, pattern_rest)
end

defp do_match([char | text_rest], [pattern_char | pattern_rest]) when char == pattern_char do
  do_match(text_rest, pattern_rest)
end

defp do_match(_, _), do: false

defp match_star(text, pattern) do
  # Option 1: '*' matches empty sequence, so try matching rest of text with rest of pattern
  if do_match(text, pattern) do
    true
  else
    # Option 2: '*' matches at least one character, so consume one char from text and retry
    if text == [] do
      false
    else
      do_match(elem(text, 1), pattern) |> (fn
        true -> true
        _ -> match_star(elem(text, 1), pattern)
      end).()
    end
  end
end

defp has_wildcard?(pattern) do
  Enum.all?(pattern, &(&1 == ?*))
end
---TEST---
