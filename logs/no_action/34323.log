defmodule Solution do
  def findpairs(list, k) do
    freq = Enum.reduce(list, %{}, fn x, acc ->
      Map.update(acc, x, 1, &(&1 + 1))
    end)

    if k == 0 do
      Enum.count(freq, fn {_key, count} -> count > 1 end)
    else
      Enum.count(Map.keys(freq), fn x ->
        Map.has_key?(freq, x + k)
      end)
    end
  end
end
