---MODULE---
defmodule Solution do
  @doc """
  Counts unique pairs with absolute difference equal to k.
  """
  @spec findpairs(list(integer), integer) :: non_neg_integer()
  def findpairs(nums, k) do
    {positive_k, pairs} =
      cond
      k > 0 ->
        set = MapSet.new(nums)
        count =
          Enum.reduce(nums, 0, fn
            num, acc ->
              if MapSet.member?(set, num + k) do
                acc + 1
              else
                acc
              end
          end)

        {k, count}
      k == 0 ->
        counts = Enum.group_by(nums, & &1)
        count =
          Enum.reduce(counts, 0, fn
            {_key, values}, acc ->
              if length(values) >= 2 do
                acc + 1
              else
                acc
              end
          end)

        {0, count}
      true ->
        abs_k = abs(k)
        set = MapSet.new(nums)
        count =
          Enum.reduce(nums, 0, fn
            num, acc ->
              if MapSet.member?(set, num + abs_k) do
                acc + 1
              else
                acc
              end
          end)

        {abs_k, count}
    end

    # To handle duplicates in nums correctly for k > 0:
    # We need to count unique pairs (a, b) where a - b = k (or b - a = k).
    # The above logic counts how many nums have a partner.
    # But we need unique pairs.
    # Let's reconsider. For k > 0, we want unique pairs (a, b) with a - b = k.
    # This is equivalent to finding unique elements b such that b and b+k exist.
    # So the count is the number of unique elements b such that b+k also exists in the set.
    # We can do this by iterating over unique elements.
    unique_nums = Enum.uniq(nums)
    set = MapSet.new(unique_nums)

    case k do
      0 ->
        # Count unique elements that appear at least twice
        counts = Enum.group_by(nums, & &1)
        Enum.count(counts, fn {_k, v} -> length(v) >= 2 end)
      k > 0 ->
        Enum.count(unique_nums, fn
          num ->
            MapSet.member?(set, num + k)
        end)
      _ ->
        # k < 0, absolute difference
        abs_k = abs(k)
        Enum.count(unique_nums, fn
          num ->
            MapSet.member?(set, num + abs_k)
        end)
    end
  end
end
---TEST---
