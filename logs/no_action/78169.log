---INSTRUCTION---
Write a function that takes a list of integers and returns a new list with all the elements reversed and their signs inverted (positive numbers become negative and vice versa).

Function name: `reverse_and_invert/1`
- Takes a list of integers.
- Returns a new list of integers.
- The returned list has the elements in reverse order, with each element's sign negated.
- Zero remains zero after sign inversion.
- An empty list input returns an empty list.
- The input list must not be modified.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "reverses and inverts a list of positive integers" do
    assert Solution.reverse_and_invert([1, 2, 3, 4, 5]) == [-5, -4, -3, -2, -1]
  end

  test "reverses and inverts a list of negative integers" do
    assert Solution.reverse_and_invert([-10, -20, -30, -40, -50]) == [50, 40, 30, 20, 10]
  end

  test "reverses and inverts a mixed list including zero" do
    assert Solution.reverse_and_invert([0, 2, -4, 6, -8]) == [8, -6, 4, -2, 0]
  end

  test "handles an empty list" do
    assert Solution.reverse_and_invert([]) == []
  end

  test "handles a single element" do
    assert Solution.reverse_and_invert([7]) == [-7]
  end
end
---REFERENCE---
defmodule Solution do
  @spec reverse_and_invert([integer]) :: [integer]
  def reverse_and_invert(lst) do
    lst
    |> Enum.reverse()
    |> Enum.map(fn x -> -x end)
  end
end
---END---[0m
