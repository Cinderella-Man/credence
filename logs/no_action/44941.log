---REFERENCE---
defmodule Solution do
  def pattern_count(text, pattern) do
    text_len = String.length(text)
    pattern_len = String.length(pattern)

    cond do
      pattern_len == 0 ->
        0
      pattern_len > text_len ->
        0
      true ->
        do_count(text, pattern, 0, text_len - pattern_len + 1, 0)
    end
  end

  defp do_count(_text, _pattern, i, limit, count) when i >= limit, do: count

  defp do_count(text, pattern, i, limit, count) do
    window = String.slice(text, i, String.length(pattern))

    new_count =
      if window == pattern do
        count + 1
      else
        count
      end

    do_count(text, pattern, i + 1, limit, new_count)
  end
end
