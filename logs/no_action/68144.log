@doc """
Generates all possible combinations by taking one element from each input list.
Returns a list of tuples. If the input is an empty list, returns a list with a single empty tuple.
If any input list is empty, returns an empty list.
"""
@spec possible_permutations([list(any())]) :: [tuple()]
def possible_permutations([]), do: [{}]

def possible_permutations([[] | _rest]), do: []

def possible_permutations([head | tail]) do
  tail_combinations = possible_permutations(tail)

  for item <- head, combo <- tail_combinations do
    {item | combo}
  end
end
