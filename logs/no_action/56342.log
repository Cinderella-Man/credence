defmodule Solution do
  def max_palindromic_substrings(s) do
    char_freq = Enum.frequencies(String.graphemes(s))

    even_count = Enum.count(char_freq, fn {_char, count} -> rem(count, 2) == 0 end)
    odd_count = Enum.count(char_freq, fn {_char, count} -> rem(count, 2) != 0 end)

    if odd_count > 1 do
      0
    else
      even_count + (if odd_count == 1, do: 1, else: 0)
    end
  end
end

