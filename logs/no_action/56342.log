@doc """
Given a string, determine the maximum number of palindromic substrings that can be formed by rearranging the characters of the string.
"""
@spec max_palindromic_substrings(String.t()) :: non_neg_integer()
def max_palindromic_substrings(str) do
  if str == "" do
    0
  else
    char_freqs =
      str
      |> String.graphemes()
      |> Enum.frequencies()

    {odd_count, even_count} =
      char_freqs
