---MODULE---
@doc """
Returns the character with the minimum frequency from a list of {character, frequency} tuples.
If multiple characters have the same minimum frequency, returns the first one encountered.
Returns nil for an empty list.
"""
@spec min_frequency_char([{String.t(), integer()}]) :: String.t() | nil
def min_frequency_char([]), do: nil

def min_frequency_char([{char, freq} | rest]) do
  {result_char, _} = Enum.reduce(rest, {char, freq}, fn {char2, freq2}, {best_char, best_freq} ->
    if freq2 < best_freq do
      {char2, freq2}
    else
      {best_char, best_freq}
    end
  end)
  result_char
end

