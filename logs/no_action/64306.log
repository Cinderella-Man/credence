  test "most frequent element in mixed list" do
    assert Solution.find_most_frequent_elements([1, 1, 2, 3, 3, 3, 4, 4, 4, 4]) == {4, 4}
  end

  test "most frequent element with tie, first element wins" do
    assert Solution.find_most_frequent_elements([8, 8, 8, 8, 8, 9, 9, 9, 9, 9]) == {8, 5}
  end

  test "most frequent element in unsorted list" do
    assert Solution.find_most_frequent_elements([2, 3, 1, 3, 2, 4, 6, 7, 9, 2, 19]) == {2, 3}
  end
end
