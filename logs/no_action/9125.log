---MODULE---
@doc """
Calculates the maximum depth of a nested list structure.

The depth of a non-list element is 0.
The depth of a list is 1 plus the maximum depth of its elements.
An empty list has depth 1.
"""
@spec maxdepth(term()) :: non_neg_integer()
def maxdepth(term) when is_list(term) do
  case term do
    [] ->
      1

    [head | tail] ->
      depth_head = maxdepth(head)
      depth_tail = maxdepth(tail)
      1 + max(depth_head, depth_tail)
  end
end

def maxdepth(_non_list) do
  0
end

---TEST---
