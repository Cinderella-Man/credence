@spec counttarget([number()], number()) :: non_neg_integer()
def counttarget(numbers, target) do
  count_helper(numbers, target, 0)
end

defp count_helper([], _target, count), do: count

defp count_helper([head | tail], target, count) do
  new_count =
    if head == target do
      count + 1
    else
      count
    end

  count_helper(tail, target, new_count)
end
