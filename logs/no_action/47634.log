defmodule Solution do
@doc """
Counts the number of times the target number appears in a list.

Traverses the list exactly once, returning 0 if the list is empty or if the target
is not found.

## Parameters
  - numbers: A list of numbers
  - target: The number to count occurrences of

## Returns
  The count of occurrences of the target in the list

## Examples
      iex> Solution.counttarget([10, 10, 10, 10, 10], 10)
      5

      iex> Solution.counttarget([1, 2, 3, 4, 5], 6)
      0

      iex> Solution.counttarget([1, 2, 3, 2, 4, 2, 5], 2)
      3
"""
@spec counttarget([number()], number()) :: non_neg_integer()
def counttarget(numbers, target) do
  count_helper(numbers, target, 0)
end

defp count_helper(list, target, count) when is_list(list),
  do: count + Enum.count(list, fn head -> head == target end)
end
