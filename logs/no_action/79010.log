defmodule Solution do
  def transform_strings(strings) do
    Enum.map(strings, fn s ->
      if s == "" do
        ""
      else
        first = String.at(s, 0) |> String.upcase()
        rest = String.slice(s, 1..-1) |> String.downcase()
        first <> rest
      end
    end)
  end
end
