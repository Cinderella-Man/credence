  test "transform_strings with another set of strings" do
    assert Solution.transform_strings(["apple", "BANANA", "cherry"]) == ["Apple", "Banana", "Cherry"]
  end

  test "transform_strings with strings starting with digits" do
    assert Solution.transform_strings(["123abc", "ABC123", "abc123"]) == ["123abc", "Abc123", "Abc123"]
  end
end
