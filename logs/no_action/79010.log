@doc """
Transforms each string in a list so that the first character is uppercase
and all remaining characters are lowercase. Strings starting with a non-letter
character are left unchanged.
"""
defmodule Solution do
  @spec transform_strings(list(String.t())) :: list(String.t())
  def transform_strings(strings) do
    Enum.map(strings, &transform_string/1)
  end

  @doc """
  Transforms a single string so that the first character is uppercase
  and all remaining characters are lowercase. If the string starts with
  a non-letter character, it is left unchanged.
  """
  @spec transform_string(String.t()) :: String.t()
  def transform_string(""), do: ""

  def transform_string(<<first::binary-size(1), rest::binary>>) when first =~ ~r/^\p{L}$/u do
    upper_first = String.upcase(first)
    lower_rest = String.downcase(rest)
    upper_first <> lower_rest
  end

  def transform_string(str) do
    str
  end
end
