---MODULE---
defmodule Solution do
  @doc """
  Finds the length of the longest subsequence of consecutive integers in a list.

  Duplicates are ignored when forming consecutive runs.
  """
  @spec lengthoflongestconsecutivesequence([integer()]) :: non_neg_integer()
  def lengthoflongestconsecutivesequence(numbers) do
    unique_numbers = Enum.uniq(numbers)

    if Enum.empty?(unique_numbers) do
      0
    else
      sorted_numbers = Enum.sort(unique_numbers)

      Enum.reduce(sorted_numbers, {0, 0, :no_prev}, fn num, {max_len, current_len, prev} ->
        case prev do
          :no_prev ->
            new_len = current_len + 1
            new_max = if new_len > max_len, do: new_len, else: max_len
            {new_max, new_len, num}

          prev_value ->
            new_len = if num == prev_value + 1, do: current_len + 1, else: 1
            new_max = if new_len > max_len, do: new_len, else: max_len
            {new_max, new_len, num}
        end
      end)
      |> elem(0)
    end
  end
end
