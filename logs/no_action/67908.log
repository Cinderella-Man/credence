defmodule Solution do
  def lengthoflongestconsecutivesequence([]), do: 0
  def lengthoflongestconsecutivesequence(nums) do
    set = MapSet.new(nums)

    Enum.reduce(set, 0, fn num, longest ->
      if MapSet.member?(set, num - 1) do
        longest
      else
        current = find_streak(set, num, 1)
        max(longest, current)
      end
    end)
  end

  defp find_streak(set, current_num, streak) do
    if MapSet.member?(set, current_num + 1) do
      find_streak(set, current_num + 1, streak + 1)
    else
      streak
    end
  end
end
