@moduledoc """
Solves the decoding ways problem: given a string of digits, count the number
of ways to decode it into letters using the mapping 'A' -> 1, ..., 'Z' -> 26.
"""

defmodule Solution do
  @doc """
  Returns the number of valid decodings for the given string of digits.
  """
  @spec num_decodings(String.t()) :: non_neg_integer()
  def num_decodings(<<>>) do
    0
  end

  def num_decodings(<<?0, _rest::binary>>) do
    0
  end

  def num_decodings(digits) do
    nums =
      digits
      |> :binary.bin_to_list()
      |> Enum.map(&(&1 - ?0))

    do_decode(nums, 1, 1)
  end

  # dp[i] corresponds to the number of ways to decode the prefix of length i.
  # prev2 is dp[i-2], prev1 is dp[i-1].
  # We want dp[n].

  # When no digits left, we have processed all. prev1 is dp[n].
  defp do_decode([], _index, prev1) do
    prev1
  end

  # When one digit left, index is 1 (since we started with index=1 for first digit)
  # prev2 is dp[-1]? No, let's reframe.
  # Let's use a simpler recursive approach with index tracking.

  defp do_decode([digit | rest], index, prev2, prev1) when index == 1 do
    # First digit
    if digit >= 1 and digit <= 9 do
      do_decode(rest, 2, 1, 1)
    else
      0
    end
  end

  # This is getting messy. Let's use a clean iterative DP with a list.

  defp do_decode([digit | rest], index, prev2, prev1) do
    # Current digit
    current_ways = 0

    # Option 1: Decode single digit
    if digit >= 1 and digit <= 9 do
      current_ways = current_ways + prev1
    end

    # Option 2: Decode two digits (previous + current)
    # prev1 is dp[i-1], which means we took one digit before.
    # prev2 is dp[i-2].
    # We need to check if the two-digit number formed by previous digit and current digit is valid.
    # But we don't have the previous digit here easily.

    # Let's restart with a cleaner approach.
    _ = {prev2, prev1, index}
    0
  end
end[0m
