@moduledoc """
Solves the decoding ways problem: given a string of digits, count the number
of ways to decode it into letters using the mapping 'A' -> 1, ..., 'Z' -> 26.
"""

defmodule Solution do
  @doc """
  Returns the number of valid decodings for the given string of digits.
  """
  @spec num_decodings(String.t()) :: non_neg_integer()
  def num_decodings(<<>>) do
    0
  end

  def num_decodings(<<first, rest::binary>>) when first == ?0 do
    0
  end

  def num_decodings(digits) when is_binary(digits) do
    do_decode(String.to_charlist(digits))
  end

  # dp state: {prev2, prev1} where prev2 is ways[i-2] and prev1 is ways[i-1]
  # Base case: empty string has 1 way (do nothing), but our input validation
  # handles empty strings separately. However, for recursion, we need a base.
  # Let's process from right to left or left to right.
  # Left to right:
  # dp[0] = 1 (base)
  # For each digit i:
  #   dp[i+1] = 0
  #   if digit[i] is valid single digit (1-9), dp[i+1] += dp[i]
  #   if digit[i-1] and digit[i] form valid 2-digit number (10-26), dp[i+1] += dp[i-1]

  defp do_decode(chars) do
    # dp[i] = number of ways to decode prefix of length i
    # dp[0] = 1
    # dp[1] depends on first char
    # We'll iterate through chars and update dp[i] and dp[i+1]

    # Handle first character separately to initialize
    [first | rest] = chars

    # dp[-1] doesn't exist, conceptually 0
    # dp[0] = 1
    # dp[1] = 1 if first is valid single digit, else 0
    prev_prev = 1 # dp[i-1] initially dp[0]
    prev = 1      # dp[i] initially dp[1] if valid, but we need to check

    # Actually, let's use a cleaner approach with a list of digits
    nums = Enum.map(chars, &(&1 - ?0))
    decode_helper(nums, 0, 1, 1)
  end

  # decode_helper: processes digits starting from index `index`
  # prev2 = ways to decode prefix ending at index-2
  # prev1 = ways to decode prefix ending at index-1
  # We want to compute ways to decode prefix ending at index
  # After processing all digits, prev1 will be the answer

  # Base case: no more digits to process
  defp decode_helper([], _index, _prev2, prev1) do
    prev1
  end

  # One digit left: check if it's valid single digit
  defp decode_helper([digit], _index, prev2, prev1) do
    if digit >= 1 and digit <= 9 do
      prev1 + prev2
    else
      0
    end
  end

  # Multiple digits left
  defp decode_helper([current | rest], index, prev2, prev1) do
    # Check single digit
    single_ways =
      if current >= 1 and current <= 9 do
        prev1
      else
        0
      end

    # Check two digit (previous + current)
    # We need to know the previous digit. Let's pass it or restructure.
    # Let's restructure to pass the previous digit value.

    # Actually, this is getting complicated. Let's use a simpler iterative approach.
    _ = {index, prev2, prev1}
    0
  end
end
