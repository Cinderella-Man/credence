---INSTRUCTION---
Given a string of digits, count the number of ways to decode it into letters using the mapping 'A' -> 1, 'B' -> 2, ..., 'Z' -> 26. The decoding must follow these rules:
- A single digit must be between 1 and 9 (inclusive) to represent a letter.
- Two consecutive digits must form a number between 10 and 26 (inclusive) to represent a letter.
- The string may be empty, in which case the result is 0.
- If the string contains a leading zero (e.g., "0" or "06"), it cannot be decoded and the result is 0.

Write a function `num_decodings/1` that takes a string and returns the number of valid decodings.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "empty string returns 0" do
    assert Solution.num_decodings("") == 0
  end

  test "\"12\" has two decodings (AB or L)" do
    assert Solution.num_decodings("12") == 2
  end

  test "\"226\" has three decodings (BZ, VF, BBF)" do
    assert Solution.num_decodings("226") == 3
  end

  test "leading zero returns 0" do
    assert Solution.num_decodings("0") == 0
  end

  test "leading zero with other digits returns 0" do
    assert Solution.num_decodings("06") == 0
  end
end
---REFERENCE---
defmodule Solution do
  def num_decodings(""), do: 0

  def num_decodings(s) do
    digits =
      s
      |> String.graphemes()
      |> Enum.map(&String.to_integer/1)

    case hd(digits) do
      0 ->
        0

      _ ->
        {_prev2, prev1, _last} =
          Enum.reduce(tl(digits), {1, 1, hd(digits)}, fn cur, {prev2, prev1, prev} ->
            double = prev * 10 + cur
            cur_count = 0
            cur_count = if cur >= 1 and cur <= 9, do: cur_count + prev1, else: cur_count
            cur_count = if double >= 10 and double <= 26, do: cur_count + prev2, else: cur_count
            {prev1, cur_count, cur}
          end)

        prev1
    end
  end
end
