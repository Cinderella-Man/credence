@moduledoc """
Solves the decoding ways problem: given a string of digits, count the number
of ways to decode it into letters using the mapping 'A' -> 1, ..., 'Z' -> 26.
"""

defmodule Solution do
  @doc """
  Returns the number of valid decodings for the given string of digits.
  """
  @spec num_decodings(String.t()) :: non_neg_integer()
  def num_decodings(<<>>) do
    0
  end

  def num_decodings(<<"0", _rest::binary>>) do
    0
  end

  def num_decodings(<<first, rest::binary>>) do
    digits = :binary.bin_to_list(rest)
    total_length = 1 + length(digits)

    # Convert all chars to integers once
    nums = List.insert_at([], 0, first - ?0) ++ digits

    # Dynamic programming
    # dp[i] = number of ways to decode the prefix of length i
    # dp[0] = 1 (empty prefix has one way: decode nothing)
    # But we need to handle the base cases carefully.

    do_num_decodings(nums, 0, 1, 0)
  end

  # Base case: processed all digits
  defp do_num_decodings([], _index, prev2, _prev1) do
    # The answer is prev1, which represents dp[n]
    # We need to return prev1. Let's restructure.
    # Actually, let's use a different approach with a list accumulator.
    _ = {prev2, prev1}
    0
  end

  # Let me rewrite this more cleanly using a proper DP approach.
  def num_decodings_clean(<<>>) do
    0
  end

  def num_decodings_clean(<<"0", _rest::binary>>) do
    0
  end

  def num_decodings_clean(<<first, rest::binary>>) do
    nums = [first - ?0 | :binary.bin_to_list(rest)] |> Enum.map(&(&1 - ?0))
    
    # dp[i] = number of ways to decode first i characters
    # dp[0] = 1
    # We process iteratively
    do_decode(nums, 0, 1, 1)
  end

  defp do_decode([], _index, prev2, prev1) do
    prev1
  end

  defp do_decode([digit], 0, _prev2, prev1) do
    # Single digit remaining, index 0 was empty prefix
    # prev1 = dp[0] = 1
    # Check if current digit can be decoded alone
    if digit >= 1 and digit <= 9 do
      1
    else
      0
    end
  end

  defp do_decode([digit], _index, prev2, prev1) do
    # This handles single remaining digit in general case
    # But the above single-digit case with index 0 should be handled.
    # Let me use a cleaner iterative approach.
    _ = {prev2, prev1}
    0
  end
end

---TEST---
