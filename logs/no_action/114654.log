defmodule Solution do
  def island_connection(n, _connections) when n <= 1, do: 0

  def island_connection(n, connections) do
    sorted = Enum.sort_by(connections, fn [_, _, cost] -> cost end)
    parent = Enum.into(0..(n - 1), %{}, fn i -> {i, i} end)
    kruskal(sorted, parent, 0, 0, n)
  end

  defp kruskal(_connections, _parent, edges_used, cost, n)
       when edges_used == n - 1,
       do: cost

  defp kruskal([], _parent, _edges_used, _cost, _n), do: -1

  defp kruskal([[u, v, c] | rest], parent, edges_used, cost, n) do
    root_u = find(parent, u)
    root_v = find(parent, v)

    if root_u == root_v do
      kruskal(rest, parent, edges_used, cost, n)
    else
      new_parent = Map.put(parent, root_u, root_v)
      kruskal(rest, new_parent, edges_used + 1, cost + c, n)
    end
  end

  defp find(parent, x) do
    if parent[x] == x do
      x
    else
      find(parent, parent[x])
    end
  end
end
