---REFERENCE---
defmodule Solution do
  def min_cost_climbing_stairs(cost) do
    case cost do
      [] -> 0
      [_] -> 0
      [first, second | rest] ->
        # prev2: minimum cost to reach step 0
        # prev1: minimum cost to reach step 1
        prev2 = first
        prev1 = second

        {a, b} =
          Enum.reduce(rest, {prev2, prev1}, fn c, {a, b} ->
            {b, c + min(a, b)}
          end)

        min(a, b)
    end
  end
end
