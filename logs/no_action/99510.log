      15

      iex> Solution.min_cost_climbing_stairs([0, 0, 0, 0])
      0

  """
  @spec min_cost_climbing_stairs(list(integer)) :: integer
  def min_cost_climbing_stairs([]), do: 0
  def min_cost_climbing_stairs([_]), do: 0
  def min_cost_climbing_stairs([cost1, cost2]), do: min(cost1, cost2)

  def min_cost_climbing_stairs(costs) do
    [cost1, cost2 | rest] = costs
    min_cost_rest(cost1, cost2, rest)
  end

  @spec min_cost_rest(integer, integer, list(integer)) :: integer
  defp min_cost_rest(prev2, prev1, [cost | tail]) do
    current = cost + min(prev2, prev1)
    min_cost_rest(prev1, current, tail)
  end

  defp min_cost_rest(_prev2, prev1, []) do
    prev1
  end
end
