defmodule Solution do
  @moduledoc """
  Provides functionality to calculate the minimum cost to climb the staircase.
  """

  @doc """
  Returns the minimum cost to climb the staircase.

  You can start from step 0 or step 1, and you can climb one or two steps at a time.
  The cost of a step is paid when you land on it. You must reach beyond the last step.

  ## Examples

      iex> Solution.min_cost_climbing_stairs([1, 100, 1, 1, 1, 100, 1, 1, 100, 1])
      6

      iex> Solution.min_cost_climbing_stairs([10, 15, 20])
      15

      iex> Solution.min_cost_climbing_stairs([0, 0, 0, 0])
      0

  """
  @spec min_cost_climbing_stairs(list(integer)) :: integer
  def min_cost_climbing_stairs([]), do: 0
  def min_cost_climbing_stairs([_]), do: 0
  def min_cost_climbing_stairs([cost1, cost2]), do: min(cost1, cost2)

  def min_cost_climbing_stairs(costs) when is_list(costs) do
    {prev1, prev2} =
      Enum.reduce(
        costs,
        {0, 0},
        fn cost, {prev1, prev2} ->
          {min(prev1 + cost, prev2 + cost), prev1}
        end
      )

    min(prev1, prev2)
  end
end[0m
