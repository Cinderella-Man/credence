defmodule Solution do
  @moduledoc """
  Solution module for rearranging string characters so no two adjacent are the same.
  """

  @spec rearrangestring(String.t()) :: String.t()
  def rearrangestring(""), do: ""

  def rearrangestring(string) do
    char_count = count_chars(string)
    max_freq = max_value(char_count)
    length = String.length(string)

    # If the most frequent character appears more than (length + 1) / 2 times,
    # it's impossible to rearrange without adjacency.
    if max_freq > div(length + 1, 2) do
      ""
    else
      rearrange(string, char_count, length)
    end
  end

  defp count_chars(string) do
    string
    |> String.graphemes()
    |> Enum.frequencies()
  end

  defp max_value(map) do
    map
    |> Map.values()
    |> Enum.max()
  end

  defp rearrange(_string, char_count, length) do
    # Sort characters by frequency descending to prioritize frequent ones
    sorted_chars =
      char_count
      |> Enum.sort(fn {_, c1}, {_, c2} -> c1 >= c2 end)

    # Create a flat list of all characters sorted by frequency desc.
    flat_chars =
      sorted_chars
      |> Enum.flat_map(fn {char, count} -> List.duplicate(char, count) end)

    # Split into two halves. The first half gets placed at even indices (0, 2, ...).
    # The second half gets placed at odd indices (1, 3, ...).
    # Since max_freq <= (length + 1) / 2, the most frequent char won't overflow
    # the first half if we split carefully.
    # Actually, the standard algorithm:
