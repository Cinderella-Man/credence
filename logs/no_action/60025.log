## Python Instruction
Write a function to rearrange a given string such that no two adjacent characters are the same. If it is not possible to rearrange the string to meet the requirements, return an empty string.

## Python Solution
```python
import queue

class Char:
    def __init__(self, ch, count):
        self.ch = ch
        self.count = count
    def __lt__(self, other):
        return self.count > other.count

def rearrangeString(s: str) -> str:
    cnt = {chr(ord('a') + i) : 0 for i in range(26)}
    for char in s:
        cnt[char] += 1
    pq = queue.PriorityQueue()
    for i in cnt:
        if cnt[i] != 0:
            pq.put(Char(i, cnt[i]))
        
    ans = ''
        
    lastChar = pq.get()
    lastChar.count -= 1
    ans += lastChar.ch
        
    while len(pq.queue) > 0:
        nextChar = pq.get()
        ans += nextChar.ch
        nextChar.count -= 1
            
        if lastChar.count > 0:
            pq.put(lastChar)
            
        lastChar = nextChar
        
    if lastChar.count == 0:
        return ans
    return ''
```

