defmodule Solution do
  @spec rearrangestring(String.t()) :: String.t()
  def rearrangestring(s) do
    freq = s
           |> String.graphemes()
           |> Enum.frequencies()

    freq_list = freq
                |> Enum.map(fn {ch, cnt} -> {cnt, ch} end)
                |> Enum.sort_by(fn {cnt, ch} -> {-cnt, ch} end)

    case freq_list do
      [] ->
        ""

      _ ->
        {cnt, ch} = hd(freq_list)
        new_cnt = cnt - 1
        new_freq_list = if new_cnt == 0 do
          tl(freq_list)
        else
          freq_list
          |> tl()
          |> then(fn list -> [{new_cnt, ch} | list] end)
          |> Enum.sort_by(fn {cnt, ch} -> {-cnt, ch} end)
        end

        build_string(new_freq_list, ch, ch)
    end
  end

  defp build_string([], _last_char, acc), do: acc

  defp build_string(freq_list, last_char, acc) do
    case Enum.find(freq_list, fn {_cnt, ch} -> ch != last_char end) do
      nil ->
        ""

      {cnt, ch} ->
        new_cnt = cnt - 1
        new_freq_list = freq_list
                        |> List.delete({cnt, ch})
                        |> then(fn list ->
                          if new_cnt > 0 do
                            ([{new_cnt, ch} | list])
                            |> Enum.sort_by(fn {cnt, ch} -> {-cnt, ch} end)
                          else
                            list
                          end
                        end)

        build_string(new_freq_list, ch, acc <> ch)
    end
  end
end
