defmodule Solution do
  @moduledoc """
  Solution module for rearranging string characters so no two adjacent are the same.
  """

  @spec rearrangestring(String.t()) :: String.t()
  def rearrangestring(""), do: ""

  def rearrangestring(string) do
    char_count = count_chars(string)
    max_freq = max_value(char_count)
    length = String.length(string)

    # If the most frequent character appears more than (length + 1) / 2 times,
    # it's impossible to rearrange without adjacency.
    if max_freq > (length + 1) / 2 do
      ""
    else
      rearrange(string, char_count, max_freq, length)
    end
  end

  defp count_chars(string) do
    string
    |> String.graphemes()
    |> Enum.group_by(fn c -> c end)
    |> Map.new(fn {k, v} -> {k, length(v)} end)
  end

  defp max_value(map) do
    map
    |> Map.values()
    |> Enum.max()
  end

