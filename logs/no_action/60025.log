defmodule Solution do
  @moduledoc """
  Solution module for rearranging string characters so no two adjacent are the same.
  """

  @spec rearrangestring(String.t()) :: String.t()
  def rearrangestring(""), do: ""

  def rearrangestring(string) do
    char_count = count_chars(string)
    max_freq = max_value(char_count)
    length = String.length(string)

    # If the most frequent character appears more than (length + 1) / 2 times,
    # it's impossible to rearrange without adjacency.
    if max_freq > (length + 1) / 2 do
      ""
    else
      rearrange(string, char_count, max_freq, length)
    end
  end

  defp count_chars(string) do
    string
    |> String.graphemes()
    |> Enum.group_by(fn c -> c end)
    |> Map.new(fn {k, v} -> {k, length(v)} end)
  end

  defp max_value(map) do
    map
    |> Map.values()
    |> Enum.max()
  end

  defp rearrange(string, char_count, max_freq, length) do
    # Sort characters by frequency descending to prioritize frequent ones
    sorted_chars =
      char_count
      |> Enum.sort(fn {_, c1}, {_, c2} -> c1 >= c2 end)
      |> Enum.map(fn {k, v} -> {k, v} end)

    # We need to distribute the most frequent character into the "even" positions
    # or interleave properly. A robust approach:
    # Fill even indices first with the most frequent char, then fill the rest.
    # Actually, a standard algorithm is:
    # 1. Put the most frequent char at indices 0, 2, 4...
    # 2. Put other chars at remaining indices.

    # Let's construct the result array.
    result = List.duplicate("", length)

    # Fill even positions with the most frequent character(s)
    # We can handle this by iterating through the sorted chars.
    # We fill even indices first, then odd.
    
    # Better approach: 
    # Create a list of chars sorted by freq desc.
    # Assign to even indices, then odd indices.
    
    even_idx = 0
    odd_idx = 1
    
    # We need to fill the result array.
    # First pass: fill even indices with characters starting from the highest frequency.
    # Second pass: fill odd indices with remaining characters.
    
    # Let's collect all chars in a flat list sorted by freq desc.
    flat_chars =
      char_count
      |> Enum.sort(fn {_, c1}, {_, c2} -> c1 >= c2 end)
      |> Enum.flat_map(fn {k, v} -> List.duplicate(k, v) end)

    # If we just assign flat_chars[0] to 0, flat_chars[1] to 2, etc.,
    # and then fill odds, we might still have issues if the max freq is high.
    # But we already checked the max_freq condition.
    
    # The "even first" strategy works:
    # Fill indices 0, 2, 4... with the first N chars from flat_chars.
    # Fill indices 1, 3, 5... with the rest.
    
    # Calculate how many even positions there are.
    half_len = ceil(length / 2)
    
    {even_part, odd_part} = Enum.split(flat_chars, half_len)
    
    # Fill even positions
    Enum.each(0..(length-1) |> Enum.map(fn i -> i * 2 end) |> Enum.take(half_len), fn i ->
      # This approach is tricky with indices. Let's just build the list.
      nil
    end)

    # Let's use a simpler construction:
    # Result list.
    # Fill even indices from even_part.
    # Fill odd indices from odd_part.
    
    res_list =
      List.duplicate("", length)
      |> List.fold_in(fn _, acc -> acc end, nil)

    # Actually, let's just build a list by interleaving.
    # We can use a list of characters and split it.
    
    final_string =
      case length of
        0 -> ""
        _ ->
          # We have even_part and odd_part.
          # We need to interleave them.
          # Even positions: 0, 2, 4... get even_part
          # Odd positions: 1, 3, 5... get odd_part
          
          # Construct the result list by placing chars.
          result_list =
            List.duplicate("", length)
            |> Enum.with_index()
            |> Enum.map(fn {_, i} -> 
              case rem(i, 2) do
                0 -> List.at(even_part, div(i, 2))
                1 -> List.at(odd_part, div(i, 2))
              end
            end)
            |> List.to_string()
          
          # Check if adjacent chars are the same.
          # Due to the frequency check, this should be valid.
          # But let's verify or use a more robust construction.
          # The "even first" method is guaranteed to work if max_freq <= (n+1)/2.
          
          # Let's reconstruct carefully.
          even_list = even_part
          odd_list = odd_part
          
          final_list =
            Enum.zip(even_list, odd_list)
            |> Enum.flat_map(fn {a, b} -> [a, b] end)
            |> Enum.slice(0..(length-1))
            |> List.to_string()
          
          final_list
      end
    
    final_string
  end
end
