---MODULE---
defmodule Solution do
  @moduledoc """
  Solution module for rearranging string characters so no two adjacent are the same.
  """

  @doc """
  Rearranges the characters of a string such that no two adjacent characters are identical.
  Returns an empty string if it's impossible.
  """
  @spec rearrangestring(String.t()) :: String.t()
  def rearrangestring(""), do: ""

  def rearrangestring(string) do
    char_count = count_chars(string)
    max_freq = max_value(char_count)
    length = String.length(string)

    if max_freq > div(length + 1, 2) do
      ""
    else
      do_rearrange(char_count, length)
    end
  end

  defp count_chars(string) do
    string
    |> String.graphemes()
    |> Enum.frequencies()
  end

  defp max_value(map) do
    map
    |> Map.values()
    |> Enum.max()
  end

  defp do_rearrange(char_count, length) do
    # Sort by frequency descending
    sorted_chars =
      char_count
      |> Enum.sort(fn {_, c1}, {_, c2} -> c1 >= c2 end)

    # Flatten into a list of characters sorted by frequency
    flat_chars =
      sorted_chars
      |> Enum.flat_map(fn {char, count} -> List.duplicate(char, count) end)

    # Split into two halves
    # First half goes to even indices, second half goes to odd indices
    split_at = div(length + 1, 2)
    {first_part, second_part} = Enum.split(flat_chars, split_at)

    # Build the result list
    result_list =
      for i <- 0..(length - 1),
          c <- [if(rem(i) == 0, do: Enum.at(first_part, div(i, 2)), else: Enum.at(second_part, div(i, 2)))] do
        c
      end

    List.to_string(result_list)
  end
end
