defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "rearrangestring returns empty string for impossible case" do
    assert Solution.rearrangestring("aaab") == ""
  end

  test "rearrangestring returns rearranged string for possible case" do
    assert Solution.rearrangestring("aappp") == "papap"
  end

  test "rearrangestring returns empty string for two same characters" do
    assert Solution.rearrangestring("aa") == ""
  end

  test "rearrangestring returns correct rearrangement for equal counts" do
    assert Solution.rearrangestring("aabb") == "abab"
  end
end
