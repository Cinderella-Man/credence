defmodule Solution do
  def smallest([]), do: nil
  def smallest([head | tail]), do: smallest(tail, head)

  defp smallest([], current), do: current
  defp smallest([head | tail], current) when head < current, do: smallest(tail, head)
  defp smallest([_head | tail], current), do: smallest(tail, current)
end
