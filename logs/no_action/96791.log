---MODULE---
defmodule Solution do
  @doc """
  Returns the maximum product that can be obtained by multiplying
  any two distinct elements from the given list of integers.

  Runs in O(n) time with O(1) extra space.
  """
  @spec max_pair_product(list(integer())) :: integer()
  def max_pair_product([first, second | rest]) do
    max_pair_product(rest, first, second, first, second)
  end

  def max_pair_product([], largest, second_largest, smallest, second_smallest) do
    product_of_largest = largest * second_largest
    product_of_smallest = smallest * second_smallest
    max(product_of_largest, product_of_smallest)
  end

  def max_pair_product([current | rest], largest, second_largest, smallest, second_smallest) do
    new_largest =
      if current > largest do
        largest
      else
        second_largest
      end

    # We need to update largest, second_largest, smallest, second_smallest
    # in a way that tracks the top 2 largest and bottom 2 smallest values.

    {new_largest, new_second_largest} =
      if current >= largest do
        {current, largest}
      else
        {largest, max(second_largest, current)}
      end

    {new_smallest, new_second_smallest} =
      if current <= smallest do
        {current, smallest}
      else
        {smallest, min(second_smallest, current)}
      end

    max_pair_product(rest, new_largest, new_second_largest, new_smallest, new_second_smallest)
  end
end
