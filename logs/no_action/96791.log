---REFERENCE---
defmodule Solution do
  @doc """
  Given a list of integers, returns the maximum product from a pair of distinct elements.
  """
  def max_pair_product([a, b | rest]) do
    {max1, max2} = if a >= b, do: {a, b}, else: {b, a}
    {min1, min2} = if a <= b, do: {a, b}, else: {b, a}

    {max1, max2, min1, min2} =
      Enum.reduce(rest, {max1, max2, min1, min2}, fn num, {max1, max2, min1, min2} ->
        {max1, max2} =
          cond do
            num > max1 -> {num, max1}
            num > max2 -> {max1, num}
            true -> {max1, max2}
          end

        {min1, min2} =
          cond do
            num < min1 -> {num, min1}
            num < min2 -> {min1, num}
            true -> {min1, min2}
          end

        {max1, max2, min1, min2}
      end)

    max(max1 * max2, min1 * min2)
  end
end

