defmodule Solution do
  @doc """
  Returns the maximum product that can be obtained by multiplying
  any two distinct elements from the given list of integers.

  Runs in O(n) time with O(1) extra space.
  """
  @spec max_pair_product(list(integer())) :: integer()
  def max_pair_product(numbers) when length(numbers) >= 2 do
    {largest, second_largest, smallest, second_smallest} =
      Enum.reduce(numbers, initial_state(), fn num,
                                               {largest, second_largest, smallest,
                                                second_smallest} ->
        update_state(num, largest, second_largest, smallest, second_smallest)
      end)

    max(largest * second_largest, smallest * second_smallest)
  end

  defp initial_state do
    {
      :no_value,
      :no_value,
      :no_value,
      :no_value
    }
  end

  defp update_state(num, :no_value, :no_value, :no_value, :no_value) do
    {num, num, num, num}
  end

  defp update_state(
         num,
         largest,
         second_largest,
         smallest,
         second_smallest
       ) do
    # Update largest and second_largest
    {new_largest, new_second_largest} =
      if num > largest do
        {num, largest}
      else
        {largest, max(num, second_largest)}
      end

    # Update smallest and second_smallest
    {new_smallest, new_second_smallest} =
      if num < smallest do
        {num, smallest}
      else
        {smallest, min(num, second_smallest)}
      end

    {new_largest, new_second_largest, new_smallest, new_second_smallest}
  end
end
