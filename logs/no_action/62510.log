---MODULE---
@doc """
Determines if it's possible to complete all trips given the car's capacity.

## Examples

    iex> Solution.can_complete_trips([{2, 1, 5}, {3, 3, 7}], 4)
    false

    iex> Solution.can_complete_trips([{2, 1, 5}, {3, 3, 7}], 5)
    true

    iex> Solution.can_complete_trips([{2, 1, 5}, {3, 5, 7}], 3)
    true
"""
defmodule Solution do
  @spec can_complete_trips(list({integer(), integer(), integer()}), integer()) :: boolean()
  def can_complete_trips(trips, capacity) do
    # Collect all events: passenger pickups and dropoffs
    events =
      trips
      |> Enum.flat_map(fn {num_passengers, start_location, end_location} ->
        [{start_location, num_passengers}, {end_location, -num_passengers}]
      end)
      # Sort by location, then by event type (dropoffs before pickups at same location)
      # This ensures that when both pickup and dropoff happen at the same location,
      # we drop off first to minimize peak occupancy
      |> Enum.sort_by(fn {location, _change} -> location end)
      |> Enum.sort_by(fn {location, change} ->
        if location == location, do: {location, change}, else: {location, change}
      end)

    # More precise sorting: at same location, dropoffs (-change) should come before pickups
    # We can sort by {location, change} where we want negative changes (dropoffs) before positive (pickups)
    events =
      trips
      |> Enum.flat_map(fn {num_passengers, start_location, end_location} ->
        [{start_location, num_passengers}, {end_location, -num_passengers}]
      end)
      |> Enum.sort(fn {loc1, change1}, {loc2, change2} ->
        cond do
          loc1 != loc2 -> loc1 < loc2
          change1 < change2 -> true  # dropoffs (negative) before pickups (positive)
          true -> false
        end
      end)

    # Simulate the journey, tracking current number of passengers
    {_, possible?} =
      events
      |> Enum.reduce_while({0, true}, fn {_location, change}, {current_passengers, _possible} ->
        new_passengers = current_passengers + change

        if new_passengers > capacity do
      {:halt, {new_passengers, false}}
        else
      {:cont, {new_passengers, true}}
        end
      end)

    possible?
  end
end

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "example 1" do
    trips = [{2, 1, 5}, {3, 3, 7}]
    assert Solution.can_complete_trips(trips, 4) == false
  end

  test "example 2" do
    trips = [{2, 1, 5}, {3, 3, 7}]
    assert Solution.can_complete_trips(trips, 5) == true
  end

  test "example 3" do
    trips = [{2, 1, 5}, {3, 5, 7}]
    assert Solution.can_complete_trips(trips, 3) == true
  end
end

