---INSTRUCTION---
Write a function that determines if it's possible to complete all the trips with the given capacity of the car.

You are given a list of trips where each trip is a tuple of three integers: {num_passengers, start_location, end_location}. You are also given an integer `capacity`. Your task is to return `true` if it's possible to complete all the trips using a single car that can carry at most `capacity` passengers at any time during the journey, and `false` otherwise.

Assume location values are integers between 0 and 1000 inclusive. The car starts empty and picks up/drops off passengers exactly at the specified locations. Passengers are picked up at the start location and dropped off at the end location.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "example 1" do
    trips = [{2, 1, 5}, {3, 3, 7}]
    assert Solution.can_complete_trips(trips, 4) == false
  end

  test "example 2" do
    trips = [{2, 1, 5}, {3, 3, 7}]
    assert Solution.can_complete_trips(trips, 5) == true
  end

  test "example 3" do
    trips = [{2, 1, 5}, {3, 5, 7}]
    assert Solution.can_complete_trips(trips, 3) == true
  end
end
---REFERENCE---
defmodule Solution do
  def can_complete_trips(trips, capacity) do
    # Use a map to track passenger changes at each location
    changes =
      Enum.reduce(trips, %{}, fn {passengers, start, end_loc}, acc ->
        acc
        |> Map.update(start, passengers, &(&1 + passengers))
        |> Map.update(end_loc, -passengers, &(&1 - passengers))
      end)

    # Get sorted unique locations
    locations = Map.keys(changes) |> Enum.sort()

    # Process in order, tracking current load and maximum
    {max_load, _} =
      Enum.reduce(locations, {0, 0}, fn loc, {current_max, current_load} ->
        change = Map.get(changes, loc, 0)
        new_load = current_load + change
        new_max = max(current_max, new_load)
        {new_max, new_load}
      end)

    max_load <= capacity
  end
end
