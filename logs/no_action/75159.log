defmodule Solution do
  @spec find_subarray_with_zero_sum(list(integer())) :: boolean()
  def find_subarray_with_zero_sum(list) do
    do_find(list, 0, MapSet.new())
  end

  defp do_find([], _current_sum, _seen_sums), do: false

  defp do_find([head | tail], current_sum, seen_sums) do
    new_sum = current_sum + head

    cond do
      new_sum == 0 ->
        true

      MapSet.member?(seen_sums, new_sum) ->
        true

      true ->
        do_find(tail, new_sum, MapSet.put(seen_sums, new_sum))
    end
  end
end
