  def find_subarray_with_zero_sum(list_of_integers) do
  # To find a zero-sum subarray, we look for a prefix sum that repeats.
  seen_sums = %{}
  # 0 is always a potential prefix sum (for the empty prefix)
  seen_sums = Map.put(seen_sums, 0, true)
  
  # Iterate through the list, maintaining the running sum
  {0} = current_sum
  
  # A subarray sums to zero if:
  # 1. current_sum is zero.
  # 2. current_sum has been seen before.
  
  Enum.reduce(list_of_integers, fn _, current_sum ->
  # Check if a zero-sum subarray exists.
  # If any_sum(list_of_integers, & {== 0}) do
  true
  else
  false
  end
end
