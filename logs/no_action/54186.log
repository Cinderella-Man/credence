defmodule Solution do
  def longest_subarray_length(nums, k) do
    nums
    |> Enum.with_index()
    |> Enum.reduce(%{sum: 0, map: %{0 => -1}, max_len: 0}, fn {num, i}, acc ->
      sum = acc.sum + num
      map = if Map.has_key?(acc.map, sum), do: acc.map, else: Map.put(acc.map, sum, i)
      max_len = case Map.get(map, sum - k) do
        nil -> acc.max_len
        start_index -> max(acc.max_len, i - start_index)
      end
      %{sum: sum, map: map, max_len: max_len}
    end)
    |> Map.get(:max_len)
  end
end
