defmodule Solution do
  @doc """
  Returns the length of the longest contiguous subarray whose elements sum to k.
  If no such subarray exists, returns 0.
  """
  @spec longest_subarray_length(list(integer()), integer()) :: integer()
  def longest_subarray_length(nums, k) do
    Enum.reduce(Enum.with_index(nums), {0, 0, %{0 => -1}}, fn
      {num, idx}, {max_len, current_sum, prefix_map} ->
        new_sum = current_sum + num
        target = new_sum - k
        
        {new_max_len, new_prefix_map} =
          case Map.fetch(prefix_map, target) do
            {:ok, prev_idx} ->
              length = idx - prev_idx
              new_max = max(max_len, length)
              new_map = if Map.has_key?(prefix_map, new_sum), do: prefix_map, else: Map.put(prefix_map, new_sum, idx)
              {new_max, new_map}
            
            :error ->
              new_map = if Map.has_key?(prefix_map, new_sum), do: prefix_map, else: Map.put(prefix_map, new_sum, idx)
              {max_len, new_map}
          end
          
      {new_max_len, new_sum, new_prefix_map}
    end)
  end
end[0m
