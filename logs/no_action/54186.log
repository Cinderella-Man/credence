defmodule Solution do
  @doc """
  Returns the length of the longest contiguous subarray whose elements sum to k.
  If no such subarray exists, returns 0.
  """
  @spec longest_subarray_length(list(integer()), integer()) :: integer()
  def longest_subarray_length(nums, k) do
    # We use Enum.reduce with an accumulator containing:
    # {max_length, current_prefix_sum, prefix_map, current_index}
    # prefix_map maps prefix_sum -> index (the index BEFORE this element was added, i.e., the end of the prefix)
    # Actually, let's map prefix_sum -> index such that the subarray is from index+1 to current_index
    # Standard approach: map[prefix_sum] = index (where the prefix sum was last seen)
    # Initialize with 0 at index -1 (meaning prefix sum 0 before any element)
    
    initial_state = {0, 0, %{0 => -1}, -1}
    
    # We process each number and its index
    {max_length, _, _, _} = 
      Enum.reduce(nums, initial_state, fn
        num, {max_length, current_sum, prefix_map, idx} ->
          new_sum = current_sum + num
          # The index of the current element being processed is idx + 1
          # Wait, let's simplify. 
          # Let the accumulator track: {max_length, current_sum, prefix_map}
          # But we need the index to calculate length.
          # Let's use Enum.with_index to get the index explicitly.
          # However, we can just track the index in the accumulator.
          
          # Let's restart the accumulator logic to be cleaner.
          # Acc: {max_length, current_sum, prefix_map, next_index}
          # In each step:
          # 1. Calculate new_sum
          # 2. Check if (new_sum - k) exists in prefix_map
          # 3. If so, length = next_index - existing_index
          # 4. Update max_length
          # 5. Add new_sum to prefix_map if not present (store next_index)
          # 6. Return new state
          
          target = new_sum - k
          new_max = max_length
          updated_map = prefix_map
          new_idx = idx + 1
          
          case Map.fetch(prefix_map, target) do
            {:ok, prev_index} ->
              length = new_idx - prev_index
              new_max = max(max_length, length)
              updated_map = if Map.has_key?(prefix_map, new_sum), do: prefix_map, else: Map.put(prefix_map, new_sum, new_idx)
              {new_max, new_sum, updated_map, new_idx + 1}
            
            :error ->
              updated_map = if Map.has_key?(prefix_map, new_sum), do: prefix_map, else: Map.put(prefix_map, new_sum, new_idx)
              {new_max, new_sum, updated_map, new_idx + 1}
          end
      end)
      
    # Wait, the above loop logic is slightly flawed in state transition.
    # Let's write it cleanly with a proper reduce that maintains index.
    
    # Reset and rewrite cleanly.
    max_length = 0
    current_sum = 0
    prefix_map = %{0 => -1}
    
    # We can't easily do this in a single Enum.reduce without tuple state.
    # Let's use a tuple state: {max_length, current_sum, prefix_map}
    # But we need index. We can use Enum.with_index.
    
    {max_length, _, _} = 
      Enum.reduce(Enum.with_index(nums), {0, 0, %{0 => -1}}, fn
        {num, idx}, {max_length, current_sum, prefix_map} ->
          new_sum = current_sum + num
          # We want subarray sum k.
          # sum(i..j) = prefix[j] - prefix[i-1] = k
          # prefix[j] - k = prefix[i-1]
          # We are at index idx (0-based). The prefix sum is new_sum.
          # The previous prefix sum index we stored was the index BEFORE the element.
          # If we store index i for prefix_sum, it means the prefix sum ends at index i-1?
          # No, standard: map[prefix_sum] = index (the index of the element that caused this prefix sum).
          # If map has 0 at -1, it means prefix sum 0 exists before index 0.
          # So if current prefix sum is new_sum, and we find target in map at index prev_idx,
          # the subarray is from prev_idx + 1 to idx.
          # Length = idx - prev_idx.
          
          target = new_sum - k
          new_max = max_length
          new_map = prefix_map
          
          case Map.fetch(prefix_map, target) do
            {:ok, prev_idx} ->
              length = idx - prev_idx
              new_max = max(max_length, length)
              # Store new_sum if not already present
              new_map = if Map.has_key?(prefix_map, new_sum), do: prefix_map, else: Map.put(prefix_map, new_sum, idx)
              {new_max, new_sum, new_map}
            
            :error ->
              new_map = if Map.has_key?(prefix_map, new_sum), do: prefix_map, else: Map.put(prefix_map, new_sum, idx)
              {new_max, new_sum, new_map}
          end
      end)
      
    max_length
  end
end

