defmodule Solution do
  def most_frequent_value(nums) do
    freq = Enum.frequencies(nums)
    max_count = freq |> Map.values() |> Enum.max()
    freq
    |> Enum.filter(fn {_k, v} -> v == max_count end)
    |> Enum.min_by(fn {k, _v} -> k end)
    |> elem(0)
  end
end
