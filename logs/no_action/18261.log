@moduledoc """
Identifies the most frequent value in a list of numbers.
In case of a tie, returns the smallest number among those with the highest frequency.
"""

defmodule Solution do
  @doc """
  Returns the most frequent value in the given list of numbers.
  If several numbers share the highest frequency, returns the smallest of them.

  ## Examples

      iex> Solution.most_frequent_value([1, 2, 3, 2, 2, 4, 5, 4, 4, 1])
      2

      iex> Solution.most_frequent_value([7, 8, 9, 7, 10, 10, 10, 8])
      10
  """
  @spec most_frequent_value(list(number())) :: number()
  def most_frequent_value(numbers) do
    frequencies = Enum.frequencies(numbers)

    frequencies
    |> Enum.reduce(fn {value, count}, {max_count, best_value} = _acc ->
      case count > max_count or (count == max_count and value < best_value) do
        true ->
          {count, value}

        false ->
          {max_count, best_value}
      end
    end, {0, :infinity})
    |> elem(1)
  end
end[0m
