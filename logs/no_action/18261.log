  end

  test "returns the smallest when there is a tie" do
    assert Solution.most_frequent_value([7, 8, 9, 7, 10, 10, 10, 8]) == 10
  end

  test "handles multiple ties and returns the smallest" do
    assert Solution.most_frequent_value([15, 15, 16, 16, 17, 18, 18, 18, 19, 19, 20]) == 18
  end
end
