defmodule Solution do
  @doc """
  Counts the number of distinct ways to climb an n-step staircase.

  ## Examples

      iex> Solution.count_step(5)
      13

      iex> Solution.count_step(4)
      7

      iex> Solution.count_step(3)
      4

      iex> Solution.count_step(0)
      0

      iex> Solution.count_step(-1)
      0
  """
  @spec count_step(non_neg_integer()) :: non_neg_integer()
  def count_step(n) when n <= 0, do: 0
  def count_step(1), do: 1
  def count_step(2), do: 2
  def count_step(3), do: 4

  def count_step(n) when is_integer(n) and n > 3 do
    count_step(n - 1) + count_step(n - 2) + count_step(n - 3)
  end
end
