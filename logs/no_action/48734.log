assert integer_frequency([5, 5, 5, 5, 5, 5, 6, 6]) == {5: 6, 6: 2}
assert integer_frequency([11, 11, 22, 33, 33, 33, 44, 44, 44, 44]) == {11: 2, 22: 1, 33: 3, 44: 4}

