  end

  test "example from problem: abcabcbb" do
    assert Solution.longest_distinct_subsequence("abcabcbb") == 3
  end

  test "all same characters: bbbbb" do
    assert Solution.longest_distinct_subsequence("bbbbb") == 1
  end
end
