defmodule Solution do
  @doc """
  Finds the length of the longest substring with all distinct characters.

  Uses a sliding window approach to achieve O(n) time complexity.
  """
  @spec longest_distinct_subsequence(String.t()) :: non_neg_integer()
  def longest_distinct_subsequence(<<>>) do
    0
  end

  def longest_distinct_subsequence(<<char, rest::binary>>) do
    do_longest_distinct_subsequence(rest, [char], 1, 1)
  end

  # Helper function to process the rest of the binary
  defp do_longest_distinct_subsequence(<<>>, _chars_so_far, current_length, max_length) do
    max(current_length, max_length)
  end

  defp do_longest_distinct_subsequence(
         <<char, rest::binary>>,
         chars_so_far,
         current_length,
         max_length
       ) do
    new_max_length = max(current_length, max_length)

    if char in chars_so_far do
      # Find the index of the duplicate character in chars_so_far
      index = Enum.find_index(chars_so_far, &(&1 == char))

      # Calculate the new current length by removing characters from the left
      # up to and including the first occurrence of the duplicate
      chars_removed = index + 1
      new_current_length = current_length - chars_removed

      # Remove the leftmost `chars_removed` characters and add the new character
      new_chars = Enum.drop(chars_so_far, chars_removed) ++ [char]

      do_longest_distinct_subsequence(rest, new_chars, new_current_length, new_max_length)
    else
      # No duplicate, extend the current window
      do_longest_distinct_subsequence(
        rest,
        chars_so_far ++ [char],
        current_length + 1,
        new_max_length
      )
    end
  end
end
