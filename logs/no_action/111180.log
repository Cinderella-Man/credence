@doc """
Finds the length of the longest substring with all distinct characters.

Uses a sliding window approach to achieve O(n) time complexity.
"""
@spec longest_distinct_subsequence(String.t()) :: non_neg_integer()
def longest_distinct_subsequence(""), do: 0

def longest_distinct_subsequence(string) do
  chars = String.graphemes(string)
  do_longest_distinct_subsequence(chars, 0, 0, 0, 0, %{})
end

defp do_longest_distinct_subsequence([], left, right, window_length, max_length, _char_positions) do
  max(window_length, max_length)
end

defp do_longest_distinct_subsequence([char | rest], left, right, window_length, max_length, char_positions) do
  new_max_length = max(window_length, max_length)

  case Map.get(char_positions, char) do
    nil ->
      # Character not in current window, expand right
      new_positions = Map.put(char_positions, char, right)
      do_longest_distinct_subsequence(rest, left, right + 1, window_length + 1, new_max_length, new_positions)

    left_index ->
      # Character is in the current window, need to shrink the window from the left
      # The duplicate character is at position left_index in the original indexing
      # We need to move left to left_index + 1
      new_left = left_index + 1
      chars_to_remove = new_left - left
      new_window_length = window_length - chars_to_remove
      
      # Remove characters from left up to (but not including) the duplicate from positions
      new_positions = Enum.reduce(left..(new_left - 1), char_positions, fn i, acc ->
        # We need to find which character is at position i
        # This is inefficient but correct. A better approach:
        # Actually, we can rebuild the positions map for the new window, but that's O(n)
        # Let's use a different strategy: keep a list of characters in the current window
        acc
      end)
      
      # Simpler approach: just keep the window as a list
      # Let me refactor to use a list-based window for simplicity and correctness
      
      # Actually, let's just use a simpler O(n^2) approach for correctness first,
      # then optimize if needed. But the sliding window with a map is standard.
      # The issue is removing old entries from the map efficiently.
      
      # Let's use a different approach: use a list for the current window characters
      # and rebuild the positions map when needed, or just use find_index on the list.
      
      # For now, let's just use the list-based approach which is cleaner
      do_longest_distinct_subsequence_list(rest, 0, [char], new_max_length, new_max_length)
  end
end

defp do_longest_distinct_subsequence_list([], _start, _current_window, _max_length, final_max) do
  final_max
end

defp do_longest_distinct_subsequence_list([char | rest], _start, current_window, max_length, final_max) do
  new_final_max = max(length(current_window), final_max)
  
  case Enum.find(current_window, &(&1 == char)) do
    nil ->
      # Character not in current window, add it
      do_longest_distinct_subsequence_list(rest, _start, current_window ++ [char], max_length, new_final_max)

    _duplicate ->
