  use ExUnit.Case, async: false

  test "example from problem: pwwkew" do
    assert Solution.longest_distinct_subsequence("pwwkew") == 3
  end

  test "example from problem: abcabcbb" do
    assert Solution.longest_distinct_subsequence("abcabcbb") == 3
  end

  test "all same characters: bbbbb" do
    assert Solution.longest_distinct_subsequence("bbbbb") == 1
  end
end
---REFERENCE---
defmodule Solution do
  def longest_distinct_subsequence(s) do
    chars = s |> String.graphemes() |> Enum.with_index()

    {_start, max_length, _used_char} =
      Enum.reduce(chars, {0, 0, %{}}, fn {char, i}, {start, max_length, used_char} ->
        {new_start, new_max} =
          if Map.has_key?(used_char, char) and start <= Map.get(used_char, char) do
            {Map.get(used_char, char) + 1, max_length}
          else
            {start, max(max_length, i - start + 1)}
          end

        {new_start, new_max, Map.put(used_char, char, i)}
      end)

    max_length
  end
end
