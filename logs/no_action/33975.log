@doc """
  Returns a list of all leader elements in the order they appear in the input list.
  An element is a leader if it is greater than or equal to every element to its right.
  """
  @spec get_leaders([number()]) :: [number()]
  def get_leaders([]), do: []

  def get_leaders([last]), do: [last]

  def get_leaders(numbers) do
    # Process from right to left, tracking the maximum seen so far
    # Elements that are >= max_so_far are leaders
    {leaders, _} =
      numbers
      |> Enum.reverse()
      |> Enum.reduce({[], -Float.infinity()}, fn
        num, {acc, max_so_far} when num >= max_so_far ->
          { [num | acc], num }
        _, {acc, max_so_far} ->
          { acc, max_so_far }
      end)

    # The result is in reverse order (since we processed from right to left)
    # But wait, we built the list by prepending, so it's already in the order
    # of discovery from right to left. We need to reverse it back to original order.
    Enum.reverse(leaders)
  end
end[0m
