defmodule Solution do
  def get_leaders(list) do
    [first | rest] = Enum.reverse(list)

    Enum.reduce(rest, {first, [first]}, fn x, {max_seen, acc} ->
      if x >= max_seen do
        {x, [x | acc]}
      else
        {max_seen, acc}
      end
    end)
    |> elem(1)
  end
end

