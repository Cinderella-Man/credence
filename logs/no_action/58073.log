  test "ways to climb 3 steps" do
    assert Solution.waystoclimb(3) == 3
  end

  test "ways to climb 5 steps" do
    assert Solution.waystoclimb(5) == 8
  end

  test "ways to climb 4 steps" do
    assert Solution.waystoclimb(4) == 5
  end
end
