defmodule Solution do
  @doc """
  Returns the number of distinct ways to climb a staircase of `n` steps,
  where you can take either 1 or 2 steps at a time.

  For n = 0, returns 0.
  For n = 1, returns 1.
  For n = 2, returns 2.
  For n >= 3, computes iteratively in O(n) time and O(1) space.
  """
  @spec waystoclimb(non_neg_integer()) :: non_neg_integer()
  def waystoclimb(0), do: 0
  def waystoclimb(1), do: 1
  def waystoclimb(2), do: 2

  def waystoclimb(n) when is_integer(n) and n >= 3 do
    Enum.reduce(3..n, {1, 2}, fn _, {prev_prev, prev} ->
      {prev, prev_prev + prev}
    end)
    |> elem(1)
  end
end
