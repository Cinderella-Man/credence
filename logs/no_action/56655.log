defmodule Solution do
  @doc """
  Returns the maximum number of consecutive 1's after changing at most one 0 to 1.
  """
  @spec maxconsecutiveones(list(0 | 1)) :: non_neg_integer()
  def maxconsecutiveones(nums) do
    do_max_consecutive_ones(nums, 0, 0, 0, 0)
  end

  defp do_max_consecutive_ones([], _left, _right, zero_count, max_length) do
    max_length
  end

  defp do_max_consecutive_ones(nums, left, right, zero_count, max_length) do
    if right == length(nums) do
      max_length
    else
      new_zero_count =
        if Enum.at(nums, right) == 0, do: zero_count + 1, else: zero_count

      {new_left, new_zero_count} =
        adjust_left(nums, left, new_zero_count)

      current_length = right - new_left + 1
      new_max = max(max_length, current_length)

      do_max_consecutive_ones(nums, new_left, right + 1, new_zero_count, new_max)
    end
  end

  defp adjust_left(nums, left, zero_count) when zero_count > 1 do
    new_zero_count = if Enum.at(nums, left) == 0, do: zero_count - 1, else: zero_count
    adjust_left(nums, left + 1, new_zero_count)
  end

  defp adjust_left(_nums, left, zero_count) do
    {left, zero_count}
  end
end

