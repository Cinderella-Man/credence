defmodule Solution do
  @doc """
  Given a list of integers (each element is either 0 or 1), return the maximum
  number of consecutive 1's that can be obtained by flipping at most one 0 to 1.

  Uses a sliding window approach with O(n) time and O(1) extra space.
  """
  @spec maxconsecutiveones(list(integer)) :: non_neg_integer
  def maxconsecutiveones(list) when is_list(list) do
    do_max_consecutive_ones(list, 0, 0, 0)
  end

  # State: {left, right, max_len, zeros_count}
  # Actually, let's use a simpler recursion:
  # We iterate through the list, maintaining a window [left, right].
  # right is the current index being considered.
  # If zeros > 1, we increment left until zeros == 1.

  # Helper that passes the current window boundaries and max seen.
  # Since we can't easily do index arithmetic in pure recursion without passing the list and indices,
  # let's use a different strategy: collect all segments of 1s separated by 0s.
  # Then the answer is max(
  #   sum of all segments (if no zeros),
  #   sum of adjacent segments + 1 (if flipping a zero between them)
  # )

  def maxconsecutiveones_v2(list) do
    if Enum.empty?(list) do
      0
    else
      segments = collect_segments(list, 0)
      compute_max_sequential_ones(segments)
    end
  end

  defp collect_segments([], count) do
    if count > 0 do
      [count]
    else
      []
    end
  end

  defp collect_segments([0 | rest], count) do
    if count > 0 do
      [count | collect_segments(rest, 0)]
    else
      collect_segments(rest, 0)
    end
  end

  defp collect_segments([1 | rest], count) do
    collect_segments(rest, count + 1)
  end

  defp compute_max_sequential_ones([]), do: 0

  defp compute_max_sequential_ones([_only_segment]), do: _only_segment

  defp compute_max_sequential_ones([seg1, seg2 | rest]) do
    # Option 1: Just seg1
    opt1 = seg1

    # Option 2: Just seg2
    opt2 = seg2

    # Option 3: Flip the zero between seg1 and seg2
    opt3 = seg1 + seg2 + 1

    current_max = max(opt1, max(opt2, opt3))

    # Also need to consider if there are more segments after.
    # The result for the rest of the list starting from seg2 might involve seg2 and seg3.
    rest_max = compute_max_sequential_ones([seg2 | rest])

    max(current_max, rest_max)
  end
end

