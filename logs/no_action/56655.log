  def maxconsecutiveones(nums) do
    tuple = List.to_tuple(nums)
    size = tuple_size(tuple)
    do_slide(tuple, size, 0, 0, 0, 0)
  end

  defp do_slide(_tuple, size, right, _left, _zero_count, max_length) when right >= size do
    max_length
