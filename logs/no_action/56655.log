defmodule Solution do
  @doc """
  Given a list of integers (each element is either 0 or 1), return the maximum
  number of consecutive 1's that can be obtained by flipping at most one 0 to 1.
  """
  @spec maxconsecutiveones(list(integer)) :: non_neg_integer
  def maxconsecutiveones(list) do
    {_, max_len} =
      Enum.reduce(
        list,
        {0, 0, 0, 0, 0},
        fn
          1, {left, right, max_len, _zeros_count, _zeros_before} ->
            new_right = right + 1
            new_zeros_before = _zeros_before + 1
            {left, new_right, max(max_len, new_right - left + 1), 0, new_zeros_before}

          0, {left, right, max_len, zeros_count, zeros_before} ->
