  defp do_slide(tuple, size, right, left, zero_count, max_length) do
    new_zero = if elem(tuple, right) == 0, do: zero_count + 1, else: zero_count
    {new_left, new_zero} = shrink_left(tuple, left, new_zero)
    current_length = right - new_left + 1
    new_max = max(max_length, current_length)
    do_slide(tuple, size, right + 1, new_left, new_zero, new_max)
  end

  defp shrink_left(_tuple, left, zero_count) when zero_count <= 1 do
    {left, zero_count}
  end

  defp shrink_left(tuple, left, zero_count) do
    new_zero = if elem(tuple, left) == 0, do: zero_count - 1, else: zero_count
    shrink_left(tuple, left + 1, new_zero)
  end
