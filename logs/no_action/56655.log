defmodule Solution do
  @doc """
  Given a list of integers (each element is either 0 or 1), return the maximum
  number of consecutive 1's that can be obtained by flipping at most one 0 to 1.

  Uses a sliding window approach with O(n) time and O(1) extra space.
  """
  @spec maxconsecutiveones(list(integer)) :: non_neg_integer
  def maxconsecutiveones(list) when is_list(list) do
    case list do
      [] ->
        0

      [0 | _rest] = list ->
        # Count leading zeros to skip them initially
        {leading_zeros_count, rest} = skip_leading_zeros(list, 0)
        case rest do
          [] ->
            leading_zeros_count

          _ ->
            do_max_consecutive_ones(rest, 0, 0, leading_zeros_count, 0)
        end

      _list ->
        do_max_consecutive_ones(list, 0, 0, 0, 0)
    end
  end

  defp skip_leading_zeros([0 | tail], count), do: skip_leading_zeros(tail, count + 1)
  defp skip_leading_zeros([], count), do: {count, []}
  defp skip_leading_zeros(head = [_ | _], count), do: {count, head}

  # Main recursive sliding window function
  # current_window_len: length of the current valid window (at most 1 zero)
  # max_len: maximum window length seen so far
  # zeros_in_window: number of zeros in the current window
  # zeros_before: number of consecutive 1s immediately preceding the current window
  #               (used when we need to shrink the window from the left)
  defp do_max_consecutive_ones([], max_len, _zeros_in_window, _zeros_before, current_window_len) do
    max(max_len, current_window_len)
  end

  defp do_max_consecutive_ones([0 | tail], max_len, zeros_in_window, zeros_before, current_window_len) do
    new_zeros_in_window = zeros_in_window + 1
    new_window_len = current_window_len + 1

    if new_zeros_in_window > 1 do
      # We have two zeros now. We need to shrink the window from the left.
      # The window currently includes the previous zeros_before 1s, the previous zero, and the new zero.
      # After shrinking, the new window should start right after the first zero.
      # The new window will start with the zeros_before 1s, then the second zero.
      # So the new current_window_len will be zeros_before + 1 (just the second zero).
      # And new_zeros_before will be zeros_before.
      new_window_len_after_shrink = zeros_before + 1
      new_max_len = max(max_len, new_window_len_after_shrink)
      do_max_consecutive_ones(tail, new_max_len, 1, zeros_before, new_window_len_after_shrink)
    else
      # Valid window, just expand
      new_max_len = max(max_len, new_window_len)
      do_max_consecutive_ones(tail, new_max_len, new_zeros_in_window, 0, new_window_len)
    end
  end

  defp do_max_consecutive_ones([1 | tail], max_len, zeros_in_window, zeros_before, current_window_len) do
    new_window_len = current_window_len + 1
    new_zeros_before = zeros_before + 1
    new_max_len = max(max_len, new_window_len)
    do_max_consecutive_ones(tail, new_max_len, zeros_in_window, new_zeros_before, new_window_len)
  end
end
