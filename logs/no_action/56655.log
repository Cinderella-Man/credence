defmodule Solution do
  @doc """
  Given a list of integers (each element is either 0 or 1), return the maximum
  number of consecutive 1's that can be obtained by flipping at most one 0 to 1.

  Uses a sliding window approach with O(n) time and O(1) extra space.
  """
  @spec maxconsecutiveones(list(integer)) :: non_neg_integer
  def maxconsecutiveones([]), do: 0

  def maxconsecutiveones(list) when is_list(list) do
    # Sliding window: maintain a window where at most one 0 is allowed
    # left = left boundary of window
    # right = right boundary of window (exclusive in some conventions, but we'll use inclusive)
    # zero_count = number of zeros in current window
    # max_len = maximum window size seen

    max_len = do_max_consecutive_ones(list, 0, 0, 0, length(list))
    max_len
  end

  # When right goes past the end, we're done
  defp do_max_consecutive_ones(_list, _left, _right, zero_count, total_len) when _right >= total_len and zero_count <= 1 do
    # Window is valid, return its size
    _right - _left
  end

  defp do_max_consecutive_ones(_list, _left, _right, zero_count, total_len) when _right >= total_len and zero_count > 1 do
    # This shouldn't happen if we shrink properly, but just in case
    0
  end

  defp do_max_consecutive_ones(list, left, right, zero_count, total_len) do
    case Enum.at(list, right) do
      0 ->
        new_zero_count = zero_count + 1
        # If we now have more than one zero, shrink from the left
        if new_zero_count > 1 do
          # Shrink left until zero_count <= 1
          {new_left, new_zero_count} = shrink_left(list, left, right, zero_count)
          do_max_consecutive_ones(list, new_left, right, new_zero_count, total_len)
        else
          # Valid window, expand right
          do_max_consecutive_ones(list, left, right + 1, new_zero_count, total_len)
        end

      1 ->
        # No new zero, just expand
        do_max_consecutive_ones(list, left, right + 1, zero_count, total_len)
    end
  end

  # Shrink from the left until zero_count <= 1
  # Returns {new_left, new_zero_count}
  defp shrink_left(_list, left, _right, zero_count) when zero_count <= 1 do
    {left, zero_count}
  end

  defp shrink_left(list, left, _right, zero_count) do
    item_at_left = Enum.at(list, left)
    new_left = left + 1
    new_zero_count = if item_at_left == 0, do: zero_count - 1, else: zero_count
    shrink_left(list, new_left, _right, new_zero_count)
  end
end
