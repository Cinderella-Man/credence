  @doc """
  Calculates the determinant of a square matrix.

  The matrix is represented as a list of lists of numbers.
  For a 1x1 matrix, returns the single element.
  For larger matrices, uses cofactor expansion along the first row.
  """
  @spec determinant([[number]]) :: number
  def determinant([[val]]), do: val

  def determinant(matrix) do
