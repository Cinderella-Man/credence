  def determinant(matrix) do
    case matrix do
      [[val]] ->
        val

      [_ | _] = mat ->
        {first_row, _rest} = Enum.split(mat, 1)
        row = List.first(mat)

        row
        |> Enum.with_index()
        |> Enum.reduce(0, fn {element, col_idx}, acc ->
