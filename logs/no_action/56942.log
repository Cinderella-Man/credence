defmodule Solution do
  @doc """
  Calculates the determinant of a square matrix.

  The matrix is represented as a list of lists of numbers.
  For a 1x1 matrix, returns the single element.
  For larger matrices, uses cofactor expansion along the first row.
  """
  @spec determinant([[number]]) :: number
  def determinant([[val]]), do: val

  def determinant(matrix) do
    matrix
    |> Enum.with_index()
    |> Enum.reduce(0, fn {row, row_idx}, acc ->
      col_idx = 0
      {element, _row} = Enum.at(matrix, row_idx) |> Enum.with_index() |> Enum.find(fn {_val, idx} -> idx == col_idx end)

      # Actually, let's just iterate over the first row properly
      nil
    end)
    # The above is messy. Let me rewrite cleanly.
  end

  # Actually, let me rewrite the whole function cleanly
  @spec determinant([[number]]) :: number
  def determinant(matrix) do
    case matrix do
      [[val]] ->
        val

      [_ | _] = mat ->
        {first_row, _rest} = Enum.split(mat, 1)
        row = List.first(mat)

        row
        |> Enum.with_index()
        |> Enum.reduce(0, fn {element, col_idx}, acc ->
          sign = if rem(col_idx, 2) == 0, do: 1, else: -1
          minor = remove_row_and_column(mat, 0, col_idx)
          acc + sign * element * determinant(minor)
        end)
    end
  end

  @doc """
  Removes the row at `row_idx` and the column at `col_idx` from the matrix.
  """
  @spec remove_row_and_column([[number]], integer(), integer()) :: [[number]]
  defp remove_row_and_column(matrix, row_idx, col_idx) do
