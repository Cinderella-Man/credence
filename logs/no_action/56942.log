defmodule Solution do
  @doc """
  Calculates the determinant of a square matrix.
  """
  def determinant([[a]]), do: a
  def determinant([[a, b], [c, d]]), do: a * d - b * c
  def determinant(matrix) do
    matrix
    |> List.first()
    |> Enum.with_index()
    |> Enum.reduce(0, fn {elem, j}, acc ->
      minor =
        matrix
        |> tl()
        |> Enum.map(fn row -> List.delete_at(row, j) end)
      sign = if rem(j, 2) == 0, do: 1, else: -1
      acc + sign * elem * determinant(minor)
    end)
  end
end
