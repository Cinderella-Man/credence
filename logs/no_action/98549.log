defmodule Solution do
  @spec isvalidurl(String.t()) :: boolean()
  def isvalidurl(url) do
    regex =
      ~r/^(http|https):\/\/[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)+(\/[a-zA-Z0-9.,@:%_\+~#?&\/\/=]*)?$/

    Regex.match?(regex, url)
  end
end
