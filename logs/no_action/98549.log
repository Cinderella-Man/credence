---MODULE---
defmodule Solution do
  @doc """
  Checks whether a given string is a valid URL.

  A valid URL must:
  - Start with `http://` or `https://`
  - Be followed by a domain name with at least one label
  - Optionally include a path, query string, or fragment identifier
  """
  @spec isvalidurl(String.t()) :: boolean()
  def isvalidurl(url) when is_binary(url) do
    # Must start with http:// or https://
    case URI.parse(url) do
      %{scheme: "http", host: host} when is_binary(host) and byte_size(host) > 0 ->
        valid_domain?(host)

      %{scheme: "https", host: host} when is_binary(host) and byte_size(host) > 0 ->
        valid_domain?(host)

      %{scheme: "http", host: nil} ->
        false

      %{scheme: "https", host: nil} ->
        false

      _other ->
        false
    end
  end

  def isvalidurl(_other), do: false

  @doc """
  Validates that a host string is a properly formed domain name.

  A domain consists of one or more labels separated by dots.
  Each label must contain only alphanumeric characters or hyphens,
  and must not be empty.
  """
  @spec valid_domain?(String.t()) :: boolean()
  defp valid_domain?(host) when is_binary(host) do
    # Split by dots and validate each label
    labels = String.split(host, ".", trim: true)

    labels
    |> Enum.all?(&valid_label?/1)
  end

  @doc """
  Checks if a single domain label is valid.
  Labels must contain only alphanumeric characters and hyphens,
  and must not be empty.
  """
  @spec valid_label?(String.t()) :: boolean()
  defp valid_label?(label) when is_binary(label) do
    byte_size(label) > 0 and
      Regex.match?(~r/^[a-zA-Z0-9\-]+$/, label)
  end
end
