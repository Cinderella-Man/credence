    assert Solution.consecutive_subsequence([8, 9, 10]) == true
  end

  test "returns false for duplicate numbers" do
    assert Solution.consecutive_subsequence([1, 1, 2, 3]) == true
  end

  test "returns true for longer consecutive sequence" do
    assert Solution.consecutive_subsequence([4, 5, 6, 7, 10]) == true
  end

  test "returns false for descending consecutive" do
    assert Solution.consecutive_subsequence([5, 4, 3]) == false
  end
end
---REFERENCE---
defmodule Solution do
  @spec consecutive_subsequence(list(integer)) :: boolean
  def consecutive_subsequence([]), do: false
  def consecutive_subsequence([_]), do: false
  def consecutive_subsequence([_, _]), do: false
  def consecutive_subsequence(nums) do
    nums
    |> Enum.chunk_while(
         nil,
         fn
           x, nil -> {:cont, [x]}
           x, [prev | _] = acc when x == prev + 1 -> {:cont, [x | acc]}
           x, acc -> {:cont, acc, [x]}
         end,
         fn acc -> {:cont, acc, []} end
       )
    |> Enum.any?(fn sub -> length(sub) >= 3 end)
  end
end
