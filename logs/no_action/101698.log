---MODULE---
defmodule Solution do
  @doc """
  Returns true if the list contains at least one subsequence of consecutive
  strictly increasing integers of length three or more.
  """
  @spec consecutive_subsequence(list(integer())) :: boolean()
  def consecutive_subsequence(list) when is_list(list) do
    case preprocess(list) do
      [] -> false
      [head | _] -> has_consecutive?(head, 0, 1, list)
    end
  end

  # Remove duplicates while preserving order for the purpose of finding runs
  # But actually, we need to process the list as-is but skip non-consecutive jumps.
  # Let's just iterate through the list and track the current run.

  defp has_consecutive?(_prev, _run_length, _min_required, []) do
    false
  end

  defp has_consecutive?(_prev, run_length, min_required, [last | []]) when run_length < min_required do
    false
  end

  defp has_consecutive?(_prev, run_length, _min_required, [_last | _rest]) when run_length >= 3 do
    true
  end

  defp has_consecutive?(prev, run_length, min_required, [curr | rest]) do
    if curr == prev + 1 do
      has_consecutive?(curr, run_length + 1, min_required, rest)
    else
      # Reset the run
      has_consecutive?(curr, 1, min_required, rest)
    end
  end

  # Helper to handle the initial state
  defp preprocess([]), do: []
  defp preprocess([head | tail]), do: [head | tail]
end
