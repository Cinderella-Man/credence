  use ExUnit.Case, async: false

  test "returns false when a phone number is prefix of another" do
    assert Solution.check_phone_prefix(["12", "123", "1523", "567", "88"]) == false
  end

  test "returns true when no phone number is prefix of another" do
    assert Solution.check_phone_prefix(["123", "456", "789"]) == true
  end

  test "returns false for overlapping prefixes" do
    assert Solution.check_phone_prefix(["119", "97674223", "1195524421"]) == false
  end
end
