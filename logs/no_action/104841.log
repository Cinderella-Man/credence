---MODULE---
defmodule Solution do
  @doc """
  Checks whether any phone number in the list is a prefix of another phone number in the list.

  Returns `false` if such a prefix relationship exists, and `true` otherwise.

  ## Examples

      iex> Solution.check_phone_prefix(["12", "123"])
      false

      iex> Solution.check_phone_prefix(["123", "456"])
      true

      iex> Solution.check_phone_prefix([])
      true
  """
  @spec check_phone_prefix([String.t()]) :: boolean()
  def check_phone_prefix(phone_numbers) when is_list(phone_numbers) do
    case phone_numbers do
      [] ->
        true

      [_single] ->
        true

      _ ->
        sorted = Enum.sort(phone_numbers)

        # Check adjacent pairs in the sorted list.
        # If A is a prefix of B, and both A and C are prefixes of B (or vice versa),
        # then in a sorted list, A will appear immediately before or near the number
        # that has A as a prefix. Specifically, if A is a prefix of C, and we sort
        # lexicographically, A will come before C. If there's a B between them such
        # that A < B < C, then A must also be a prefix of B (because B starts with A
        # since A is a prefix of C and A < B < C lexicographically).
        #
        # So we only need to check if any element is a prefix of its immediate successor.
        do_check_prefix(sorted)
    end
  end

  defp do_check_prefix(_list), do: true

  defp do_check_prefix([_last]), do: true

  defp do_check_prefix([first | [second | _rest]] = _rest_tail) do
    if String.starts_with?(second, first) do
      false
    else
      do_check_prefix([second | tl(rest_tail(_rest_tail))])
    end
  end

  defp rest_tail(list) do
    case tl(list) do
      [] -> []
      [_ | tail] -> tail
    end
  end
end
---TEST---
