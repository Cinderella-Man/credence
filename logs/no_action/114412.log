    else
      grid
      |> Enum.with_index(fn row, i ->
        row
        |> Enum.with_index(fn height, j ->
          calculate_surface(height, grid, i, j, rows, cols)
        end)
      end)
      |> Enum.map(&Enum.sum/1)
      |> Enum.sum()
    end
  end

