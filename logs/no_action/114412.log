defmodule Solution do
  @doc """
  Computes the total exposed surface area of a 3D shape made of unit cubes.
  """
  @spec surface_area(list(list(non_neg_integer))) :: non_neg_integer
  def surface_area([]) do
    0
  end

  def surface_area(grid) do
    total_cubes = Enum.sum(Enum.map(grid, &Enum.sum/1))
    total_faces = total_cubes * 6

    # Hidden faces from vertical stacking (within a cell)
    vertical_stack_hidden = Enum.sum(Enum.map(grid, fn row ->
      Enum.sum(Enum.map(row, fn h ->
        if h > 0, do: h - 1, else: 0
      end))
    end))

    # Hidden faces from horizontal neighbors (within a row)
    horizontal_neighbor_hidden = Enum.sum(Enum.map(grid, &count_horizontal_hidden/1))

    # Hidden faces from vertical neighbors (between rows)
    # Transpose to get columns, then count vertical neighbors
