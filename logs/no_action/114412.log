defmodule Solution do
  def surface_area(grid) do
    rows = length(grid)
    cols = if rows > 0, do: length(hd(grid)), else: 0

    for i <- 0..rows-1, j <- 0..cols-1, reduce: 0 do
      acc ->
        h = grid |> Enum.at(i) |> Enum.at(j)
        area = if h > 0, do: 4 * h + 2, else: 0

        area = if i > 0 do
          h_above = grid |> Enum.at(i-1) |> Enum.at(j)
          area - 2 * min(h, h_above)
        else
          area
        end

        area = if j > 0 do
          h_left = grid |> Enum.at(i) |> Enum.at(j-1)
          area - 2 * min(h, h_left)
        else
          area
        end

        acc + area
    end
  end
end

