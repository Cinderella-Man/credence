  Computes the total exposed surface area of a 3D shape made of unit cubes.
  The grid is represented as a list of lists (rows of integers), where each
  integer represents the height of a column of cubes at that grid position.
  """
  def surface_area(grid) when is_list(grid) do
    if grid == [] do
      0
    else
      area(grid)
    end
  end

  defp area(grid) do
    rows = length(grid)
    cols = if rows > 0 do
      hd(grid) |> length()
    else
      0
    end

