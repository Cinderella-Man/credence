defmodule Solution do
  @doc """
  Computes the total exposed surface area of a 3D shape made of unit cubes.
  """
  @spec surface_area(list(list(non_integer))) :: non_integer
  def surface_area(grid) when is_list(grid) do
    case grid do
      [] ->
        0
      _ ->
        rows = length(grid)
        cols = if rows > 0, do: length(hd(grid)), else: 0

        if rows == 0 or cols == 0 do
          0
        else
          total_cubes = Enum.sum(List.flatten(grid))
          total_faces = total_cubes * 6

          # Count hidden faces due to vertical stacking (within same column)
          # For each cell, if h > 0, there are (h-1) vertical internal faces.
          # Each internal face hides 2 faces (top of bottom, bottom of top).
          vertical_pairs = Enum.sum(
            grid
            |> Enum.map(fn row ->
              Enum.sum(Enum.map(row, fn h ->
                if h > 0, do: h - 1, else: 0
              end))
            end)
          )

          # Count hidden faces due to horizontal neighbors (within same row)
          horizontal_neighbor_pairs = Enum.sum(
            grid
            |> Enum.map(fn row ->
              Enum.reduce(
                Enum.chunk_every(row, 2, 1, []),
                0,
                fn [h1, h2], acc ->
                  acc + min(h1, h2)
                end
              )
            end)
            |> elem(0, 0) # This approach is flawed with reduce on list of lists
          )
          
          # Let's redo horizontal neighbor pairs properly
          horizontal_neighbor_pairs = Enum.sum(
            grid
            |> Enum.map(fn row ->
              case row do
                [] -> 0
                [h] -> 0
                _ ->
                  Enum.reduce(
                    Enum.chunk_every(row, 2, 1),
                    0,
                    fn [h1, h2], acc ->
                      acc + min(h1, h2)
                    end
                  )
              end
            end)
          )

          # Count hidden faces due to vertical neighbors (between rows, same column)
          # We transpose the grid to get columns, then look at adjacent rows in each column
          # Actually, it's easier to iterate row by row and compare with previous row
          # For each column j, and row i, compare grid[i][j] with grid[i+1][j]
          # This is "vertical neighbors" between rows.
          
          vertical_neighbor_pairs = Enum.sum(
