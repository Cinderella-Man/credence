defmodule Solution do
  @doc """
  Computes the total exposed surface area of a 3D shape made of unit cubes.
  """
  @spec surface_area(list(list(non_neg_integer))) :: non_neg_integer
  def surface_area(grid) when is_list(grid) do
    if Enum.empty?(grid) do
      0
    else
      # Calculate total cubes and total faces (assuming isolated cubes)
      total_cubes = Enum.sum(Enum.map(grid, &Enum.sum/1))
      total_faces = total_cubes * 6

      # Calculate hidden faces due to vertical stacking in the same column
      # Each cube on top of another hides 2 faces (the bottom of the top cube and the top of the bottom cube).
      # If height is h, there are h-1 such interfaces.
      vertical_stack_hidden = Enum.sum(Enum.map(grid, fn row ->
        Enum.sum(Enum.map(row, fn h ->
          if h > 0, do: h - 1, else: 0
        end))
      end))

      # Calculate hidden faces due to horizontal neighbors in the same row
      # If two adjacent cells have heights h1 and h2, the shared face is min(h1, h2).
      # Each shared face hides 2 faces (one from each cube).
      horizontal_neighbor_hidden = Enum.sum(Enum.map(grid, fn row ->
        case row do
          [] -> 0
          [h] -> 0
          _ ->
            Enum.zip(row, Enum.tail(row))
            |> Enum.sum(fn {h1, h2} -> min(h1, h2) end)
        end
      end))

      # Calculate hidden faces due to vertical neighbors (rows) in the same column
      # We transpose the grid to get columns, then apply the same horizontal neighbor logic.
      # Or, simpler: iterate through columns, then adjacent rows.
      # Let's use the transpose approach.
      transposed = Enum.zip(grid)
      
      vertical_row_neighbor_hidden = Enum.sum(Enum.map(transposed, fn col ->
        case col do
          [] -> 0
          [h] -> 0
          _ ->
            Enum.zip(col, Enum.tail(col))
            |> Enum.sum(fn {h1, h2} -> min(h1, h2) end)
        end
      end))

      total_hidden = 2 * vertical_stack_hidden + 2 * horizontal_neighbor_hidden + 2 * vertical_row_neighbor_hidden

      total_faces - total_hidden
    end
  end
end[0m
