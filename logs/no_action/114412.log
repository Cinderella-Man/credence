defmodule Solution do
  @doc """
  Computes the total exposed surface area of a 3D shape made of unit cubes.
  """
  @spec surface_area(list(list(non_neg_int))) :: non_neg_int
  def surface_area(grid) when is_list(grid) do
    if grid == [] do
      0
    else
      rows = length(grid)
      cols = if rows > 0, do: hd(grid) |> length(), else: 0

      if rows == 0 or cols == 0 do
        0
      else
        total_cubes = Enum.sum(List.flatten(grid))
        total_faces = total_cubes * 6

        # Count vertical pairs (within each column)
        vertical_pairs = Enum.sum(
          grid
          |> Enum.map(fn row ->
            Enum.sum(row) |> fn(h) -> if h > 0, do: h - 1, else: 0 end.()
            # Actually simpler: sum of max(0, h-1) for each cell
          end)
        )
        # Let's recalculate vertical pairs properly
        vertical_pairs = Enum.sum(
          grid
          |> Enum.map(fn row ->
            Enum.sum(Enum.map(row, fn h -> if h > 0, do: h - 1, else: 0 end))
          end)
        )

        # Count horizontal neighbor pairs (within each row)
        horizontal_neighbor_pairs = Enum.sum(
          grid
          |> Enum.map(fn row ->
            Enum.sum(Enum.chunk_every(row, 2, 1, [:discard]) |> Enum.map(fn [h1, h2] -> min(h1, h2) end))
          end)
        )

        # Count vertical neighbor pairs (between rows)
        vertical_neighbor_pairs = Enum.sum(
          Enum.map(Enum.chunk_every(grid, 2, 1, [:discard]), fn [row1, row2] ->
            Enum.zip(row1, row2)
            |> Enum.map(fn {h1, h2} -> min(h1, h2) end)
            |> Enum.sum()
          end)
        )

        hidden_faces = 2 * vertical_pairs + 2 * (horizontal_neighbor_pairs + vertical_neighbor_pairs)
        total_faces - hidden_faces
      end
    end
  end
end
