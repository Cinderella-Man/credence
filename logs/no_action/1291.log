defmodule Solution do
  def find_largest_within_threshold(nums, threshold) do
    Enum.reduce(nums, nil, fn num, acc ->
      if num <= threshold do
        case acc do
          nil -> num
          _ -> max(num, acc)
        end
      else
        acc
      end
    end)
  end
end
