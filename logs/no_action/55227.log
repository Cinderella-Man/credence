@moduledoc """
Given a binary string, returns the number of distinct non-empty subsequences
modulo 10^9 + 7.

A subsequence is formed by deleting zero or more characters from the string
without changing the order of the remaining characters.
Two subsequences are distinct if they are formed from different sets of indices,
even if the resulting strings are the same.
"""

defmodule Solution do
  @moduledoc false
  @doc """
  Returns the number of distinct non-empty subsequences of the given binary string,
  modulo 10^9 + 7.
  """
  @spec find_distinct_subsequences(binary()) :: non_neg_integer()
  def find_distinct_subsequences(<<>>) do
    0
  end

  def find_distinct_subsequences(binary) do
    modulo = 1_000_000_007

    # Convert binary to list of char codes for easier processing
    chars = binary_to_codes(binary)
    len = length(chars)

    # dp[i] = number of distinct subsequences using first i characters (including empty)
    # We use a map to store the last occurrence of each character to handle duplicates efficiently.
    # When we encounter a character that was seen before, we subtract the count of subsequences
    # that ended with the previous occurrence of that character.

    # Let dp be the number of distinct subsequences including the empty one.
    # Initially, dp = 1 (just the empty subsequence)
    # For each character c at position i:
    #   new_dp = dp * 2
    #   If c was seen before at position prev, then we subtract dp_at_prev_time * 2 + 1... 
    #   Actually, the standard approach:
    #   dp[i] = 2 * dp[i-1]
    #   If char c appeared last at index j, then dp[j-1] subsequences when c was added would be duplicated.
    #   So we subtract dp[j-1] where dp[j-1] is the dp value right before the previous occurrence.
    
    # More precisely:
    # Let dp = 1 (empty subsequence)
    # last_seen = Map.new()  # char -> the dp value right before its last addition
    # For each char c in string:
    #   new_dp = dp * 2 % mod
    #   if c in last_seen:
    #     subtract = last_seen[c]
    #     new_dp = (new_dp - subtract + mod) % mod
    #   last_seen[c] = dp  # Save the current dp before updating (this is dp before adding c)
    #   dp = new_dp
    
    # At the end, dp includes the empty subsequence, so result = dp - 1
    
    {dp, _last_seen} = Enum.reduce(chars, {1, Map.new()}, fn char_code, {dp, last_seen} ->
      new_dp = rem(dp * 2, modulo)
      
      case Map.get(last_seen, char_code) do
        nil ->
          new_last_seen = Map.put(last_seen, char_code, dp)
          {rem(new_dp, modulo), new_last_seen}
        
        subtract ->
          new_dp = rem((new_dp - subtract + modulo), modulo)
          new_last_seen = Map.put(last_seen, char_code, dp)
          {new_dp, new_last_seen}
      end
    end)

    # Subtract the empty subsequence
    result = rem(dp - 1 + modulo, modulo)
    result
  end

  defp binary_to_codes(binary) do
    String.to_charlist(binary)
  end
end[0m
