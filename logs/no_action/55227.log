defmodule Solution do
  @moduledoc """
  Given a string, returns the number of distinct non-empty subsequences
  modulo 10^9 + 7.
  """

  @doc """
  Returns the number of distinct non-empty subsequences of the given string,
  modulo 10^9 + 7.
  """
  @spec find_distinct_subsequences(String.t()) :: non_neg_integer()
  def find_distinct_subsequences(binary) do
    modulo = 1_000_000_007

    chars = String.graphemes(binary)
    len = length(chars)

    if len == 0 do
      0
    else
      # dp represents the number of distinct subsequences including the empty one
      # Initially, dp = 1 (just the empty subsequence)
      # last_seen maps each character to the dp value right before its last addition
      # When we encounter a character c:
      #   new_dp = dp * 2
      #   If c was seen before, we subtract the dp value that was saved when c was last added
      #   (This removes duplicates)
      #   Then we save the current dp (before update) for the next occurrence

      {dp, _last_seen} = Enum.reduce(chars, {1, %{}}, fn char, {dp, last_seen} ->
        new_dp = rem(dp * 2, modulo)

        case Map.get(last_seen, char) do
          nil ->
            new_last_seen = Map.put(last_seen, char, dp)
            {new_dp, new_last_seen}

          subtract ->
            new_dp = rem((new_dp - subtract + modulo), modulo)
            new_last_seen = Map.put(last_seen, char, dp)
            {new_dp, new_last_seen}
        end
      end)

      # Subtract the empty subsequence
      result = rem(dp - 1 + modulo, modulo)
      result
    end
  end
end
