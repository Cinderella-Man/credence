---INSTRUCTION---
Write an Elixir function that counts the number of distinct non-empty subsequences (not necessarily contiguous) of a given string. Two subsequences are considered distinct if they differ in at least one position.

The function should:
- Accept a string as input
- Return an integer representing the count modulo 1,000,000,007
- Handle the empty string case (return 0)

Examples:
- "abcd" has 15 distinct non-empty subsequences
- "aaa" has 3 distinct non-empty subsequences
- "abc" has 7 distinct non-empty subsequences

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "counts distinct subsequences for 'abcd'" do
    assert Solution.find_distinct_subsequences("abcd") == 15
  end

  test "counts distinct subsequences for 'aaa'" do
    assert Solution.find_distinct_subsequences("aaa") == 3
  end

  test "counts distinct subsequences for 'abc'" do
    assert Solution.find_distinct_subsequences("abc") == 7
  end
end

---REFERENCE---
defmodule Solution do
  @mod 1_000_000_007

  def find_distinct_subsequences(s) do
    chars = String.graphemes(s)

    {dp, _last} =
      Enum.reduce(chars, {[1], %{}}, fn char, {dp, last} ->
        last_count = List.last(dp)
        new_count = Integer.mod(last_count * 2, @mod)

        new_count =
          if Map.has_key?(last, char) do
            idx = Map.get(last, char)
            prev = Enum.at(dp, idx)
            Integer.mod(new_count - prev, @mod)
          else
            new_count
          end

        {dp ++ [new_count], Map.put(last, char, length(dp))}
      end)

    Integer.mod(List.last(dp) - 1, @mod)
  end
end
