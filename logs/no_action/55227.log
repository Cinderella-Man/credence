defmodule Solution do
  @mod 1_000_000_007

  def find_distinct_subsequences(s) do
    chars = String.to_charlist(s)
    {dp, _last_occ} =
      Enum.reduce(chars, {1, %{}}, fn c, {dp, last_occ} ->
        prev = Map.get(last_occ, c, 0)
        new_dp = (2 * dp - prev) |> rem(@mod)
        new_dp = if new_dp < 0, do: new_dp + @mod, else: new_dp
        last_occ = Map.put(last_occ, c, dp)
        {new_dp, last_occ}
      end)
    result = (dp - 1) |> rem(@mod)
    if result < 0, do: result + @mod, else: result
  end
end
