---REFERENCE---
defmodule Solution do
  def find_first_minimum_index([]), do: nil

  def find_first_minimum_index(list) do
    {min_index, _} =
      list
      |> Enum.with_index()
      |> Enum.reduce({0, hd(list)}, fn {num, idx}, {current_min_idx, current_min} ->
        if num < current_min do
          {idx, num}
        else
          {current_min_idx, current_min}
        end
      end)

    min_index
  end
end

