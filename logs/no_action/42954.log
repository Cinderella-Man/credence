@doc """
Finds the index of the first occurrence of the minimum value in a list of numbers.

## Examples

    iex> Solution.find_first_minimum_index([4, 2, 1, 3, 1])
    2

    iex> Solution.find_first_minimum_index([])
    nil

    iex> Solution.find_first_minimum_index([42])
    0
"""
@spec find_first_minimum_index([number()]) :: non_neg_integer() | nil
def find_first_minimum_index([]) do
  nil
end

def find_first_minimum_index(numbers) do
  minimum_value = Enum.min(numbers)

  Enum.find_index(numbers, fn value ->
    value == minimum_value
  end)
end[0m
