defmodule Solution do
  @spec get_max_consecutive(list(integer())) :: integer()
  def get_max_consecutive(coins) do
    coins
    |> Enum.sort()
    |> Enum.reduce_while(1, fn y, x ->
      if y <= x do
        {:cont, x + y}
      else
        {:halt, x}
      end
    end)
  end
end
