defmodule Solution do
  @doc """
  Returns the smallest positive integer that cannot be represented as a sum
  of a subset of the given integers (each used at most once).

  This is one more than the maximum consecutive integer (starting from 1)
  that can be formed.
  """
  @spec get_max_consecutive(list(integer())) :: non_neg_integer()
  def get_max_consecutive(integers) do
    sorted = integers |> Enum.sort()

    case sorted do
      [] ->
        1

      [head | _tail] when head > 1 ->
        1

      [head | _tail] when head == 1 ->
        do_get_max_consecutive(sorted, 1)
    end
  end

  defp do_get_max_consecutive(sorted, current_max) do
    case sorted do
      [] ->
        current_max + 1

      [head | tail] ->
        # If the next smallest element is greater than current_max + 1,
        # we have a gap and cannot form current_max + 1.
        if head > current_max + 1 do
          current_max + 1
