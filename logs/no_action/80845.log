  test "returns 2 for [1, 3]" do
    assert Solution.get_max_consecutive([1, 3]) == 2
  end

  test "returns 8 for [1, 1, 1, 4]" do
    assert Solution.get_max_consecutive([1, 1, 1, 4]) == 8
  end

  test "returns 20 for [1, 4, 10, 3, 1]" do
    assert Solution.get_max_consecutive([1, 4, 10, 3, 1]) == 20
  end
end
