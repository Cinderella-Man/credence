defmodule Solution do
  @doc """
  Converts a number of seconds into a tuple of {days, hours, minutes, seconds}.
  """
  @spec convert_seconds(non_neg_integer()) :: {integer(), integer(), integer(), integer()}
  def convert_seconds(seconds) do
    days = div(seconds, 86400)
    remainder_after_days = rem(seconds, 86400)

    hours = div(remainder_after_days, 3600)
    remainder_after_hours = rem(remainder_after_days, 3600)

    minutes = div(remainder_after_hours, 60)
    remaining_seconds = rem(remainder_after_hours, 60)

    {days, hours, minutes, remaining_seconds}
  end
end
