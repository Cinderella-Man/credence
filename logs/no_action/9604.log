defmodule Solution do
  @doc """
  Counts the number of 1 bits in the binary representation of a non-negative integer.
  """
  @spec count_ones(pos_integer) :: non_neg_integer
  @spec count_ones(non_neg_integer) :: non_neg_integer
  def count_ones(0), do: 0

  def count_ones(n) when n > 0 do
    case rem(n, 2) do
      1 -> 1 + count_ones(div(n, 2))
      _ -> count_ones(div(n, 2))
    end
  end
end
