  def count_ones(n) when is_integer(n) and n >= 0 do
    do_count_ones(n, 0)
  end

  defp do_count_ones(0, acc), do: acc
  defp do_count_ones(n, acc) do
    do_count_ones(n &&& (n - 1), acc + 1)
  end
end

