defmodule Solution do
  def runningsum(nums) do
    runningsum(nums, 0, [])
    |> Enum.reverse()
  end

  defp runningsum([], _acc, result), do: result
  defp runningsum([h | t], acc, result) do
    new_acc = acc + h
    runningsum(t, new_acc, [new_acc | result])
  end
end
