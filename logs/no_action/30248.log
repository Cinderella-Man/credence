      []
  """
  @spec runningsum(list(number())) :: list(number())
  def runningsum([]), do: []

  def runningsum([head | tail]) do
    [head | tail]
    |> Enum.reduce_while({[], head}, fn value, {acc, current_sum} ->
      new_sum = current_sum + value
      {:halt, {[new_sum | acc], new_sum}}
