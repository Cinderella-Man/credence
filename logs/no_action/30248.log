    |> elem(0)
    |> Enum.reverse()
    |> then(fn first_acc ->
      # The reduce returns {accumulated_reverse, last_sum}
      # We need to prepend the first element (head) to the reversed acc
      [head | first_acc]
    end)
  end
end
