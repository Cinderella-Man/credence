---MODULE---
defmodule Solution do
  @doc """
  Computes the running sum of a list of numbers.

  The running sum at index `i` is the sum of all elements from index `0` through `i` in the original list.

  ## Examples

      iex> Solution.runningsum([1, 2, 3, 4])
      [1, 3, 6, 10]

      iex> Solution.runningsum([])
      []
  """
  @spec runningsum(list(number())) :: list(number())
  def runningsum([]), do: []

  def runningsum(numbers) do
    numbers
    |> Enum.reduce({[], 0}, fn num, {acc, current_sum} ->
      new_sum = current_sum + num
      {[new_sum | acc], new_sum}
    end)
    |> elem(0)
    |> Enum.reverse()
  end
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "running sum of [1, 2, 3, 4]" do
    assert Solution.runningsum([1, 2, 3, 4]) == [1, 3, 6, 10]
  end

  test "running sum of [1, 1, 1, 1, 1]" do
    assert Solution.runningsum([1, 1, 1, 1, 1]) == [1, 2, 3, 4, 5]
  end

  test "running sum of [3, 1, 2, 10, 1]" do
    assert Solution.runningsum([3, 1, 2, 10, 1]) == [3, 4, 6, 16, 17]
  end

  test "running sum of an empty list" do
    assert Solution.runningsum([]) == []
  end

  test "running sum of a single element" do
    assert Solution.runningsum([5]) == [5]
  end
end
