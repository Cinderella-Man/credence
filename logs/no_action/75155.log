Write an Elixir function that, given a list of numbers, returns the maximum absolute difference between any two consecutive elements in the list. If the list has fewer than two elements, the function should return 0.

Function: max_abs_diff_consecutive/1
Input: a list of numbers (integers or floats)
Output: a non-negative number (integer or float) representing the maximum absolute difference.

Complexity: O(n) where n is the length of the list.

Edge cases:
- Empty list or list with one element: return 0.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "returns 0 for empty list" do
    assert Solution.max_abs_diff_consecutive([]) == 0
  end

  test "returns 0 for single element list" do
    assert Solution.max_abs_diff_consecutive([42]) == 0
  end

  test "returns maximum absolute difference for given examples" do
    assert Solution.max_abs_diff_consecutive([10, 5, 15, 20, 25]) == 10
    assert Solution.max_abs_diff_consecutive([2, 9, 4, 10, 3]) == 7
    assert Solution.max_abs_diff_consecutive([1, 2, 3, 4, 5]) == 1
  end
end

---REFERENCE---
defmodule Solution do
  @spec max_abs_diff_consecutive(list(number)) :: number
  def max_abs_diff_consecutive([]), do: 0
  def max_abs_diff_consecutive([_]), do: 0
  def max_abs_diff_consecutive([a, b | rest]) do
    diff = abs(a - b)
    max_rest = max_abs_diff_consecutive([b | rest])
    max(diff, max_rest)
  end
end

