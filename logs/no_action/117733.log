---REFERENCE---
```elixir
defmodule Solution do
  def average_of_list_of_lists(list_of_lists) do
    {total_sum, total_elements} =
      Enum.reduce(list_of_lists, {0, 0}, fn sublist, {sum, count} ->
        sublist_sum = Enum.sum(sublist)
        sublist_length = length(sublist)
        {sum + sublist_sum, count + sublist_length}
      end)

    total_sum / total_elements
  end
end
```
