defmodule Solution do
  @doc """
  Calculates the average of all elements in a list of lists of integers.

  ## Examples

      iex> Solution.average_of_list_of_lists([[10, 20, 30], [40, 50, 60]])
      35.0

      iex> Solution.average_of_list_of_lists([[1, 2, 3], [4, 5, 6], [7, 8, 9]])
      5.0

      iex> Solution.average_of_list_of_lists([[1, 2], [3, 4], [5, 6], [7, 8]])
      4.5
  """
  @spec average_of_list_of_lists([[integer()]]) :: float()
  def average_of_list_of_lists(list_of_lists) do
    flattened = Enum.concat(list_of_lists)

    {total, count} =
      Enum.reduce(flattened, {0, 0}, fn
        value, {acc_total, acc_count} ->
          {acc_total + value, acc_count + 1}
      end)

    total / count
  end
end
