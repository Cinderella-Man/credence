---INSTRUCTION---
Write a function `intersection_sets/2` that computes the intersection of two sets, returning a new set containing only the elements present in both input sets. The sets are represented as `MapSet`. The function should handle empty sets as inputs and return an empty `MapSet` when there are no common elements. The time complexity should be linear with respect to the size of the smaller input set.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "intersection with overlapping elements" do
    assert Solution.intersection_sets(MapSet.new([1, 2, 3, 4, 5]), MapSet.new([4, 5, 6, 7, 8])) == MapSet.new([4, 5])
  end

  test "intersection with partial overlap" do
    assert Solution.intersection_sets(MapSet.new([10, 20, 30, 40]), MapSet.new([30, 40, 50, 60])) == MapSet.new([30, 40])
  end

  test "intersection with no common elements" do
    assert Solution.intersection_sets(MapSet.new([1, 2, 3]), MapSet.new([4, 5, 6])) == MapSet.new()
  end
end

---REFERENCE---
defmodule Solution do
  @spec intersection_sets(MapSet.t(), MapSet.t()) :: MapSet.t()
  def intersection_sets(set1, set2) do
    Enum.reduce(set1, MapSet.new(), fn element, acc ->
      if MapSet.member?(set2, element) do
        MapSet.put(acc, element)
      else
        acc
      end
    end)
  end
end
