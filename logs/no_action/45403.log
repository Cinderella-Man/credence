      tree = {1, {2, {4, :leaf, :leaf}, {5, :leaf, :leaf}}, {3, :leaf, {6, :leaf, :leaf}}}
      assert Solution.balanced_tree?(tree) == true
    end
  end
end

---REFERENCE---
defmodule Solution do
  @spec balanced_tree?(binary_tree) :: boolean
        when binary_tree: :leaf | {integer, binary_tree, binary_tree}
  def balanced_tree?(tree) do
    case check_height(tree) do
      {:ok, _height} -> true
      :unbalanced -> false
    end
  end

  defp check_height(:leaf), do: {:ok, 0}
  defp check_height({_value, left, right}) do
    case check_height(left) do
      :unbalanced -> :unbalanced
      {:ok, left_height} ->
        case check_height(right) do
          :unbalanced -> :unbalanced
          {:ok, right_height} ->
            if abs(left_height - right_height) > 1 do
              :unbalanced
            else
              {:ok, max(left_height, right_height) + 1}
            end
        end
    end
  end
end
