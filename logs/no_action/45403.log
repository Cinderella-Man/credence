defmodule SolutionTest do
  use ExUnit.Case, async: false

  describe "balanced_tree?" do
    test "balanced tree" do
      #     3
      #    / \
      #   9  20
      #     /  \
      #    15   7
      tree = {3, {9, :leaf, :leaf}, {20, {15, :leaf, :leaf}, {7, :leaf, :leaf}}}
      assert Solution.balanced_tree?(tree) == true
    end

    test "unbalanced tree" do
      #       1
      #      / \
      #     2   2
      #    / \
      #   3   3
      #  /
      # 4
      tree = {1, {2, {3, {4, :leaf, :leaf}, :leaf}, {3, :leaf, :leaf}}, {2, :leaf, :leaf}}
      assert Solution.balanced_tree?(tree) == false
    end

    test "empty tree" do
      assert Solution.balanced_tree?(:leaf) == true
    end

    test "single node" do
      assert Solution.balanced_tree?({1, :leaf, :leaf}) == true
    end

    test "left heavy but balanced" do
      #     1
      #    /
      #   2
      tree = {1, {2, :leaf, :leaf}, :leaf}
      assert Solution.balanced_tree?(tree) == true
    end

    test "left heavy and unbalanced" do
      #       1
      #      /
      #     2
      #    /
      #   3
      tree = {1, {2, {3, :leaf, :leaf}, :leaf}, :leaf}
      assert Solution.balanced_tree?(tree) == false
    end

    test "right heavy and unbalanced" do
      #   1
      #    \
      #     2
      #      \
      #       3
      tree = {1, :leaf, {2, :leaf, {3, :leaf, :leaf}}}
      assert Solution.balanced_tree?(tree) == false
    end

    test "complex balanced tree" do
      #       1
      #      / \
      #     2   3
      #    / \   \
      #   4   5   6
      tree = {1, {2, {4, :leaf, :leaf}, {5, :leaf, :leaf}}, {3, :leaf, {6, :leaf, :leaf}}}
      assert Solution.balanced_tree?(tree) == true
    end
  end
end
