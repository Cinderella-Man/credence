---MODULE---
@doc """
Determines if a given binary tree is height-balanced.

A binary tree is height-balanced if the left and right subtrees of every
node differ in height by no more than 1.

The tree is represented as:
- `:leaf` for an empty tree
- `{value, left, right}` for a node

The function returns `true` if the tree is balanced, `false` otherwise.
An empty tree is considered balanced.
"""
@spec balanced_tree?(term()) :: boolean()
def balanced_tree?(tree) do
  case check_balance(tree) do
    {:ok, _height} -> true
    :not_balanced -> false
  end
end

# Base case: empty tree is balanced with height 0
defp check_balance(:leaf), do: {:ok, 0}

# Recursive case: check both subtrees
defp check_balance({_value, left_subtree, right_subtree}) do
  with {:ok, left_height} <- check_balance(left_subtree),
       {:ok, right_height} <- check_balance(right_subtree) do
    height_difference = abs(left_height - right_height)

    if height_difference <= 1 do
      current_height = max(left_height, right_height) + 1
      {:ok, current_height}
    else
      :not_balanced
    end
  else
    :not_balanced -> :not_balanced
  end
end
