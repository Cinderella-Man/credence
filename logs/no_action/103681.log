defmodule Solution do
  def almost_equivalent?(s1, s2) do
    freq1 = s1 |> String.graphemes() |> Enum.frequencies()
    freq2 = s2 |> String.graphemes() |> Enum.frequencies()
    keys1 = MapSet.new(Map.keys(freq1))
    keys2 = MapSet.new(Map.keys(freq2))
    keys1 == keys2 && Enum.all?(keys1, fn k -> abs(freq1[k] - freq2[k]) <= 3 end)
  end
end
