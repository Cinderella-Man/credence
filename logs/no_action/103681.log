---MODULE---
defmodule Solution do
  @doc """
  Checks if two strings are almost equivalent.

  Two strings are almost equivalent if:
  1. They have exactly the same set of characters.
  2. For every character, the absolute difference in its frequency between the two strings is at most 3.

  The function handles empty strings (two empty strings are almost equivalent).
  Time complexity is linear in the length of the strings.
  """
  @spec almost_equivalent?(String.t(), String.t()) :: boolean()
  def almost_equivalent?(str1, str2) do
    freq1 = count_chars(str1)
    freq2 = count_chars(str2)

    same_set?(freq1, freq2) and same_frequency_diff?(freq1, freq2)
  end

  @doc """
  Counts the frequency of each character in a string.
  """
  @spec count_chars(String.t()) :: %{required(String.grapheme()) => non_neg_integer()}
  defp count_chars(""), do: %{}

  defp count_chars(str) do
    str
    |> String.graphemes()
    |> Enum.reduce(%{}, fn char, acc ->
      Map.update(acc, char, 1, &(&1 + 1))
    end)
  end

  @doc """
  Checks if two frequency maps have the same set of keys.
  """
  @spec same_set?(%{}, %{}) :: boolean()
  defp same_set?(freq1, freq2) do
    Map.keys(freq1) == Map.keys(freq2)
  end

  @doc """
  Checks if the absolute difference in frequency for each character is at most 3.
  """
  @spec same_frequency_diff?(%{required(String.grapheme()) => non_neg_integer()}, %{required(String.grapheme()) => non_neg_integer()}) :: boolean()
  defp same_frequency_diff?(freq1, freq2) do
    freq1
    |> Map.keys()
    |> Enum.all?(fn char ->
      count1 = Map.get(freq1, char, 0)
      count2 = Map.get(freq2, char, 0)
      abs(count1 - count2) <= 3
    end)
  end
end
