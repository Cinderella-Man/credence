defmodule Solution do
  def find_missing_positive(nums) do
    n = length(nums)
    positives = for x <- nums, x >= 1 and x <= n, into: MapSet.new(), do: x
    missing = Enum.find(1..n, fn i -> not MapSet.member?(positives, i) end)
    missing || (n + 1)
  end
end
