defmodule Solution do
  @moduledoc """
  Provides functionality to find the length of the longest contiguous sublist
  containing an equal number of "0"s and "1"s in a list of strings.
  """

  @doc """
  Returns the length of the longest contiguous sublist that contains an equal
  number of "0"s and "1"s.

  ## Examples

      iex> Solution.maxequalzeroone(["0", "1", "0"])
      2

      iex> Solution.maxequalzeroone(["0", "1", "0", "1"])
      4

      iex> Solution.maxequalzeroone(["0", "0", "1", "0", "1", "1"])
      6

  """
  @spec maxequalzeroone([String.t()]) :: non_neg_integer()
  def maxequalzeroone(list) do
    # We use a hash map to store the first occurrence of each running balance.
    # Treat "0" as -1 and "1" as +1.
    # If the same balance is seen again, the subarray between those indices has a net sum of 0.
    # This gives us O(n) time complexity.

    map = %{}
    # Initialize with balance 0 at index -1 to handle cases where the equal subarray starts from index 0
    balance_map = Map.put(map, 0, -1)

    {_, max_len} =
      Enum.reduce(0..(length(list) - 1), {balance_map, 0}, fn idx, {current_map, current_max} ->
        case Enum.at(list, idx) do
          "0" -> -1
          "1" -> 1
          _ -> raise ArgumentError, "Expected \"0\" or \"1\", got: #{inspect(Enum.at(list, idx))}"
        end
        |> then(fn delta ->
          # Calculate previous balance
          {prev_map, prev_max} = {current_map, current_max}
          
          # We need to know the balance before this element to add delta.
          # But we don't store balances in a simple list, so let's restructure.
          {prev_map, current_balance_so_far} = prev_map # This doesn't work directly.
        end)
      end)

    # Let's rewrite this more cleanly
    do_maxequalzeroone(list, 0, 0, %{}, 0)
  end

  defp do_maxequalzeroone([], _index, _balance, _balance_map, max_len), do: max_len

  defp do_maxequalzeroone([head | tail], index, balance, balance_map, max_len) do
    new_balance =
      case head do
        "0" -> balance - 1
        "1" -> balance + 1
      end

    {new_balance_map, new_max_len} =
      case Map.fetch(balance_map, new_balance) do
        {:ok, first_idx} ->
          length = index - first_idx
          new_max = max(max_len, length)
          {balance_map, new_max}

        :error ->
          new_balance_map = Map.put(balance_map, new_balance, index)
          {new_balance_map, max_len}
      end

    do_maxequalzeroone(tail, index + 1, new_balance, new_balance_map, new_max_len)
  end

  # Actually, let's start with the initial state properly
  def maxequalzeroone(list) when is_list(list) do
    # Start with balance 0 at index -1
    balance_map = %{0 => -1}
    do_maxequalzeroone(list, 0, 0, balance_map, 0)
  end

  defp do_maxequalzeroone([], _index, _balance, _balance_map, max_len), do: max_len

  defp do_maxequalzeroone([head | tail], index, balance, balance_map, max_len) do
    new_balance =
      case head do
        "0" -> balance - 1
        "1" -> balance + 1
      end

    {new_balance_map, new_max_len} =
      case Map.fetch(balance_map, new_balance) do
        {:ok, first_idx} ->
          length = index - first_idx
          new_max = max(max_len, length)
          {balance_map, new_max}

        :error ->
          new_balance_map = Map.put(balance_map, new_balance, index)
          {new_balance_map, max_len}
      end

    do_maxequalzeroone(tail, index + 1, new_balance, new_balance_map, new_max_len)
  end
end
