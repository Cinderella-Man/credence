---REFERENCE---
defmodule Solution do
  @spec maxequalzeroone([String.t()]) :: non_neg_integer()
  def maxequalzeroone(nums) do
    nums
    |> Enum.with_index()
    |> Enum.reduce({0, 0, %{0 => -1}}, fn {num, i}, {count, max_len, map} ->
      count = if num == "0", do: count - 1, else: count + 1
      case Map.get(map, count) do
        nil -> {count, max_len, Map.put(map, count, i)}
        prev -> {count, max(max_len, i - prev), map}
      end
    end)
    |> elem(1)
  end
end

