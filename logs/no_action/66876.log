defmodule Solution do
  @ones ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine"]
  @tens ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"]
  @teens ["Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"]

  def num_to_word(num) when is_integer(num) do
    cond do
      num == 0 -> "Zero"
      num < 10 -> Enum.at(@ones, num)
      num < 20 -> Enum.at(@teens, num - 10)
      num < 100 ->
        tens_part = Enum.at(@tens, div(num, 10))
        ones_part = rem(num, 10)
        if ones_part == 0, do: tens_part, else: "#{tens_part} #{Enum.at(@ones, ones_part)}"
      num < 1000 ->
        hundreds = Enum.at(@ones, div(num, 100))
        remainder = rem(num, 100)
        if remainder == 0, do: "#{hundreds} Hundred", else: "#{hundreds} Hundred #{num_to_word(remainder)}"
      true -> "Number out of range"
    end
  end
end
