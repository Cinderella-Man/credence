defmodule Solution do
  @doc """
  Converts an integer between 0 and 999 inclusive to its English words representation.
  Returns "Number out of range" for numbers outside this range.
  """
  @spec num_to_word(integer()) :: String.t()
  def num_to_word(number) when number < 0 or number > 999 do
    "Number out of range"
  end

  def num_to_word(0), do: "Zero"
  def num_to_word(number) when number < 100 do
    tens = div(number, 10)
    ones = rem(number, 10)
    do_tens(ones, tens)
  end

  def num_to_word(number) when number < 1000 do
    hundreds = div(number, 100)
    remainder = rem(number, 100)
    hundreds_word = single(0) <> " Hundred"
    if remainder == 0 do
      hundreds_word
    else
      hundreds_word <> " " <> do_tens(rem(remainder, 10), div(remainder, 10))
    end
  end

  defp do_tens(ones, tens) when tens < 10 do
    cond do
      tens == 0 ->
        single(ones)
      tens == 1 ->
        teens(ones)
      true ->
        tens_word = tens_word(tens)
        if ones == 0 do
          tens_word
        else
          tens_word <> " " <> single(ones)
        end
    end
  end

  defp single(0), do: ""
  defp single(1), do: "One"
  defp single(2), do: "Two"
  defp single(3), do: "Three"
  defp single(4), do: "Four"
