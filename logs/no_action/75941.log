defmodule Solution do
  def equalsubstring(s, t, max_cost) do
    s_list = String.to_charlist(s)
    t_list = String.to_charlist(t)
    pairs = Enum.zip(s_list, t_list)
    pairs_tuple = List.to_tuple(pairs)
    helper(pairs_tuple, 0, 0, 0, 0, max_cost)
  end

  defp helper(pairs_tuple, i, j, current_cost, max_len, max_cost) do
    if j >= tuple_size(pairs_tuple) do
      max_len
    else
      {c1, c2} = elem(pairs_tuple, j)
      cost = abs(c1 - c2)
      new_cost = current_cost + cost

      if new_cost <= max_cost do
        new_len = j - i + 1
        new_max_len = max(max_len, new_len)
        helper(pairs_tuple, i, j + 1, new_cost, new_max_len, max_cost)
      else
        new_max_len = max(max_len, j - i)
        {c1_left, c2_left} = elem(pairs_tuple, i)
        left_cost = abs(c1_left - c2_left)
        helper(pairs_tuple, i + 1, j + 1, new_cost - left_cost, new_max_len, max_cost)
      end
    end
  end
end

