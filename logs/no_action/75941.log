defmodule Solution do
  @doc """
  Returns the maximum length of a contiguous substring such that the sum of
  the absolute differences between the ASCII values of corresponding characters
  in `s` and `t` is at most `max_cost`.

  Both `s` and `t` must be of the same length.
  """
  @spec equalsubstring(String.t(), String.t(), integer()) :: non_neg_integer()
  def equalsubstring(s, t, max_cost) when is_binary(s) and is_binary(t) and is_integer(max_cost) do
    bytes_s = :binary.bin_to_list(s)
    bytes_t = :binary.bin_to_list(t)
    len = length(bytes_s)

    do_equalsubstring(bytes_s, bytes_t, len, 0, 0, 0, max_cost)
  end

  # Window is valid (current_cost <= max_cost), try to expand right
  defp do_equalsubstring(_s, _t, _len, left, right, current_cost, max_cost) when right < _len and current_cost <= max_cost do
    # Include the character at position `right`
    cost = abs(<<Enum.at(_s, right)>> - <<Enum.at(_t, right)>>)
    new_cost = current_cost + cost
    new_right = right + 1

    if new_cost <= max_cost do
      # Window is still valid after expanding
      do_equalsubstring(_s, _t, _len, left, new_right, new_cost, max_cost)
    else
      # Adding this character exceeds max_cost, so the best window ended before this character
      # The window [left, right] is valid with length right - left
      right - left
    end
  end

  # Window is invalid (current_cost > max_cost), try to shrink from left
  defp do_equalsubstring(s, t, len, left, right, current_cost, max_cost) when left <= right do
    # Remove the character at position `left`
    cost_to_remove = abs(<<Enum.at(s, left)>> - <<Enum.at(t, left)>>)
    new_cost = current_cost - cost_to_remove
    new_left = left + 1

    if new_cost <= max_cost do
      # Window is now valid after shrinking, try to expand
      do_equalsubstring(s, t, len, new_left, right, new_cost, max_cost)
    else
      # Still invalid, keep shrinking
      do_equalsubstring(s, t, len, new_left, right, new_cost, max_cost)
    end
  end

  # Base case: right has reached the end or left passed right
  # Return the current window length
  defp do_equalsubstring(_s, _t, _len, left, right, _current_cost, _max_cost) when left > right do
    0
  end

  defp do_equalsubstring(_s, _t, _len, left, right, _current_cost, _max_cost) do
    # This case covers when right == len and we need to return the window size
    right - left
  end
end[0m
