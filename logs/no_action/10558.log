@doc """
Finds the index of the first occurrence of a target character in a string.

Returns the zero-based index of the first match, or -1 if the character
does not appear in the string.
"""
@spec find_char_index(String.t(), String.t()) :: non_neg_integer() | -1
def find_char_index(string, target_char) do
  case String.split(string, target_char, parts: 2) do
    [^string] -> -1
    [prefix, _rest] -> byte_size(prefix)
  end
end
