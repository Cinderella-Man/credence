  @doc """
  Calculates the binomial coefficient C(n, k).

  """
  @spec choose(pos_integer, non_neg_integer) :: non_neg_integer
  def choose(n, k) when n < k do
    0
  end

  def choose(_n, 0) do
    1
  end

  def choose(n, 1) do
    n
  end

  def choose(n, k) do
    do_choose(n, k, 1, k)
  end

  defp do_choose(_n, _k, acc, 0) do
    acc
  end

  defp do_choose(n, k, acc, current_k) do
    numerator = acc * (n - current_k + 1)
    new_acc = div(numerator, current_k)
    do_choose(n, k, new_acc, current_k - 1)
  end
end
