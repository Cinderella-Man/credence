defmodule Solution do
  @doc """
  Calculates the binomial coefficient C(n, k).
  """
  @spec choose(pos_integer, pos_integer) non_neg_integer
  def choose(_n, _k) when _n < _k do
    0
  end

  def choose(_n, 0) do
    1
  end

  def choose(_n, 1) do
    _n
  end

  def choose(_n, _k) when _k > _n do
    0
  end

  def choose(n, k) do
    # Use symmetry: C(n, k) == C(n, n-k)
    k = if k > div(n, 2), do: n - k, else: k
    do_choose(n, k, 1)
  end

  defp do_choose(_n, 0, acc) do
    acc
  end

  defp do_choose(n, k, acc) do
    # C(n, k) = C(n, k-1) * (n - k + 1) / k
    # We iterate from 1 to k.
    # At step i (1-based), we multiply by (n - i + 1) / i
    # But it's easier to track the current k value.
    # Let's use a helper that goes down from k to 1.
    # Actually, let's just use the standard formula with integer division carefully.
    # We want to compute product_{i=1 to k} (n - i + 1) / i
    # Since the result is always integer, we can compute numerator product and denominator product?
    # No, that grows too large.
    # Better: Use the recursive definition directly with integer arithmetic.
    # C(n, k) = C(n-1, k-1) + C(n-1, k) - too slow.
    # Let's use the multiplicative formula with floating point and then floor/round?
    # No, precision issues.
    
    # Let's implement the helper to compute iteratively using the property:
    # result = result * (n - k + 1) / k
    # We start with k' = k, and go down to 1?
    # Let's rewrite the helper to be cleaner.
    do_choose_acc(n, k, 1, k)
  end

  # acc is the accumulator. current_k is the k value for the term (n - current_k + 1) / current_k
  defp do_choose_acc(_n, 0, acc, _current_k) do
    acc
  end

  defp do_choose_acc(n, k, acc, current_k) do
    # term = (n - current_k + 1) / current_k
    # But we want to avoid float.
    # acc = acc * (n - current_k + 1) / current_k
    # This division must be exact.
    numerator = n - current_k + 1
    # We can't just divide if it's not exact at each step?
    # Actually, binomial coefficients are integers.
    # We can use the property that C(n, k) is integer.
    # But intermediate steps might not be integers if we divide by i before multiplying by (n-i+1)?
    # No, C(n, k) = n! / (k! (n-k)!).
    # The iterative formula C(n, k) = C(n, k-1) * (n - k + 1) / k is safe if we do multiplication first.
    # acc_new = acc * (n - current_k + 1) / current_k
    # We need to ensure (acc * (n - current_k + 1)) is divisible by current_k.
    
    # Let's use a different approach: compute numerator product and denominator product separately?
    # No, let's use the recursive function with memoization or just direct computation.
    
    # Let's try a different iterative approach:
    # We have k steps.
    # In each step i from 1 to k:
    # acc = acc * (n - i + 1) / i
    
    # Let's use a helper that counts down current_k from k to 1.
    # At each step, we multiply by (n - current_k + 1) and divide by current_k.
    # But we must multiply first to keep precision.
    
    new_acc = acc * (n - current_k + 1)
    
    # Check divisibility? It should be divisible.
    do_choose_acc(n, k - 1, div(new_acc, current_k), current_k - 1)
  end
end

