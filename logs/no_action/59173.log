defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "example from Python" do
    assert Solution.most_frequent_non_banned_word(
             "Hello world, hello Python, hello world again.",
             ["hello"]
           ) == "world"
  end

  test "single word with no banned" do
    assert Solution.most_frequent_non_banned_word("a.", []) == "a"
  end

  test "sentence with punctuation" do
    assert Solution.most_frequent_non_banned_word(
             "Bob hit a ball, the hit BALL flew far after it was hit.",
             ["hit"]
           ) == "ball"
  end
end
