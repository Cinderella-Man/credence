---MODULE---
@moduledoc """
Provides functionality to find the most frequent non-banned word in a string.
"""

defmodule Solution do
  @doc """
  Given a string and a list of banned words, returns the most frequent non-banned word.
  
  The comparison is case-insensitive, and the result is returned in lowercase.
  Punctuation is ignored when extracting words.
  
  If multiple words share the same highest frequency, any one of them may be returned.
  """
  @spec most_frequent_non_banned_word(String.t(), [String.t()]) :: String.t()
  def most_frequent_non_banned_word(text, banned_words) do
    banned_set =
      banned_words
      |> Enum.map(&String.downcase/1)
      |> MapSet.new()

    text
    |> String.downcase()
    |> extract_words()
    |> Enum.reject(&MapSet.member?(banned_set, &1))
    |> count_frequencies()
    |> most_frequent()
  end

  @doc false
  defp extract_words(text) do
    text
    |> String.split(~r/[^\p{L}\p{N}]+/, trim: true)
    |> Enum.map(&String.trim/1)
    |> Enum.reject(&(&1 == ""))
  end

  @doc false
  defp count_frequencies(words) do
    Enum.reduce(words, %{}, fn word, acc ->
      Map.update(acc, word, 1, &(&1 + 1))
    end)
  end

  @doc false
  defp most_frequencies(freq_map) when map_size(freq_map) == 0,
    do: ""

  defp most_frequencies(freq_map) do
    freq_map
    |> Enum.max_by(fn {_word, count} -> count end)
    |> elem(0)
  end
end
