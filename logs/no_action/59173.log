---REFERENCE---
```elixir
defmodule Solution do
  def most_frequent_non_banned_word(paragraph, banned) do
    banned_set = MapSet.new(banned, &String.downcase/1)

    paragraph
    |> String.downcase()
    |> extract_words()
    |> Enum.reject(&MapSet.member?(banned_set, &1))
    |> Enum.frequencies()
    |> Enum.max_by(fn {_, count} -> count end, fn -> nil end)
    |> case do
      {word, _} -> word
      nil -> raise ArgumentError, "no non-banned words"
    end
  end

  defp extract_words(string) do
    Regex.scan(~r/[[:alnum:]]+/, string) |> List.flatten()
  end
end
```
