@doc """
Generates a pyramid of asterisks with `n` rows.

Each row is centered within a total width of `2 * n - 1` characters.
Trailing spaces are included so every string has the same length.
"""
@spec pyramid(pos_integer()) :: [String.t()]
def pyramid(n) when is_integer(n) and n > 0 do
  width = 2 * n - 1

  for row <- 1..n do
    stars = row * 2 - 1
    padding = div(width - stars, 2)
    String.duplicate(" ", padding) <> String.duplicate("*", stars) <> String.duplicate(" ", padding)
  end
end
