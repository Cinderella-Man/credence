defmodule Solution do
  @spec pyramid(pos_integer()) :: [String.t()]
  def pyramid(n) do
    total_width = 2 * n - 1

    Enum.map(0..(n - 1), fn i ->
      stars = 2 * i + 1
      padding = div(total_width - stars, 2)
      String.duplicate(" ", padding) <> String.duplicate("*", stars) <> String.duplicate(" ", padding)
