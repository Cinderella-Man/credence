  use ExUnit.Case, async: false

  test "all same characters" do
    assert Solution.shortest_unique_substring("bbbbb") == "b"
  end

  test "aab" do
    assert Solution.shortest_unique_substring("aab") == "ab"
  end

  test "abcabcbb" do
    assert Solution.shortest_unique_substring("abcabcbb") == "abc"
  end

  test "empty string" do
    assert Solution.shortest_unique_substring("") == ""
  end

  test "single character" do
    assert Solution.shortest_unique_substring("a") == "a"
  end

  test "all unique characters" do
    assert Solution.shortest_unique_substring("abcd") == "abcd"
  end

  test "repeating pattern" do
    assert Solution.shortest_unique_substring("ababab") == "ab"
  end

  test "longer string with all same" do
    assert Solution.shortest_unique_substring("aaaaa") == "a"
  end
end
