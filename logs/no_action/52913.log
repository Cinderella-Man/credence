defmodule Solution do
  @spec shortest_unique_substring(String.t()) :: String.t()
  def shortest_unique_substring(s) do
    graphemes = String.graphemes(s)
    chars = List.to_tuple(graphemes)
    total = tuple_size(chars)
    unique = MapSet.size(MapSet.new(graphemes))

    if unique == 0 do
      ""
    else
      case do_find(chars, total, unique, 0, 0, %{}, 0, total + 1, 0) do
        {min_len, min_start} ->
          if min_len > total do
            ""
          else
            graphemes
            |> Enum.slice(min_start, min_len)
            |> Enum.join()
          end
      end
    end
  end

  defp do_find(chars, total, unique, start, end_idx, freq, matched, min_len, min_start) do
    if end_idx >= total do
      {min_len, min_start}
    else
      char = elem(chars, end_idx)
      new_freq = Map.update(freq, char, 1, &(&1 + 1))
      new_matched = if Map.get(new_freq, char) == 1, do: matched + 1, else: matched

      {new_start, new_freq, new_matched, min_len, min_start} =
        shrink_while(chars, start, end_idx, new_freq, new_matched, unique, min_len, min_start)

      do_find(chars, total, unique, new_start, end_idx + 1, new_freq, new_matched, min_len, min_start)
    end
  end

  defp shrink_while(chars, start, end_idx, freq, matched, unique, min_len, min_start) do
    if matched != unique do
      {start, freq, matched, min_len, min_start}
    else
      current_len = end_idx - start + 1
      {new_min_len, new_min_start} =
        if current_len < min_len, do: {current_len, start}, else: {min_len, min_start}

      left_char = elem(chars, start)
      new_freq = Map.update(freq, left_char, 0, &(&1 - 1))
      new_matched = if Map.get(new_freq, left_char) == 0, do: matched - 1, else: matched

      shrink_while(chars, start + 1, end_idx, new_freq, new_matched, unique, new_min_len, new_min_start)
    end
  end
end
