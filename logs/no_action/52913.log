  char = Enum.at(graphemes, right)
  new_counts = Map.update(counts, char, 1, &(&1 + 1))
  unique_in_window = Map.keys(new_counts) |> length()
  
  # Try to shrink from the left while maintaining all unique characters
  final_left = left
  final_counts = new_counts
  final_unique = unique_in_window
  
  # Actually, we need to shrink properly. Let's do it iteratively within the function.
  {final_left, final_counts, final_unique} = 
    shrink_until_invalid(graphemes, left, right, new_counts, unique_in_window, target_count)
  
