@spec shortest_unique_substring(String.t()) :: String.t()
def shortest_unique_substring(string) when is_binary(string) do
  graphemes = String.graphemes(string)
  n = length(graphemes)

  if n == 0 do
    ""
  else
    unique_chars = Enum.uniq(graphemes)
    target_count = length(unique_chars)

    if target_count == 0 do
      ""
