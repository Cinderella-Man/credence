      # Let's use a two-pointer approach
      counts = Map.new()
      
      do_shortest_unique(graphemes, 0, 0, n, target_count, counts, :infinity, :infinity)
      |> case do
        :no_match -> ""
        {start, len} -> String.slice(string, start, len)
      end
  end
end

