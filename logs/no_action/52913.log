@doc """
Returns the shortest substring that contains all unique characters of the input string.
If multiple such substrings exist, returns the one with the smallest starting index.
"""
@spec shortest_unique_substring(String.t()) :: String.t()
def shortest_unique_substring(string) when is_binary(string) do
  graphemes = String.graphemes(string)
  n = length(graphemes)

  if n == 0 do
    ""
  else
    unique_chars = Enum.uniq(graphemes)
    target_count = length(unique_chars)

    if target_count == 0 do
      ""
    else
      do_shortest(graphemes, target_count)
    end
  end
end

defp do_shortest(_graphemes, 0), do: ""

defp do_shortest(graphemes, target_count) do
  n = length(graphemes)
  
  # Sliding window: [left, right] inclusive
  # We maintain counts of each char in the current window
  # and the number of unique chars currently in the window.
  
  {best_start, best_len} = 
    Enum.reduce(0..(n - 1), {0, n + 1}, fn right, {best_start, best_len} ->
      char = Enum.at(graphemes, right)
      # We need to track the window state. Let's use a recursive helper or accumulate state.
      # Since Enum.reduce doesn't easily let us mutate, we'll use a helper with left pointer.
      # Actually, let's just do the full sliding window in a separate function.
      {best_start, best_len}
    end)
  
  # Redo with explicit left pointer management
  do_sliding_window(graphemes, target_count, 0, %{}, 0, n + 1, 0)
end

defp do_sliding_window(_graphemes, _target, left, _counts, _unique_in_window, best_len, best_start) when best_len == 0 do
  {best_start, best_len}
end

defp do_sliding_window(graphemes, target_count, left, counts, unique_in_window, best_len, best_start) do
  n = length(graphemes)
  
    # Try to expand right from current position? No, the standard approach:
    # Move right pointer, add char. If all unique chars are present, try shrinking from left.
    # But we need to process each right. Let's use a reduce that carries left.
    
    {_left, counts, unique_in_window, best_start, best_len} =
      Enum.reduce(0..(n - 1), {0, counts, unique_in_window, best_start, best_len}, fn right, {left, counts, unique_in_window, best_start, best_len} ->
        char = Enum.at(graphemes, right)
        new_counts = Map.update(counts, char, 1, &(&1 + 1))
        new_unique = if Map.get(new_counts, char, 0) == 1, do: unique_in_window + 1, else: unique_in_window
        
        # While all target unique chars are in window, try to shrink from left
        {final_left, final_counts, final_unique} = shrink_window(graphemes, left, right, new_counts, new_unique, target_count)
        
        # Check if this is the best
        if final_unique == target_count do
          current_len = right - final_left + 1
          if current_len < best_len do
            {final_left, final_counts, final_unique, final_left, current_len}
          else
            {final_left, final_counts, final_unique, best_start, best_len}
          end
        else
          {final_left, final_counts, final_unique, best_start, best_len}
        end
      end)
    
    {best_start, best_len}
end

defp shrink_window(_graphemes, left, _right, counts, _unique, _target) when not is_map_element(counts, :__struct__) and not Map.has_key?(counts, left) do
  {left, counts, 0}
end

defp shrink_window(graphemes, left, right, counts, unique, target_count) do
  if unique >= target_count do
    # Try to shrink from left
    left_char = Enum.at(graphemes, left)
    new_counts = Map.update(counts, left_char, 1, &(&1 - 1))
    new_unique = if new_counts[left_char] == 1, do: unique - 1, else: unique
    
    # If removing left_char would drop the unique count, we stop shrinking
    # Actually, we check if new_unique is still >= target_count
    if new_unique >= target_count do
      shrink_window(graphemes, left + 1, right, new_counts, new_unique, target_count)
    else
      {left, counts, unique}
    end
  else
    {left, counts, unique}
  end
end[0m
