    {_left, counts, unique_in_window, best_start, best_len} =
      Enum.reduce(0..(n - 1), {0, counts, unique_in_window, best_start, best_len}, fn right, {left, counts, unique_in_window, best_start, best_len} ->
        char = Enum.at(graphemes, right)
        new_counts = Map.update(counts, char, 1, &(&1 + 1))
        new_unique = if Map.get(new_counts, char, 0) == 1, do: unique_in_window + 1, else: unique_in_window
        
        # While all target unique chars are in window, try to shrink from left
        {final_left, final_counts, final_unique} = shrink_window(graphemes, left, right, new_counts, new_unique, target_count)
        
        # Check if this is the best
        if final_unique == target_count do
          current_len = right - final_left + 1
          if current_len < best_len do
            {final_left, final_counts, final_unique, final_left, current_len}
          else
            {final_left, final_counts, final_unique, best_start, best_len}
          end
        else
          {final_left, final_counts, final_unique, best_start, best_len}
        end
      end)
    
    {best_start, best_len}
end

defp shrink_window(_graphemes, left, _right, counts, _unique, _target) when not is_map_element(counts, :__struct__) and not Map.has_key?(counts, left) do
  {left, counts, 0}
end

defp shrink_window(graphemes, left, right, counts, unique, target_count) do
  if unique >= target_count do
    # Try to shrink from left
    left_char = Enum.at(graphemes, left)
    new_counts = Map.update(counts, left_char, 1, &(&1 - 1))
    new_unique = if new_counts[left_char] == 1, do: unique - 1, else: unique
    
    # If removing left_char would drop the unique count, we stop shrinking
    # Actually, we check if new_unique is still >= target_count
    if new_unique >= target_count do
      shrink_window(graphemes, left + 1, right, new_counts, new_unique, target_count)
    else
      {left, counts, unique}
    end
  else
    {left, counts, unique}
  end
end

