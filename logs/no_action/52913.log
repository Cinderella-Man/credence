defmodule Solution do
  @doc """
  Returns the shortest substring that contains all unique characters of the input string.
  If multiple such substrings exist, returns the one with the smallest starting index.
  """
  @spec shortest_unique_substring(String.t()) :: String.t()
  def shortest_unique_substring(string) when is_binary(string) do
    graphemes = String.graphemes(string)
    n = length(graphemes)

    if n == 0 do
      ""
    else
      unique_chars = Enum.uniq(graphemes)
      target_count = length(unique_chars)

      if target_count == 0 do
        ""
      else
        result =
          do_shortest_unique(graphemes, 0, 0, n, target_count, %{}, :infinity, :infinity)

        case result do
          :no_match -> ""
          {start, len} -> String.slice(string, start, len)
        end
      end
    end
  end

  defp do_shortest_unique(
         _graphemes,
         _left,
         right,
         n,
         _target_count,
         _counts,
         _best_start,
         _best_len
       )
       when right >= n do
    :no_match
  end

  defp do_shortest_unique(graphemes, left, right, n, target_count, counts, best_start, best_len) do
    char = Enum.at(graphemes, right)
    new_counts = Map.update(counts, char, 1, &(&1 + 1))
    unique_in_window = Map.keys(new_counts) |> length()

    {final_left, final_counts} =
      shrink_until_invalid(graphemes, left, right, new_counts, unique_in_window, target_count)

    final_unique = Map.keys(final_counts) |> length()

    if final_unique >= target_count do
      current_len = right - final_left + 1

      new_best =
        if best_len == :infinity or current_len < best_len do
          {final_left, current_len}
        else
          {best_start, best_len}
        end

      do_shortest_unique(
        graphemes,
        final_left + 1,
        right + 1,
        n,
        target_count,
        final_counts,
        elem(new_best, 0),
        elem(new_best, 1)
      )
    else
      do_shortest_unique(
        graphemes,
        left,
        right + 1,
        n,
        target_count,
        new_counts,
        best_start,
        best_len
      )
    end
  end

  defp shrink_until_invalid(_graphemes, left, _right, counts, unique, target_count)
       when unique < target_count do
    {left, counts}
  end

  defp shrink_until_invalid(graphemes, left, right, counts, unique, target_count)
       when unique >= target_count do
    left_char = Enum.at(graphemes, left)
    new_count = Map.get(counts, left_char, 0) - 1

    if new_count == 0 do
      new_counts = Map.delete(counts, left_char)
      new_unique = Map.keys(new_counts) |> length()

      if new_unique >= target_count do
        shrink_until_invalid(graphemes, left + 1, right, new_counts, new_unique, target_count)
      else
        {left, counts}
      end
    else
      new_counts = Map.put(counts, left_char, new_count)
      shrink_until_invalid(graphemes, left + 1, right, new_counts, unique, target_count)
    end
  end
end
