defmodule Solution do
  @doc """
  Takes a list of integers, reverses the list, and increments each element by 1.

  ## Examples

      iex> Solution.reverse_and_increment([1, 2, 3])
      [4, 3, 2]

      iex> Solution.reverse_and_increment([9, 8, 7, 6, 5])
      [6, 7, 8, 9, 10]

      iex> Solution.reverse_and_increment([4, 5, 6, 7])
      [8, 7, 6, 5]
  """
  @spec reverse_and_increment(list_of_integers :: [integer()]) :: [integer()]
  def reverse_and_increment(integers) do
    integers
    |> Enum.reverse()
    |> Enum.map(&(&1 + 1))
  end
end
