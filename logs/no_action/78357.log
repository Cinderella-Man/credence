    assert Solution.reverse_and_increment([9, 8, 7, 6, 5]) == [6, 7, 8, 9, 10]
  end

  test "four elements" do
    assert Solution.reverse_and_increment([4, 5, 6, 7]) == [8, 7, 6, 5]
  end
end
