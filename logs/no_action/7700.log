---MODULE---
defmodule Solution do
  @doc """
  Sorts a list of non-negative integers using the Radix Sort algorithm.
  """
  @spec radix_sort(list(non_neg_integer)) :: list(non_neg_integer)
  def radix_sort([]) do
    []
  end

  def radix_sort(list) do
    max = Enum.max(list)
    do_radix_sort(list, 0, max)
  end

  defp do_radix_sort(_list, exp, max) when exp > max do
    # When exp exceeds max, we should return the list sorted from the previous pass.
    # However, the logic here needs to be careful.
    # Actually, let's restructure.
    # The issue with the previous implementation was infinite recursion or
    # incorrect base case handling.
    []
  end

  # Let's implement a standard iterative radix sort or a cleaner recursive one.
  # We'll pass the list through passes based on the digit position.
  defp do_radix_sort(list, exp, max) when exp <= max do
    buckets = Enum.map(0..9, fn _ -> [] end)
    
    sorted_list = Enum.reduce(list, buckets, fn n, acc ->
      digit = rem(div(n, Integer.pow(10, exp)), 10)
      List.insert_at(acc, digit, n)
    end)

    # Flatten the buckets
    flattened = Enum.concat(sorted_list)
    
    # Next exponent
    next_exp = Integer.pow(10, exp + 1)
    
    # If next_exp > max, we are done (since max is the largest number, digits beyond its magnitude don't matter)
    if next_exp > max do
      flattened
    else
      do_radix_sort(flattened, exp + 1, max)
    end
  end
  
  defp do_radix_sort(list, _exp, _max) do
    list
  end
end
