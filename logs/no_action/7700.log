defmodule Solution do
  @doc """
  Sorts a list of non-negative integers using the Radix Sort algorithm.
  """
  @spec radix_sort(list(non_neg_integer())) :: list(non_neg_integer())
  def radix_sort([]) do
    []
  end

  def radix_sort(list) do
    max = Enum.max(list)
    do_radix_sort(list, 1, max)
  end

  defp do_radix_sort(_list, exp, max) when exp > max do
    []
  end

  defp do_radix_sort(list, exp, _max) do
    buckets = List.duplicate([], 10)

    flattened =
      Enum.reduce(list, buckets, fn n, acc ->
        digit = rem(div(n, exp), 10)
        List.insert_at(acc, digit, n)
      end)

    next_exp = exp * 10

    if next_exp > Enum.max([Enum.max(list), 1]) do
      Enum.concat(flattened)
    else
      do_radix_sort(Enum.concat(flattened), next_exp, Enum.max(list))
    end
  end
end
