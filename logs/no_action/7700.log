defmodule Solution do
  @doc """
  Sorts a list of non-negative integers using Radix Sort.
  """
  def radix_sort([]), do: []
  def radix_sort(list) when is_list(list) do
    max = Enum.max(list)
    do_radix_sort(list, 1, max)
  end

  defp do_radix_sort(list, exp, max) when div(max, exp) > 0 do
    sorted = counting_sort_by_digit(list, exp)
    do_radix_sort(sorted, exp * 10, max)
  end
  defp do_radix_sort(list, _exp, _max), do: list

  defp counting_sort_by_digit(list, exp) do
    # Create 10 empty buckets
    buckets = for _ <- 0..9, do: []
    # Distribute numbers into buckets based on the current digit
    Enum.reduce(list, buckets, fn num, acc ->
      digit = div(num, exp) |> rem(10)
      List.update_at(acc, digit, &[num | &1])
    end)
    # Reverse each bucket to maintain original order within the digit
    |> Enum.map(&Enum.reverse/1)
    # Concatenate all buckets
    |> List.flatten()
  end
end
