defmodule Test do
  use ExUnit.Case, async: false

  test "radix_sort with mixed numbers" do
    assert Solution.radix_sort([170, 45, 75, 90, 802, 24, 2, 66]) == [
             2,
             24,
             45,
             66,
             75,
             90,
             170,
             802
           ]
  end

  test "radix_sort with larger numbers" do
    assert Solution.radix_sort([123, 456, 789, 101_112, 13, 14, 15]) == [
             13,
             14,
             15,
             123,
             456,
             789,
             101_112
           ]
  end

  test "radix_sort with small numbers" do
    assert Solution.radix_sort([10, 12, 3, 1, 0, 22, 8, 16]) == [0, 1, 3, 8, 10, 12, 16, 22]
  end
end
