---MODULE---
defmodule Solution do
  @doc """
  Sorts a list of non-negative integers using the Radix Sort algorithm.
  """
  @spec radix_sort(list(non_neg_integer)) :: list(non_neg_integer)
  def radix_sort(list) when is_list(list) do
    case list do
      [] -> []
      _ ->
        max = Enum.max(list)
        exp = 1

        radix_sort(list, max, exp)
    end
  end

  defp radix_sort(list, _max, exp) when exp > 0 do
    sorted = sort_by_digit(list, exp)
    radix_sort(sorted, _max, exp * 10)
  end

  defp radix_sort(_list, _max, _exp) do
    []
  end

  defp sort_by_digit(list, exp) do
    buckets = List.duplicate([], 10)

    sorted =
      Enum.group_by(list, fn n -> rem(div(n, exp), 10) end)
      |> Enum.map(fn {digit, group} ->
        {digit, group}
      end)
      |> Enum.sort(fn {d1, _}, {d2, _} -> d1 < d2 end)
      |> Enum.map(fn {_, group} -> group end)
      |> Enum.concat([])

    # Wait, the above approach loses order if we just concat groups by digit.
    # We need to preserve the relative order within the groups (stable sort).
    # But Enum.group_by returns a map, and we lose order if we just concat groups.
    # However, we want to collect items in the order of the buckets 0..9.
    # Within each bucket, the items should maintain their original relative order.
    # Let's use a more explicit stable counting sort approach.

    # Actually, let's use a stable counting sort implementation.
    sort_by_digit_stable(list, exp)
  end

  defp sort_by_digit_stable(list, exp) do
    # We will create 10 buckets for digits 0..9
    # We process the list and append each number to its corresponding bucket.
    # This preserves the order within the buckets.
    buckets = Enum.reduce(list, List.duplicate([], 10), fn n, acc ->
      index = rem(div(n, exp), 10)
      # We need to append to the specific bucket index.
      # Since acc is a list of lists, we can use put_at.
      List.update_at(acc, index, fn current_bucket ->
        current_bucket ++ [n]
      end)
    end))

    # Flatten the buckets in order 0..9
    Enum.concat(buckets)
  end

  @spec radix_sort(list(non_neg_integer)) :: list(non_neg_integer)
end


