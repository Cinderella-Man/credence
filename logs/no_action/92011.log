  # Iterate through all rows in the grid, and for each row, count negative numbers.
  Enum.reduce(grid, 0, fn(row, count) -> count + length_negatives(row) end)
  end

  def length_negatives(row) do
  # Counts negative numbers in a list of integers
  import Enum do
  Enum.reduce(row, 0, fn(x, count) -> count + if x < 0, do count + 1 end)
  end
end
