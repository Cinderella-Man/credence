defmodule Solution do
  def find_most_occuring(s) do
    graphemes = String.graphemes(s)
    freq = Enum.reduce(graphemes, %{}, fn char, acc ->
      Map.update(acc, char, 1, &(&1 + 1))
    end)
    max_count = Enum.max(Map.values(freq))
    Enum.find(graphemes, fn char -> freq[char] == max_count end)
  end
end
