  use ExUnit.Case, async: false

  test "find most occurring character in 'hello world'" do
    assert Solution.find_most_occuring("hello world") == "l"
  end

  test "find most occurring character in 'character'" do
    assert Solution.find_most_occuring("character") == "c"
  end

  test "find most occurring character in 'success'" do
    assert Solution.find_most_occuring("success") == "s"
  end
end

