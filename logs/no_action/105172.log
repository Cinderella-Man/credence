---MODULE---
defmodule Solution do
  @doc """
  Returns the character with the highest frequency in a non-empty string.
  If multiple characters have the same highest frequency, returns the one
  that appears first in the string.
  """
  @spec find_most_occuring(String.t()) :: String.t()
  def find_most_occuring(input) when is_binary(input) and byte_size(input) > 0 do
    # Count frequency of each grapheme
    freq = input |> String.graphemes() |> Enum.count_by(& &1)

    # Find max frequency
    max_count = Enum.max(freq, fn {_, count} -> count end)

    # Filter to only those with max count
    candidates = Enum.filter(freq, fn {_, count} -> count == max_count end)

    # Find the first one that appears in the original string order
    # We need to find which candidate appears earliest in the input
    # Sort by first occurrence
    candidates
    |> Enum.min_by(fn {char, _} ->
      # Find the index of the first occurrence of char in the string
      input
      |> String.graphemes()
      |> Enum.find_index(& &1 == char)
      |> to_number()
    end)
    |> elem(0)
  end

  # Helper to convert nil or int to integer
  defp to_number(nil), do: 0
  defp to_number(n), do: n
end

---TEST---
