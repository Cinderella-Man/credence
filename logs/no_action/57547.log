defmodule Solution do
  @doc """
  Given a list of integers `nums` and a positive integer `k`, returns the number
  of contiguous non-empty subarrays whose sum is divisible by `k`.

  The algorithm runs in O(n) time by using a map to count remainders of prefix
  sums modulo k.
  """
  @spec subarrays_div_by_k([integer()], non_neg_integer()) :: non_neg_integer()
  def subarrays_div_by_k(nums, k) when is_list(nums) and is_integer(k) and k > 0 do
    {_, count} =
      Enum.reduce(nums, %{0 => 1}, fn num, remainder_counts ->
        # Update running total
        running_total = rem(running_total, k)
        
        # Compute non-negative remainder in [0, k-1]
        remainder = rem(remainder, k)
        
        # Add to answer the count of previous prefix sums with the same remainder
        current_count = Map.get(remainder_counts, remainder, 0)
        
        # Increment the count for that remainder
        new_remainder_counts = Map.put(remainder_counts, remainder, current_count + 1)
        
        {new_remainder_counts, running_total + num}
      end)
    
    count
  end
  
