@moduledoc """
Solution module for counting subarrays divisible by k.
"""

defmodule Solution do
  @doc """
  Given a list of integers `nums` and a positive integer `k`, returns the number
  of contiguous non-empty subarrays whose sum is divisible by `k`.

  The algorithm runs in O(n) time by using a map to count remainders of prefix
  sums modulo k.
  """
  @spec subarrays_div_by_k([integer()], non_neg_integer()) :: non_neg_integer()
  def subarrays_div_by_k(nums, k) when is_list(nums) and is_integer(k) and k > 0 do
    do_subarrays_div_by_k(nums, k, 0, %{0 => 1}, 0)
  end

  defp do_subarrays_div_by_k([], _k, _running_total, _remainder_counts, count) do
    count
  end

  defp do_subarrays_div_by_k([num | rest], k, running_total, remainder_counts, count) do
    new_running_total = running_total + num
    remainder = rem(new_running_total, k)
    remainder = if remainder < 0, do: remainder + k, else: remainder

    current_count = Map.get(remainder_counts, remainder, 0)
    new_count = count + current_count

    new_remainder_counts = Map.put(remainder_counts, remainder, current_count + 1)

    do_subarrays_div_by_k(rest, k, new_running_total, new_remainder_counts, new_count)
  end
end[0m
