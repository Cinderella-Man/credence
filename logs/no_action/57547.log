defmodule Solution do
  def subarrays_div_by_k(nums, k) do
    {_map, _current_sum, count} =
      Enum.reduce(nums, {%{0 => 1}, 0, 0}, fn num, {map, current_sum, count} ->
        new_sum = current_sum + num
        remainder = Integer.mod(new_sum, k)
        new_count = count + Map.get(map, remainder, 0)
        new_map = Map.update(map, remainder, 1, &(&1 + 1))
        {new_map, new_sum, new_count}
      end)

    count
  end
end
```
