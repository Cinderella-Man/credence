Write a function `find_original_array/1` that takes a list of integers as input, which represents a doubled array, and returns the original array if it can be reconstructed. A doubled array is constructed by taking an original array and appending each element's double to it. For example, if the original array is [1, 2], the doubled array would be [1, 2, 2, 4]. If the input does not form a valid doubled array, return an empty list. The input list can be empty, in which case an empty list should be returned. The function should handle cases where the array contains zeros, as each original zero yields two zeros in the doubled array.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "returns empty list when doubled array is invalid" do
    assert Solution.find_original_array([6, 3, 0, 1]) == []
  end

  test "returns original array from valid doubled array" do
    assert Solution.find_original_array([1, 2, 2, 4]) == [1, 2]
  end

  test "handles zeros correctly" do
    assert Solution.find_original_array([0, 0, 0, 0]) == [0, 0]
  end

  test "returns empty list for empty input" do
    assert Solution.find_original_array([]) == []
  end

  test "handles single element array" do
    assert Solution.find_original_array([1]) == []
  end

  test "handles array with only zeros but odd count" do
    assert Solution.find_original_array([0, 0, 0]) == []
  end
end
---REFERENCE---
defmodule Solution do
  def find_original_array(arr) do
    freq = Enum.frequencies(arr)
    sorted_keys = Map.keys(freq) |> Enum.sort()

    result = Enum.reduce_while(sorted_keys, {:ok, freq}, fn x, {:ok, acc} ->
      case process_key(x, acc) do
        {:ok, new_acc} -> {:cont, {:ok, new_acc}}
        :error -> {:halt, :error}
      end
    end)

    case result do
      {:ok, final_freq} ->
        Enum.sort_by(final_freq, fn {k, _} -> k end)
        |> Enum.flat_map(fn {k, v} -> List.duplicate(k, v) end)
      :error ->
        []
    end
  end

  defp process_key(0, acc) do
    count = Map.get(acc, 0, 0)
    if rem(count, 2) == 1 do
      :error
    else
      {:ok, Map.put(acc, 0, div(count, 2))}
    end
  end

  defp process_key(x, acc) do
    count_x = Map.get(acc, x, 0)
    count_2x = Map.get(acc, 2 * x, 0)
    if count_x > count_2x do
      :error
    else
      {:ok, Map.put(acc, 2 * x, count_2x - count_x)}
    end
  end
end
