---MODULE---
defmodule Solution do
  @doc """
  Takes a list of integers representing a doubled array and returns the original array.
  A doubled array is formed by taking an original array and appending each element's double to it.
  Returns an empty list if the input does not form a valid doubled array.
  """
  @spec find_original_array([integer()]) :: [integer()]
  def find_original_array(array) when is_list(array) do
    unless rem(length(array), 2) == 0 do
      []
    else
      reconstruct(array)
    end
  end

  defp reconstruct(array) do
    counts = Enum.reduce(array, %{}, fn num, acc ->
      Map.update(acc, num, 1, &(&1 + 1))
    end)

    sorted_nums = Map.keys(counts) |> Enum.sort()

    case build_original(sorted_nums, counts, []) do
      :invalid -> []
      original -> Enum.reverse(original)
    end
  end

  defp build_original([], counts, original) do
    if Map.values(counts) |> Enum.all?(&(&1 == 0)),
      do: original,
      else: :invalid
  end

  defp build_original([num | rest], counts, original) do
    case Map.fetch(counts, num) do
      :error ->
        :invalid

      {:ok, count} ->
        cond do
          count == 0 ->
            build_original(rest, counts, original)

          num == 0 ->
            if rem(count, 2) == 0 do
              half = div(count, 2)
              new_counts = Map.put(counts, 0, half)
              build_original(rest, new_counts, Enum.concat(original, List.duplicate(0, half)))
            else
              :invalid
            end

          true ->
            double = num * 2
            double_count = Map.get(counts, double, 0)

            if double_count >= count do
              new_counts =
                counts
                |> Map.put(num, 0)
                |> Map.update(double, count, &(&1 - count))

              build_original(rest, new_counts, Enum.concat(original, List.duplicate(num, count)))
            else
              :invalid
            end
        end
    end
  end
end
