defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "returns empty list when doubled array is invalid" do
    assert Solution.find_original_array([6, 3, 0, 1]) == []
  end

  test "returns original array from valid doubled array" do
    assert Solution.find_original_array([1, 2, 2, 4]) == [1, 2]
  end

  test "handles zeros correctly" do
    assert Solution.find_original_array([0, 0, 0, 0]) == [0, 0]
  end

  test "returns empty list for empty input" do
    assert Solution.find_original_array([]) == []
  end

  test "handles single element array" do
    assert Solution.find_original_array([1]) == []
  end

  test "handles array with only zeros but odd count" do
    assert Solution.find_original_array([0, 0, 0]) == []
  end
end
