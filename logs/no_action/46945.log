defmodule Solution do
  def shellsortex(list) do
    tuple = List.to_tuple(list)
    n = tuple_size(tuple)
    do_shell_sort(tuple, div(n, 2), n)
  end

  defp do_shell_sort(tuple, gap, _n) when gap <= 0, do: Tuple.to_list(tuple)
  defp do_shell_sort(tuple, gap, n) do
    tuple = process_i(tuple, gap, n, gap)
    do_shell_sort(tuple, div(gap, 2), n)
  end

  defp process_i(tuple, _gap, n, i) when i >= n, do: tuple
  defp process_i(tuple, gap, n, i) do
    temp = elem(tuple, i)
    tuple = insert_loop(tuple, gap, temp, i)
    process_i(tuple, gap, n, i + 1)
  end

  defp insert_loop(tuple, gap, temp, j) when j < gap or elem(tuple, j - gap) <= temp, do: put_elem(tuple, j, temp)
  defp insert_loop(tuple, gap, temp, j) do
    tuple = put_elem(tuple, j, elem(tuple, j - gap))
    insert_loop(tuple, gap, temp, j - gap)
  end
end
