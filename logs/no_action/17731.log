defmodule Solution do
  @doc """
  Takes two lists of the same length and returns the number of positions
  where the elements are equal.
  """
  @spec count_matches(list(), list()) :: non_neg_integer()
  def count_matches(list1, list2) do
    do_count_matches(list1, list2, 0)
  end

  defp do_count_matches([], [], count), do: count

  defp do_count_matches([h1 | t1], [h2 | t2], count) do
    new_count =
      case h1 == h2 do
        true -> count + 1
        false -> count
      end

    do_count_matches(t1, t2, new_count)
  end
end
---TEST---
