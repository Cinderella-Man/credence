defmodule Solution do
  @doc """
  Returns the nth Lucas number.

  The Lucas sequence is defined as:
  - L(0) = 2
  - L(1) = 1
  - L(n) = L(n-1) + L(n-2) for n > 1

  ## Examples

      iex> Solution.lucasnumber(0)
      2

      iex> Solution.lucasnumber(1)
      1

      iex> Solution.lucasnumber(5)
      11
  """
  @spec lucasnumber(non_neg_integer()) :: non_neg_integer()
  def lucasnumber(0), do: 2
  def lucasnumber(1), do: 1
  def lucasnumber(n) when is_integer(n) and n > 1 do
    lucasnumber_iterative(n, 2, 1)
  end

  defp lucasnumber_iterative(0, current, _previous), do: current
  defp lucasnumber_iterative(1, _current, previous), do: previous

  defp lucasnumber_iterative(step, current, previous) do
    lucasnumber_iterative(step - 1, current + previous, current)
  end
end
