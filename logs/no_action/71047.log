@spec non_zero_positions([[number]]) :: [{non_neg_integer(), non_neg_integer()}]
def non_zero_positions(matrix) do
  matrix
  |> Enum.with_index()
  |> Enum.flat_map(fn {row, col_index} ->
    row
    |> Enum.with_index()
    |> Enum.filter(fn {value, _col_idx} -> value != 0 end)
    |> Enum.map(fn {_value, col_idx} -> {col_index, col_idx} end)
  end)
end
