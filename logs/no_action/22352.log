  @spec anagram_checker(String.t(), String.t()) :: boolean()
  def anagram_checker(string1, string2) do
    normalized1 = normalize(string1)
    normalized2 = normalize(string2)

    normalized1 == normalized2
  end

  defp normalize(string) do
    string
    |> String.downcase()
    |> String.replace(~r/\s/, "")
    |> String.graphemes()
    |> Enum.sort()
  end
end
