---REFERENCE---
defmodule Solution do
  @vowels MapSet.new([?a, ?e, ?i, ?o, ?u, ?A, ?E, ?I, ?O, ?U])

  def count_vowels_consonants(input_string) do
    input_string
    |> String.to_charlist()
    |> Enum.reduce({0, 0}, fn char, {v, c} ->
      cond do
        char in ?a..?z or char in ?A..?Z ->
          if char in @vowels, do: {v + 1, c}, else: {v, c + 1}
        true ->
          {v, c}
      end
    end)
  end
end
