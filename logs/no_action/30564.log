defmodule Solution do
  @doc """
  Counts the number of vowels and consonants in a given string.

  Only alphabetic characters are considered. Vowels are A, E, I, O, U (case-insensitive).
  All other alphabetic characters are counted as consonants.
  Non-alphabetic characters (digits, spaces, punctuation) are ignored.

  ## Examples

      iex> Solution.count_vowels_consonants("Hello World")
      {3, 7}

      iex> Solution.count_vowels_consonants("")
      {0, 0}

      iex> Solution.count_vowels_consonants("123 !@#")
      {0, 0}
  """
  @spec count_vowels_consonants(String.t()) :: {non_neg_integer(), non_neg_integer()}
  def count_vowels_consonants(string) do
    string
    |> to_charlist()
    |> Enum.reduce({0, 0}, fn char, {vowel_count, consonant_count} ->
      cond do
        char in ~c(AEIOUaeiou) ->
          {vowel_count + 1, consonant_count}

        char in ~c(BCDFGHJKLMNPQRSTVWXYZbcdfghjklmnpqrstvwxz) ->
          {vowel_count, consonant_count + 1}

        true ->
          {vowel_count, consonant_count}
      end
    end)
  end
end
