---INSTRUCTION---
Given a list of words (strings), return the k most frequently occurring words. The words should be returned in order from most frequent to least frequent. If two or more words have the same frequency, return them in the order of their first appearance in the input list.

Implement a function `frequent_words/2` in a module `Solution` that accepts two arguments: a list of strings `words` and an integer `k`. The function returns a list of the k most frequent strings.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "returns the 3 most frequent words" do
    words = ["the", "day", "is", "sunny", "the", "the", "the", "sunny", "is", "is"]
    assert Solution.frequent_words(words, 3) == ["the", "is", "sunny"]
  end

  test "returns the 2 most frequent words with ties broken by first occurrence" do
    words = ["apple", "orange", "banana", "apple", "orange", "grape", "grape", "grape"]
    assert Solution.frequent_words(words, 2) == ["grape", "apple"]
  end

  test "returns the single most frequent word" do
    words = ["hello", "world", "hello", "python", "python", "python"]
    assert Solution.frequent_words(words, 1) == ["python"]
  end
end

---REFERENCE---
defmodule Solution do
  def frequent_words(words, k) do
    {counts, first_index} =
      words
      |> Enum.with_index()
      |> Enum.reduce({%{}, %{}}, fn {word, idx}, {counts, first_index} ->
        counts = Map.update(counts, word, 1, &(&1 + 1))
        first_index = Map.update(first_index, word, idx, & &1)
        {counts, first_index}
      end)

    words
    |> Enum.uniq()
    |> Enum.map(fn word ->
      {word, Map.get(counts, word), Map.get(first_index, word)}
    end)
    |> Enum.sort_by(fn {_word, count, idx} -> {-count, idx} end)
    |> Enum.take(k)
    |> Enum.map(fn {word, _count, _idx} -> word end)
  end
end

