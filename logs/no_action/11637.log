@doc """
Returns the k most frequent words from the given list of words.
Words are sorted by frequency (descending), and ties are broken by first occurrence (ascending).
"""
@spec frequent_words([String.t()], non_neg_integer()) :: [String.t()]
def frequent_words(words, k) do
  words
  |> Enum.with_index()
  |> Enum.reduce(%{}, fn {word, index}, acc ->
    Map.update(acc, word, {1, index}, fn {count, first_index} ->
      {count + 1, first_index}
    end)
  end)
  |> Enum.sort_by(fn {_word, {count, first_index}} ->
    # Sort by count descending, then by first_index ascending
    {%{count: count, first_index: first_index}, []}
  end, fn a, b ->
    # Custom comparator for :custom sort
    case {elem(a, 1).count, elem(a, 1).first_index} |> compare({elem(b, 1).count, elem(b, 1).first_index}) do
      :lt -> :lt
      :gt -> :gt
      :eq -> :lt
    end
  end)
  |> Enum.take(k)
  |> Enum.map(fn {word, _info} ->
    word
  end)
end

