  def frequent_words(words, k) do
    # Count frequencies and track first occurrence index
    freq_map =
      words
      |> Stream.with_index()
      |> Enum.reduce(%{}, fn {word, index}, acc ->
        Map.update(acc, word, {1, index}, fn {count, first_index} ->
          {count + 1, first_index}
        end)
      end)

    # Convert to list of tuples and sort by:
    # 1. Frequency descending (higher frequency first)
    # 2. First occurrence index ascending (earlier occurrence first for ties)
    sorted_words =
      freq_map
      |> Enum.sort_by(fn {_word, {count, first_index}} -> {-count, first_index} end)
      |> Enum.take(k)

    # Extract just the words
    sorted_words
    |> Enum.map(fn {word, _info} ->
      word
    end)
  end
end
