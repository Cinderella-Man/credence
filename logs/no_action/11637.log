    words = ["apple", "orange", "banana", "apple", "orange", "grape", "grape", "grape"]
    assert Solution.frequent_words(words, 2) == ["grape", "apple"]
  end

  test "returns the single most frequent word" do
    words = ["hello", "world", "hello", "python", "python", "python"]
    assert Solution.frequent_words(words, 1) == ["python"]
  end
end

