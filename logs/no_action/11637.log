---MODULE---
@doc """
Returns the k most frequent words from the given list of words.
Words are sorted by frequency (descending), and ties are broken by first occurrence.
"""
@spec frequent_words([String.t()], non_neg_integer()) :: [String.t()]
def frequent_words(words, k) when is_list(words) and is_integer(k) and k >= 0 do
  words
  |> Enum.with_index()
  |> Enum.reduce(%{}, fn {word, index}, acc ->
    Map.update(acc, word, {1, index}, fn {count, first_index} ->
      {count + 1, first_index}
    end)
  end)
  |> Enum.sort_by(fn {_word, {count, first_index}} ->
    {count, first_index}
  end, :desc)
  |> Enum.take(k)
  |> Enum.map(fn {word, {_count, _first_index}} ->
    word
  end)
end

---TEST---
