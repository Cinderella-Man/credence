defmodule Solution do
  def kth_smallest_element(list, k) do
    quick_select(list, k - 1)
  end

  defp quick_select(list, k) do
    pivot = List.last(list)
    {left, rest} = Enum.split_while(list, &(&1 < pivot))
    {pivots, right} = Enum.split_while(rest, &(&1 == pivot))

    len_left = length(left)
    len_pivots = length(pivots)

    cond do
      k < len_left -> quick_select(left, k)
      k < len_left + len_pivots -> pivot
      true -> quick_select(right, k - (len_left + len_pivots))
    end
  end
end
