@doc """
Finds the kth smallest element in a list using the QuickSelect algorithm.
"""
@spec kth_smallest_element(list(), integer()) :: integer()
def kth_smallest_element(list, k) when is_list(list) and is_integer(k) and k >= 1 do
  do_kth_smallest(list, k)
end

defp do_kth_smallest(list, k) do
  # Choose pivot as the middle element
  {pivot, lower, upper} = partition(list)

  len_lower = length(lower)
  len_equal = length(upper)

  cond do
    # k is in the lower partition (elements less than pivot)
    k <= len_lower ->
      do_kth_smallest(lower, k)
    # k is in the upper partition (elements greater than pivot)
    k > len_lower + len_equal ->
      do_kth_smallest(upper, k - len_lower - len_equal)
    # pivot is the kth smallest
    true ->
      pivot
  end
end

defp partition([pivot | rest]) do
  lower = Enum.filter(rest, &(&1 < pivot))
  equal = Enum.filter(rest, &(&1 == pivot))
  upper = Enum.filter(rest, &(&1 > pivot))
  {pivot, lower, [pivot | equal] ++ upper}
end[0m
