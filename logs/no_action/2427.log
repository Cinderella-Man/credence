@doc """
Finds the kth smallest element in a list using the QuickSelect algorithm.
"""
@spec kth_smallest_element(list(), integer()) :: integer()
def kth_smallest_element(list, k) when is_list(list) and is_integer(k) and k >= 1 and k <= length(list) do
  do_kth_smallest(list, k)
end

defp do_kth_smallest([pivot], _k) do
  pivot
end

defp do_kth_smallest(list, k) do
  # Pick a random pivot for better average-case performance
  {pivot, rest} = Enum.split(list, Enum.random(1..length(list)))
  pivot = List.first(pivot)

  {_lower, _equal, _upper} = Enum.reduce(rest, {[], [pivot], []}, fn
    val, {l, e, u} when val < pivot -> {l, e, [val | u]}
    val, {l, e, u} when val == pivot -> {[val | l], [pivot | e], u}
    val, {l, e, u} when val > pivot -> {l, e, [val | u]}
    _val, acc -> acc
  end)

  # Re-include the original pivot in equal if it wasn't added above (edge case)
  # Actually, let's simplify: just filter all elements.
  
  lower = Enum.filter(list, &(&1 < pivot))
  equal = Enum.filter(list, &(&1 == pivot))
  upper = Enum.filter(list, &(&1 > pivot))

  len_lower = length(lower)
  len_equal = length(equal)

  cond do
    k <= len_lower ->
      do_kth_smallest(lower, k)
    k <= len_lower + len_equal ->
      pivot
    true ->
      do_kth_smallest(upper, k - len_lower - len_equal)
  end
end
end
