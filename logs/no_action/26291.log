---MODULE---
@doc """
Finds the maximum number of characters that can be selected from a string to form a palindrome.

Characters may be rearranged arbitrarily. A palindrome can have at most one character
with an odd count. All other characters must contribute their full count (or the largest
even portion of their count).
"""
@spec max_palindrome_chars(String.t()) :: non_neg_integer()
def max_palindrome_chars(string) do
  string
  |> String.graphemes()
  |> Enum.frequencies()
  |> calculate_max_length()
end

defp calculate_max_length(frequency_map) do
  {sum_of_evens, odd_count} =
    frequency_map
    |> Map.values()
    |> Enum.reduce({0, 0}, fn count, {sum, odds} ->
      if rem(count, 2) == 0 do
        {sum + count, odds}
      else
        {sum + count - 1, odds + 1}
      end
    end)

  # If there is at least one character with an odd count, we can place one in the center
  if odd_count > 0 do
    sum_of_evens + 1
  else
    sum_of_evens
  end
end
