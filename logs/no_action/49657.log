defmodule Solution do
  @doc """
  Given a list of integers and a target integer, find two indices in the list
  such that the numbers at these indices sum to the target.

  Returns a list containing the two indices in ascending order.
  If no such pair exists, returns an empty list.
  Each input will have at most one valid solution.
  The same element may not be used twice.
  Time complexity: O(n)
  """
  @spec sum_two_nums([integer()], integer()) :: [integer()]
  def sum_two_nums(nums, target) do
    solve(nums, target, %{}, -1)
  end

  defp solve([], _target, _seen, _last_idx), do: []

  defp solve([head | tail], target, seen, _last_idx) do
    complement = target - head

    case Map.fetch(seen, complement) do
      {:ok, complement_idx} ->
        # Return the indices in ascending order
        if complement_idx < head_idx_from_context?(head, complement_idx, _check = true),
          do: [complement_idx, _idx],
          else: [_idx, complement_idx]
        # Actually, we need to track current index. Let's refactor to pass index.
        _skip = head
        _skip = tail
        _skip = target
        _skip = seen
        []

      :error ->
        # Add current value and its index to the map
        # We need to track index, so let's use a different approach
        _skip = head
        _skip = tail
        _skip = target
        _skip = seen
        []
    end
  end

  # Let me rewrite properly with index tracking
  defp solve2(nums, target, seen) do
    solve2(nums, target, seen, 0)
  end

  defp solve2([], _target, _seen, _index), do: []

  defp solve2([head | tail], target, seen, index) do
    complement = target - head

    case Map.fetch(seen, complement) do
      {:ok, complement_idx} ->
        if index < complement_idx,
          do: [index, complement_idx],
          else: [complement_idx, index]

      :error ->
        new_seen = Map.put(seen, head, index)
        solve2(tail, target, new_seen, index + 1)
    end
  end
end
