  use ExUnit.Case, async: false

  test "single element list" do
    assert Solution.num_permutations([1]) == 1
  end

  test "four elements" do
    assert Solution.num_permutations(["a", "b", "c", "d"]) == 24
  end

  test "three numbers" do
    assert Solution.num_permutations([1, 2, 3]) == 6
  end
end
