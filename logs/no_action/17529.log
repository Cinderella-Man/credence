  Returns the number of permutations of a given list of distinct items.
  This is equivalent to calculating n! where n is the length of the list.

  ## Examples

      iex> Solution.num_permutations([1, 2, 3])
      6

      iex> Solution.num_permutations(["a", "b", "c", "d"])
      24

      iex> Solution.num_permutations([])
      1
  """
  @spec num_permutations(list(any())) :: non_neg_integer()
  def num_permutations(list) when is_list(list) do
    list
    |> Enum.count()
    |> factorial()
  end

  defp factorial(0), do: 1
  defp factorial(1), do: 1

  defp factorial(n) when n > 1 do
    Enum.reduce(2..n, 1, fn val, acc -> acc * val end)
  end
end[0m
