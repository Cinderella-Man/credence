---MODULE---
defmodule Solution do
  @doc """
  Determines if two strings are special-equivalent.
  Two strings are special-equivalent if characters at even indices can be
  rearranged among even positions, and characters at odd indices can be
  rearranged among odd positions, to make the strings equal.
  """
  @spec special_equivalent?(binary(), binary()) :: boolean()
  def special_equivalent?(str1, str2) when is_binary(str1) and is_binary(str2) do
    len1 = byte_size(str1)
    len2 = byte_size(str2)

    if len1 != len2 do
      false
    else
      case split_even_odd(str1) do
        {chars1_even, chars1_odd} ->
          case split_even_odd(str2) do
            {chars2_even, chars2_odd} ->
              Enum.sort(chars1_even) == Enum.sort(chars2_even) &&
                Enum.sort(chars1_odd) == Enum.sort(chars2_odd)
          end
      end
    end
  end

  defp split_even_odd(binary) do
    do_split_even_odd(String.graphemes(binary), 0, [], [])
    |> then(fn {evens, odds} -> {Enum.reverse(evens), Enum.reverse(odds)} end)
  end

  defp do_split_even_odd([], _index, evens, odds), do: {evens, odds}

  defp do_split_even_odd([char | rest], index, evens, odds) do
    if rem(index, 2) == 0 do
      do_split_even_odd(rest, index + 1, [char | evens], odds)
    else
      do_split_even_odd(rest, index + 1, evens, [char | odds])
    end
  end
end
---TEST---
