  use ExUnit.Case, async: false

  test "special_equivalent? returns true for special-equivalent strings" do
    assert Solution.special_equivalent?("zzxy", "xyzz") == true
    assert Solution.special_equivalent?("abcd", "cdab") == true
  end

  test "special_equivalent? returns false for non-special-equivalent strings" do
    assert Solution.special_equivalent?("zzxy", "zzyx") == false
  end
end
