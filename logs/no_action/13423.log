  use ExUnit.Case, async: false

  test "special_equivalent? returns true for special-equivalent strings" do
    assert Solution.special_equivalent?("zzxy", "xyzz") == true
    assert Solution.special_equivalent?("abcd", "cdab") == true
  end

  test "special_equivalent? returns false for non-special-equivalent strings" do
    assert Solution.special_equivalent?("zzxy", "zzyx") == false
  end
end
---REFERENCE---
defmodule Solution do
  @spec special_equivalent?(String.t(), String.t()) :: boolean
  def special_equivalent?(str1, str2) do
    if String.length(str1) != String.length(str2) do
      false
    else
      chars1 = String.to_charlist(str1)
      chars2 = String.to_charlist(str2)

      even1 = Enum.take_every(chars1, 2) |> Enum.sort()
      odd1 = if length(chars1) > 0, do: chars1 |> tl() |> Enum.take_every(2) |> Enum.sort(), else: []
      even2 = Enum.take_every(chars2, 2) |> Enum.sort()
      odd2 = if length(chars2) > 0, do: chars2 |> tl() |> Enum.take_every(2) |> Enum.sort(), else: []

      even1 == even2 and odd1 == odd2
    end
  end
end
