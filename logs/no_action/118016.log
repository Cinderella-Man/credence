defmodule Solution do
  def max_consecutive_zeroes(list) do
    {_, max_run} =
      Enum.reduce(list, {0, 0}, fn x, {current_run, max_run} ->
        if x == 0 do
          new_run = current_run + 1
          {new_run, max(new_run, max_run)}
        else
          {0, max_run}
        end
      end)

    max_run
  end
end
```
