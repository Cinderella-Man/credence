---MODULE---
defmodule Solution do
  @doc """
  Returns the maximum number of consecutive zeros in a list of integers.
  """
  @spec max_consecutive_zeroes(list(integer)) :: non_neg_integer()
  def max_consecutive_zeroes(list) when is_list(list) do
    list
    |> Enum.reduce_while({0, 0, false}, fn
      0, {_max_run, current_run, _seen_zero} ->
        new_run = current_run + 1
        {:cont, {max(_max_run, new_run), new_run, true}}

      _non_zero, {max_run, 0, seen_zero} ->
        # If we were not tracking a current run, just continue
        {:cont, {max_run, 0, seen_zero}}

      _non_zero, {max_run, _current_run, _seen_zero} ->
        # Sequence broken, reset current run but keep max
        {:cont, {max_run, 0, true}}
    end)
    |> elem(0)
  end
end
