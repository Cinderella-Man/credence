defmodule Solution do
  @spec can_construct_ransom_note(String.t(), String.t()) :: boolean()
  def can_construct_ransom_note(ransom_note, magazine) do
    ransom_counts = ransom_note |> String.graphemes() |> Enum.frequencies()
    magazine_counts = magazine |> String.graphemes() |> Enum.frequencies()

    Enum.all?(ransom_counts, fn {char, count} ->
      Map.get(magazine_counts, char, 0) >= count
    end)
  end
end
