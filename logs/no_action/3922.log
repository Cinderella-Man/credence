@doc """
Checks if a ransom note can be constructed from the letters in a magazine.

Each letter in the magazine can be used at most once.
An empty ransom note can always be constructed.

Time complexity: O(n + m) where n and m are the lengths of the strings.
"""
@spec can_construct_ransom_note(String.t(), String.t()) :: boolean()
def can_construct_ransom_note(ransom_note, magazine)

def can_construct_ransom_note("", _magazine), do: true

def can_construct_ransom_note(ransom_note, magazine) do
  magazine_counts = build_char_counts(magazine)
  can_construct?(ransom_note, magazine_counts)
end

@doc false
@spec build_char_counts(String.t()) :: %{required(String.grapheme()) => non_neg_integer()}
defp build_char_counts(str) do
  str
  |> String.graphemes()
  |> Enum.reduce(%{}, fn grapheme, counts ->
    Map.update(counts, grapheme, 1, &(&1 + 1))
  end)
end

@doc false
@spec can_construct?(String.t(), %{required(String.grapheme()) => non_neg_integer()}) :: boolean()
defp can_construct?("", _counts), do: true

defp can_construct?([grapheme | rest], counts) do
  case counts[grapheme] do
    nil -> false
    0 -> false
    _ ->
      new_counts = Map.update!(counts, grapheme, &(&1 - 1))
      can_construct?(rest, new_counts)
  end
end

defp can_construct?(<<grapheme::binary-1, rest::binary>>, counts) do
  case counts[grapheme] do
    nil -> false
    0 -> false
    _ ->
      new_counts = Map.update!(counts, grapheme, &(&1 - 1))
      can_construct?(rest, new_counts)
  end
end

