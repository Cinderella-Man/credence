defmodule Solution do
  @moduledoc false

  @spec check_magic_square(list(list(integer())) | list()) :: boolean()
  def check_magic_square(matrix) do
    unless is_magic_square_size?(matrix) do
      false
    else
      target_sum = Enum.sum(hd(matrix))

      valid_rows? = Enum.all?(matrix, &row_sum_equals?(&1, target_sum))
      valid_cols? = valid_columns?(matrix, target_sum)
      valid_diag1? = valid_diagonal1?(matrix, target_sum)
      valid_diag2? = valid_diagonal2?(matrix, target_sum)
      numbers_unique? = numbers_are_unique?(matrix)

      (valid_rows? and valid_cols? and valid_diag1? and valid_diag2?) and numbers_unique?
    end
  end

  defp is_magic_square_size?(matrix) do
    Enum.all?(matrix, &(&1 |> Enum.count() == 3))
  end

  defp row_sum_equals?(row, target) do
    Enum.sum(row) == target
  end

  defp valid_columns?(matrix, target) do
    Enum.all?(0..2, fn col_idx ->
      column_sum = Enum.sum(Enum.map(matrix, &Enum.fetch(&1, col_idx)))
      column_sum == target
    end)
  end

  defp valid_diagonal1?(matrix, target) do
    Enum.sum(Enum.map(matrix, &Enum.fetch(&1, 0))) == target
  end

  defp valid_diagonal2?(matrix, target) do
    Enum.sum(Enum.map(matrix, &Enum.fetch(&1, 2))) == target
  end

  defp numbers_are_unique?(matrix) do
    matrix
    |> List.flatten()
    |> Enum.sort()
    |> Enum.any(fn _val ->
      Enum.find_index([1, 2, 3, 4, 5, 6, 7, 8, 9], fn _val -> true end)
    end)
    |> case do
      nil -> true
      _ -> false
    end
  end
end[0m
