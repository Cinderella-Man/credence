defmodule Solution do
  @moduledoc false

  @spec check_magic_square(list(list(integer())) | list()) :: boolean()
  def check_magic_square(matrix) do
    valid_size?(matrix) and
      (
        target_sum = Enum.sum(hd(matrix))

        valid_rows?(matrix, target_sum) and
          valid_columns?(matrix, target_sum) and
          valid_diagonal1?(matrix, target_sum) and
          valid_diagonal2?(matrix, target_sum) and
          numbers_unique?(matrix)
      )
  end

  @spec valid_size?(list(list(any))) :: boolean()
  defp valid_size?(matrix) do
    Enum.all?(matrix, fn row -> Enum.count(row) == 3 end)
  end

  @spec valid_rows?(list(list(integer())), integer()) :: boolean()
  defp valid_rows?(matrix, target) do
    Enum.all?(matrix, fn row -> row_sum_equals?(row, target) end)
  end

  @spec row_sum_equals?(list(integer()), integer()) :: boolean()
  defp row_sum_equals?(row, target) do
    Enum.sum(row) == target
  end

  @spec valid_columns?(list(list(integer())), integer()) :: boolean()
  defp valid_columns?(matrix, target) do
    Enum.all?(0..2, fn col_idx ->
      column_sum = Enum.reduce(matrix, 0, fn el, acc -> acc + Enum.fetch!(el, col_idx) end)
      column_sum == target
    end)
  end

  @spec valid_diagonal1?(list(list(integer())), integer()) :: boolean()
  defp valid_diagonal1?(matrix, target) do
    Enum.reduce(matrix, 0, fn el, acc -> acc + Enum.fetch!(el, 0) end) == target
  end

  @spec valid_diagonal2?(list(list(integer())), integer()) :: boolean()
  defp valid_diagonal2?(matrix, target) do
    Enum.reduce(matrix, 0, fn el, acc -> acc + Enum.fetch!(el, 2) end) == target
  end

  @spec numbers_unique?(list(list(any))) :: boolean()
  defp numbers_unique?(matrix) do
    expected = [1, 2, 3, 4, 5, 6, 7, 8, 9]
    flattened = matrix |> List.flatten() |> Enum.sort()
    flattened == expected
  end
end[0m
