    assert Solution.check_magic_square([[4, 9, 2], [3, 5, 7], [8, 1, 6]]) == true
  end

  test "non-magic square with repeated elements" do
    assert Solution.check_magic_square([[5, 3, 4], [1, 5, 8], [6, 4, 2]]) == false
