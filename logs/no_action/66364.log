defmodule Solution do
  @moduledoc false

  @spec check_magic_square(list(list(integer())) | list()) :: boolean()
  def check_magic_square(matrix) do
    unless is_magic_size(matrix) do
      false
    else
      sum = Enum.at(matrix, 0) |> List.sum()
      valid_rows = Enum.all?(matrix, &row_sum_equals(&1, sum))
      valid_cols = valid_columns(matrix, sum)
      valid_diag1 = Enum.sum(matrix |> Enum.map(&hd/1)) == sum
      valid_diag2 = Enum.sum(Enum.map(matrix, &Enum.fetch(&1, 0))) == sum

      all_sums_equal = valid_rows and valid_cols and valid_diag1 and valid_diag2
      numbers_unique = validate_numbers(matrix)

      all_sums_equal and numbers_unique
    end
  end

  defp is_magic_size(matrix) do
    Enum.all?(matrix, &(&1 |> Enum.count() == 3))
  end

  defp row_sum_equals(row, target) do
    Enum.sum(row) == target
  end

  defp valid_columns(matrix, target) do
    Enum.all?(0..2, fn col ->
      Enum.sum(Enum.map(matrix, &Enum.fetch(&1, col))) == target
    end)
  end

  defp validate_numbers(matrix) do
    Enum.map(matrix, &Enum.sort/1)
    |> List.flatten()
    |> Enum.sort()
    |> Enum.any(fn x ->
      Enum.find_index([1, 2, 3, 4, 5, 6, 7, 8, 9], fn x -> x == x end)
    end)
    |> case do
      nil -> true
      _ -> false
    end
  end

  defp diag1_sum(matrix) do
    Enum.sum(Enum.map(matrix, &Enum.fetch(&1, 0)))
  end

  defp diag2_sum(matrix) do
    Enum.sum(Enum.map(matrix, &Enum.fetch(&1, 0)))
  end
end[0m
