---REFERENCE---
defmodule Solution do
  def check_magic_square(matrix) do
    flat = List.flatten(matrix)

    # Must contain exactly 1..9
    if Enum.sort(flat) != Enum.to_list(1..9) do
      false
    else
      # All rows
      row_sums = Enum.map(matrix, &Enum.sum/1)

      # All columns
      cols = for c <- 0..2 do
        Enum.map(matrix, fn row -> Enum.at(row, c) end)
      end
      col_sums = Enum.map(cols, &Enum.sum/1)

      # Main diagonal
      diag1 = Enum.at(Enum.at(matrix, 0), 0) + Enum.at(Enum.at(matrix, 1), 1) + Enum.at(Enum.at(matrix, 2), 2)

      # Anti-diagonal
      diag2 = Enum.at(Enum.at(matrix, 0), 2) + Enum.at(Enum.at(matrix, 1), 1) + Enum.at(Enum.at(matrix, 2), 0)

      all_sums = row_sums ++ col_sums ++ [diag1, diag2]
      Enum.all?(all_sums, &(&1 == Enum.at(row_sums, 0)))
    end
  end
end
