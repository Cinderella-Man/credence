defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "merge three dictionaries" do
    assert Solution.merge_dicts([%{"a" => 1, "b" => 2, "c" => 3}, %{"a" => 4, "b" => 5, "d" => 6}, %{"a" => 7, "c" => 8, "e" => 9}]) == %{"a" => 12, "b" => 7, "c" => 11, "d" => 6, "e" => 9}
  end

  test "merge three dictionaries with different keys" do
    assert Solution.merge_dicts([%{"x" => 10, "y" => 20}, %{"x" => 30, "z" => 40}, %{"x" => 50, "y" => 60, "z" => 70}]) == %{"x" => 90, "y" => 80, "z" => 110}
  end

  test "merge three dictionaries with overlapping keys" do
    assert Solution.merge_dicts([%{"m" => 1, "n" => 2}, %{"m" => 3, "o" => 4}, %{"m" => 5, "n" => 6, "o" => 7, "p" => 8}]) == %{"m" => 9, "n" => 8, "o" => 11, "p" => 8}
  end

  test "empty list returns empty map" do
    assert Solution.merge_dicts([]) == %{}
  end

  test "single map returns same map" do
    assert Solution.merge_dicts([%{"a" => 5, "b" => 10}]) == %{"a" => 5, "b" => 10}
  end
end

---REFERENCE---
defmodule Solution do
  def merge_dicts([]), do: %{}
  def merge_dicts([map | rest]) do
    merge_dicts(rest, map)
  end

  defp merge_dicts([], acc), do: acc
  defp merge_dicts([map | rest], acc) do
    new_acc =
      Enum.reduce(map, acc, fn {k, v}, acc ->
        Map.update(acc, k, v, &(&1 + v))
      end)

    merge_dicts(rest, new_acc)
  end
end

