---REFERENCE---
```elixir
defmodule Solution do
  @spec length_of_longest_unique_subarray(list(integer())) :: integer()
  def length_of_longest_unique_subarray(list) do
    list
    |> Enum.with_index()
    |> Enum.reduce({0, 0, %{}}, fn {value, end_index}, {start, max_length, seen} ->
      if Map.has_key?(seen, value) and start <= seen[value] do
        {seen[value] + 1, max_length, Map.put(seen, value, end_index)}
      else
        {start, max(max_length, end_index - start + 1), Map.put(seen, value, end_index)}
      end
    end)
    |> elem(1)
  end
end
```
