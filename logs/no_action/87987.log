@doc """
Takes a grid (a list of lists of numbers) and an integer k,
and returns a list of the k biggest numbers in the grid, sorted in descending order.

If the grid is empty or k is larger than the total number of elements,
returns as many numbers as possible in descending order.

Runs in O(n log n) time.
"""
@spec k_biggest_numbers([[number()]], integer()) :: [number()]
def k_biggest_numbers(grid, k) when is_list(grid) and is_integer(k) and k >= 0 do
  grid
  |> Enum.concat()
  |> Enum.sort(:desc)
  |> Enum.take(k)
end
