defmodule Solution do
  @doc """
  Sorts a list of students by grade based on the order parameter.
  """
  @spec sort_students([tuple()], integer()) :: [tuple()]
  def sort_students(students, 1) do
    Enum.sort(students, fn {_, grade_a}, {_, grade_b} ->
      grade_a <= grade_b
    end)
  end

  def sort_students(students, 0) do
    Enum.sort(students, fn {_, grade_a}, {_, grade_b} ->
      grade_a >= grade_b
    end)
  end

  def sort_students([], _) do
    []
  end
end
