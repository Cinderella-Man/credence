    content: defmodule Credence.Pattern.NoUnreachableEmptyListClauseEquivalenceTest do
  @moduledoc """
  Tier 2 (module-call) behaviour equivalence.

  The fix removes an unreachable `[]` clause that follows a catch-all clause.
  Since the catch-all already matches every input (including empty lists),
  the removed clause is dead code and the function's behaviour is unchanged
  for every input.
  """
  use Credence.RuleCase, async: true

  import Credence.BehaviourEquivalence
  alias Credence.Pattern.NoUnreachableEmptyListClause

  @before """
  defmodule Solution do
    def sort(_, _), do: :catchall
    def sort([], _), do: []
  end
  """

  test "removing unreachable [] clause after catch-all preserves behaviour" do
    assert_equivalent_module(@before,
      rule: NoUnreachableEmptyListClause,
      call: {:sort, 2},
      # The catch-all clause always returns :catchall, so the removed []
      # clause never executes. Output is constant across all inputs.
      allow_constant_output: true,
      inputs: [
        {[], []},
        {[], [1, 2]},
        {[1, 2], [3, 4]},
        {:foo, :bar},
        {nil, nil}
      ]
    )
  end
end

