    content: defmodule Credence.Pattern.NoUnreachableEmptyListClause do
  @moduledoc """
  Detects `[]` (empty list) clauses that follow a catch-all clause in a
  multi-clause function definition and are therefore unreachable at runtime.

  When a clause with only bare variables or underscores (no guard) precedes
  an `[]` clause in the same function, the catch-all already matches empty
  lists, making the `[]` clause dead code. Credence's compiler-warning rule
  does not fire here because Elixir does not emit an unused-clause warning
  for structural patterns like `[]` after a catch-all.

  ## Bad

      def sort_students(students, 1) do
        Enum.sort(students, fn {_, grade_a}, {_, grade_b} -> grade_a <= grade_b end)
      end

      def sort_students(students, 0) do
        Enum.sort(students, fn {_, grade_a}, {_, grade_b} -> grade_a >= grade_b end)
      end

      def sort_students([], _), do: []   # unreachable!

  ## Good

      def sort_students(students, 1) do
        Enum.sort(students, fn {_, grade_a}, {_, grade_b} -> grade_a <= grade_b end)
      end

      def sort_students(students, 0) do
        Enum.sort(students, fn {_, grade_a}, {_, grade_b} -> grade_a >= grade_b end)
      end

  ## Auto-fix

  Removes the unreachable `[]` clause.
  """

  use Credence.Pattern.Rule
  alias Credence.Issue

  @impl true
  def check(ast, _opts) do
    ast
    |> extract_def_groups()
    |> Enum.flat_map(fn {_key, clauses} ->
      find_unreachable_empty_list_clauses(clauses)
    end)
  end

  @impl true
  def fix_patches(ast, _opts) do
    transformed = maybe_fix(ast)
    Credence.RuleHelpers.patches_from_diff(ast, transformed)
  end

  # ── AST extraction ─────────────────────────────────────────────────

  defp extract_def_groups({:defmodule, _meta, [_alias, kw]}) when is_list(kw) do
    case Credence.RuleHelpers.extract_do_body(kw) do
      {:ok, {:__block__, _, defs}} ->
        defs
        |> filter_def_nodes()
        |> Enum.chunk_by(fn {name, arity, _, _, _} -> {name, arity} end)
        |> Enum.map(fn group ->
          key = group |> hd() |> then(fn {n, a, _, _, _} -> {n, a} end)
          {key, group}
        end)

      _ ->
        []
    end
  end

  defp extract_def_groups(_), do: []

  defp filter_def_nodes(stmts) do
    Enum.flat_map(stmts, fn
      {dt, meta, [head, _body]} = node when dt in [:def, :defp] ->
        name = extract_name(head)
        args = extract_args(head)
        [{name, length(args), dt, meta, node}]

      _ ->
        []
    end)
  end

  defp extract_name({:when, _, [{name, _, _} | _]}) when is_atom(name), do: name
  defp extract_name({name, _, _}) when is_atom(name), do: name
  defp extract_name(_), do: nil

  defp extract_args({:when, _, [inner | _]}), do: extract_args(inner)
  defp extract_args({_, _, args}) when is_list(args), do: args
  defp extract_args(_), do: []

  # ── detection ──────────────────────────────────────────────────────

  defp find_unreachable_empty_list_clauses(clauses) do
    catchall_indices =
      clauses
      |> Enum.with_index()
      |> Enum.filter(fn {{_name, _arity, _dt, _meta, node}, _idx} -> catch_all?(node) end)
      |> Enum.map(fn {_entry, idx} -> idx end)

    clauses
    |> Enum.with_index()
    |> Enum.flat_map(fn {{_name, _arity, _dt, meta, node}, idx} ->
      if empty_list_clause?(node) and any_catchall_before?(catchall_indices, idx) do
        [build_issue(meta)]
      else
        []
      end
    end)
  end

  defp any_catchall_before?(catchall_indices, idx) do
    Enum.any?(catchall_indices, fn ci -> ci < idx end)
  end

  defp empty_list_clause?({dt, _, [head | _]}) when dt in [:def, :defp] do
    args = extract_args(head)
    args != [] and Enum.any?(args, &empty_list_pattern?/1)
  end

  defp empty_list_clause?(_), do: false

  defp empty_list_pattern?({:__block__, _, [[]]}), do: true
  defp empty_list_pattern?(_), do: false

  defp catch_all?({dt, _, [head | _]}) when dt in [:def, :defp] do
    case head do
      {:when, _, _} ->
        false

      {_, _, args} when is_list(args) ->
        args != [] and Enum.all?(args, &bare_var_or_underscore?/1) and
          not repeated_named_var?(args)

      _ ->
        false
    end
  end

  defp catch_all?(_), do: false

  defp repeated_named_var?(args) do
    names =
      Enum.flat_map(args, fn
        {:_, _, ctx} when is_atom(ctx) -> []
        {name, _, ctx} when is_atom(name) and is_atom(ctx) -> [name]
        _ -> []
      end)

    names != Enum.uniq(names)
  end

  defp bare_var_or_underscore?({:_, _, ctx}) when is_atom(ctx), do: true

  defp bare_var_or_underscore?({name, _, ctx})
       when is_atom(name) and is_atom(ctx),
       do: true

  defp bare_var_or_underscore?(_), do: false

  # ── auto-fix ───────────────────────────────────────────────────────

  defp maybe_fix(ast) do
    Macro.postwalk(ast, fn
      {:defmodule, meta, [alias, kw]} = node when is_list(kw) ->
        case Credence.RuleHelpers.extract_do_body(kw) do
          {:ok, {:__block__, block_meta, defs}} ->
            filtered = remove_unreachable_empty_list_clauses(defs)

            if length(filtered) < length(defs) do
              new_body = {:__block__, block_meta, filtered}
              {:defmodule, meta, [alias, Credence.RuleHelpers.replace_do_body(kw, new_body)]}
            else
              node
            end

          _ ->
            node
        end

      node ->
        node
    end)
  end

  defp remove_unreachable_empty_list_clauses(defs) do
    annotated =
      defs
      |> filter_def_nodes()
      |> Enum.chunk_by(fn {name, arity, _, _, _} -> {name, arity} end)

    to_remove =
      annotated
      |> Enum.flat_map(fn group ->
        catchall_indices =
          group
          |> Enum.with_index()
          |> Enum.filter(fn {{_name, _arity, _dt, _meta, node}, _idx} -> catch_all?(node) end)
          |> Enum.map(fn {_entry, idx} -> idx end)

        group
        |> Enum.with_index()
        |> Enum.flat_map(fn {{_name, _arity, _dt, _meta, node}, idx} ->
          if empty_list_clause?(node) and any_catchall_before?(catchall_indices, idx) do
            [node]
          else
            []
          end
        end)
      end)
      |> MapSet.new()

    Enum.reject(defs, fn node -> MapSet.member?(to_remove, node) end)
  end

  # ── issue ──────────────────────────────────────────────────────────

  defp build_issue(meta) do
    %Issue{
      rule: :no_unreachable_empty_list_clause,
      message:
        "This `[]` clause is unreachable because a preceding catch-all clause " <>
          "already matches empty lists. Remove this clause.",
      meta: %{line: Keyword.get(meta, :line)}
    }
  end
end

