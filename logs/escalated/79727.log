    content: defmodule Credence.Pattern.NoUnreachableEmptyListClauseCheckTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.NoUnreachableEmptyListClause

  describe "flags the anti-pattern" do
    test "flags [] clause after catch-all with underscore args" do
      code = """
      defmodule Bad do
        def sort(_, _), do: :ok
        def sort([], _), do: []
      end
      """

      [issue] = check(NoUnreachableEmptyListClause, code)
      assert issue.rule == :no_unreachable_empty_list_clause
      assert issue.meta.line == 3
    end

    test "flags [] clause after catch-all with variable args" do
      code = """
      defmodule Bad do
        def foo(x, y), do: {x, y}
        def foo([], _), do: nil
      end
      """

      [issue] = check(NoUnreachableEmptyListClause, code)
      assert issue.rule == :no_unreachable_empty_list_clause
      assert issue.meta.line == 3
    end

    test "flags [] clause after catch-all with mixed variable and underscore" do
      code = """
      defmodule Bad do
        def bar(x, _), do: x
        def bar([], y), do: y
      end
      """

      [issue] = check(NoUnreachableEmptyListClause, code)
      assert issue.meta.line == 3
    end

    test "flags [] clause as second arg after catch-all" do
      code = """
      defmodule Bad do
        def baz(_, _), do: :ok
        def baz(_, []), do: nil
      end
      """

      [issue] = check(NoUnreachableEmptyListClause, code)
      assert issue.meta.line == 3
    end

    test "flags [] clause in multi-clause function with preceding catch-all" do
      code = """
      defmodule Bad do
        def process(x) when is_list(x), do: x
        def process(_), do: []
        def process([]), do: nil
      end
      """

      [issue] = check(NoUnreachableEmptyListClause, code)
      assert issue.meta.line == 4
    end
  end

  describe "leaves good code alone" do
    test "no [] clause present" do
      code = """
      defmodule Good do
        def foo(x, y), do: {x, y}
        def foo(a, b), do: {a, b}
      end
      """

      assert clean?(NoUnreachableEmptyListClause, code)
    end

    test "[] clause before catch-all is reachable" do
      code = """
      defmodule Good do
        def foo([], _), do: nil
        def foo(x, y), do: {x, y}
      end
      """

      assert clean?(NoUnreachableEmptyListClause, code)
    end

    test "[] clause with no preceding catch-all" do
      code = """
      defmodule Good do
        def foo([], _), do: nil
        def foo([h | t], acc), do: foo(t, [h | acc])
      end
      """

      assert clean?(NoUnreachableEmptyListClause, code)
    end

    test "catch-all with guard is not a catch-all" do
      code = """
      defmodule Good do
        def foo(x) when is_integer(x), do: x
        def foo([]), do: nil
      end
      """

      assert clean?(NoUnreachableEmptyListClause, code)
    end

    test "single-clause function with [] is not flagged" do
      code = """
      defmodule Good do
        def foo([]), do: nil
      end
      """

      assert clean?(NoUnreachableEmptyListClause, code)
    end

    test "repeated-variable head is not a catch-all" do
      code = """
      defmodule Good do
        def foo(x, x), do: x
        def foo([], _), do: nil
      end
      """

      assert clean?(NoUnreachableEmptyListClause, code)
    end
  end
end

