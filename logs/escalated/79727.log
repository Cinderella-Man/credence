assert sort_students([("Alice", 85), ("Bob", 90), ("Charlie", 78)], 0) == [("Bob", 90), ("Alice", 85), ("Charlie", 78)]
assert sort_students([("David", 88), ("Eve", 92), ("Frank", 81)], 1) == [("Frank", 81), ("David", 88), ("Eve", 92)]

