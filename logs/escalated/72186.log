    content: defmodule Credence.Pattern.PreferEnumJoinOverRedundantCaseCheckTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferEnumJoinOverRedundantCase

  # ═══════════════════════════════════════════════════════════════════
  # POSITIVE — should flag the anti-pattern
  # ═══════════════════════════════════════════════════════════════════

  describe "flags the redundant case pattern" do
    test "basic form with variable separator" do
      assert flagged?(PreferEnumJoinOverRedundantCase, """
             defmodule Example do
               def join_strings(strings, separator) do
                 case strings do
                   [] -> ""
                   list -> Enum.join(list, separator)
                 end
               end
             end
             """)
    end

    test "with string literal separator" do
      assert flagged?(PreferEnumJoinOverRedundantCase, """
             defmodule Example do
               def join_strings(strings) do
                 case strings do
                   [] -> ""
                   list -> Enum.join(list, ", ")
                 end
               end
             end
             """)
    end

    test "with single-letter variable names" do
      assert flagged?(PreferEnumJoinOverRedundantCase, """
             defmodule Example do
               def f(a, b) do
                 case a do
                   [] -> ""
                   x -> Enum.join(x, b)
                 end
               end
             end
             """)
    end
  end

  # ═══════════════════════════════════════════════════════════════════
  # NEGATIVE — must NOT flag
  # ═══════════════════════════════════════════════════════════════════

  describe "does not flag direct Enum.join (already idiomatic)" do
    test "direct Enum.join call" do
      assert clean?(PreferEnumJoinOverRedundantCase, """
             defmodule Example do
               def join_strings(strings, separator) do
                 Enum.join(strings, separator)
               end
             end
             """)
    end
  end

  describe "does not flag case with different empty-clause body" do
    test "empty clause returns nil instead of empty string" do
      assert clean?(PreferEnumJoinOverRedundantCase, """
             defmodule Example do
               def join_strings(strings, separator) do
                 case strings do
                   [] -> nil
                   list -> Enum.join(list, separator)
                 end
               end
             end
             """)
    end

    test "empty clause returns a different string" do
      assert clean?(PreferEnumJoinOverRedundantCase, """
             defmodule Example do
               def join_strings(strings, separator) do
                 case strings do
                   [] -> "default"
                   list -> Enum.join(list, separator)
                 end
               end
             end
             """)
    end
  end

  describe "does not flag case with different second-clause body" do
    test "second clause does not call Enum.join" do
      assert clean?(PreferEnumJoinOverRedundantCase, """
             defmodule Example do
               def join_strings(strings, separator) do
                 case strings do
                   [] -> ""
                   list -> List.to_string(list)
                 end
               end
             end
             """)
    end

    test "second clause uses subject directly instead of clause variable" do
      assert clean?(PreferEnumJoinOverRedundantCase, """
             defmodule Example do
               def join_strings(strings, separator) do
                 case strings do
                   [] -> ""
                   _list -> Enum.join(strings, separator)
                 end
               end
             end
             """)
    end

    test "second clause calls Enum.join with wrong arity" do
      assert clean?(PreferEnumJoinOverRedundantCase, """
             defmodule Example do
               def join_strings(strings) do
                 case strings do
                   [] -> ""
                   list -> Enum.join(list)
                 end
               end
             end
             """)
    end
  end

  describe "does not flag case with more than two clauses" do
    test "three clauses" do
      assert clean?(PreferEnumJoinOverRedundantCase, """
             defmodule Example do
               def join_strings(strings, separator) do
                 case strings do
                   [] -> ""
                   [single] -> single
                   list -> Enum.join(list, separator)
                 end
               end
             end
             """)
    end
  end

  describe "does not flag case with non-empty-list first pattern" do
    test "first pattern is a wildcard" do
      assert clean?(PreferEnumJoinOverRedundantCase, """
             defmodule Example do
               def join_strings(strings, separator) do
                 case strings do
                   _ -> ""
                   list -> Enum.join(list, separator)
                 end
               end
             end
             """)
    end
  end
end

