    content: defmodule Credence.Pattern.PreferEnumJoinOverRedundantCase do
  @moduledoc """
  Detects a `case` expression that special-cases an empty list for
  `Enum.join/2` and rewrites it to a direct `Enum.join/2` call.

  `Enum.join/2` already returns `""` for an empty list, so the
  `[] -> ""` clause is redundant. LLMs frequently add this guard
  before calling `Enum.join/2`, producing an unnecessary `case`
  wrapper.

  ## Bad

      case strings do
        [] -> ""
        list -> Enum.join(list, separator)
      end

  ## Good

      Enum.join(strings, separator)

  ## Auto-fix

  Replaces the entire `case` expression with `Enum.join(subject, separator)`,
  where `subject` is the original case subject and `separator` is taken from
  the `Enum.join/2` call in the non-empty clause.
  """

  use Credence.Pattern.Rule
  alias Credence.Issue
  alias Credence.RuleHelpers

  @impl true
  def check(ast, _opts) do
    {_ast, issues} =
      Macro.prewalk(ast, [], fn
        {:case, meta, [_subject, kw]} = node, acc when is_list(kw) ->
          case check_case(kw) do
            :match -> {node, [build_issue(meta) | acc]}
            :no_match -> {node, acc}
          end

        {:case, meta, [kw]} = node, acc when is_list(kw) ->
          case check_case(kw) do
            :match -> {node, [build_issue(meta) | acc]}
            :no_match -> {node, acc}
          end

        node, acc ->
          {node, acc}
      end)

    Enum.reverse(issues)
  end

  @impl true
  def fix_patches(ast, _opts) do
    RuleHelpers.patches_from_postwalk(ast, &maybe_rewrite/1)
  end

  # ── detection ──────────────────────────────────────────────────────

  defp check_case(kw) do
    case extract_do_clauses(kw) do
      [clause1, clause2] ->
        if empty_list_clause?(clause1) and enum_join_clause?(clause2) do
          :match
        else
          :no_match
        end

      _ ->
        :no_match
    end
  end

  defp extract_do_clauses([{{:__block__, _, [:do]}, clauses}]) when is_list(clauses),
    do: clauses

  defp extract_do_clauses(_), do: nil

  # Matches `[] -> ""`
  defp empty_list_clause?({:->, _, [[pattern], body]}) do
    empty_list_pattern?(pattern) and empty_string_body?(body)
  end

  defp empty_list_clause?(_), do: false

  defp empty_list_pattern?({:__block__, _, [[]]}), do: true
  defp empty_list_pattern?(_), do: false

  defp empty_string_body?({:__block__, _, [""]}), do: true
  defp empty_string_body?(_), do: false

  # Matches `var -> Enum.join(var, separator)` where `var` is a fresh binding
  defp enum_join_clause?({:->, _, [[pattern], body]}) do
    with true <- bare_var_pattern?(pattern),
         {clause_var_name, _, nil} <- pattern,
         true <- enum_join_call_with_var?(body, clause_var_name) do
      true
    else
      _ -> false
    end
  end

  defp enum_join_clause?(_), do: false

  defp bare_var_pattern?({name, _, ctx}) when is_atom(name) and is_atom(ctx) do
    not (name |> to_string() |> String.starts_with?("_"))
  end

  defp bare_var_pattern?(_), do: false

  # Checks that the body is `Enum.join(var, separator)` where `var` is the
  # clause-bound variable (same name as the pattern).
  defp enum_join_call_with_var?(body, var_name) do
    case body do
      {{:., _, [{:__aliases__, _, [:Enum]}, :join]}, _, [{^var_name, _, nil}, _sep]} ->
        true

      _ ->
        false
    end
  end

  # ── issue ──────────────────────────────────────────────────────────

  defp build_issue(meta) do
    %Issue{
      rule: :prefer_enum_join_over_redundant_case,
      message:
        "`case` with `[] -> \"\"` is redundant — `Enum.join/2` already returns " <>
          "`\"\"` for an empty list. Use `Enum.join(subject, separator)` directly.",
      meta: %{line: Keyword.get(meta, :line)}
    }
  end

  # ── auto-fix ───────────────────────────────────────────────────────

  defp maybe_rewrite({:case, _meta, [subject, kw]} = node) when is_list(kw) do
    case extract_do_clauses(kw) do
      [clause1, clause2] ->
        if empty_list_clause?(clause1) do
          case extract_join_args(clause2) do
            {:ok, _var_name, sep} ->
              build_enum_join(subject, sep)

            :no_match ->
              node
          end
        else
          node
        end

      _ ->
        node
    end
  end

  defp maybe_rewrite({:case, _meta, [kw]} = node) when is_list(kw) do
    # piped form: `subject |> case do ... end`
    # In this form, the subject is not directly available in the case node;
    # it comes from the pipe. We can't safely rewrite this form without
    # knowing the piped subject, so skip it.
    node
  end

  defp maybe_rewrite(node), do: node

  defp extract_join_args({:->, _, [[pattern], body]}) do
    with true <- bare_var_pattern?(pattern),
         {clause_var_name, _, nil} <- pattern do
      case body do
        {{:., _, [{:__aliases__, _, [:Enum]}, :join]}, _, [{^clause_var_name, _, nil}, sep]} ->
          {:ok, clause_var_name, sep}

        _ ->
          :no_match
      end
    else
      _ -> :no_match
    end
  end

  defp extract_join_args(_), do: :no_match

  defp build_enum_join(subject, sep) do
    {{:., [], [{:__aliases__, [], [:Enum]}, :join]}, [], [subject, sep]}
  end
end

