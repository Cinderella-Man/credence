    content: defmodule Credence.Pattern.PreferEnumJoinOverRedundantCaseEquivalenceTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferEnumJoinOverRedundantCase

  test "fix preserves behaviour" do
    # The expression has two free variables: `strings` (a list) and
    # `separator` (a string). We exercise edge cases: empty list,
    # single element, multiple elements, unicode, and various separators.
    assert_equivalent(
      """
      case strings do
        [] -> ""
        list -> Enum.join(list, separator)
      end
      """,
      rule: PreferEnumJoinOverRedundantCase,
      vars: [:strings, :separator],
      inputs: [
        [[], ""],
        [["a"], ","],
        [["a", "b", "c"], ","],
        [["hello", "world"], " "],
        [["café", "naïve"], " & "],
        [["👨‍👩‍👧", "🇵🇱"], " "],
        [[1, 2, 3], "-"],
        [["x"], ""],
        [["", ""], ","],
        [["a", "b", "c", "d", "e"], " | "]
      ]
    )
  end
end

