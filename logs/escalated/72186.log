    content: defmodule Credence.Pattern.PreferEnumJoinOverRedundantCaseFixTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferEnumJoinOverRedundantCase

  test "rewrites the anti-pattern" do
    input = """
    defmodule Example do
      def join_strings(strings, separator) do
        case strings do
          [] -> ""
          list -> Enum.join(list, separator)
        end
      end
    end
    """

    expected = """
    defmodule Example do
      def join_strings(strings, separator) do
        Enum.join(strings, separator)
      end
    end
    """

    assert fix(PreferEnumJoinOverRedundantCase, input) == expected
  end

  test "rewrites with string literal separator" do
    input = """
    defmodule Example do
      def join_strings(strings) do
        case strings do
          [] -> ""
          list -> Enum.join(list, ", ")
        end
      end
    end
    """

    expected = """
    defmodule Example do
      def join_strings(strings) do
        Enum.join(strings, ", ")
      end
    end
    """

    assert fix(PreferEnumJoinOverRedundantCase, input) == expected
  end

  test "rewrites with single-letter variable names" do
    input = """
    defmodule Example do
      def f(a, b) do
        case a do
          [] -> ""
          x -> Enum.join(x, b)
        end
      end
    end
    """

    expected = """
    defmodule Example do
      def f(a, b) do
        Enum.join(a, b)
      end
    end
    """

    assert fix(PreferEnumJoinOverRedundantCase, input) == expected
  end
end

