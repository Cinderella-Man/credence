    content: defmodule Credence.Semantic.NoDefAsLocalBinding do
  @moduledoc """
  Fixes `def name = expr` inside function bodies — an LLM anti-pattern
  that confuses `def` with local variable assignment.

  When an LLM writes `def doubled = x * 2` inside a function body, the
  Elixir compiler emits an error about an unexpected `end` (the bare `def`
  without a `do…end` block steals the enclosing function's `end`). The fix
  strips the `def` keyword, converting the erroneous definition into a
  plain assignment: `doubled = x * 2`.
  """
  use Credence.Semantic.Rule

  alias Credence.Issue

  @impl true
  def match?(%{severity: :error, message: msg}) when is_binary(msg) do
    String.contains?(msg, "cannot invoke def/2 inside function/macro") or
      String.contains?(msg, "unexpected reserved word: end")
  end

  def match?(_), do: false

  @impl true
  def to_issue(diagnostic) do
    %Issue{
      rule: :no_def_as_local_binding,
      message: "def used as local binding; use plain assignment instead",
      meta: %{line: line(diagnostic)}
    }
  end

  @impl true
  def fix(source, _diagnostic) do
    source
    |> String.split("\n")
    |> Enum.map_join("\n", fn line ->
      if Regex.match?(~r/^\s+def\s+[a-z_]\w*\s*=/, line) do
        Regex.replace(~r/^(\s+)def\s+/, line, "\\1")
      else
        line
      end
    end)
  end

  defp line(%{position: {line, _col}}), do: line
  defp line(%{position: line}) when is_integer(line), do: line
end

