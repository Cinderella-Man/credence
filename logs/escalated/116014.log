  use ExUnit.Case

  alias Credence.Semantic.NoDefAsLocalBinding

  # The real captured diagnostic from Code.with_diagnostics when compiling
  # source with `def name = expr` inside a function body.  The bare `def`
  # without a `do…end` block steals the enclosing function's `end`,
  # producing an "unexpected reserved word: end" parse error.
  @def_as_local_diag %{
    severity: :error,
    message:
      "invalid syntax found on credence_check.ex:19:1:\n    error: unexpected reserved word: end\n    hint: the \"end\" on line 18 may not have a matching \"do\" defined before it (based on indentation)\n    │\n 19 │ end\n    │ ^\n    │\n    └─ credence_check.ex:19:1",
    position: 19,
    file: "credence_check.ex"
  }

  test "matches the diagnostic" do
    assert NoDefAsLocalBinding.match?(@def_as_local_diag)
  end

  test "ignores unrelated diagnostics" do
    diag = %{severity: :warning, message: "unrelated", position: {1, 1}}
    refute NoDefAsLocalBinding.match?(diag)
  end

  test "attributes the issue to this rule" do
    assert NoDefAsLocalBinding.to_issue(@def_as_local_diag).rule == :no_def_as_local_binding
  end
end

