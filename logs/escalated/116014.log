defmodule Solution do
  def number_of_trailing_zeros(n) do
    n
    |> count_fives(5, 0)
  end

  defp count_fives(n, divisor, acc) when n / divisor < 1, do: acc

  defp count_fives(n, divisor, acc) do
    count_fives(n, divisor * 5, acc + div(n, divisor))
  end
end
