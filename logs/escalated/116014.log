    content: defmodule Credence.Semantic.NoDefAsLocalBindingFixTest do
  use ExUnit.Case

  import Credence.RuleCase, only: [valid_syntax?: 1]

  alias Credence.Semantic.NoDefAsLocalBinding

  @message "invalid syntax found on credence_check.ex:19:1:\n    error: unexpected reserved word: end\n    hint: the \"end\" on line 18 may not have a matching \"do\" defined before it (based on indentation)\n    │\n 19 │ end\n    │ ^\n    │\n    └─ credence_check.ex:19:1"

  defp fix(source, line \\ 1) do
    NoDefAsLocalBinding.fix(source, %{severity: :error, message: @message, position: {line, 1}})
  end

  test "strips def keyword from local binding" do
    input = """
    defmodule Solution do
      def compute(x) do
        def doubled = x * 2
        def tripled = x * 3
        doubled + tripled
      end
    end
    """

    expected = """
    defmodule Solution do
      def compute(x) do
        doubled = x * 2
        tripled = x * 3
        doubled + tripled
      end
    end
    """

    assert fix(input) == expected
  end

  test "does not strip def from regular function definitions" do
    input = """
    defmodule Solution do
      def compute(x) do
        x * 2
      end
    end
    """

    assert fix(input) == input
  end

  test "fixed output is well-formed (parses)" do
    assert valid_syntax?(fix("""
    defmodule Solution do
      def compute(x) do
        def doubled = x * 2
        def tripled = x * 3
        doubled + tripled
      end
    end
    """))
  end
end

