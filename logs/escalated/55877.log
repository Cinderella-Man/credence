---REFERENCE---
defmodule Solution do
  def count_lucky_triples(list) do
    n = length(list)
    l_tuple = List.to_tuple(list)
    memo = :erlang.make_tuple(n, 0)
    {cnt, _} = for i <- 0..(n-2), reduce: {0, memo} do
      {cnt, memo} ->
        {cnt, memo} = for j <- (i+1)..(n-1), reduce: {cnt, memo} do
          {cnt, memo} ->
            if rem(elem(l_tuple, j), elem(l_tuple, i)) == 0 do
              new_memo = put_elem(memo, j, elem(memo, j) + 1)
              new_cnt = cnt + elem(memo, i)
              {new_cnt, new_memo}
            else
              {cnt, memo}
            end
        end
        {cnt, memo}
    end
    cnt
  end
end

