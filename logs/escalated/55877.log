  use ExUnit.Case, async: false

  test "count_lucky_triples" do
    assert Solution.count_lucky_triples([1, 1, 1]) == 1
    assert Solution.count_lucky_triples([1, 2, 3, 4, 5, 6]) == 3
    assert Solution.count_lucky_triples([2, 4, 8, 16]) == 4
  end
