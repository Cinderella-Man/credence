    content: defmodule Credence.Pattern.NoUnusedUnderscoreAssignment do
  @moduledoc """
  Detects dead `_var = pure_expr` assignments that are never referenced
  and are not the last expression in their block.

  The Elixir compiler's `UnusedVariable` warning fix prefixes unused variables
  with `_`, but the dead assignment line remains. When the RHS is a pure
  expression (literal or variable), the `_var` is never referenced, and the
  assignment is not the last expression in its block (removing the last would
  change the block's return value), the line is safe to delete.

  ## Bad

      def process(list) do
        _length = list
        n = length(list)
        if n < 3, do: 0, else: n
      end

  ## Good

      def process(list) do
        n = length(list)
        if n < 3, do: 0, else: n
      end

  ## Auto-fix

  Removes the dead underscore-prefixed assignment from the block.

  ## Safety

  Only fires when:
  - The LHS is an underscore-prefixed variable (`_var`)
  - The `_var` is never referenced elsewhere in the same block
  - The RHS is a pure expression (literal or variable — no function calls,
    no side effects)
  - The assignment is NOT the last expression in its block (removing the
    last expression would change the block's return value)
  """

  use Credence.Pattern.Rule
  alias Credence.Issue

  @impl true
  def check(ast, _opts) do
    {_ast, issues} =
      Macro.prewalk(ast, [], fn
        {:__block__, meta, exprs} = node, acc when is_list(exprs) and length(exprs) >= 2 ->
          dead = dead_assignments(exprs)

          if dead != [] do
            new_issues =
              Enum.map(dead, fn {_idx, _var_name, {:=, assign_meta, _}} ->
                %Issue{
                  rule: :no_unused_underscore_assignment,
                  message:
                    "Dead underscore-prefixed assignment. " <>
                      "The `_` variable is never referenced and the RHS is pure — " <> "remove the line.",
                  meta: %{line: Keyword.get(assign_meta, :line)}
                }
              end)

            {node, Enum.reverse(new_issues) ++ acc}
          else
            {node, acc}
          end

        node, acc ->
          {node, acc}
      end)

    Enum.reverse(issues)
  end

  @impl true
  def fix_patches(ast, opts) do
    source = Keyword.get(opts, :source, "")

    Credence.RuleHelpers.patches_from_ast_transform(ast, source, fn tree ->
      Macro.postwalk(tree, fn
        {:__block__, meta, exprs} = node when is_list(exprs) and length(exprs) >= 2 ->
          case filter_dead_assignments(exprs) do
            ^exprs -> node
            [single] -> single
            filtered -> {:__block__, meta, filtered}
          end

        node ->
          node
      end)
    end)
  end

  # Returns a list of {index, var_name, assignment_node} for dead assignments
  # that are safe to remove (not the last expression, underscore-prefixed,
  # pure RHS, and the variable is never referenced).
  defp dead_assignments(exprs) do
    last_idx = length(exprs) - 1
    referenced = collect_references(exprs)

    exprs
    |> Enum.with_index()
    |> Enum.flat_map(fn
      {{:=, _meta, [{var_name, _, nil}, rhs]}, idx} when idx < last_idx ->
        name_str = Atom.to_string(var_name)

        if String.starts_with?(name_str, "_") and
             var_name not in referenced and
             pure_rhs?(rhs) do
          [{idx, var_name, Enum.at(exprs, idx)}]
        else
          []
        end

      _ ->
        []
    end)
  end

  # Filters out dead assignments from a block's expressions (keeps the last).
  defp filter_dead_assignments(exprs) do
    dead_indices =
      dead_assignments(exprs) |> Enum.map(fn {idx, _, _} -> idx end) |> MapSet.new()

    exprs
    |> Enum.with_index()
    |> Enum.reject(fn {_expr, idx} -> idx in dead_indices end)
    |> Enum.map(fn {expr, _idx} -> expr end)
  end

  # Collects all variable names referenced in the block (excluding LHS of assignments).
  defp collect_references(exprs) do
    {_ast, refs} =
      Macro.prewalk(exprs, [], fn
        {:=, _, [lhs, rhs]}, acc ->
          # Walk the RHS (the assigned value may reference variables)
          {_, rhs_refs} = Macro.prewalk(rhs, [], fn node, a -> {node, maybe_add_ref(node, a)} end)
          # Skip the LHS (it's the binding, not a reference)
          {{:=, [], [lhs, rhs]}, rhs_refs ++ acc}

        node, acc ->
          {node, maybe_add_ref(node, acc)}
      end)

    MapSet.new(refs)
  end

  defp maybe_add_ref({name, _, ctx}, acc) when is_atom(name) and is_atom(ctx) do
    [name | acc]
  end

  defp maybe_add_ref(_, acc), do: acc

  # A pure RHS: a literal or a variable. No function calls, no side effects.
  # Literals in Sourceror AST are wrapped: {:__block__, meta, [value]}
  defp pure_rhs?({:__block__, _, [v]})
       when is_number(v) or is_atom(v) or is_binary(v) or is_boolean(v),
       do: true

  # A variable reference (3-tuple with atom context, not a call).
  defp pure_rhs?({name, _, ctx}) when is_atom(name) and is_atom(ctx), do: true
  defp pure_rhs?(_), do: false
end

