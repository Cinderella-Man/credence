    content: defmodule Credence.Pattern.NoUnusedUnderscoreAssignmentCheckTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.NoUnusedUnderscoreAssignment

  describe "fires — dead underscore assignment before another expression" do
    test "flags _var = literal before another expression" do
      code = """
      defmodule Example do
        def process(list) do
          _length = list
          n = length(list)
          if n < 3, do: 0, else: n
        end
      end
      """

      issues = check(NoUnusedUnderscoreAssignment, code)
      assert length(issues) == 1
      assert hd(issues).rule == :no_unused_underscore_assignment
    end

    test "flags _var = literal before another expression (literal RHS)" do
      code = """
      defmodule M do
        def f(x) do
          _unused = 42
          x + 1
        end
      end
      """

      assert length(check(NoUnusedUnderscoreAssignment, code)) == 1
    end

    test "flags _var = variable before another expression" do
      code = """
      defmodule M do
        def f(x, y) do
          _copy = x
          y + 1
        end
      end
      """

      assert length(check(NoUnusedUnderscoreAssignment, code)) == 1
    end

    test "flags multiple dead assignments" do
      code = """
      defmodule M do
        def f(x) do
          _a = 1
          _b = 2
          x + 1
        end
      end
      """

      assert length(check(NoUnusedUnderscoreAssignment, code)) == 2
    end
  end

  describe "no issue — pure RHS but last expression" do
    test "single dead assignment (last expression) is left alone" do
      code = """
      defmodule M do
        def f(list) do
          _length = list
        end
      end
      """

      assert check(NoUnusedUnderscoreAssignment, code) == []
    end
  end

  describe "no issue — _var is referenced" do
    test "underscore variable used later in the block" do
      code = """
      defmodule M do
        def f(list) do
          _len = length(list)
          _len + 1
        end
      end
      """

      assert check(NoUnusedUnderscoreAssignment, code) == []
    end
  end

  describe "no issue — non-pure RHS" do
    test "function call RHS is not flagged" do
      code = """
      defmodule M do
        def f(list) do
          _len = length(list)
          :ok
        end
      end
      """

      assert check(NoUnusedUnderscoreAssignment, code) == []
    end
  end

  describe "no issue — no underscore prefix" do
    test "non-underscore variable assignment is left alone" do
      code = """
      defmodule M do
        def f(list) do
          len = list
          n = length(list)
          if n < 3, do: 0, else: n
        end
      end
      """

      assert check(NoUnusedUnderscoreAssignment, code) == []
    end
  end

  describe "no issue — no block" do
    test "single-expression function body is left alone" do
      code = """
      defmodule M do
        def f(x), do: x + 1
      end
      """

      assert check(NoUnusedUnderscoreAssignment, code) == []
    end
  end
end

