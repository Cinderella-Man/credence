defmodule Solution do
  @doc """
  Counts the number of lucky triples in a list of integers.
  A lucky triple is a triplet (i, j, k) with i < j < k such that:
    - list[j] is a multiple of list[i]
    - list[k] is a multiple of list[j]
  """
  @spec count_lucky_triples([integer()]) :: non_neg_integer()
  def count_lucky_triples(list) when is_list(list) do
    count_triples(list)
  end

  defp count_triples(list) do
    _length = list
    n = length(list)

    if n < 3 do
      0
    else
      Enum.reduce(0..(n - 3), 0, fn i, acc ->
        Enum.reduce((i + 1)..(n - 2), acc, fn j, acc_inner ->
          div_i = Enum.at(list, i)
          div_j = Enum.at(list, j)

          if rem(div_j, div_i) == 0 do
            Enum.reduce((j + 1)..(n - 1), acc_inner, fn k, acc_innermost ->
              div_k = Enum.at(list, k)

              if rem(div_k, div_j) == 0 do
                acc_innermost + 1
              else
                acc_innermost
              end
            end)
          else
            acc_inner
          end
        end)
      end)
    end
  end
end
