    content: defmodule Credence.Semantic.PreferDivForIntegerDivisionFixTest do
  use ExUnit.Case

  import Credence.RuleCase, only: [confirm_fix: 2, valid_syntax?: 1]

  alias Credence.Semantic.PreferDivForIntegerDivision

  @real_message "redefining module Solution (current version loaded from " <>
                  "_build/test/lib/workspace/ebin/Elixir.Solution.beam)"

  defp fix(source, message, line \\ 1) do
    PreferDivForIntegerDivision.fix(source, %{
      severity: :warning,
      message: message,
      position: {line, 1}
    })
  end

  test "replaces / with div/2 and strips redundant trunc()" do
    input = ~S"""
    defmodule Example do
      def check(str) do
        len = String.length(str)
        period = 2
        if rem(len, period) == 0 do
          candidate = String.slice(str, 0, period)
          repeats = len / period
          expected = List.duplicate(candidate, trunc(repeats)) |> Enum.join()
          str == expected
        else
          false
        end
      end
    end
    """

    expected = ~S"""
    defmodule Example do
      def check(str) do
        len = String.length(str)
        period = 2
        if rem(len, period) == 0 do
          candidate = String.slice(str, 0, period)
          repeats = div(len, period)
          expected = List.duplicate(candidate, repeats) |> Enum.join()
          str == expected
        else
          false
        end
      end
    end
    """

    confirm_fix(fix(input, @real_message), expected)
  end

  test "returns source unchanged when no / pattern is present" do
    source = ~S"""
    defmodule Clean do
      def f(x), do: div(x, 2)
    end
    """

    confirm_fix(fix(source, @real_message), source)
  end

  test "fixed output is well-formed (parses)" do
    input = ~S"""
    defmodule Example do
      def check(str) do
        len = String.length(str)
        period = 2
        if rem(len, period) == 0 do
          candidate = String.slice(str, 0, period)
          repeats = len / period
          expected = List.duplicate(candidate, trunc(repeats)) |> Enum.join()
          str == expected
        else
          false
        end
      end
    end
    """

    assert valid_syntax?(fix(input, @real_message))
  end
end

