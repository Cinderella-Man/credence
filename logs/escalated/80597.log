---MODULE---
defmodule Solution do
  @doc """
  Determines whether a given string can be formed by concatenating two or more
  copies of a non-empty substring.
  """
  @spec can_form_by_repeating(String.t()) :: boolean()
  def can_form_by_repeating(str) when is_binary(str) do
    len = String.length(str)

    # Edge cases: empty string or single character cannot be formed by repeating
    # a non-empty substring at least twice.
    when len < 2 do
      false
    end

    # Check if the string is formed by repeating a substring.
    # We look for the longest proper prefix which is also a suffix.
    # Using KMP failure function / rolling hash approach or simple division check.
    # Since we need to find ANY substring, a common efficient approach is:
    # Concatenate str + str, then check if the original str is a substring of (str + str)[1:-1].
    # This works if the string is periodic.

    # However, the problem asks if it's composed of 2+ copies of a shorter substring.
    # Let's use the property: if s is formed by repeating a substring of length k,
    # then k must divide len, and s[0..k-1] repeated must equal s.

    # We can check all divisors of len.
    divisors = divisors(len)

    Enum.any?(divisors, fn k ->
      k > 0 and k < len and rem_len = len - k and rem_len > 0 and
        can_form_with_period(str, k, rem_len)
    end)
  end

  @spec can_form_with_period(String.t(), non_neg_integer(), non_neg_integer()) :: boolean()
  defp can_form_with_period(str, period_len, total_len) do
    # Extract the first period_len characters
    prefix = String.slice(str, 0, period_len)

    # Check if the entire string is composed of repeating prefix
    # We can do this by checking if str matches a pattern of prefix repeated total_len/period_len times.
    # Or simply: check if every chunk of size period_len equals prefix.

    chunks_count = total_len / period_len

    # To avoid building the string, we check each chunk
    # But slicing might be easier for idiomatic Elixir
    # Let's build the expected string and compare
    expected = String.repeat(prefix, trunc(chunks_count))

    str == expected
  end

  @spec divisors(non_neg_integer()) :: [non_neg_integer()]
  defp divisors(n) when n > 0 do
    for i <- 1..floor(n/2), rem(n, i) == 0, do: i
  end
end

