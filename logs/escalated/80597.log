defmodule Solution do
  @spec can_form_by_repeating(String.t()) :: boolean()
  def can_form_by_repeating(s) do
    n = String.length(s)
    if n < 2 do
      false
    else
      Enum.any?(1..div(n, 2), fn i ->
        rem(n, i) == 0 and
          String.duplicate(String.slice(s, 0, i), div(n, i)) == s
      end)
    end
  end
end

