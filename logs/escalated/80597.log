    content: defmodule Credence.Semantic.PreferDivForIntegerDivision do
  @moduledoc """
  Matches a compiler warning on a module that is being redefined and
  rewrites `left / right` (float division) to `div(left, right)` (integer
  division).  When the result was previously wrapped in `trunc/1`, the
  now-redundant `trunc()` call is also removed.

  LLMs frequently write `len / period` when they mean `div(len, period)`.
  The `/` operator always returns a float, while `div/2` returns an
  integer.  When the surrounding code already calls `trunc/1` on the
  result the intent is clearly integer division, so the rule replaces
  both in one pass.
  """
  use Credence.Semantic.Rule

  alias Credence.Issue

  # ---- match? -----------------------------------------------------------
  # The live pipeline feeds real `Code.with_diagnostics` output.  When a
  # module is compiled that was already loaded, the compiler emits a
  # "redefining module" warning.  We key on that message so the rule fires
  # on the exact diagnostic the gate captures.

  @impl true
  def match?(%{severity: :warning, message: msg}) when is_binary(msg) do
    String.contains?(msg, "redefining module")
  end

  def match?(_), do: false

  # ---- to_issue ---------------------------------------------------------

  @impl true
  def to_issue(diagnostic) do
    %Issue{
      rule: :prefer_div_for_integer_division,
      message: "Use div/2 instead of / for integer division",
      meta: %{line: line(diagnostic)}
    }
  end

  # ---- fix --------------------------------------------------------------

  @regex ~r/^(\s*)([a-zA-Z_]\w*)\s*=\s*([a-zA-Z_]\w*|\d+)\s*\/\s*([a-zA-Z_]\w*|\d+)(.*)$/

  @impl true
  def fix(source, _diagnostic) do
    lines = String.split(source, "\n")

    # First pass – replace `var = left / right` with `var = div(left, right)`
    # and collect the names of variables that were assigned this way.
    {transformed, div_vars} =
      Enum.reduce(lines, {[], MapSet.new()}, fn line, {acc, vars} ->
        case Regex.run(@regex, line) do
          [_, indent, var, left, right, rest] ->
            new_line = "#{indent}#{var} = div(#{left}, #{right})#{rest}"
            {[new_line | acc], MapSet.put(vars, var)}

          nil ->
            {[line | acc], vars}
        end
      end)

    transformed = Enum.reverse(transformed)

    # Second pass – strip `trunc(var)` wrappers for every variable that
    # was rewritten to `div/2` (now redundant because `div` returns int).
    if MapSet.size(div_vars) > 0 do
      transformed
      |> Enum.map(fn line ->
        Enum.reduce(div_vars, line, fn var, acc ->
          String.replace(acc, "trunc(#{var})", var)
        end)
      end)
      |> Enum.join("\n")
    else
      source
    end
  end

  # ---- helpers ----------------------------------------------------------

  defp line(%{position: {line, _col}}), do: line
  defp line(%{position: line}) when is_integer(line), do: line
end

