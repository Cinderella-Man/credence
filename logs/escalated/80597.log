---MODULE---
defmodule Solution do
  @doc """
  Determines whether a given string can be formed by concatenating two or more
  copies of a non-empty substring.
  """
  @spec can_form_by_repeating?(String.t()) :: boolean()
  def can_form_by_repeating?(str) when is_binary(str) do
    case String.length(str) do
      len when len < 2 ->
        false

      len ->
        max_period = floor(len / 2)

        Enum.any?(1..max_period, fn period ->
          rem(len, period) == 0 and String.repeat(str, period, len / period) == str
        end)
    end
  end
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "repeating substring" do
    assert Solution.can_form_by_repeating?("abab") == true
  end

  test "no repeating substring" do
    assert Solution.can_form_by_repeating?("abcd") == false
  end

  test "multiple repetitions" do
    assert Solution.can_form_by_repeating?("abcabcabc") == true
  end

  test "empty string returns false" do
    assert Solution.can_form_by_repeating?("") == false
  end

  test "single character returns false" do
    assert Solution.can_form_by_repeating?("a") == false
  end

  test "all same characters" do
    assert Solution.can_form_by_repeating?("aaaa") == true
  end

  test "string that repeats but with period 1" do
    assert Solution.can_form_by_repeating?("bb") == true
  end

  test "string with odd length that doesn't repeat" do
    assert Solution.can_form_by_repeating?("abcde") == false
  end

  test "longer repeating pattern" do
    assert Solution.can_form_by_repeating?("xyzxyzxyzxyz") == true
  end
end
