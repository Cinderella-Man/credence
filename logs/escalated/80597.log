    content: defmodule Credence.Semantic.PreferDivForIntegerDivisionCheckTest do
  use ExUnit.Case

  alias Credence.Semantic.PreferDivForIntegerDivision

  # The real diagnostic the compiler emits when a module that was already
  # loaded is compiled again.  This is the diagnostic the live pipeline
  # (`Code.with_diagnostics`) actually produces for the before snippet.
  @real_message "redefining module Solution (current version loaded from " <>
                  "_build/test/lib/workspace/ebin/Elixir.Solution.beam)"

  describe "match?/1" do
    test "matches the real redefining-module diagnostic" do
      diag = %{severity: :warning, message: @real_message, position: 1}
      assert PreferDivForIntegerDivision.match?(diag)
    end

    test "matches with tuple position" do
      diag = %{severity: :warning, message: @real_message, position: {1, 1}}
      assert PreferDivForIntegerDivision.match?(diag)
    end

    test "ignores unrelated diagnostics" do
      diag = %{severity: :warning, message: "unrelated", position: {1, 1}}
      refute PreferDivForIntegerDivision.match?(diag)
    end

    test "ignores error severity" do
      diag = %{severity: :error, message: @real_message, position: {1, 1}}
      refute PreferDivForIntegerDivision.match?(diag)
    end
  end

  describe "to_issue/1" do
    test "attributes the issue to this rule with the right line" do
      diag = %{severity: :warning, message: @real_message, position: 7}
      issue = PreferDivForIntegerDivision.to_issue(diag)
      assert issue.rule == :prefer_div_for_integer_division
      assert issue.meta.line == 7
    end

    test "handles tuple position" do
      diag = %{severity: :warning, message: @real_message, position: {5, 10}}
      assert PreferDivForIntegerDivision.to_issue(diag).meta.line == 5
    end
  end
end

