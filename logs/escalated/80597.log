defmodule Solution do
  @doc """
  Determines whether a given string can be formed by concatenating two or more
  copies of a non-empty substring.
  """
  @spec can_form_by_repeating?(String.t()) :: boolean()
  def can_form_by_repeating?(str) when is_binary(str) do
    case String.length(str) do
      len when len < 2 ->
        false

      len ->
        max_period = floor(len / 2)

        Enum.any?(1..max_period, fn period ->
          cond do
            rem(len, period) != 0 -> false
            true ->
              candidate = String.slice(str, 0, period)
              repeats = len / period
              expected = List.duplicate(candidate, repeats) |> Enum.join()
              str == expected
          end
        end)
    end
  end
end[0m
