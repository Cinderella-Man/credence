  use Credence.RuleCase, async: true

  alias Credence.Issue
  alias Credence.Pattern.PreferGraphemesForCharacterComparisons

  describe "flags the anti-pattern" do
    test "pipe form: String.codepoints(x) |> Enum.sort()" do
      assert [%Issue{rule: :prefer_graphemes_for_character_comparisons}] =
               check(PreferGraphemesForCharacterComparisons, """
               String.codepoints(str) |> Enum.sort()
               """)
    end

    test "nested form: Enum.sort(String.codepoints(x))" do
      assert [%Issue{rule: :prefer_graphemes_for_character_comparisons}] =
               check(PreferGraphemesForCharacterComparisons, """
               Enum.sort(String.codepoints(str))
               """)
    end

    test "within a module with anagram check pattern" do
      code = """
      defmodule Solution do
        def are_anagrams(str1, str2) do
          str1_sorted = String.codepoints(str1) |> Enum.sort()
          str2_sorted = String.codepoints(str2) |> Enum.sort()
          str1_sorted == str2_sorted
        end
      end
      """

      assert length(check(PreferGraphemesForCharacterComparisons, code)) == 2
    end

    test "upstream pipeline: str |> f() |> String.codepoints() |> Enum.sort()" do
      assert [%Issue{rule: :prefer_graphemes_for_character_comparisons}] =
               check(PreferGraphemesForCharacterComparisons, """
               str |> String.trim() |> String.codepoints() |> Enum.sort()
               """)
    end
  end

  describe "does NOT flag" do
    test "String.graphemes(x) |> Enum.sort()" do
      assert check(PreferGraphemesForCharacterComparisons, """
             String.graphemes(str) |> Enum.sort()
             """) == []
    end

    test "Enum.sort(String.graphemes(x))" do
      assert check(PreferGraphemesForCharacterComparisons, """
             Enum.sort(String.graphemes(str))
             """) == []
    end

    test "String.codepoints without Enum.sort()" do
      assert check(PreferGraphemesForCharacterComparisons, """
             String.codepoints(str)
             """) == []
    end

    test "String.codepoints piped to something other than Enum.sort()" do
      assert check(PreferGraphemesForCharacterComparisons, """
             String.codepoints(str) |> Enum.reverse()
             """) == []
    end

    test "Enum.sort with argument (not zero-arity)" do
      assert check(PreferGraphemesForCharacterComparisons, """
             Enum.sort(String.codepoints(str), :desc)
             """) == []
    end

    test "Enum.sort on non-codepoints list" do
      assert check(PreferGraphemesForCharacterComparisons, """
             Enum.sort(list)
             """) == []
    end
  end
end

