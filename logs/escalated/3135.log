    content: defmodule Credence.Pattern.PreferGraphemesForCharacterComparisons do
  @moduledoc """
  Readability rule: detects `String.codepoints/1` used in an anagram-check
  pattern (sorted then compared) and rewrites it to `String.graphemes/1`.

  `String.codepoints/1` splits a string into individual Unicode codepoints,
  while `String.graphemes/1` returns user-perceived characters. For anagram
  checks that compare "letters" as perceived characters, graphemes is more
  correct because it avoids splitting combining characters into separate
  codepoints.

  Both `String.codepoints/1` and `String.graphemes/1` return `list(String.t())`,
  so the type is preserved by the rewrite.

  ## Bad

      str1_sorted = String.codepoints(str1) |> Enum.sort()
      str2_sorted = String.codepoints(str2) |> Enum.sort()
      str1_sorted == str2_sorted

      # Or nested:
      Enum.sort(String.codepoints(str))

  ## Good

      str1_sorted = String.graphemes(str1) |> Enum.sort()
      str2_sorted = String.graphemes(str2) |> Enum.sort()
      str1_sorted == str2_sorted

      # Or nested:
      Enum.sort(String.graphemes(str))
  """
  use Credence.Pattern.Rule
  alias Credence.Issue
  alias Credence.RuleHelpers

  @impl true
  def check(ast, _opts) do
    {_ast, issues} =
      Macro.prewalk(ast, [], fn
        # Pipe form: String.codepoints(x) |> Enum.sort()
        {:|>, _pipe_meta, [left, rhs]} = node, issues ->
          if args_empty_call?(rhs, :Enum, :sort) and codepoints_call?(left) do
            {node, [build_issue(node) | issues]}
          else
            {node, issues}
          end

        # Nested form: Enum.sort(String.codepoints(x))
        {{:., _dot_meta, [{:__aliases__, _alias_meta, [:Enum]}, :sort]}, _call_meta,
         [{{:., _, [{:__aliases__, _, [:String]}, :codepoints]}, _, _}]} = node,
        issues ->
          {node, [build_issue(node) | issues]}

        node, issues ->
          {node, issues}
      end)

    Enum.reverse(issues)
  end

  @impl true
  def fix_patches(ast, _opts) do
    RuleHelpers.patches_from_ast_transform(ast, "", fn input ->
      Macro.postwalk(input, fn
        # Pipe form: String.codepoints(x) |> Enum.sort()
        {:|>, pipe_meta, [left, rhs]} = node ->
          if args_empty_call?(rhs, :Enum, :sort) and codepoints_call?(left) do
            {:|>, pipe_meta, [replace_codepoints(left), rhs]}
          else
            node
          end

        # Nested form: Enum.sort(String.codepoints(x)) -> Enum.sort(String.graphemes(x))
        {{:., dot_meta, [{:__aliases__, alias_meta, [:Enum]}, :sort]}, call_meta,
         [{{:., _, [{:__aliases__, _, [:String]}, :codepoints]}, _, _} = inner]} ->
          {{:., dot_meta, [{:__aliases__, alias_meta, [:Enum]}, :sort]}, call_meta,
           [replace_codepoints(inner)]}

        node ->
          node
      end)
    end)
  end

  # Replaces String.codepoints/1 with String.graphemes/1
  defp replace_codepoints(
         {{:., dot_meta, [{:__aliases__, alias_meta, [:String]}, :codepoints]}, call_meta, args}
       ) do
    {{:., dot_meta, [{:__aliases__, alias_meta, [:String]}, :graphemes]}, call_meta, args}
  end

  # Matches a zero-arity call like Enum.sort() (no args)
  defp args_empty_call?(
         {{:., _, [{:__aliases__, _, [mod]}, func]}, _, args},
         mod,
         func
       )
       when args == [],
       do: true

  defp args_empty_call?(_, _, _), do: false

  # Matches String.codepoints(x)
  defp codepoints_call?(
         {{:., _, [{:__aliases__, _, [:String]}, :codepoints]}, _, _}
       ),
       do: true

  defp codepoints_call?(_), do: false

  defp build_issue(node) do
    meta =
      case node do
        {_, m, _} when is_list(m) -> m
        _ -> []
      end

    %Issue{
      rule: :prefer_graphemes_for_character_comparisons,
      message:
        "Use `String.graphemes/1` instead of `String.codepoints/1` for anagram checks. " <>
          "`String.graphemes/1` returns user-perceived characters, which avoids incorrectly " <>
          "splitting combining characters into separate codepoints.",
      meta: %{line: Keyword.get(meta, :line)}
    }
  end
end

