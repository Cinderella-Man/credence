    content: defmodule Credence.Syntax.NoDocWithDoBlockFixTest do
  use ExUnit.Case

  import Credence.RuleCase, only: [valid_syntax?: 1]

  alias Credence.Syntax.NoDocWithDoBlock

  defp analyze(code), do: NoDocWithDoBlock.analyze(code)
  defp fix(code), do: NoDocWithDoBlock.fix(code)

  test "fixes the syntax error" do
    input = """
    defmodule Solution do
      @doc "top_n_items/2" do
      def find_top_n_items(map_data, n_items) do
        Enum.map(map_data, fn {key, value} -> {key, value} end)
      end
    end
    """

    expected = """
    defmodule Solution do
      @doc "top_n_items/2"
      def find_top_n_items(map_data, n_items) do
        Enum.map(map_data, fn {key, value} -> {key, value} end)
      end
    end
    """

    assert fix(input) == expected
  end

  test "fixed output no longer flags" do
    assert analyze(
             fix("""
             defmodule Solution do
               @doc "top_n_items/2" do
               def find_top_n_items(map_data, n_items) do
                 Enum.map(map_data, fn {key, value} -> {key, value} end)
               end
             end
             """)
           ) == []
  end

  test "fixed output is well-formed (parses)" do
    assert valid_syntax?(
             fix("""
             defmodule Solution do
               @doc "top_n_items/2" do
               def find_top_n_items(map_data, n_items) do
                 Enum.map(map_data, fn {key, value} -> {key, value} end)
               end
             end
             """)
           )
  end

  test "leaves already-clean source unchanged" do
    input = """
    defmodule Solution do
      @doc "top_n_items/2"
      def find_top_n_items(map_data, n_items) do
        Enum.map(map_data, fn {key, value} -> {key, value} end)
      end
    end
    """

    assert fix(input) == input
  end
end

