  use ExUnit.Case, async: false

  test "top 3 items from a map of 4" do
    assert Solution.find_top_n_items(%{"apple" => 5, "banana" => 2, "cherry" => 3, "date" => 1}, 3) ==
      [{"apple", 5}, {"cherry", 3}, {"banana", 2}]
  end

  test "top 2 items from a map of 4" do
    assert Solution.find_top_n_items(%{"a" => 10, "b" => 20, "c" => 30, "d" => 40}, 2) ==
      [{"d", 40}, {"c", 30}]
  end

  test "top 1 item from a map of 3" do
    assert Solution.find_top_n_items(%{"x" => 100, "y" => 200, "z" => 300}, 1) ==
      [{"z", 300}]
  end
end
