    content: defmodule Credence.Syntax.NoDocWithDoBlockAnalyzeTest do
  use ExUnit.Case

  alias Credence.Issue
  alias Credence.Syntax.NoDocWithDoBlock

  defp analyze(code), do: NoDocWithDoBlock.analyze(code)

  test "flags the unparseable code" do
    assert [%Issue{rule: :no_doc_with_do_block, meta: %{line: 2}}] =
             analyze("""
             defmodule Solution do
               @doc "top_n_items/2" do
               def find_top_n_items(map_data, n_items) do
                 Enum.map(map_data, fn {key, value} -> {key, value} end)
               end
             end
             """)
  end

  test "flags @doc with string do block" do
    assert [%Issue{rule: :no_doc_with_do_block, meta: %{line: 1}}] =
             analyze(~s(@doc "some_fn/1" do\n))
  end

  test "leaves good code alone" do
    assert analyze("""
           defmodule Solution do
             @doc "top_n_items/2"
             def find_top_n_items(map_data, n_items) do
               Enum.map(map_data, fn {key, value} -> {key, value} end)
             end
           end
           """) == []
  end

  test "leaves @doc without do alone" do
    assert analyze(~s(@doc "hello"\n)) == []
  end

  test "leaves @doc false alone" do
    assert analyze(~s(@doc false\n)) == []
  end
end

