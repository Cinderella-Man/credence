[22m23:18:34.761 [info] [ClaudeCode] step 35: Write
    content: defmodule Credence.Syntax.NoDocWithDoBlock do
  @moduledoc """
  Detects and removes erroneous `do` blocks on `@doc` module attributes.

  LLMs sometimes produce `@doc "..." do` — attaching a `do` block to a
  module attribute. Module attributes never accept `do` blocks, so this
  is always a parse error. The fix strips the trailing `do` keyword,
  leaving a bare `@doc "..."` attribute that parses and evaluates
  identically (the doc string is unchanged).

  ## Bad (won't parse)

      defmodule Solution do
        @doc "top_n_items/2" do
        def find_top_n_items(map_data, n_items) do
          Enum.map(map_data, fn {key, value} -> {key, value} end)
        end
      end

  ## Good

      defmodule Solution do
        @doc "top_n_items/2"
        def find_top_n_items(map_data, n_items) do
          Enum.map(map_data, fn {key, value} -> {key, value} end)
        end
      end
  """
  use Credence.Syntax.Rule

  alias Credence.Issue

  # Matches a line that is a @doc attribute with a trailing erroneous `do`.
  # Captures the @doc + its value, then the stray ` do` at end-of-line.
  @doc_with_do ~r/^(\s*@doc\s+.+?)\s+do\s*$/

  @impl true
  def analyze(source) do
    source
    |> String.split("\n")
    |> Enum.with_index(1)
    |> Enum.flat_map(fn {line, line_no} ->
      if Regex.match?(@doc_with_do, line) do
        [
          %Issue{
            rule: :no_doc_with_do_block,
            message: "@doc attribute followed by erroneous `do` block.",
            meta: %{line: line_no}
          }
        ]
      else
        []
      end
    end)
  end

  @impl true
  def fix(source) do
    source
    |> String.split("\n")
    |> Enum.map_join("\n", fn line ->
      Regex.replace(@doc_with_do, line, "\\1")
    end)
  end
end

