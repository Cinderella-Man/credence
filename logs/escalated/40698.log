    content: defmodule Credence.Pattern.PreferDefaultArgOverAccumulatorWrapperCheckTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferDefaultArgOverAccumulatorWrapper

  describe "flags the anti-pattern" do
    test "wrapper passes literal initial accumulator to private helper" do
      code = """
      defmodule Example do
        def compute(a, b) do
          recurse(a, 0, b)
        end

        defp recurse(_a, acc, 0), do: acc
        defp recurse(a, acc, count) do
          recurse(a, acc + a, count - 1)
        end
      end
      """

      issues = check(PreferDefaultArgOverAccumulatorWrapper, code)
      assert length(issues) == 1
      issue = hd(issues)
      assert issue.rule == :prefer_default_arg_over_accumulator_wrapper
      assert issue.meta.line != nil
    end

    test "flags with string initial accumulator" do
      code = """
      defmodule Example do
        def join_words(words) do
          join(words, "")
        end

        defp join([], acc), do: acc
        defp join([w | rest], acc) do
          join(rest, acc <> w)
        end
      end
      """

      assert flagged?(PreferDefaultArgOverAccumulatorWrapper, code)
    end

    test "flags with list initial accumulator" do
      code = """
      defmodule Example do
        def double_all(list) do
          do_double(list, [])
        end

        defp do_double([], acc), do: acc
        defp do_double([h | t], acc) do
          do_double(t, acc ++ [h * 2])
        end
      end
      """

      assert flagged?(PreferDefaultArgOverAccumulatorWrapper, code)
    end
  end

  describe "leaves good code alone" do
    test "no wrapper — public function is itself recursive" do
      code = """
      defmodule Good do
        def recurse(_a, acc, 0), do: acc
        def recurse(a, acc, count) do
          recurse(a, acc + a, count - 1)
        end
      end
      """

