    content: defmodule Credence.Pattern.PreferDefaultArgOverAccumulatorWrapper do
  @moduledoc """
  Detects public functions that exist only to supply a literal initial
  accumulator value to a private recursive helper, and merges them using
  a default argument.

  ## Bad

      def compute(a, b) do
        recurse(a, 0, b)
      end

      defp recurse(_a, acc, 0), do: acc
      defp recurse(a, acc, count) do
        recurse(a, acc + a, count - 1)
      end

  ## Good

      def compute(a, b) do
        recurse(a, b)
      end

      defp recurse(_a, acc \\\\ 0, 0), do: acc
      defp recurse(a, acc, count) do
        recurse(a, acc + a, count - 1)
      end
  """
  use Credence.Pattern.Rule
  alias Credence.Issue
  alias Credence.RuleHelpers

  @impl true
  def check(ast, _opts) do
    ast
    |> find_wrapper_patterns()
    |> Enum.map(fn info ->
      %Issue{
        rule: :prefer_default_arg_over_accumulator_wrapper,
        message:
          "Function `#{info.wrapper_name}` exists only to pass the initial accumulator " <>
            "#{inspect_literal(info.default_value)} to a private helper. " <>
            "Use a default argument instead.",
        meta: %{line: info.line}
      }
    end)
  end

  @impl true
  def fix_patches(ast, opts) do
    case find_wrapper_patterns(ast) do
      [] ->
        []

      infos ->
        source = Keyword.get(opts, :source) || Sourceror.to_string(ast)
        RuleHelpers.patches_from_ast_transform(ast, source, &apply_fixes(&1, infos))
    end
  end

  # ── Pattern detection ──────────────────────────────────────────────

  defp find_wrapper_patterns(ast) do
    clauses = collect_clauses(ast)
    by_name = Enum.group_by(clauses, & &1.name)

    Enum.flat_map(clauses, fn clause ->
      if clause.type == :def and not clause.guard? do
        case check_wrapper(clause, by_name) do
          {:ok, info} -> [info]
          :no -> []
        end
      else
        []
      end
    end)
  end

  defp check_wrapper(wrapper_clause, by_name) do
    case extract_single_call(wrapper_clause.body) do
      {:ok, call_name, call_args} when call_name != wrapper_clause.name ->
        check_wrapper_call(wrapper_clause, call_name, call_args, by_name)

      _ ->
        :no
    end
  end

  defp check_wrapper_call(wrapper_clause, helper_name, call_args, by_name) do
    wrapper_arity = length(wrapper_clause.args)
    call_arity = length(call_args)

    # The call must have exactly one more argument than the wrapper
    if call_arity != wrapper_arity + 1 do
      :no
    else
      helper_clauses =
        by_name
        |> Map.get(helper_name, [])
        |> Enum.filter(&(&1.type == :defp and &1.arity == call_arity))

      # Need at least 2 clauses (base case + recursive case)
      if length(helper_clauses) < 2 do
        :no
      else
        find_extra_literal(wrapper_clause, helper_name, call_args, helper_clauses)
      end
    end
  end

  defp find_extra_literal(wrapper_clause, helper_name, call_args, helper_clauses) do
    wrapper_args = wrapper_clause.args
    call_arity = length(call_args)

    Enum.find_value(0..(call_arity - 1), :no, fn pos ->
      call_arg = Enum.at(call_args, pos)

      if literal?(call_arg) do
        # This literal must NOT be one of the wrapper's own parameters
        if has_wrapper_param_at?(call_arg, wrapper_args) do
          nil
        else
          check_helper_base_case(wrapper_clause, helper_name, call_arg, pos, helper_clauses)
        end
      end
    end)
  end

  defp check_helper_base_case(wrapper_clause, helper_name, call_arg, pos, helper_clauses) do
    Enum.find_value(helper_clauses, fn clause ->
      param = Enum.at(clause.args, pos)

      case param do
        {param_name, _, ctx} when is_atom(param_name) and (is_nil(ctx) or is_atom(ctx)) ->
          if returns_param?(clause.body, param_name) do
            {:ok,
             %{
               wrapper_node: wrapper_clause.node,
               wrapper_name: wrapper_clause.name,
               helper_name: helper_name,
               base_clause_node: clause.node,
               literal_pos: pos,
               default_value: call_arg,
               line: Keyword.get(elem(wrapper_clause.node, 1), :line)
             }}
          end

        _ ->
          nil
      end
    end) || :no
  end

  # ── Predicates ─────────────────────────────────────────────────────

  defp returns_param?({param_name, _, ctx}, param_name)
       when is_atom(param_name) and (is_nil(ctx) or is_atom(ctx)),
       do: true

  defp returns_param?(_, _), do: false

  defp has_wrapper_param_at?(call_arg, wrapper_args) do
    Enum.any?(wrapper_args, &same_var?(call_arg, &1))
  end

  defp same_var?({name, _, ctx1}, {name, _, ctx2})
       when is_atom(name) and is_atom(ctx1) and is_atom(ctx2),
       do: true

  defp same_var?(_, _), do: false

  defp literal?({:__block__, meta, [_val]}) when is_list(meta) do
    Keyword.has_key?(meta, :token) or Keyword.has_key?(meta, :format)
  end

  defp literal?(_), do: false

  # ── Transformation ────────────────────────────────────────────────

  defp apply_fixes(ast, infos) do
    Enum.reduce(infos, ast, fn info, acc ->
      apply_single_fix(acc, info)
    end)
  end

  defp apply_single_fix(ast, info) do
    %{
      wrapper_node: wrapper_node,
      helper_name: helper_name,
      base_clause_node: base_node,
      literal_pos: pos,
      default_value: default_val
    } = info

    Macro.prewalk(ast, fn
      ^wrapper_node ->
        rewrite_wrapper_body(wrapper_node, helper_name, pos)

      ^base_node ->
        rewrite_base_clause(base_node, pos, default_val)

      node ->
        node
    end)
  end

  # Remove the literal arg from the helper call inside the wrapper body
  defp rewrite_wrapper_body(wrapper_node, helper_name, pos) do
    Macro.prewalk(wrapper_node, fn
      {^helper_name, meta, args} = node when is_list(args) and length(args) > pos ->
        {helper_name, meta, List.delete_at(args, pos)}

      node ->
        node
    end)
  end

  # Add `\\ default_value` to the param at `pos` in the base case clause
  defp rewrite_base_clause(base_node, pos, default_val) do
    {kind, meta, [head, body_kw]} = base_node
    new_head = add_default_to_head(head, pos, default_val)
    {kind, meta, [new_head, body_kw]}
  end

  defp add_default_to_head(head, pos, default_val) do
    case head do
      {:when, when_meta, [{fname, fname_meta, args}, guard]} ->
        new_args = insert_default(args, pos, default_val)
        {:when, when_meta, [{fname, fname_meta, new_args}, guard]}

      {fname, fname_meta, args} ->
        new_args = insert_default(args, pos, default_val)
        {fname, fname_meta, new_args}
    end
  end

  defp insert_default(args, pos, default_val) do
    param = Enum.at(args, pos)
    new_param = {:\\, [], [param, default_val]}
    List.replace_at(args, pos, new_param)
  end

  # ── Clause collection ─────────────────────────────────────────────

  defp collect_clauses(ast) do
    {_ast, acc} =
      Macro.prewalk(ast, [], fn
        {dt, meta, [head, body_kw]} = node, acc
        when dt in [:def, :defp] and is_list(body_kw) ->
          name = extract_func_name(head)
          args = extract_func_args(head)
          body = extract_do_body(body_kw)

          if name != nil and is_list(args) and body != nil do
            clause = %{
              type: dt,
              name: name,
              arity: length(args),
              args: args,
              guard?: match?({:when, _, _}, head),
              body: body,
              node: node,
              line: Keyword.get(meta, :line)
            }

            {node, [clause | acc]} (truncated)[0m
