      defmodule Good do
        def compute(a, b, init) do
          recurse(a, init, b)
        end

        defp recurse(_a, acc, 0), do: acc
        defp recurse(a, acc, count) do
          recurse(a, acc + a, count - 1)
        end
      end
      """

      assert clean?(PreferDefaultArgOverAccumulatorWrapper, code)
    end
  end
end

