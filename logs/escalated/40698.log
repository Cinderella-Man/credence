    content: defmodule Credence.Pattern.PreferDefaultArgOverAccumulatorWrapper do
  @moduledoc """
  Detects private helper functions that exist only to supply a literal
  initial accumulator value, and merges them using a default argument.

  When a public function's body is a single call to a private recursive
  function with an extra literal argument (the initial accumulator), the
  wrapper is unnecessary — the helper can take a default argument instead.

  ## Bad

      def compute(a, b) do
        recurse(a, 0, b)
      end

      defp recurse(_a, acc, 0), do: acc
      defp recurse(a, acc, count) do
        recurse(a, acc + a, count - 1)
      end

  ## Good

      def compute(a, b) do
        recurse(a, b)
      end

      defp recurse(_a, acc \\\\ 0, 0), do: acc
      defp recurse(a, acc, count) do
        recurse(a, acc + a, count - 1)
      end
  """
  use Credence.Pattern.Rule
  alias Credence.Issue
  alias Credence.RuleHelpers

  @impl true
  def check(ast, _opts) do
    case find_wrapper_pattern(ast) do
      {:ok, %{wrapper_name: name, line: line, default_value: val}} ->
        [%Issue{
          rule: :prefer_default_arg_over_accumulator_wrapper,
          message:
            "Function `#{name}` exists only to pass the initial accumulator " <>
              "#{inspect(val)} to a private helper. Use a default argument instead.",
          meta: %{line: line}
        }]

      :no ->
        []
    end
  end

  @impl true
  def fix_patches(ast, opts) do
    case find_wrapper_pattern(ast) do
      {:ok, info} ->
        source = Keyword.get(opts, :source) || Sourceror.to_string(ast)
        RuleHelpers.patches_from_ast_transform(ast, source, &apply_fix(&1, info))

      :no ->
        []
    end
  end

  # ── Pattern detection ──────────────────────────────────────────────

  defp find_wrapper_pattern(ast) do
    clauses = collect_clauses(ast)

    # Group by name so we can look up helpers
    by_name = Enum.group_by(clauses, & &1.name)

    Enum.find_value(clauses, :no, fn clause ->
      if clause.type == :def and not clause.guard? do
        check_wrapper(clause, by_name)
      end
    end)
  end

  defp check_wrapper(wrapper_clause, by_name) do
    case extract_single_call(wrapper_clause.body) do
      {:ok, call_name, call_args} when call_name != wrapper_clause.name ->
        check_wrapper_call(wrapper_clause, call_name, call_args, by_name)

      _ ->
        nil
    end
  end

  defp check_wrapper_call(wrapper_clause, helper_name, call_args, by_name) do
    wrapper_arity = length(wrapper_clause.args)
    call_arity = length(call_args)

    # The call must have exactly one more argument than the wrapper
    if call_arity != wrapper_arity + 1 do
      nil
    else
      # Find the helper's defp clauses
      helper_clauses =
        by_name
        |> Map.get(helper_name, [])
        |> Enum.filter(&(&1.type == :defp and &1.arity == call_arity))

      if helper_clauses == [] do
        nil
      else
        find_extra_literal(wrapper_clause, helper_name, call_args, helper_clauses)
      end
    end
  end

  defp find_extra_literal(wrapper_clause, helper_name, call_args, helper_clauses) do
    # For each position in the call args, check if the arg is a literal
    # and if the helper's base case has the same literal at that position
    wrapper_args = wrapper_clause.args
    call_arity = length(call_args)

    Enum.find_value(0..(call_arity - 1), fn pos ->
      call_arg = Enum.at(call_args, pos)

      if literal?(call_arg) do
        # Check that this position corresponds to the wrapper passing a fresh literal
        # (not one of the wrapper's own parameters)
        wrapper_pos = wrapper_arg_position(pos, wrapper_args, call_args)

        if wrapper_pos == nil do
          # This position in the call is a literal not from the wrapper's params
          check_helper_base_case(helper_name, call_arity, pos, call_arg, helper_clauses, wrapper_clause)
        else
          nil
        end
      else
        nil
      end
    end)
  end

  # Check if any helper clause is a base case that uses the literal at the given position
  # and the accumulator is returned directly
  defp check_helper_base_case(helper_name, call_arity, pos, literal, helper_clauses, wrapper_clause) do
    Enum.find_value(helper_clauses, fn clause ->
      if clause.arity == call_arity do
        param = Enum.at(clause.args, pos)

        case param do
          {param_name, _, ctx} when is_atom(param_name) and (is_nil(ctx) or is_atom(ctx)) ->
            # Check that this param is returned directly (base case pattern: `defp f(_, acc, 0), do: acc`)
            if returns_param?(clause.body, param_name) do
              %{
                wrapper_node: wrapper_clause.node,
                wrapper_name: wrapper_clause.name,
                helper_name: helper_name,
                helper_clauses: helper_clauses,
                literal_pos: pos,
                default_value: literal,
                line: Keyword.get(elem(wrapper_clause.node, 1), :line)
              }
            else
              nil
            end

          _ ->
            nil
        end
      end
    end)
  end

  # Check if body simply returns a parameter (e.g. `do: acc`)
  defp returns_param?({param_name, _, ctx}, param_name)
       when is_atom(param_name) and (is_nil(ctx) or is_atom(ctx)),
       do: true

  defp returns_param?({:__block__, _, [{param_name, _, ctx}]}, param_name)
       when is_atom(param_name) and (is_nil(ctx) or is_atom(ctx)),
       do: true

  defp returns_param?(_, _), do: false

  # Figure out which wrapper arg position corresponds to each call arg position.
  # Returns the wrapper arg index if the call arg is a wrapper param, or nil if it's a literal.
  defp wrapper_arg_position(call_pos, wrapper_args, call_args) do
    call_arg = Enum.at(call_args, call_pos)

    Enum.find_value(Enum.with_index(wrapper_args), fn {w_arg, w_idx} ->
      if same_var?(call_arg, w_arg), do: w_idx
    end)
  end

  defp same_var?({name, _, ctx1}, {name, _, ctx2})
       when is_atom(name) and is_atom(ctx1) and is_atom(ctx2),
       do: true

  defp same_var?(_, _), do: false

  # ── Helpers ────────────────────────────────────────────────────────

  defp extract_single_call(body) do
    case body do
      {name, _, args} when is_atom(name) and is_list(args) ->
        {:ok, name, args}

      {:__block__, _, [single]} ->
        extract_single_call(single)

      _ ->
        :error
    end
  end

  defp literal?({:__block__, meta, [_val]}) when is_list(meta) do
    Keyword.has_key?(meta, :token) or Keyword.has_key?(meta, :format)
  end

  defp literal?(_), do: false

  # ── Transformation ────────────────────────────────────────────────

  defp apply_fix(ast, info) do
    %{wrapper_node: wrapper_node, helper_name: helper_name, helper_clauses: helper_clauses,
      literal_pos: pos, default_value: default_val} = info

    ast
    |> rewrite_wrapper_call(wrapper_node, helper_name, pos)
    |> add_default_to_helper(helper_clauses, pos, default_val)
  end

  # Rewrite the wrapper's body call: remove the literal argument
  defp rewrite_wrapper_call(ast, wrapper_node, helper_name, pos) do
    Macro.prewalk(ast, fn
      ^wrapper_node ->
        # Rewrite the body of the wrapper
        Macro.prewalk(wrapper_node, fn
          {^helper_name, meta, args} = node when is_list(args) and length(args) > pos ->
            new_args = List.delete_at(args, pos)
            {helper_name, meta, new_args}

          node ->
            node
        end)

      node ->
        node
    end)
  end

  # Add `\\ default_value` to the helper's base case parameter at the given position
  defp add_default_to_helper(ast, helper_clauses, pos, default_val) do
