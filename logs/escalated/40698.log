    content: defmodule Credence.Pattern.PreferDefaultArgOverAccumulatorWrapperEquivalenceTest do
  @moduledoc """
  Behaviour-equivalence test for PreferDefaultArgOverAccumulatorWrapper.

  The wrapper `compute(a, b)` calls `recurse(a, 0, b)` where 0 is the
  initial accumulator. The fix removes the literal from the call and adds
  `\\ 0` as a default arg to the helper's first clause. The recursive
  arithmetic (acc + a, count - 1) must produce identical results.
  """
  use Credence.RuleCase, async: true

  import Credence.BehaviourEquivalence
  alias Credence.Pattern.PreferDefaultArgOverAccumulatorWrapper

  @before """
  defmodule AccumWrapperExample do
    def compute(a, b) do
      recurse(a, 0, b)
    end

    defp recurse(_a, acc, 0), do: acc
    defp recurse(a, acc, count) do
      recurse(a, acc + a, count - 1)
    end
  end
  """

  test "wrapper → default arg preserves behaviour" do
    assert_equivalent_module(@before,
      rule: PreferDefaultArgOverAccumulatorWrapper,
      call: {:compute, 2},
      inputs: [
        {3, 0},
        {3, 1},
        {0, 5},
        {1, 10},
        {7, 3}
      ]
    )
  end
end

