defmodule Solution do
  @doc """
  Computes the factorial of a non-negative integer n without using the
  multiplication operator. Only addition is used, resulting in O(n^2) time
  complexity.
  """
  @spec factorial_without_multiplication(non_neg_integer) :: non_neg_integer
  def factorial_without_multiplication(0) do
    1
  end

  def factorial_without_multiplication(n) when n > 0 do
    # We need to compute n! = 1 * 2 * ... * n
    # Multiplication by addition: a * b = sum of a, b times.
    # So n! = 1 * 2 * 3 * ... * n
    # We can compute iteratively: result = result * i
    # where result starts at 1, and for i in 2..n, we do:
    # result = add(result, i) repeated? No, result * i means adding result, i times.
    
    # Let's implement multiplication using addition first
    # mul(a, b) adds a to itself b times.
    
    # Then factorial(n) = mul(n, factorial(n-1)) ? No, standard recursive:
    # factorial(n) = n * factorial(n-1)
    # So we need a function that multiplies without *
    
    factorial_recursive(n)
  end

  # Helper for factorial: n! = n * (n-1)!
  # But we need to compute n * (n-1)! using addition
  # Let's define mul_add(a, b) that computes a * b using addition
  # mul_add(a, b) = add a, b times
  
  # To compute factorial_iteratively(1, 2, n) = 1 * 2 * 3 * ... * n
  # Start with acc = 1
  # For i from 2 to n: acc = acc * i = add acc, i times
  
  defp factorial_recursive(n) do
    if n == 1 do
      1
    else
      # We need to multiply (factorial_recursive(n-1)) by n
      # using addition. So we take the result of factorial(n-1) and add it n times.
      # But that's not efficient in recursion. Let's do iterative approach.
      
      factorial_iterative(n)
    end
  end

  defp factorial_iterative(n) do
    # We want to compute n! = 1 * 2 * ... * n
    # Start with acc = 1
    # For i = 2 to n: acc = mul(acc, i) where mul adds acc i times
    
    1
    |> factor_helper(2, n)
  end

  # factor_helper(current_acc, next_i, n)
  # When next_i > n, return current_acc
  defp factor_helper(acc, next_i, n) when next_i > n do
    acc
  end

  defp factor_helper(acc, next_i, n) do
    # acc = acc * next_i, computed by addition
    # acc_new = add(acc, next_i) repeated next_i times? No.
    # acc * next_i means: acc added to itself next_i times.
    # So we need to add acc, next_i times.
    new_acc = add_n_times(acc, next_i)
    factor_helper(new_acc, next_i + 1, n)
  end

  # add_n_times(value, n): adds value to itself n times, starting from 0
  # Actually, value * n = value + value + ... (n times)
  # We can compute this by adding value n times starting from 0
  defp add_n_times(value, 0) do
    0
  end

  defp add_n_times(value, n) do
    add_n_times_helper(value, 0, n)
  end

  defp add_n_times_helper(_value, acc, 0) do
    acc
  end

  defp add_n_times_helper(value, acc, count) do
    add_n_times_helper(value, acc + value, count - 1)
  end
end
---TEST---
