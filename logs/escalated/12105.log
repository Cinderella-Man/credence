defmodule Solution do
  @spec spiral_order([[integer]]) :: [integer]
  def spiral_order([]), do: []
  def spiral_order(matrix) do
    rows = length(matrix)
    cols = length(hd(matrix))
    matrix_tuple = List.to_tuple(Enum.map(matrix, &List.to_tuple/1))
    do_spiral(matrix_tuple, 0, cols - 1, 0, rows - 1, [])
  end

  defp do_spiral(_matrix, left, right, top, bottom, acc)
       when left > right or top > bottom do
    acc
  end

  defp do_spiral(matrix, left, right, top, bottom, acc) do
    # Top row (left to right)
    acc = acc ++ (for i <- left..right, do: elem(elem(matrix, top), i))
    top = top + 1

    # Right column (top to bottom)
    acc =
      if top <= bottom do
        acc ++ (for i <- top..bottom, do: elem(elem(matrix, i), right))
      else
        acc
      end
    right = right - 1

    # Bottom row (right to left)
    acc =
      if left <= right and top <= bottom do
        acc ++ (for i <- right..left//-1, do: elem(elem(matrix, bottom), i))
      else
        acc
      end
    bottom = bottom - 1

    # Left column (bottom to top)
    acc =
      if left <= right and top <= bottom do
        acc ++ (for i <- bottom..top//-1, do: elem(elem(matrix, i), left))
      else
        acc
      end
    left = left + 1

    do_spiral(matrix, left, right, top, bottom, acc)
  end
end

