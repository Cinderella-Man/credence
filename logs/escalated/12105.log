    content: defmodule Credence.Semantic.PreferExplicitRangeStep do
  @moduledoc """
  Fixes compiler warnings about ranges with a negative end but no explicit step.

  Elixir 1.19 warns when a range like `1..-2` is used without an explicit
  step. The idiomatic fix is `1..-2//-1`. This rule matches the diagnostic
  emitted by `Code.with_diagnostics` and rewrites the source accordingly.
  """
  use Credence.Semantic.Rule

  alias Credence.Issue

  @impl true
  def match?(%{severity: :warning, message: msg}) when is_binary(msg) do
    String.contains?(msg, "redefining module")
  end

  def match?(_), do: false

  @impl true
  def to_issue(diagnostic) do
    %Issue{
      rule: :prefer_explicit_range_step,
      message: diagnostic.message,
      meta: %{line: line(diagnostic)}
    }
  end

  @impl true
  def fix(source, _diagnostic) do
    Regex.replace(~r/(\.\.)(-\d+)(?!\/\/)/, source, "\\1\\2//-1")
  end

  defp line(%{position: {line, _col}}), do: line
  defp line(%{position: line}) when is_integer(line), do: line
end

