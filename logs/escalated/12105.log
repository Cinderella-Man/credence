defmodule Solution do
  @doc """
  Returns a list of integers representing the elements of the matrix in spiral order.
  """
  @spec spiral_order(matrix :: list(list(integer))) :: list(integer)
  def spiral_order([]) do
    []
  end

  def spiral_order(matrix) do
    spiral_collect(matrix, [])
  end

  defp spiral_collect([], acc) do
    acc
  end

  defp spiral_collect([row], acc) do
    acc ++ row
  end

  defp spiral_collect(matrix, acc) do
    [top, middle_rows] = Enum.split(matrix, 1)

    top_row = hd(top)
    bottom_row = List.last(middle_rows)
    middle_rows_no_bottom = Enum.drop(middle_rows, 1)

    left_col = Enum.map(middle_rows_no_bottom, &hd/1) |> Enum.reverse()
    right_col = Enum.map(middle_rows_no_bottom, &List.last/1)
    bottom_row_inner = Enum.reverse(Enum.drop(bottom_row, 1))

    new_acc = acc ++ top_row ++ right_col ++ bottom_row_inner ++ left_col

    inner =
      Enum.map(middle_rows_no_bottom, fn row ->
        row |> Enum.reverse() |> Enum.drop(1) |> Enum.reverse() |> Enum.drop(1)
      end)

    spiral_collect(inner, new_acc)
  end
end
