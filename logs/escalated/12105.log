defmodule Solution do
  @doc """
  Returns a list of integers representing the elements of the matrix in spiral order.
  """
  @spec spiral_order(matrix :: list(list(integer))) :: list(integer)
  def spiral_order(matrix) do
    do_spiral(matrix, [])
  end

  defp do_spiral([], acc), do: acc
  defp do_spiral([], acc), do: acc

  defp do_spiral(matrix, acc) do
    # Take the first row as the top boundary
    [top_row | remaining_rows] = matrix
    acc = acc ++ top_row

    # If no rows remain, we are done
    if remaining_rows == [] do
      acc
    else
      # Take the last row as the bottom boundary (reversed later for correct traversal)
      # We need to collect the right column from remaining_rows (excluding bottom row)
      # Then the bottom row (excluding first element which is handled by top row traversal if 1xN, but here we handle edges)
      
      # Let's peel the border:
      # 1. Top row: done (added to acc)
      # 2. Right column: elements from remaining_rows, taking the last element of each row
      # 3. Bottom row: the last row in remaining_rows, reversed (except the last element which is the bottom-right corner, already taken by right column step? No, bottom-right corner is taken by right column step. So we take bottom row reversed, excluding the last element)
      # 4. Left column: elements from remaining_rows (excluding the bottom row), taking the first element, in reverse order (so we traverse from bottom-left up to top-left)
      
      # Actually, standard spiral:
      # - Top row left-to-right: done
      # - Right column top-to-bottom (excluding top-left of this sub-matrix which is the element below the first row? No.
      #   The right column consists of the last element of each row in remaining_rows.
      #   The bottom-right corner is the last element of the last row. It should be included.
      # - Bottom row right-to-left (excluding the bottom-right corner which was just taken).
      #   So we take the last row, reverse it, and drop the last element (which is the bottom-right corner).
      # - Left column bottom-to-top (excluding the bottom-left corner which is handled by bottom row? No.
      #   The left column consists of the first element of each row in remaining_rows, excluding the last row.
      #   We traverse from the second-to-last row up to the first row. So we reverse the list of these first elements.
      
      # Let's implement this carefully.
      
      # Right column:
      right_col = Enum.map(remaining_rows, &List.last/1)
      acc = acc ++ right_col
      
      # Bottom row inner (reverse of bottom row, excluding the last element which was the last element of the right column):
      last_row = List.last(remaining_rows)
      bottom_inner = Enum.reverse(Enum.drop(last_row, 1))
      acc = acc ++ bottom_inner
      
      # Left column:
      # The rows involved are all except the last one in remaining_rows.
      # We want the first element of each of these rows, from bottom to top.
      # So we take remaining_rows minus the last row, reverse them, and take the first element of each.
      remaining_rows_except_last = Enum.drop(remaining_rows, -1)
      if Enum.empty?(remaining_rows_except_last) do
        # No more rows to process for left column, we are done with this layer
        inner_matrix = Enum.map(remaining_rows_except_last, fn row -> Enum.drop(row, 1) |> Enum.reverse() |> Enum.drop(1) end)
        do_spiral(inner_matrix, acc)
      else
        left_col = Enum.map(Enum.reverse(remaining_rows_except_last), &hd/1)
        acc = acc ++ left_col
        
        # Recurse with the inner matrix
        inner_matrix = Enum.map(Enum.drop(remaining_rows, -1), fn row -> Enum.drop(row, 1) |> Enum.reverse() |> Enum.drop(1) end)
        do_spiral(inner_matrix, acc)
      end
    end
  end
end
