@doc """
Counts the number of words that appear exactly once in both input lists simultaneously.
"""
@spec count_unique_once([String.t()], [String.t()]) :: non_neg_integer()
def count_unique_once(list1, list2) do
  {freq1, freq2} = compute_frequencies(list1, list2)

  freq1
  |> Map.keys()
  |> Enum.count(fn word ->
    Map.get(freq2, word, 0) == 1 and Map.get(freq1, word, 0) == 1
  end)
end

defp compute_frequencies(list1, list2) do
  {freq1, freq2} = Enum.reduce(list1, {Map.new(), Map.new()}, fn word, {f1, f2} ->
    {Map.update(f1, word, 1, &(&1 + 1)), f2}
  end)

  freq2 = Enum.reduce(list2, freq2, fn word, f2 ->
    Map.update(f2, word, 1, &(&1 + 1))
  end)

  {freq1, freq2}
end
