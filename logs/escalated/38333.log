defmodule Solution do
  @doc """
  Calculates the sum of the first n terms of the harmonic series.
  """
  @spec harmonic_sum(pos_integer()) :: float()
  def harmonic_sum(0) do
    0.0
  end

  def harmonic_sum(n) when n > 0 do
    1..n
    |> Enum.reduce(0, fn el, acc ->
      acc + 1.0 / el
    end)
  end

  def harmonic_sum(_n) do
    0.0
  end
end
