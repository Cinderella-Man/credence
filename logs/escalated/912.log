    content: defmodule Credence.Semantic.PreferComprehensionForRangeToMapFixTest do
  use ExUnit.Case

  import Credence.RuleCase, only: [valid_syntax?: 1]

  alias Credence.Semantic.PreferComprehensionForRangeToMap

  defp fix(source, message \\ nil, line \\ 1) do
    msg = message || "credence_check.ex: cannot compile module Solution (errors have been logged)"

    PreferComprehensionForRangeToMap.fix(source, %{
      severity: :error,
      message: msg,
      position: {line, 1}
    })
  end

  test "fixes Map.new with range to comprehension" do
    input = """
    defmodule PreferComprehensionExample do
      @moduledoc "Builds an adjacency list map using Map.new/2 with a range."

      def build_adjacency_list(n) do
        Map.new(0..(n - 1), fn _k -> [] end)
      end
    end
    """

    expected = """
    defmodule PreferComprehensionExample do
      @moduledoc "Builds an adjacency list map using Map.new/2 with a range."

      def build_adjacency_list(n) do
        for k <- 0..(n - 1), into: %{}, do: {k, []}
      end
    end
    """

    assert fix(input) == expected
  end

  test "fixed output is well-formed (parses)" do
    assert valid_syntax?(
             fix("""
             defmodule PreferComprehensionExample do
               @moduledoc "Builds an adjacency list map using Map.new/2 with a range."

               def build_adjacency_list(n) do
                 Map.new(0..(n - 1), fn _k -> [] end)
               end
             end
             """)
           )
  end

  test "returns source unchanged when no Map.new pattern" do
    input = """
    defmodule Solution do
      def build_map(n) do
        Enum.map(0..(n - 1), fn k -> {k, []} end)
        |> Map.new()
      end
    end
    """

    assert fix(input) == input
  end
end

