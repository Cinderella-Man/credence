defmodule Solution do
  @doc """
  Determines if the given undirected graph is a valid tree.
  """
  @spec validtree?(non_neg_integer(), list(list(integer()))) :: boolean()
  def validtree?(n, _edges) when n < 0 do
    false
  end

  def validtree?(0, _edges) do
    true
  end

  def validtree?(1, edges) do
    Enum.empty?(edges)
  end

  # A valid tree must have exactly n-1 edges
  def validtree?(n, edges) do
    if Enum.count(edges) == n - 1 do
      adj = build_adjacency_list(n, edges)
      # Start DFS from vertex 0
      {visited, has_cycle} = dfs(0, adj, MapSet.new(), MapSet.new(), false)
      # Check if all nodes were visited (connected) and no cycles found
      MapSet.size(visited) == n and not has_cycle
      # Build adjacency list
    else
      false
    end
  end

  defp build_adjacency_list(n, edges) do
    Enum.reduce(edges, Map.new(0..(n - 1), fn _k -> [] end), fn [u, v], acc ->
      acc
      |> Map.update!(u, fn neighbors -> [v | neighbors] end)
      |> Map.update!(v, fn neighbors -> [u | neighbors] end)
    end)
  end

  defp dfs(vertex, adj, visited, stack, has_cycle) do
    if MapSet.member?(visited, vertex) do
      {visited, has_cycle or MapSet.member?(stack, vertex)}
