        Enum.reduce(adj[vertex], {visited_set, stack_set, has_cycle}, fn neighbor,
                                                                         {vis, st, cyc} ->
          if MapSet.member?(vis, neighbor) do
            if MapSet.member?(st, neighbor) do
              {vis, st, cyc or true}
