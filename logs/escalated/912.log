defmodule Solution do
  @spec validtree(n :: integer, edges :: [[integer]]) :: boolean
  def validtree(0, _edges), do: true
  def validtree(1, []), do: true
  def validtree(n, edges) when n > 1 do
    # Quick edge count check: a tree must have exactly n-1 edges.
    if length(edges) != n - 1 do
      false
    else
      graph = build_graph(n, edges)
      visited = MapSet.new()
      case dfs(0, -1, graph, visited) do
        {:ok, final_visited} -> MapSet.size(final_visited) == n
        {:cycle} -> false
      end
    end
  end

  defp build_graph(n, edges) do
    graph = for i <- 0..(n - 1), into: %{}, do: {i, []}
    Enum.reduce(edges, graph, fn [a, b], acc ->
      acc
      |> Map.update!(a, fn list -> [b | list] end)
      |> Map.update!(b, fn list -> [a | list] end)
    end)
  end

  defp dfs(node, parent, graph, visited) do
    if MapSet.member?(visited, node) do
      {:cycle}
    else
      visited = MapSet.put(visited, node)
      neighbors = Map.get(graph, node, [])
      Enum.reduce_while(neighbors, {:ok, visited}, fn neighbor, {:ok, acc} ->
        if neighbor == parent do
          {:cont, {:ok, acc}}
        else
          if MapSet.member?(acc, neighbor) do
            {:halt, {:cycle}}
          else
            case dfs(neighbor, node, graph, acc) do
              {:ok, new_acc} -> {:cont, {:ok, new_acc}}
              {:cycle} -> {:halt, {:cycle}}
            end
          end
        end
      end)
    end
  end
end
