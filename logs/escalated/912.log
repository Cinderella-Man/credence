    content: defmodule Credence.Semantic.PreferComprehensionForRangeToMap do
  @moduledoc """
  Fixes compiler errors when `Map.new/2` is called with a range but the
  anonymous function returns a bare value instead of `{key, value}` tuples.

  LLMs frequently generate `Map.new(0..(n-1), fn _k -> value end)` where the
  function returns a bare value rather than a `{key, value}` tuple. This causes
  a runtime `ArgumentError` in `:maps.from_list/1` because `Map.new/2` expects
  tuples from the mapper function.

  The fix rewrites to a `for` comprehension which naturally produces `{key, value}`
  pairs:

      # Before (LLM error — bare value in Map.new mapper)
      Map.new(0..(n - 1), fn _k -> [] end)

      # After (idiomatic comprehension)
      for k <- 0..(n - 1), into: %{}, do: {k, []}
  """
  use Credence.Semantic.Rule

  alias Credence.Issue

  @impl true
  def match?(%{message: msg}) when is_binary(msg) do
    String.contains?(msg, "cannot compile module")
  end

  def match?(_), do: false

  @impl true
  def to_issue(diagnostic) do
    %Issue{
      rule: :prefer_comprehension_for_range_to_map,
      message: "Map.new/2 with range should use a comprehension instead",
      meta: %{line: line(diagnostic)}
    }
  end

  @impl true
  def fix(source, _diagnostic) do
    case parse(source) do
      {:ok, ast} ->
        transformed = transform(ast)

        if transformed == ast do
          source
        else
          rendered = Sourceror.to_string(transformed)

          case Sourceror.parse_string(rendered) do
            {:ok, re_parsed} ->
              patches = Credence.RuleHelpers.patches_from_diff(ast, re_parsed)

              if patches == [] do
                source
              else
                result = Sourceror.patch_string(source, patches)
                if result == source, do: source, else: result
              end

            {:error, _} ->
              source
          end
        end

      :error ->
        source
    end
  end

  defp line(%{position: {line, _col}}), do: line
  defp line(%{position: line}) when is_integer(line), do: line

  defp parse(source) do
    {:ok, Sourceror.parse_string!(source)}
  rescue
    _ -> :error
  end

  # Walk the AST looking for Map.new(range, fn var -> value end) patterns
  defp transform(ast) do
    Macro.postwalk(ast, fn
      # Match: Map.new(range, fn var -> value end)
      # AST shape: {{:., [], [{:__aliases__, _, [:Map]}, :new]}, meta, [range, {:fn, _, [{:->, _, [[{var, _, nil}], value]}]}]}
      {{:., dot_meta, [{:__aliases__, aliases_meta, [:Map]}, :new]}, call_meta,
       [range, {:fn, fn_meta, [{:->, arrow_meta, [[{var_name, var_meta, nil}], value]}]}]} ->
        build_comprehension(range, {var_name, var_meta, nil}, value)

      node ->
        node
    end)
  end

  defp build_comprehension(range, var, value) do
    # Build: for var <- range, into: %{}, do: {var, value}
    var_ref = {elem(var, 0), [], nil}

    {:for, [],
     [
       {:<-, [], [var, range]},
       [
         {{:__block__, [format: :keyword], [:into]}, {:%{}, [], []}},
         {{:__block__, [format: :keyword], [:do]},
          {:__block__, [],
           [
             {var_ref, value}
           ]}}
       ]
     ]}
  end
end

