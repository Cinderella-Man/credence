defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "valid tree with 5 vertices" do
    assert Solution.validtree?(5, [[0, 1], [0, 2], [0, 3], [1, 4]]) == true
  end

  test "graph with a cycle" do
    assert Solution.validtree?(5, [[0, 1], [1, 2], [2, 3], [1, 3], [1, 4]]) == false
  end

  test "disconnected graph (two vertices, no edges)" do
    assert Solution.validtree?(2, []) == false
  end

  test "single vertex, no edges" do
    assert Solution.validtree?(1, []) == true
  end

  test "empty graph (zero vertices)" do
    assert Solution.validtree?(0, []) == true
  end
end
