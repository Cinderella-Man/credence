@doc """
Determines if the given undirected graph is a valid tree.
"""
@spec validtree?(non_neg_integer(), list(list(integer()))) :: boolean()
def validtree?(n, edges) when n < 0 do
  false
end

def validtree?(0, _edges) do
  true
end

def validtree?(1, edges) do
  Enum.empty?(edges)
end

def validtree?(n, edges) do
  if Enum.count(edges) != n - 1 do
    false
  else
    adj = build_adjacency_list(n, edges)
    case dfs(0, adj, MapSet.new(), MapSet.new(), false) do
      {visited_count, has_cycle} when visited_count == n and not has_cycle ->
        true
      _ ->
        false
    end
  end
end

defp build_adjacency_list(n, edges) do
  initial = Map.new(0..(n - 1), fn _k -> MapSet.new() end)

  Enum.reduce(edges, initial, fn [u, v], acc ->
    acc
    |> Map.update!(u, fn neighbors -> MapSet.put(neighbors, v) end)
    |> Map.update!(v, fn neighbors -> MapSet.put(neighbors, u) end)
  end)
end

defp dfs(vertex, adj, visited, stack, has_cycle) do
  visited_set = MapSet.put(visited, vertex)
  stack_set = MapSet.put(stack, vertex)

  {final_visited_size, final_has_cycle} =
    Enum.reduce_while(adj[vertex], {MapSet.size(visited_set), has_cycle}, fn neighbor, {vis_size, cyc} ->
      if MapSet.member?(visited_set, neighbor) do
        if MapSet.member?(stack_set, neighbor) do
          {:halt, {vis_size, cyc or true}}
        else
          {:cont, {vis_size, cyc}}
        end
      else
        case dfs(neighbor, adj, visited_set, stack_set, cyc) do
          {size, has_cycle} ->
            if has_cycle do
              {:halt, {size, true}}
            else
              {:cont, {size + 1, cyc}}
            end
        end
      end
    end)

  {final_visited_size, final_has_cycle}
end[0m
