---REFERENCE---
```elixir
defmodule Solution do
  def checkvalidstring(s) do
    result =
      s
      |> String.to_charlist()
      |> Enum.with_index()
      |> Enum.reduce_while({[], []}, fn {char, idx}, {left, star} ->
        case char do
          ?( -> {:cont, {[idx | left], star}}
          ?* -> {:cont, {left, [idx | star]}}
          ?) ->
            cond do
              left != [] ->
                [_ | rest_left] = left
                {:cont, {rest_left, star}}
              star != [] ->
                [_ | rest_star] = star
                {:cont, {left, rest_star}}
              true ->
                {:halt, :error}
            end
        end
      end)

    case result do
      :error ->
        false
      {left, star} ->
        if left == [] do
          true
        else
          if star == [] do
            false
          else
            match_left_star(left, star)
          end
        end
    end
  end

  defp match_left_star([], _), do: true
  defp match_left_star(_, []), do: false
  defp match_left_star([l | rest_left], [s | rest_star]) do
    if l < s do
      match_left_star(rest_left, rest_star)
    else
      false
    end
  end
end
```
