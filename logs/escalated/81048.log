@doc """
Checks if a string containing '(', ')', and '*' is valid.

A valid string can have its '*' characters replaced with '(', ')', or empty
such that the resulting string has balanced parentheses.

The algorithm uses two passes (left-to-right and right-to-left) to track
the balance of parentheses, treating '*' as a wildcard that can help balance.
"""
@spec checkvalidstring(String.t()) :: boolean()
def checkvalidstring(s) do
  # Empty string is valid
  if String.length(s) == 0 do
    true
  else
    # First pass: left to right
    # Treat '(' as +1, ')' as -1, '*' as wildcard (can be anything)
    # We track min_balance and max_balance
    # min_balance: the lowest possible balance considering * as ')'
    # max_balance: the highest possible balance considering * as '('
    # If max_balance ever goes negative, it's invalid
    # If min_balance goes negative, it means we might have too many ')', but * could fix it
    # Actually, the standard approach is:
    # left pass: count open and wildcard. If open < 0 at any point, invalid.
    # right pass: count close and wildcard. If close < 0 at any point, invalid.

    left_pass_valid?(s) and right_pass_valid?(s)
  end
end

# Left to right pass
defp left_pass_valid?(s) do
  chars = String.graphemes(s)
  left_pass_helper(chars, 0, 0)
end

defp left_pass_helper([], _balance, _wildcards) do
  true
end

defp left_pass_helper([char | rest], balance, wildcards) do
  new_balance =
    case char do
      "(" -> balance + 1
      ")" -> balance - 1
      "*" -> balance
    end

  new_wildcards =
    case char do
      "*" -> wildcards + 1
      _ -> wildcards
    end

  # If balance goes negative, we might need a wildcard to be '('
  # But actually, the condition is: if balance < -wildcards, it's invalid
  # Because we can use at most wildcards as '(' to cover the deficit
  
  if new_balance + new_wildcards < 0 do
    false
  else
    left_pass_helper(rest, new_balance, new_wildcards)
  end
end

# Right to left pass
defp right_pass_valid?(s) do
  chars = String.graphemes(s) |> Enum.reverse()
  right_pass_helper(chars, 0, 0)
end

defp right_pass_helper([], _balance, _wildcards) do
  true
end

defp right_pass_helper([char | rest], balance, wildcards) do
  new_balance =
    case char do
      ")" -> balance + 1
      "(" -> balance - 1
      "*" -> balance
    end

  new_wildcards =
    case char do
      "*" -> wildcards + 1
      _ -> wildcards
    end

  # If balance goes negative in right-to-left, it means too many '(' that aren't closed
  if new_balance + new_wildcards < 0 do
    false
  else
    right_pass_helper(rest, new_balance, new_wildcards)
  end
end[0m
