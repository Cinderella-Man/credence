  use ExUnit.Case, async: false

  test "(*)) is valid" do
    assert Solution.checkvalidstring("(*))") == true
  end

  test "() is valid" do
    assert Solution.checkvalidstring("()") == true
  end

  test "(*) is valid" do
    assert Solution.checkvalidstring("(*)") == true
  end

  test "(((*) is invalid" do
    assert Solution.checkvalidstring("(((*)") == false
  end
end
