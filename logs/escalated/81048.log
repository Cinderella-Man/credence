    content: defmodule Credence.Pattern.PreferLengthZeroOverEquality do
  @moduledoc """
  Detects `String.length(string) == 0` used to check for empty strings.

  While `String.length/1 == 0` works, it is non-idiomatic Elixir. Prefer
  direct comparison with `""` for empty-string checks, which is clearer
  and more idiomatic.

  Note: No auto-fix is available because the recommended replacement
  (`string == ""`) has different semantics — `String.length(nil) == 0`
  raises an `ArgumentError`, while `nil == ""` returns `false`.

  ## Bad

      String.length(string) == 0
      String.length(str) == 0
      0 == String.length(string)

  ## Good

      string == ""
  """

  use Credence.Pattern.Rule
  alias Credence.Issue

  @impl true
  def check(ast, _opts) do
    {_ast, issues} =
      Macro.prewalk(ast, [], fn node, acc ->
        case detect_pattern(node) do
          {:ok, meta} -> {node, [build_issue(meta) | acc]}
          :skip -> {node, acc}
        end
      end)

    Enum.reverse(issues)
  end

  @impl true
  def fix_patches(_ast, _opts) do
    # No auto-fix available: String.length(nil) == 0 raises ArgumentError,
    # while nil == "" returns false. The semantics differ for nil inputs.
    []
  end

  # String.length(x) == 0
  defp detect_pattern({:==, meta, [string_length_call, zero]}) do
    if string_length_call?(string_length_call) and zero?(zero) do
      {:ok, meta}
    else
      :skip
    end
  end

  # 0 == String.length(x)
  defp detect_pattern({:==, meta, [zero, string_length_call]}) do
    if string_length_call?(string_length_call) and zero?(zero) do
      {:ok, meta}
    else
      :skip
    end
  end

  defp detect_pattern(_), do: :skip

  # Matches String.length(arg) AST shape
  defp string_length_call?({{:., _, [{:__aliases__, _, [:String]}, :length]}, _, [_arg]}),
    do: true

  defp string_length_call?(_), do: false

  # Matches literal 0 (Sourceror wraps in :__block__ for position metadata)
  defp zero?({:__block__, _, [0]}), do: true
  defp zero?(0), do: true
  defp zero?(_), do: false

  defp build_issue(meta) do
    %Issue{
      rule: :prefer_length_zero_over_equality,
      message: """
      `String.length(string) == 0` is a non-idiomatic way to check for an \
      empty string.

      Prefer direct comparison with `""`:

          string == ""
      """,
      meta: %{line: Keyword.get(meta, :line)}
    }
  end
end

