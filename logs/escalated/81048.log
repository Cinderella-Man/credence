    content: defmodule Credence.Pattern.PreferLengthZeroOverEqualityCheckTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferLengthZeroOverEquality

  # ═══════════════════════════════════════════════════════════════════
  # POSITIVE — should flag String.length(x) == 0
  # ═══════════════════════════════════════════════════════════════════

  describe "flags the anti-pattern" do
    test "String.length(var) == 0 in a function body" do
      assert flagged?(PreferLengthZeroOverEquality, """
             defmodule Example do
               def empty?(string) do
                 String.length(string) == 0
               end
             end
             """)
    end

    test "0 == String.length(var) — reversed operands" do
      assert flagged?(PreferLengthZeroOverEquality, """
             defmodule Example do
               def empty?(string) do
                 0 == String.length(string)
               end
             end
             """)
    end

    test "String.length(var) == 0 in a pipeline" do
      assert flagged?(PreferLengthZeroOverEquality, """
             defmodule Example do
               def empty?(string) do
                 String.length(string) == 0
               end
             end
             """)
    end

    test "String.length(call) == 0 with function call argument" do
      assert flagged?(PreferLengthZeroOverEquality, """
             defmodule Example do
               def empty?(input) do
                 String.length(to_string(input)) == 0
               end
             end
             """)
    end
  end

  # ═══════════════════════════════════════════════════════════════════
  # NEGATIVE — should NOT flag
  # ═══════════════════════════════════════════════════════════════════

  describe "leaves good code alone" do
    test "string == \"\" — idiomatic empty check" do
      assert clean?(PreferLengthZeroOverEquality, """
             defmodule Example do
               def empty?(string) do
                 string == ""
               end
             end
             """)
    end

    test "String.length(var) == 1 — comparison with non-zero" do
      assert clean?(PreferLengthZeroOverEquality, """
             defmodule Example do
               def single_char?(string) do
                 String.length(string) == 1
               end
             end
             """)
    end

    test "String.length(var) > 0 — different comparison operator" do
      assert clean?(PreferLengthZeroOverEquality, """
             defmodule Example do
               def not_empty?(string) do
                 String.length(string) > 0
               end
             end
             """)
    end

    test "length(list) == 0 — Kernel.length, not String.length" do
      assert clean?(PreferLengthZeroOverEquality, """
             defmodule Example do
               def empty_list?(list) do
                 length(list) == 0
               end
             end
             """)
    end

    test "String.length(var) == 0 in guard — different context" do
      assert clean?(PreferLengthZeroOverEquality, """
             defmodule Example do
               def size(string), do: String.length(string)
             end
             """)
    end
  end
end

