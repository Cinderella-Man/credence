    content: defmodule Credence.Pattern.PreferLengthZeroOverEqualityFixTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferLengthZeroOverEquality

  describe "PreferLengthZeroOverEquality fix" do
    test "no auto-fix — String.length(var) == 0 is left unchanged" do
      input = """
      defmodule Example do
        def empty?(string) do
          String.length(string) == 0
        end
      end
      """

      # No auto-fix available: the idiomatic replacement (string == "")
      # has different semantics for nil inputs.
      assert fix(PreferLengthZeroOverEquality, input) == input
    end

    test "no auto-fix — reversed 0 == String.length(var) is left unchanged" do
      input = """
      defmodule Example do
        def empty?(string) do
          0 == String.length(string)
        end
      end
      """

      assert fix(PreferLengthZeroOverEquality, input) == input
    end

    test "no auto-fix — preserves surrounding code unchanged" do
      input = """
      defmodule Example do
        def empty?(string) do
          String.length(string) == 0
        end

        def not_empty?(string) do
          String.length(string) > 0
        end
      end
      """

      assert fix(PreferLengthZeroOverEquality, input) == input
    end

    test "clean code passes through unchanged" do
      input = """
      defmodule Example do
        def empty?(string) do
          string == ""
        end
      end
      """

      assert fix(PreferLengthZeroOverEquality, input) == input
    end
  end
end

