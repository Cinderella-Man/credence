      "(" -> balance - 1
      "*" -> balance
    end

  new_wildcards =
    case char do
      "*" -> wildcards + 1
      _ -> wildcards
    end

  # If balance goes negative in right-to-left, it means too many '(' that aren't closed
  if !(new_balance + new_wildcards < 0) do
      right_pass_helper(rest, new_balance, new_wildcards)
  else
      false
  end
end
end
