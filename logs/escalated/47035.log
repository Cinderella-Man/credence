    # Result: ["Silver", "Silver", "Gold"]

    # Assign awards based on rank position
    ranked_awards =
      sorted_scores
      |> Enum.with_index(1)
      |> Enum.map(fn {{score, _idx}, rank} ->
        award =
          case rank do
            1 -> "Gold Medal"
            2 -> "Silver Medal"
            3 -> "Bronze Medal"
            other -> Integer.to_string(other)
          end

        {score, award}
      end)

    # Create a map from score to award
    score_to_award = Map.new(ranked_awards)

    # Reconstruct the result in the original order
    indexed_scores
    |> Enum.map(fn {score, _idx} -> Map.get(score_to_award, score) end)
  end
end
