defmodule Solution do
  def find_relative_ranks([]), do: []

  def find_relative_ranks(nums) do
    sorted = Enum.sort(nums, :desc)

    rank_map =
      sorted
      |> Enum.with_index(1)
      |> Enum.into(%{}, fn {num, rank} ->
        {num, rank_to_string(rank)}
      end)

    Enum.map(nums, &Map.fetch!(rank_map, &1))
  end

  defp rank_to_string(1), do: "Gold Medal"
  defp rank_to_string(2), do: "Silver Medal"
  defp rank_to_string(3), do: "Bronze Medal"
  defp rank_to_string(rank), do: Integer.to_string(rank)
end
