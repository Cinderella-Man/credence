---MODULE---
@doc """
Given a list of numbers, return a list of strings representing the relative ranking
of each number in the original order. The highest number receives "Gold Medal",
the second highest receives "Silver Medal", the third highest receives "Bronze Medal",
and all remaining numbers receive their rank as a string (4, 5, etc.).
"""
@spec find_relative_ranks(list(number)) :: list(String.t())
def find_relative_ranks(scores) when is_list(scores) do
  case scores do
    [] -> []
    _ ->
      # Create tuples of {score, original_index}
      indexed_scores = Enum.with_index(scores)

      # Sort by score descending to determine ranks
      sorted_scores = indexed_scores |> Enum.sort_by(fn {score, _idx} -> score end, :desc)

      # Assign ranks: 1st -> "Gold Medal", 2nd -> "Silver Medal", 3rd -> "Bronze Medal", else -> rank as string
      ranked = Enum.reduce(Enum.with_index(sorted_scores, 1), %{}, fn {{_score, idx}, rank}, acc ->
        award = case rank do
          1 -> "Gold Medal"
          2 -> "Silver Medal"
          3 -> "Bronze Medal"
          other -> Integer.to_string(other)
        end
        Map.put(acc, idx, award)
      end)

      # Reconstruct the result in the original order
      scores
      |> Enum.with_index()
      |> Enum.map(fn {_score, idx} -> Map.get(ranked, idx) end)
  end
end

