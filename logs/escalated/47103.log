    content: defmodule Credence.Pattern.PreferForComprehensionOverReduce do
  @moduledoc """
  Detects `Enum.reduce/3` over a pipe chain with a tuple accumulator and a
  matching tuple-destructuring anonymous function, and rewrites it to a
  `for` comprehension with `reduce:`.

  ## Bad

      string
      |> String.graphemes()
      |> Enum.reduce({0, 0}, fn grapheme, {alpha, digit} ->
        cond do
          String.match?(grapheme, ~r/[A-Za-z]/) -> {alpha + 1, digit}
          String.match?(grapheme, ~r/[0-9]/)    -> {alpha, digit + 1}
          true                                   -> {alpha, digit}
        end
      end)

  ## Good

      for grapheme <- String.graphemes(string), reduce: {0, 0} do
        {alpha, digit} ->
          cond do
            String.match?(grapheme, ~r/[A-Za-z]/) -> {alpha + 1, digit}
            String.match?(grapheme, ~r/[0-9]/)    -> {alpha, digit + 1}
            true                                   -> {alpha, digit}
          end
      end

  ## Why this matters

  `Enum.reduce/3` with a tuple accumulator and a destructuring anonymous
  function is verbose and wraps the iteration in an anonymous function call.
  A `for` comprehension with `reduce:` is idiomatic, eliminates the wrapping
  function and intermediate binding, and reads more naturally.

  ## Detection scope

  Only the piped form `enum |> Enum.reduce(tuple_acc, fn elem, {a, b, ...} -> body end)`
  is flagged. The accumulator must be a tuple literal, and the anonymous function
  must be a single-clause `fn` whose second parameter is a tuple pattern.

  The direct form `Enum.reduce(enum, tuple_acc, fn ...)` is **not** flagged because
  `for` comprehension generators expect the enumerable on the right side of `<-`,
  making the rewrite less natural for non-piped calls.
  """

  use Credence.Pattern.Rule
  alias Credence.Issue
  alias Credence.RuleHelpers

  @impl true
  def check(ast, _opts) do
    {_ast, issues} =
      Macro.prewalk(ast, [], fn node, issues ->
        case check_node(node) do
          {:ok, issue} -> {node, [issue | issues]}
          :error -> {node, issues}
        end
      end)

    Enum.reverse(issues)
  end

  @impl true
  def fix_patches(ast, opts) do
    RuleHelpers.patches_from_ast_transform(ast, Keyword.fetch!(opts, :source), fn input ->
      Macro.postwalk(input, fn
        # Piped form: enum |> Enum.reduce(tuple_acc, fn elem, {a, b} -> body end)
        {:|>, pipe_meta,
         [
           left,
           {{:., _dot_meta, [{:__aliases__, _, [:Enum]}, :reduce]}, _rc_meta,
            [acc, {:fn, _fn_meta, [{:->, _arrow_meta, [[elem_var, acc_pattern], body]}]}]}
         ]} = node ->
          if tuple_literal?(acc) and tuple_pattern?(acc_pattern) do
            build_for_comprehension(left, elem_var, acc, acc_pattern, body, pipe_meta)
          else
            node
          end

        node ->
          node
      end)
    end)
  end

  # ── check ────────────────────────────────────────────────────────────

  defp check_node(
         {:|>, _pipe_meta,
          [
            _left,
            {{:., _dot_meta, [{:__aliases__, _, [:Enum]}, :reduce]}, rc_meta,
             [acc, {:fn, _, [{:->, _, [[_elem_var, acc_pattern], _body]}]}]}
          ]}
       ) do
    if tuple_literal?(acc) and tuple_pattern?(acc_pattern) do
      {:ok,
       %Issue{
         rule: :prefer_for_comprehension_over_reduce,
         message:
           "`Enum.reduce/3` with a tuple accumulator and destructuring function " <>
             "can be replaced with a `for` comprehension with `reduce:`.",
         meta: %{line: Keyword.get(rc_meta, :line)}
       }}
    else
      :error
    end
  end

  defp check_node(_), do: :error

  # ── fix builders ─────────────────────────────────────────────────────

  defp build_for_comprehension(enumerable, elem_var, acc, acc_pattern, body, meta) do
    generator =
      {:<-, [],
       [
         elem_var,
         enumerable
       ]}

    reduce_option =
      [
        {{:__block__, [format: :keyword], [:reduce]},
         acc}
      ]

    clauses =
      [{:->, [], [[acc_pattern], body]}]

    do_block =
      [{{:__block__, [], [:do]}, clauses}]

    {:for, meta,
     [
       generator,
       reduce_option,
       do_block
     ]}
  end

  # ── pattern helpers ──────────────────────────────────────────────────

  defp tuple_literal?({:__block__, _, [inner]}), do: tuple_literal?(inner)
  defp tuple_literal?({a, b}) when is_tuple(a) and is_tuple(b), do: true
  defp tuple_literal?(_), do: false

  defp tuple_pattern?({:__block__, _, [inner]}), do: tuple_pattern?(inner)
  defp tuple_pattern?({a, b}) when is_tuple(a) and is_tuple(b), do: true
  defp tuple_pattern?(_), do: false
end

