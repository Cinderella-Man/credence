    content: defmodule Credence.Pattern.PreferForComprehensionOverReduceCheckTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferForComprehensionOverReduce

  describe "flags the anti-pattern" do
    test "pipe chain with Enum.reduce and tuple accumulator" do
      code = """
      string
      |> String.graphemes()
      |> Enum.reduce({0, 0}, fn grapheme, {alpha, digit} ->
        cond do
          String.match?(grapheme, ~r/[A-Za-z]/) ->
            {alpha + 1, digit}

          String.match?(grapheme, ~r/[0-9]/) ->
            {alpha, digit + 1}

          true ->
            {alpha, digit}
        end
      end)
      """

      [issue] = check(PreferForComprehensionOverReduce, code)
      assert issue.rule == :prefer_for_comprehension_over_reduce
      assert issue.message =~ "for"
      assert issue.message =~ "reduce"
    end

    test "inside a module" do
      code = """
      defmodule Solution do
        def countalphanum(string) do
          string
          |> String.graphemes()
          |> Enum.reduce({0, 0}, fn grapheme, {alpha, digit} ->
            {alpha + 1, digit}
          end)
        end
      end
      """

      assert flagged?(PreferForComprehensionOverReduce, code)
    end
  end

  describe "does NOT flag safe / non-matching shapes" do
    test "Enum.reduce without tuple accumulator" do
      code = """
      string
      |> String.graphemes()
      |> Enum.reduce(0, fn grapheme, acc ->
        acc + 1
      end)
      """

      assert clean?(PreferForComprehensionOverReduce, code)
    end

    test "Enum.reduce with non-tuple second fn parameter" do
      code = """
      string
      |> String.graphemes()
      |> Enum.reduce({0, 0}, fn grapheme, acc ->
        {elem(acc, 0) + 1, elem(acc, 1)}
      end)
      """

      assert clean?(PreferForComprehensionOverReduce, code)
    end

    test "already idiomatic for comprehension" do
      code = """
      for grapheme <- String.graphemes(string), reduce: {0, 0} do
        {alpha, digit} ->
          {alpha + 1, digit}
      end
      """

      assert clean?(PreferForComprehensionOverReduce, code)
    end

    test "Enum.sum" do
      code = """
      list
      |> Enum.sum()
      """

      assert clean?(PreferForComprehensionOverReduce, code)
    end

    test "Enum.reduce with non-tuple accumulator and non-tuple fn param" do
      code = """
      list
      |> Enum.reduce([], fn x, acc -> [x | acc] end)
      """

      assert clean?(PreferForComprehensionOverReduce, code)
    end
  end
end

