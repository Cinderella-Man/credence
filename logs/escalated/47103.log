---MODULE---
@moduledoc """
Counts the number of alphabetic characters and digit characters in a string.
"""

defmodule Solution do
  @doc """
  Takes a string and returns a tuple `{alpha_count, digit_count}`.

  ## Examples

      iex> Solution.countalphanum("HelloWorld123")
      {10, 3}

      iex> Solution.countalphanum("abcdef")
      {6, 0}

      iex> Solution.countalphanum("")
      {0, 0}
  """
  @spec countalphanum(String.t()) :: {non_neg_integer(), non_neg_integer()}
  def countalphanum(string) do
    {alpha_count, digit_count} =
      string
      |> String.graphemes()
      |> Enum.reduce({0, 0}, fn grapheme, {alpha, digit} ->
        cond do
          String.match?(grapheme, ~r/[A-Za-z]/) ->
            {alpha + 1, digit}

          String.match?(grapheme, ~r/[0-9]/) ->
            {alpha, digit + 1}

          true ->
            {alpha, digit}
        end
      end)

    {alpha_count, digit_count}
  end
end

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "counts alphabets and digits" do
    assert Solution.countalphanum("123456789") == {0, 9}
    assert Solution.countalphanum("HelloWorld123") == {10, 3}
    assert Solution.countalphanum("abcdef") == {6, 0}
  end

  test "handles empty strings" do
    assert Solution.countalphanum("") == {0, 0}
  end

  test "ignores non-alphanumeric characters" do
    assert Solution.countalphanum("Hello, World! 123") == {10, 3}
  end

  test "handles mixed content" do
    assert Solution.countalphanum("abc!@#123$%^def") == {6, 3}
  end
end

