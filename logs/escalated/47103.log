    content: defmodule Credence.Pattern.PreferForComprehensionOverReduceEquivalenceTest do
  @moduledoc """
  Tier 1 (expression). The piped `Enum.reduce` with a tuple accumulator and
  destructuring function → `for` comprehension with `reduce:`. The rule
  preserves the accumulator and body verbatim; only the iteration structure
  changes. Input set covers empty, all-alpha, all-digit, mixed, and
  special-character-only strings to exercise all three cond branches.
  """
  use Credence.RuleCase, async: true

  import Credence.BehaviourEquivalence
  alias Credence.Pattern.PreferForComprehensionOverReduce

  @expr """
  string
  |> String.graphemes()
  |> Enum.reduce({0, 0}, fn grapheme, {alpha, digit} ->
    cond do
      String.match?(grapheme, ~r/[A-Za-z]/) ->
        {alpha + 1, digit}

      String.match?(grapheme, ~r/[0-9]/) ->
        {alpha, digit + 1}

      true ->
        {alpha, digit}
    end
  end)
  """

  test "for comprehension with reduce preserves the accumulator tuple" do
    assert_equivalent(@expr,
      rule: PreferForComprehensionOverReduce,
      vars: [:string],
      inputs: [
        "",
        "abc",
        "123",
        "a1!",
        "hello123world",
        "!!!",
        "a1b2c3"
      ]
    )
  end
end

