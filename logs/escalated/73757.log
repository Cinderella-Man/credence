defmodule Solution do
  @moduledoc """
  Given a list of integers, find the maximum sum achievable by selecting elements
  such that no two selected elements are adjacent in the original list.
  """

  @doc """
  Returns the maximum sum of non-adjacent elements from a list of integers.
  Returns 0 for an empty list.
  """
  @spec max_sum_nonadjacent([integer()]) :: integer()
  def max_sum_nonadjacent([]), do: 0

  def max_sum_nonadjacent([head | tail]), do: do_max_sum_nonadjacent_impl(head, tail, 0, 0)

  defp do_max_sum_nonadjacent_impl(current_elem, remaining, incl, excl) do
    new_incl = excl + current_elem
    new_excl = max(incl, excl)

    case remaining do
      [] ->
        max(new_incl, new_excl)

      [next_elem | rest] ->
        do_max_sum_nonadjacent_impl(next_elem, rest, new_incl, new_excl)
    end
  end
end
===AFTER===
defmodule Solution do
  @moduledoc """
  Given a list of integers, find the maximum sum achievable by selecting elements
  such that no two selected elements are adjacent in the original list.
  """

  @doc """
  Returns the maximum sum of non-adjacent elements from a list of integers.
  Returns 0 for an empty list.
  """
  @spec max_sum_nonadjacent([integer()]) :: integer()
  def max_sum_nonadjacent([]), do: 0
  def max_sum_nonadjacent(list), do: max_sum_nonadjacent(list, 0, 0)

  defp max_sum_nonadjacent([], incl, excl), do: max(incl, excl)
  defp max_sum_nonadjacent([head | tail], incl, excl) do
    max_sum_nonadjacent(tail, excl + head, max(incl, excl))
  end
end
===ASSUMPTIONS===
===RATIONALE===
Use the same function name for the private helper to follow idiomatic Elixir conventions.
