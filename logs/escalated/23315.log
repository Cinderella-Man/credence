    new_string: defmodule Credence.Semantic.NoCaptureAsBitwiseAnd do
  @moduledoc """
  Fixes compiler errors where `&` (the capture operator) is mistakenly used
  as bitwise AND.

  LLMs frequently write `number & 1` meaning bitwise-AND, but `&` in Elixir
  is the capture operator.  The parser sees `number(&1)` — a call with a
  capture argument that can only appear inside `&(...)`.  The resulting
  diagnostic from `Code.with_diagnostics/1` is a cascading parse error:

      token missing …
      error: missing terminator: end

  The fix scans the source for the pattern `IDENT & DIGITS` and rewrites it
  to `Bitwise.band(IDENT, DIGITS)`, which is the idiomatic Elixir spelling
  of bitwise AND.
  """
  use Credence.Semantic.Rule

  alias Credence.Issue

  @capture_as_band_pattern ~r/(\b\w+)\s*&\s*(\d+)/

  @impl true
  def match?(%{severity: :error, message: msg}) when is_binary(msg) do
    String.contains?(msg, "token missing") and
      String.contains?(msg, "missing terminator")
  end

  def match?(_), do: false

  @impl true
  def to_issue(diagnostic) do
    %Issue{
      rule: :no_capture_as_bitwise_and,
      message: diagnostic.message,
      meta: %{line: line(diagnostic)}
    }
  end

  @impl true
  def fix(source, _diagnostic) do
    Regex.replace(@capture_as_band_pattern, source, "Bitwise.band(\\1, \\2)")
  end

  defp line(%{position: {line, _col}}), do: line
  defp line(%{position: line}) when is_integer(line), do: line
end
