  @real_diagnostic_message "token missing on credence_check.ex:17:4:\n    error: missing terminator: end\n    hint: it looks like the \"do\" on line 7 does not have a matching \"end\"\n    │\n  1 │ defmodule Solution do\n    │                    └ unclosed delimiter\n ...\n 17 │ end\n    │    └ missing closing delimiter (expected \"end\")\n    │\n    └─ credence_check.ex:17:4"

  defp fix(source, message, line \\ 1) do
    NoCaptureAsBitwiseAnd.fix(source, %{severity: :error, message: message, position: line})
  end

  test "fixes the source" do
    input = """
    defmodule Solution do
      @moduledoc "Stub for rule check."

      def extract_lsb(number) do
        number & 1
      end
