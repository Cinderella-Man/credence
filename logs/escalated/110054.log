defmodule Solution do
  @doc """
  Checks if two strings are almost equal.

  Two strings are almost equal if they are identical or if swapping exactly two characters
  in one string makes it equal to the other.
  """
  @spec are_almost_equal?(String.t(), String.t()) :: boolean()
  def are_almost_equal?(s1, s2) do
    s1 == s2 or do_strings_are_almost_equal(s1, s2)
  end

  @spec do_strings_are_almost_equal(String.t(), String.t()) :: boolean()
  defp do_strings_are_almost_equal(s1, s2) do
    diffs = collect_differences(s1, s2, 0)
    diffs != nil and (diffs == :too_many or (match?([_, _], diffs) and are_swappable(diffs)))
  end

  @spec collect_differences(String.t(), String.t(), integer()) ::
          [{char(), char()}] | :too_many | nil
  defp collect_differences(<<c1::utf8, rest1::binary>>, <<c2::utf8, rest2::binary>>, count) do
    if c1 == c2 do
      collect_differences(rest1, rest2, count)
    else
      case collect_differences(rest1, rest2, count + 1) do
        :too_many -> :too_many
        nil -> nil
        diffs -> [{c1, c2} | diffs]
      end
    end
  end

  defp collect_differences("", "", count) do
    if count > 2 do
      :too_many
    else
      nil
    end
  end

  @spec are_swappable([{char(), char()}]) :: boolean()
  defp are_swappable([{a1, a2}, {b1, b2}]) do
    a1 == b2 and a2 == b1
  end
end
