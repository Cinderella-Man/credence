@doc """
Module for checking if two strings are almost equal.
Two strings are almost equal if they are identical or if swapping exactly two characters
in one string makes it equal to the other.
"""
defmodule Solution do
  @doc """
  Checks if two strings are almost equal.

  ## Examples

      iex> Solution.are_almost_equal("attack", "defend")
      false

      iex> Solution.are_almost_equal("bank", "kanb")
      true

      iex> Solution.are_almost_equal("kelb", "kelb")
      true
  """
  @spec are_almost_equal(String.t(), String.t()) :: boolean()
  def are_almost_equal(s1, s2) when is_binary(s1) and is_binary(s2) do
    s1 == s2 or has_exactly_two_swappable_differences(s1, s2)
  end

  # Helper function to check if two strings differ in exactly two positions
  # and swapping the differing characters in one makes them equal.
  @spec has_exactly_two_swappable_differences(String.t(), String.t()) :: boolean()
  defp has_exactly_two_swappable_differences(s1, s2) do
    {differences, count} = collect_differences(s1, s2, [], 0)
    count == 2 and is_swappable(differences)
  end

  # Recursively collect differences between two strings of the same length
  @spec collect_differences(String.t(), String.t(), [{char(), char()}], integer()) ::
          {[{char(), char()}], integer()}
  defp collect_differences(<<c1::utf8, rest1::binary>>, <<c2::utf8, rest2::binary>>, acc, count) do
    if c1 == c2 do
      collect_differences(rest1, rest2, acc, count)
    else
      collect_differences(rest1, rest2, [{c1, c2} | acc], count + 1)
    end
  end

  # Base case: when both strings are empty
  defp collect_differences("", "", acc, count) do
    {acc, count}
  end

  # Check if the differences are swappable
  # For two differences (a, b) and (b, a), swapping makes them equal
  @spec is_swappable([char() | {char(), char()}]) :: boolean()
  defp is_swappable(diffs) do
    # Diffs should be a list of tuples from the recursion
    # But due to how we built it, let's check if it's a list of 2-element tuples
    case diffs do
      [{a1, a2}, {b1, b2}] -> a1 == b2 and a2 == b1
      _ -> false
    end
  end
end[0m
