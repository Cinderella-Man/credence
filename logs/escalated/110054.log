defmodule Solution do
  def are_almost_equal(s1, s2) do
    if s1 == s2 do
      true
    else
      list1 = String.to_charlist(s1)
      list2 = String.to_charlist(s2)
      diff =
        Enum.zip(list1, list2)
        |> Enum.filter(fn {a, b} -> a != b end)

      case diff do
        [{a1, b1}, {a2, b2}] -> a1 == b2 and a2 == b1
        _ -> false
      end
    end
  end
end
