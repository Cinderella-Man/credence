defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "returns false when strings are not almost equal" do
    refute Solution.are_almost_equal?("attack", "defend")
  end

  test "returns true when swap makes equal" do
    assert Solution.are_almost_equal?("bank", "kanb")
  end

  test "returns true for identical strings" do
    assert Solution.are_almost_equal?("kelb", "kelb")
  end
end
