defmodule Solution do
  @doc """
  Returns the first and last positions of the target in a sorted list.
  """
  @spec first_last_position(list(), integer()) :: list()
  def first_last_position(sorted_list, target) do
    case do_find_first(sorted_list, target, 0) do
      nil -> [-1, -1]
      first ->
        case do_find_last(sorted_list, target, 0) do
          nil -> [-1, -1]
          last -> [first, last]
        end
    end
  end

  defp do_find_first([], _target, _idx) do
    nil
  end

  defp do_find_first([head | tail], target, idx) when head > target do
    nil
  end

  defp do_find_first([head | tail], target, idx) do
    case find_first_acc(tail, target, idx + 1) do
      nil ->
        if head == target do
          idx
        else
          nil
        end
    end
  end

  defp find_first_acc([], _target, _idx) do
    nil
  end

  defp find_first_acc([head | tail], target, idx) when head > target do
    nil
  end

  defp find_first_acc([head | tail], target, idx) do
    if head == target do
      idx
    else
      find_first_acc(tail, target, idx + 1)
    end
  end

  defp do_find_last([], _target, _idx) do
    nil
  end

  defp do_find_last([head | tail], target, idx) do
    case find_last_acc(tail, target, idx + 1) do
      nil ->
        if head == target do
          idx
        else
          nil
        end
    end
  end

  defp find_last_acc([], _target, _idx) do
    nil
  end

  defp find_last_acc([head | tail], target, idx) do
    if head == target do
      find_last_acc(tail, target, idx + 1)
    else
      find_last_acc(tail, target, idx + 1)
    end
  end
end[0m
