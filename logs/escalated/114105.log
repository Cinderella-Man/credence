    new_string: defmodule Credence.Semantic.NoUnusedPrivateFunctionFixTest do
  use ExUnit.Case

  import Credence.RuleCase, only: [confirm_fix: 2, valid_syntax?: 1]

  alias Credence.Semantic.NoUnusedPrivateFunction

  defp fix(source, message, line) do
    NoUnusedPrivateFunction.fix(source, %{
      severity: :warning,
      message: message,
      position: {line, 1}
    })
  end

  test "removes unused private function" do
    input = """
    defmodule Solution do
      def public_fn(x) do
        used_helper(x)
      end

      defp used_helper(x) do
        x + 1
      end

      defp unused_helper(x) do
        x * 2
      end
    end
    """

    expected = """
    defmodule Solution do
      def public_fn(x) do
        used_helper(x)
      end

      defp used_helper(x) do
        x + 1
      end
    end
    """

    message = "function unused_helper/1 is unused"
    confirm_fix(fix(input, message, 10), expected)
  end

  test "fixed output is well-formed (parses)" do
    input = """
    defmodule Solution do
      defp unused_helper(x) do
        x * 2
      end
    end
    """

    message = "function unused_helper/1 is unused"
    assert valid_syntax?(fix(input, message, 2))
  end
end
