---REFERENCE---
defmodule Solution do
  @spec first_last_position([integer], integer) :: [integer]
  def first_last_position(nums, target) do
    tuple = List.to_tuple(nums)
    first = find_first(tuple, target, 0, tuple_size(tuple) - 1, -1)
    last = find_last(tuple, target, 0, tuple_size(tuple) - 1, -1)
    [first, last]
  end

  defp find_first(_tuple, _target, low, high, result) when low > high, do: result

  defp find_first(tuple, target, low, high, result) do
    mid = div(low + high, 2)
    current = elem(tuple, mid)

    cond do
      current == target ->
        find_first(tuple, target, low, mid - 1, mid)

      current < target ->
        find_first(tuple, target, mid + 1, high, result)

      true ->
        find_first(tuple, target, low, mid - 1, result)
    end
  end

  defp find_last(_tuple, _target, low, high, result) when low > high, do: result

  defp find_last(tuple, target, low, high, result) do
    mid = div(low + high, 2)
    current = elem(tuple, mid)

    cond do
      current == target ->
        find_last(tuple, target, mid + 1, high, mid)

      current < target ->
        find_last(tuple, target, mid + 1, high, result)

      true ->
        find_last(tuple, target, low, mid - 1, result)
    end
  end
end

