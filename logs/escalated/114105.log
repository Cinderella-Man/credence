    new_string: defmodule Credence.Semantic.NoUnusedPrivateFunction do
  @moduledoc """
  Fixes compiler warnings about unused private functions by removing them.

  The Elixir compiler emits a warning when a `defp` function is defined
  but never called within its module. Under `--warnings-as-errors`, this
  blocks compilation. The diagnostic message matches:

      "function <name>/<arity> is unused"

  The fix removes the entire unused `defp` block (and a preceding blank
  line when present, to avoid leaving a double-blank).

  ## Example

      # Warning: function unused_helper/1 is unused
      defp unused_helper(x), do: x * 2

      # Fixed: (removed entirely)
  """
  use Credence.Semantic.Rule

  alias Credence.Issue

  @impl true
  def match?(%{severity: :warning, message: msg}) when is_binary(msg) do
    String.match?(msg, ~r/function .* is unused/)
  end

  def match?(_), do: false

  @impl true
  def to_issue(diagnostic) do
    %Issue{
      rule: :no_unused_private_function,
      message: "Removing unused private function",
      meta: %{line: line(diagnostic)}
    }
  end

  @impl true
  def fix(source, %{position: position}) do
    line_no = line(%{position: position})

    case safe_parse(source) do
      {:ok, ast} ->
        case find_defp_range(ast, line_no) do
          nil -> source
          {start_line, end_line} -> remove_block(source, start_line, end_line)
        end

      :error ->
        source
    end
  end

  defp line(%{position: {line, _col}}), do: line
  defp line(%{position: line}) when is_integer(line), do: line

  # Walk the AST looking for a `defp` node whose :line metadata matches
  # `target_line`.  Returns `{start_line, end_line}` or nil.
  defp find_defp_range(ast, target_line) do
    {_, result} =
      Macro.prewalk(ast, nil, fn
        {:defp, meta, _} = node, nil ->
          if meta[:line] == target_line do
            end_info = meta[:end]
            end_line = if end_info, do: end_info[:line], else: meta[:line]
            {node, {meta[:line], end_line}}
          else
            {node, nil}
          end

        node, acc ->
          {node, acc}
      end)

    result
  end

  # Remove lines `start_line` through `end_line` (1-indexed), plus a
  # preceding blank line when one exists — avoids leaving a double-blank
  # after the excision.
  defp remove_block(source, start_line, end_line) do
    lines = String.split(source, "\n")

    actual_start =
      if start_line > 1 && Enum.at(lines, start_line - 2) == "",
        do: start_line - 1,
        else: start_line

    before = Enum.take(lines, actual_start - 1)
    after_block = Enum.drop(lines, end_line)

    Enum.join(before ++ after_block, "\n")
  end

  defp safe_parse(source) do
    {:ok, Sourceror.parse_string!(source)}
  rescue
    _ -> :error
  end
end
