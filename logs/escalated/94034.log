    content: defmodule Credence.Syntax.NoFunctionInsideDocHeredoc do
  @moduledoc """
  Detects and fixes `def`/`defp` function definitions placed inside `@doc` heredocs.

  LLMs frequently write function definitions inside `@doc """` heredocs,
  causing the function body to be consumed as documentation text. This
  results in a module that compiles (the heredoc is never closed, so
  everything up to the module's `end` is doc text) but the intended
  function is never defined.

  The fix inserts a closing `\"\"\"` line — indented to match the `@doc`
  line — immediately before the first `def`/`defp` line found inside the
  heredoc.

  ## Bad (function inside @doc heredoc)

      defmodule Solution do
        @doc \"\"\"
        Some documentation.
        def top_frequent_words(words, n) do
          words
        end
      end

  ## Good

      defmodule Solution do
        @doc \"\"\"
        Some documentation.
        \"\"\"
        def top_frequent_words(words, n) do
          words
        end
      end
  """
  use Credence.Syntax.Rule

  alias Credence.Issue

  @doc_heredoc_open ~r/^(\s*)@doc\s+"""\s*$/
  @def_line ~r/^\s*defp?\s+\w+/

  @impl true
  def analyze(source) do
    source
    |> String.split("\n")
    |> find_issues(1)
  end

  defp find_issues([], _line_no), do: []

  defp find_issues([line | rest], line_no) do
    case Regex.run(@doc_heredoc_open, line) do
      [_, _indent] ->
        case find_def_inside_heredoc(rest, line_no + 1) do
          nil -> []
          def_line_no ->
            [
              %Issue{
                rule: :no_function_inside_doc_heredoc,
                message:
                  "Function definition inside `@doc \"\"\"` heredoc — the closing `\"\"\"` is missing.",
                meta: %{line: def_line_no}
              }
            ]
        end

      _ ->
        find_issues(rest, line_no + 1)
    end
  end

  # Walk through lines after an opening `@doc """` looking for a `def` line.
  # Returns the line number of the first `def` found, or nil if the heredoc
  # is properly closed before any `def`.
  defp find_def_inside_heredoc([], _line_no), do: nil

  defp find_def_inside_heredoc([line | rest], line_no) do
    cond do
      # Heredoc closed before a def — no issue
      Regex.match?(~r/^\s*"""/, line) ->
        nil

      # Found a def line inside the heredoc
      Regex.match?(@def_line, line) ->
        line_no

      # Any other content inside the heredoc — keep scanning
      true ->
        find_def_inside_heredoc(rest, line_no)
    end
  end

  @impl true
  def fix(source) do
    lines = String.split(source, "\n")

    insertions =
      lines
      |> Enum.with_index()
      |> Enum.flat_map(fn {line, idx} ->
        case Regex.run(@doc_heredoc_open, line) do
          [_, indent] ->
            remaining = Enum.drop(lines, idx + 1)

            case find_def_offset(remaining) do
              nil -> []
              offset -> [{idx + 1 + offset, indent}]
            end

          _ ->
            []
        end
      end)

    # Apply insertions in reverse order so indices stay valid
    sorted = Enum.sort_by(insertions, &elem(&1, 0), :desc)

    Enum.reduce(sorted, lines, fn {insert_at, indent}, acc ->
      {before, after_} = Enum.split(acc, insert_at)
      before ++ [indent <> ~s(""")] ++ after_
    end)
    |> Enum.join("\n")
  end

  # Find the offset (from current position) of the first `def` line inside
  # a heredoc, returning nil if the heredoc closes before any `def`.
  defp find_def_offset(lines) do
    lines
    |> Enum.with_index()
    |> Enum.find_value(fn {line, offset} ->
      cond do
        # Heredoc closed — no def found inside
        Regex.match?(~r/^\s*"""/, line) ->
          throw(:heredoc_closed)

        # Found a def
        Regex.match?(@def_line, line) ->
          offset

        # Keep scanning
        true ->
          nil
      end
    end)
  catch
    :heredoc_closed -> nil
  end
end

