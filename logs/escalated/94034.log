    content: defmodule Credence.Syntax.NoFunctionInsideDocHeredocFixTest do
  use ExUnit.Case

  import Credence.RuleCase, only: [valid_syntax?: 1]

  alias Credence.Syntax.NoFunctionInsideDocHeredoc

  defp analyze(code), do: NoFunctionInsideDocHeredoc.analyze(code)
  defp fix(code), do: NoFunctionInsideDocHeredoc.fix(code)

  test "fixes function inside @doc heredoc by inserting closing quotes" do
    input = """
    defmodule Solution do
      @doc """
      Some documentation.
      def top_frequent_words(words, n) do
        words
      end
    end
    """

    expected = """
    defmodule Solution do
      @doc """
      Some documentation.
      """
      def top_frequent_words(words, n) do
        words
      end
    end
    """

    assert fix(input) == expected
  end

  test "does not modify properly closed @doc heredoc" do
    code = """
    defmodule Solution do
      @doc \"\"\"
      Finds the min and max.
      \"\"\"
      def find_min_max(list) do
        Enum.min_max(list)
      end
    end
    """

    assert fix(code) == code
  end

  test "fixed output no longer flags" do
    assert analyze(
             fix("""
             defmodule Solution do
               @doc """
               Some documentation.
               def top_frequent_words(words, n) do
                 words
               end
             end
             """)
           ) == []
  end

  test "fixed output is well-formed (parses)" do
    assert valid_syntax?(
             fix("""
             defmodule Solution do
               @doc """
               Some documentation.
               def top_frequent_words(words, n) do
                 words
               end
             end
             """)
           )
  end
end

