    content: defmodule Credence.Syntax.NoFunctionInsideDocHeredocAnalyzeTest do
  use ExUnit.Case

  alias Credence.Issue
  alias Credence.Syntax.NoFunctionInsideDocHeredoc

  defp analyze(code), do: NoFunctionInsideDocHeredoc.analyze(code)

  test "flags function definition inside @doc heredoc" do
    assert [%Issue{rule: :no_function_inside_doc_heredoc, meta: %{line: 3}}] =
             analyze("""
             defmodule Solution do
               @doc """
               Some documentation.
               def top_frequent_words(words, n) do
                 words
               end
             end
             """)
  end

  test "flags defp inside @doc heredoc" do
    assert [%Issue{rule: :no_function_inside_doc_heredoc, meta: %{line: 3}}] =
             analyze("""
             defmodule Solution do
               @doc """
               Helper docs.
               defp helper(x) do
                 x
               end
             end
             """)
  end

  test "leaves properly closed @doc heredoc alone" do
    assert analyze("""
           defmodule Solution do
             @doc \"\"\"
             Finds the min and max.
             \"\"\"
             def find_min_max(list) do
               Enum.min_max(list)
             end
           end
           """) == []
  end

  test "leaves code without @doc heredoc alone" do
    assert analyze("""
           defmodule Solution do
             def find_min_max(list) do
               Enum.min_max(list)
             end
           end
           """) == []
  end

  test "leaves @doc string literal alone" do
    assert analyze("""
           defmodule Solution do
             @doc "Finds the min and max."
             def find_min_max(list) do
               Enum.min_max(list)
             end
           end
           """) == []
  end

  test "ignores @doc heredoc with no def inside" do
    assert analyze("""
           defmodule Solution do
             @doc \"\"\"
             This module provides utilities.
             \"\"\"
           end
           """) == []
  end
end

