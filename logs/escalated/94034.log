---REFERENCE---
defmodule Solution do
  def top_frequent_words(words, n) do
    words
    |> Enum.frequencies()
    |> Enum.sort_by(fn {word, count} -> {-count, word} end)
    |> Enum.take(n)
    |> Enum.map(fn {word, _count} -> word end)
  end
end

