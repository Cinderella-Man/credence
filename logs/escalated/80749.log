    edits: [%{"newText" => "  # Collect all parameter variable names from a function call head.\n  defp collect_param_names(call) do\n    {_, names} =\n      Macro.prewalk(call, MapSet.new(), fn\n        {name, _, ctx} = node, acc\n        when is_atom(name) and (is_atom(ctx) or is_nil(ctx)) and name != :_ ->\n          {node, MapSet.put(acc, name)}\n        node, acc ->\n          {node, acc}\n      end)\n    names\n  end\n\n  # Collect the names of variables that appear as direct (non-nested) arguments\n  # in the function call head. Variables inside patterns like [a | b] or {a, b}\n  # are not included — only bare variable arguments at the top level.\n  defp direct_param_names(call) do\n    {_, _, args} = call\n    Enum.reduce(args || [], MapSet.new(), fn arg, acc ->\n      case var_name(arg) do\n        name when is_atom(name) and name != :_ -> MapSet.put(acc, name)\n        _ -> acc\n      end\n    end)\n  end", "oldText" => "  # Collect all parameter variable names from a function call head.\n  defp collect_param_names(call) do\n    {_, names} =\n      Macro.prewalk(call, MapSet.new(), fn\n        {name, _, ctx} = node, acc\n        when is_atom(name) and (is_atom(ctx) or is_nil(ctx)) and name != :_ ->\n          {node, MapSet.put(acc, name)}\n        node, acc ->\n          {node, acc}\n      end)\n    names\n  end"}]
