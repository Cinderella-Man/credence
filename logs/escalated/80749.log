defmodule Solution do
  @doc """
  Determines whether two given positive integers are amicable numbers.

  Amicable numbers are two distinct numbers such that the sum of the proper
  divisors of each number equals the other number.
  """
  @spec amicable_numbers(pos_integer(), pos_integer()) :: boolean()
  def amicable_numbers(a, b) do
    with sum_div_a <- sum_of_proper_divisors(a),
         sum_div_b <- sum_of_proper_divisors(b),
         true <- a != b,
         true <- sum_div_a == b,
         true <- sum_div_b == a do
      true
    else
      _ -> false
    end
  end

  @doc """
  Calculates the sum of proper divisors of a given positive integer.
  """
  @spec sum_of_proper_divisors(pos_integer()) :: non_neg_integer()
  def sum_of_proper_divisors(number) do
    if number == 1 do
      0
    else
      1 +
      number
      |> divisors()
      |> Enum.sum()
    end
  end

  defp divisors(number) do
    limit = trunc(:math.sqrt(number))
    
    2..limit
    |> Enum.filter(&(rem(number, &1) == 0))
    |> Enum.flat_map(fn divisor ->
      case divisor do
        ^divisor when divisor * divisor == number -> [divisor]
        _ -> [divisor, div(number, divisor)]
      end
    end)
    |> Enum.uniq()
  end
end
