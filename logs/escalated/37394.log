[22m00:09:30.000 [info] [ClaudeCode] step 32: Write
    content: defmodule Credence.Syntax.NoFnWithCapture do
  @moduledoc """
  Detects and fixes `fn(&1 ...)` — fn-keyword mixed with capture syntax.

  LLMs repeatedly emit `fn(&1 > 0)` mixing the `fn` keyword with capture
  syntax. `fn(` followed by a capture variable is always a parse error in
  Elixir. The fix replaces `fn(` with `&(` when immediately followed by a
  capture variable (`&1`, `&2`, …), yielding the idiomatic capture form
  `&(&1 > 0)`.

  ## Bad (won't parse)

      Enum.filter(list, fn(&1 > 0))

  ## Good

      Enum.filter(list, &(&1 > 0))
  """
  use Credence.Syntax.Rule

  alias Credence.Issue

  # Matches `fn(` immediately followed by a capture variable (`&1`, `&2`, …).
  @fn_capture_pattern ~r/fn\(&\d/

  @impl true
  def analyze(source) do
    source
    |> String.split("\n")
    |> Enum.with_index(1)
    |> Enum.flat_map(fn {line, line_no} ->
      if String.match?(line, @fn_capture_pattern) do
        [
          %Issue{
            rule: :no_fn_with_capture,
            message:
              "`fn(` followed by a capture variable is a parse error; use `&(...)` capture syntax instead.",
            meta: %{line: line_no}
          }
        ]
      else
        []
      end
    end)
  end

  @impl true
  def fix(source) do
    Regex.replace(@fn_capture_pattern, source, fn match ->
      String.replace_prefix(match, "fn(", "&(")
    end)
  end
end

