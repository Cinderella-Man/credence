    content: defmodule Credence.Syntax.FixMissingModuleEnd do
  @moduledoc """
  Fixes Elixir source where a `defmodule` block is missing its closing `end`.

  LLMs frequently generate `defmodule ... do` followed by the module body but
  omit the final `end` keyword.  This is the single most common reason a draft
  fails to compile with `missing terminator: end`.  The fix is purely
  structural — it appends the missing `end` at EOF.

  ## Bad (won't compile)

      defmodule Solution do
        def hello, do: "world"
      # ← missing `end`

  ## Good

      defmodule Solution do
        def hello, do: "world"
      end
  """
  use Credence.Syntax.Rule
  alias Credence.Issue

  # Matches a block-opening `do` keyword — NOT `do:` (keyword-literal form).
  @block_do ~r/(?<!\w)do(?!:)/

  @impl true
  def analyze(source) do
    if missing_module_end?(source) do
      [%Issue{rule: :fix_missing_module_end, message: "Missing `end` for `defmodule` block.", meta: %{line: 1}}]
    else
      []
    end
  end

  @impl true
  def fix(source) do
    n = missing_end_count(source)
    if n > 0, do: source <> String.duplicate("end\n", n), else: source
  end

  defp missing_module_end?(source) do
    has_defmodule?(source) and missing_end_count(source) > 0
  end

  defp has_defmodule?(source), do: Regex.match?(~r/\bdefmodule\b/, source)

  defp missing_end_count(source) do
    source
    |> String.split("\n")
    |> Enum.reduce(0, fn line, acc ->
      line = Regex.replace(~r/#.*$/, line, "")
      opens = Regex.scan(@block_do, line) |> length()
      closes = Regex.scan(~r/\bend\b/, line) |> length()
      acc + opens - closes
    end)
  end
end

