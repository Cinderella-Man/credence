    content: defmodule Credence.Syntax.FixMissingModuleEndFixTest do
  use ExUnit.Case

  import Credence.RuleCase, only: [valid_syntax?: 1]

  alias Credence.Syntax.FixMissingModuleEnd

  defp analyze(code), do: FixMissingModuleEnd.analyze(code)
  defp fix(code), do: FixMissingModuleEnd.fix(code)

  test "fixes defmodule with missing closing end" do
    input = """
    defmodule Solution do
      @moduledoc "Weight calculator."
      def calculate_planetary_weights(earth_weight) do
        %{mercury: earth_weight * 0.37}
      end
    """

    expected = """
    defmodule Solution do
      @moduledoc "Weight calculator."
      def calculate_planetary_weights(earth_weight) do
        %{mercury: earth_weight * 0.37}
      end
    end
    """

    assert fix(input) == expected
  end

  test "fixes nested blocks with missing defmodule end" do
    input = """
    defmodule Foo do
      def bar do
        :baz
      end
    """

    expected = """
    defmodule Foo do
      def bar do
        :baz
      end
    end
    """

    assert fix(input) == expected
  end

  test "leaves correctly closed defmodule unchanged" do
    code = """
    defmodule Solution do
      def hello, do: "world"
    end
    """

    assert fix(code) == code
  end

  test "leaves code without defmodule unchanged" do
    code = """
    foo(bar)
    """

    assert fix(code) == code
  end

  test "fixed output no longer flags" do
    assert analyze(
             fix("""
             defmodule Solution do
               def hello, do: "world"
             end
             """)
           ) == []
  end

  test "fixed output is well-formed (parses)" do
    assert valid_syntax?(
             fix("""
             defmodule Solution do
               @moduledoc "Weight calculator."
               def calculate_planetary_weights(earth_weight) do
                 %{mercury: earth_weight * 0.37}
               end
             """)
           )
  end
end

