    content: defmodule Credence.Syntax.FixMissingModuleEndAnalyzeTest do
  use ExUnit.Case

  alias Credence.Issue
  alias Credence.Syntax.FixMissingModuleEnd

  defp analyze(code), do: FixMissingModuleEnd.analyze(code)

  test "flags defmodule with missing closing end" do
    assert [%Issue{rule: :fix_missing_module_end}] =
             analyze("""
             defmodule Solution do
               @moduledoc "Weight calculator."
               def calculate_planetary_weights(earth_weight) do
                 %{mercury: earth_weight * 0.37}
               end
             """)
  end

  test "flags nested do blocks with missing defmodule end" do
    assert [%Issue{rule: :fix_missing_module_end}] =
             analyze("""
             defmodule Foo do
               def bar do
                 :baz
               end
             """)
  end

  test "leaves correctly closed defmodule alone" do
    assert analyze("""
           defmodule Solution do
             def hello, do: "world"
           end
           """) == []
  end

  test "leaves code without defmodule alone" do
    assert analyze("""
           foo(bar)
           """) == []
  end

  test "leaves empty source alone" do
    assert analyze("") == []
  end
end

