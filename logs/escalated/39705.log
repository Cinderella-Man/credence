  @spec good?(integer()) :: boolean()
  def good?(n) when is_integer(n) and n >= 0 do
    digits = Integer.digits(n)
    rotated = rotate_digits(digits)

    case rotated do
      nil -> false
      rotated_list ->
        rotated_value = List.to_integer(rotated_list)
        n != rotated_value
    end
  end

  defp rotate_digits([]), do: []

  defp rotate_digits([h | t]) do
    case h do
      0 -> [0 | rotate_digits(t)]
      1 -> [1 | rotate_digits(t)]
      8 -> [8 | rotate_digits(t)]
      2 -> [5 | rotate_digits(t)]
      5 -> [2 | rotate_digits(t)]
      6 -> [9 | rotate_digits(t)]
      9 -> [6 | rotate_digits(t)]
      _ -> nil
    end
  end
