---MODULE---
defmodule Solution do
  @doc """
  Counts the number of 'good' numbers from 1 to n (inclusive).
  A good number is one where rotating each digit 180 degrees results in a
  different, valid number.
  """
  @spec count_good_numbers(integer()) :: integer()
  def count_good_numbers(n) when is_integer(n) and n >= 0 do
    if n == 0 do
      0
    else
      Enum.sum(1..n, fn num ->
        if good?(num), do: 1, else: 0
      end)
    end
  end

  @doc """
  Checks if a number is good.
  """
  @spec good?(integer()) :: boolean()
  def good?(n) when is_integer(n) and n >= 0 do
    digits = Integer.digits(n)
    rotated_digits = rotate_digits(digits)

    # If any digit cannot be rotated, return false
    if rotated_digits == nil do
      false
    else
      rotated_value = List.to_integer(rotated_digits)
      n != rotated_value
    end
  end

  defp rotate_digits([]), do: []

  defp rotate_digits([h | t]) do
    case h do
      0 -> [0 | rotate_digits(t)]
      1 -> [1 | rotate_digits(t)]
      8 -> [8 | rotate_digits(t)]
      2 -> [5 | rotate_digits(t)]
      5 -> [2 | rotate_digits(t)]
      6 -> [9 | rotate_digits(t)]
      9 -> [6 | rotate_digits(t)]
      _ -> nil
    end
  end
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "count good numbers up to 10" do
    assert Solution.count_good_numbers(10) == 4
  end

  test "count good numbers up to 1" do
    assert Solution.count_good_numbers(1) == 0
  end

  test "count good numbers up to 2" do
    assert Solution.count_good_numbers(2) == 1
  end
end
