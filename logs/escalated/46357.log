    content: defmodule Credence.Pattern.PreferEnumFindIndexWithDefaultCheckTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferEnumFindIndexWithDefault

  describe "flags the anti-pattern" do
    test "flags case with nil -> default, index -> index" do
      code = """
      defmodule Example do
        def find_index_with_default(list, target, default) do
          case Enum.find_index(list, &(&1 == target)) do
            nil -> default
            index -> index
          end
        end
      end
      """

      assert flagged?(PreferEnumFindIndexWithDefault, code)
    end

    test "flags case with reversed clause order" do
      code = """
      defmodule Example do
        def find_index_with_default(list, target, default) do
          case Enum.find_index(list, &(&1 == target)) do
            index -> index
            nil -> default
          end
        end
      end
      """

      assert flagged?(PreferEnumFindIndexWithDefault, code)
    end

    test "flags case with complex default expression" do
      code = """
      case Enum.find_index(list, &(&1 == target)) do
        nil -> compute_default()
        index -> index
      end
      """

      assert flagged?(PreferEnumFindIndexWithDefault, code)
    end
  end

  describe "leaves good code alone" do
    test "does not flag when already using ||" do
      code = """
      Enum.find_index(list, &(&1 == target)) || default
      """

      assert clean?(PreferEnumFindIndexWithDefault, code)
    end

    test "does not flag when case returns different value for non-nil" do
      code = """
      case Enum.find_index(list, &(&1 == target)) do
        nil -> :not_found
        index -> {:ok, index}
      end
      """

      assert clean?(PreferEnumFindIndexWithDefault, code)
    end

    test "does not flag when nil clause returns a different value" do
      code = """
      case Enum.find_index(list, &(&1 == target)) do
        nil -> default
        index -> index + 1
      end
      """

      assert clean?(PreferEnumFindIndexWithDefault, code)
    end

    test "does not flag when using Enum.find instead of Enum.find_index" do
      code = """
      case Enum.find(list, &(&1 == target)) do
        nil -> default
        item -> item
      end
      """

      assert clean?(PreferEnumFindIndexWithDefault, code)
    end

    test "does not flag when case has more than two clauses" do
      code = """
      case Enum.find_index(list, &(&1 == target)) do
        nil -> default
        0 -> :first
        index -> index
      end
      """

      assert clean?(PreferEnumFindIndexWithDefault, code)
    end

    test "does not flag regular case expressions" do
      code = """
      case some_function() do
        :ok -> :success
        :error -> :failure
      end
      """

      assert clean?(PreferEnumFindIndexWithDefault, code)
    end
  end
end

