    content: defmodule Credence.Pattern.PreferEnumFindIndexWithDefaultEquivalenceTest do
  @moduledoc """
  Tier 1 (expression), value-kind dimension.

  `case Enum.find_index(list, &(&1 == target)) do nil -> default; index -> index end`
  → `Enum.find_index(list, &(&1 == target)) || default`.

  The rule rewrites a verbose case-expression into a concise `||` default.
  The inputs include cases where the target is present (returning an integer
  index) and absent (returning the default value), exercising both branches.
  """
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferEnumFindIndexWithDefault

  @inputs [
    {[1, 2, 3], 2, :not_found},
    {[1, 2, 3], 5, :not_found},
    {[:a, :b, :c], :b, -1},
    {[:a, :b, :c], :z, -1},
    {[nil, false, true], false, :default},
    {[nil, false, true], :missing, :default},
    {[], 1, :empty},
    {[1], 1, :empty},
    {Enum.to_list(1..100), 50, :not_found}
  ]

  test "case Enum.find_index with nil/identity pattern preserves behaviour" do
    assert_equivalent(
      """
      case Enum.find_index(list, &(&1 == target)) do
        nil -> default
        index -> index
      end
      """,
      rule: PreferEnumFindIndexWithDefault,
      vars: [:list, :target, :default],
      inputs: @inputs
    )
  end
end

