    content: defmodule Credence.Pattern.PreferEnumFindIndexWithDefault do
  @moduledoc """
  Readability rule: flags `case Enum.find_index(...)` used solely to provide a
  default for `nil`, and rewrites it to use `||`.

  `Enum.find_index/2` returns either an integer index or `nil`. Wrapping it in
  a `case` with a `nil -> default` and `index -> index` pattern is verbose;
  `Enum.find_index(...) || default` is clearer and more idiomatic.

  The rewrite is behaviour-preserving: `||` returns the left side when it is
  truthy (non-nil, non-false), and the right side otherwise. Since
  `Enum.find_index/2` returns either an integer (truthy) or `nil` (falsy),
  the two forms are equivalent for every input.

  ## Bad

      case Enum.find_index(list, &(&1 == target)) do
        nil -> default
        index -> index
      end

  ## Good

      Enum.find_index(list, &(&1 == target)) || default

  ## Not flagged

      # Uses `Enum.find` instead of `Enum.find_index`
      case Enum.find(list, &(&1 == target)) do
        nil -> default
        item -> item
      end

      # Different case structure (not the nil/identity pattern)
      case Enum.find_index(list, &(&1 == target)) do
        nil -> :not_found
        index -> {:ok, index}
      end

      # Returns something other than the matched variable
      case Enum.find_index(list, &(&1 == target)) do
        nil -> default
        index -> index + 1
      end
  """
  use Credence.Pattern.Rule
  alias Credence.Issue
  alias Credence.RuleHelpers

  @impl true
  def check(ast, _opts) do
    {_ast, issues} =
      Macro.prewalk(ast, [], fn node, issues ->
        case check_node(node) do
          {:ok, issue} -> {node, [issue | issues]}
          :error -> {node, issues}
        end
      end)

    Enum.reverse(issues)
  end

  @impl true
  def fix_patches(ast, _opts) do
    RuleHelpers.patches_from_postwalk(ast, fn
      {:case, _meta, [_expr, branches]} = node ->
        case try_fix(node) do
          {:ok, replacement} -> replacement
          :error -> node
        end

      node ->
        node
    end)
  end

  defp check_node({:case, meta, [_expr, branches]} = node) do
    if find_index_case_pattern?(node) do
      {:ok,
       %Issue{
         rule: :prefer_enum_find_index_with_default,
         message:
           "Using `case` to provide a default for `Enum.find_index/2` is verbose. " <>
             "Use `||` instead: `Enum.find_index(...) || default`.",
         meta: %{line: Keyword.get(meta, :line)}
       }}
    else
      :error
    end
  end

  defp check_node(_), do: :error

  defp find_index_case_pattern?({:case, _, [expr, branches]}) do
    with true <- find_index_call?(expr),
         {:ok, nil_clause, identity_clause} <- extract_clauses(branches) do
      nil_returns_default?(nil_clause) and identity_returns_var?(identity_clause)
    else
      _ -> false
    end
  end

  defp find_index_call?(expr) do
    case expr do
      {{:., _, [{:__aliases__, _, [:Enum]}, :find_index]}, _, _} -> true
      _ -> false
    end
  end

  defp extract_clauses(branches) when is_list(branches) do
    # Sourceror wraps do/else keys as {:__block__, _, [:do]}
    do_body =
      Enum.find_value(branches, fn
        {{:__block__, _, [:do]}, body} -> body
        _ -> nil
      end)

    case do_body do
      [clause1, clause2] ->
        # Determine which is nil clause and which is identity clause
        case {clause1, clause2} do
          {{:->, _, [[{:__block__, _, [nil]}, _default]}, _} ->
            {:ok, clause1, clause2}

          {{:->, _, [[_var], _value]}, _} ->
            {:ok, clause2, clause1}

          _ ->
            :error
        end

      _ ->
        :error
    end
  end

  defp nil_returns_default?({:->, _, [[{:__block__, _, [nil]}], _default]}), do: true
  defp nil_returns_default?(_), do: false

  defp identity_returns_var?({:->, _, [[var], value]}) do
    # Check that the value is the same variable as the matched pattern
    case {var, value} do
      {{name, _, nil}, {name, _, nil}} when is_atom(name) -> true
      _ -> false
    end
  end

  defp try_fix({:case, _, [expr, branches]} = node) do
    with true <- find_index_call?(expr),
         {:ok, nil_clause, identity_clause} <- extract_clauses(branches),
         true <- nil_returns_default?(nil_clause),
         true <- identity_returns_var?(identity_clause) do
      # Extract the default value from the nil clause
      {:->, _, [[{:__block__, _, [nil]}], default]} = nil_clause

      # Build the replacement: expr || default
      {:ok, {:||, [], [expr, default]}}
    else
      _ -> :error
    end
  end
end

