    end

    test "preserves surrounding code" do
      input = """
      defmodule Example do
        def process(list, target, fallback) do
          idx = case Enum.find_index(list, &(&1 == target)) do
            nil -> fallback
            i -> i
          end
          other = do_something_else()
          {idx, other}
        end
      end
      """

      expected = """
      defmodule Example do
        def process(list, target, fallback) do
          idx = Enum.find_index(list, &(&1 == target)) || fallback
          other = do_something_else()
          {idx, other}
        end
      end
      """

      assert fix(PreferEnumFindIndexWithDefault, input) == expected
    end

    test "does not change code that uses Enum.find instead of Enum.find_index" do
      code = """
      case Enum.find(list, &(&1 == target)) do
        nil -> default
        item -> item
      end
      """

      assert fix(PreferEnumFindIndexWithDefault, code) == code
    end

    test "does not change code with different case structure" do
      code = """
      case Enum.find_index(list, &(&1 == target)) do
        nil -> :not_found
        index -> {:ok, index}
      end
      """

      assert fix(PreferEnumFindIndexWithDefault, code) == code
    end

    test "does not change code when nil clause returns different value" do
      code = """
      case Enum.find_index(list, &(&1 == target)) do
        nil -> default
        index -> index + 1
      end
      """

      assert fix(PreferEnumFindIndexWithDefault, code) == code
    end

    test "idempotent: running fix twice produces same result" do
      input = """
      case Enum.find_index(list, &(&1 == target)) do
        nil -> default
        index -> index
      end
      """

      once = fix(PreferEnumFindIndexWithDefault, input)
      twice = fix(PreferEnumFindIndexWithDefault, once)
      assert once == twice
    end
  end
end

