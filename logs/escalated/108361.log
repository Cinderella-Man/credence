---MODULE---
defmodule Solution do
  @doc """
  Checks if a list of numbers contains an arithmetic triplet.

  An arithmetic triplet is a set of three numbers where the difference
  between the second and the first number equals the difference between
  the third and the second number.

  ## Examples

      iex> Solution.arithmetic_triplet([5, 1, 3, 2, 4])
      true

      iex> Solution.arithmetic_triplet([1])
      false

      iex> Solution.arithmetic_triplet([1, 2, 4])
      false
  """
  @spec arithmetic_triplet(list(number())) :: boolean()
  def arithmetic_triplet(nums)

  def arithmetic_triplet(nums) when length(nums) < 3, do: false

  def arithmetic_triplet(nums) do
    sorted_nums = Enum.sort(nums)
    has_triplet?(sorted_nums)
  end

  defp has_triplet?([]), do: false
  defp has_triplet?([_]), do: false
  defp has_triplet?([_, _]), do: false

  defp has_triplet?(nums) do
    n = length(nums)

    Enum.any?(0..(n - 3), fn i ->
      Enum.any?((i + 1)..(n - 2), fn j ->
        k = j + 1

        if k < n do
          first = Enum.at(nums, i)
          second = Enum.at(nums, j)
          third = Enum.at(nums, k)

          (second - first) == (third - second)
        else
          false
        end
      end)
    end)
  end
end
