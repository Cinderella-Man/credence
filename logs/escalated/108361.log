defmodule Solution do
  def arithmetic_triplet(nums) do
    if length(nums) < 3 do
      false
    else
      nums
      |> Enum.sort()
      |> check_consecutive_triplets()
    end
  end

  defp check_consecutive_triplets([a, b, c | rest]) do
    if b - a == c - b do
      true
    else
      check_consecutive_triplets([b, c | rest])
    end
  end

  defp check_consecutive_triplets(_), do: false
end
