  def convert(s, num_rows) do
    # Calculate the period of the zigzag pattern
    period = 2 * num_rows - 2
    rows = List.duplicate("", num_rows)

    # Build rows by iterating through each row and picking characters
    for row_idx <- 0..(num_rows - 1) do
      row_str =
