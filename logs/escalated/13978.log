def convert(s, num_rows) do
  len = String.length(s)
  if num_rows >= len do
    s
  else
    rows = List.duplicate("", num_rows)

    final_rows =
      s
      |> String.graphemes()
      |> Enum.reduce({rows, 0, 1}, fn char, {current_rows, current_row, step} ->
        # Append char to the current row
        new_row_str = current_rows |> Enum.at(current_row) <> char
        new_rows = List.replace_at(current_rows, current_row, new_row_str)

        # Determine next row
        next_row =
          cond do
            current_row == 0 -> 1
            current_row == num_rows - 1 -> num_rows - 2
            step == 1 -> current_row + 1
            step == -1 -> current_row - 1
          end

        # Determine next step
        new_step =
          cond do
            current_row == 0 -> 1
            current_row == num_rows - 1 -> -1
            true -> step
          end

        {new_rows, next_row, new_step}
      end)
