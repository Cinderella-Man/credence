defmodule Solution do
  @doc """
  Converts a string into a zigzag pattern on num_rows lines and reads it line by line.
  """
  @spec convert(String.t(), integer()) :: String.t()
  def convert(s, num_rows) when num_rows == 1 or num_rows >= String.length(s) do
    s
  end

  def convert(s, num_rows) do
    rows = List.duplicate("", num_rows)
    chars = String.to_charlist(s)

    row = 0
    step = 1

    chars
    |> Enum.each(fn char ->
      rows = List.replace_at(rows, row, List.append([char | rows |> Enum.at(row) |> List.duplicate(1) |> hd |> List.delete_at(0) |> hd | []), []))
      # This is inefficient, let's use a better approach with Enum.reduce
      rows = put_in(rows, [{row, char}])
    end)

    # Let's do it properly with Enum.reduce
    result =
      s
      |> String.graphemes()
      |> Enum.reduce(Map.new(Enum.map(0..num_rows-1, &{&1, ""})), fn char, acc ->
        {current_row, step} = find_next_row(acc["#{step}"], row, step, num_rows)
        new_acc = Map.put(acc, current_row, acc[current_row] <> char)
        Map.put(new_acc, "step", step)
      end)

    # Actually, let's rewrite properly
    # We need to track current row and step (direction)
    # This is tricky with Enum.reduce because we need to update state

    # Let's use a recursive approach or a proper reduce
    {final_rows, _, _} =
      s
      |> String.graphemes()
      |> Enum.reduce({List.duplicate("", num_rows), 0, 1}, fn char, {rows, current_row, step} ->
        new_rows = put_in(rows, {current_row, rows |> Enum.at(current_row) <> char})
        # Calculate next row
        next_row = cond do
          current_row == 0 -> 1
          current_row == num_rows - 1 -> num_rows - 2
          step == 1 -> current_row + 1
          step == -1 -> current_row - 1
        end

        new_step = cond do
          current_row == 0 -> 1
          current_row == num_rows - 1 -> -1
          true -> step
        end

        {new_rows, next_row, new_step}
      end)

    List.zip(final_rows, List.duplicate("", num_rows)) |> Enum.map(fn {_row, row} -> row end) |> Enum.join()
  end

  defp find_next_row(current_row, step, num_rows) do
    cond do
      current_row == 0 -> {1, 1}
      current_row == num_rows - 1 -> {num_rows - 2, -1}
      step == 1 -> {current_row + 1, 1}
      step == -1 -> {current_row - 1, -1}
    end
  end

  defp put_in(acc, {row, char}) do
    acc |> Map.update!(row, &(&1 <> char))
  end
end
