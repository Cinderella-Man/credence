defmodule Solution do
  @doc """
  Converts a string into a zigzag pattern on the given number of rows
  and then reads it line by line.
  """
  @spec convert(s :: String.t(), numRows :: integer) :: String.t()
  def convert(s, numRows) do
    cond do
      numRows == 1 or numRows >= String.length(s) ->
        s

      true ->
        s
        |> String.graphemes()
        |> zigzag_rows(numRows)
        |> Enum.map(&Enum.reverse/1)
        |> Enum.join()
    end
  end

  defp zigzag_rows(chars, numRows) do
    initial = for _ <- 1..numRows, do: []

    {rows, _current_row, _direction} =
      Enum.reduce(chars, {initial, 0, 1}, fn char, {rows, current_row, direction} ->
        updated_rows =
          List.update_at(rows, current_row, fn row -> [char | row] end)

        next_direction =
          cond do
            current_row == 0 -> 1
            current_row == numRows - 1 -> -1
            true -> direction
          end

        {updated_rows, current_row + next_direction, next_direction}
      end)

    rows
  end
end
