defmodule Solution do
  @spec dec_to_bin_stack(non_neg_integer()) :: String.t()
  def dec_to_bin_stack(0), do: "0"

  def dec_to_bin_stack(dec_number) when is_integer(dec_number) and dec_number > 0 do
    dec_number
    |> build_stack([])
    |> Enum.reduce("", fn digit, acc -> acc <> to_string(digit) end)
  end

  defp build_stack(0, stack), do: stack

  defp build_stack(n, stack) do
    remainder = rem(n, 2)
    build_stack(div(n, 2), [remainder | stack])
  end
end

