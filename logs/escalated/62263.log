    content: defmodule Credence.Pattern.PreferJoinOverMapJoinWithIntegerToStringFixTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferJoinOverMapJoinWithIntegerToString

  test "rewrites the anti-pattern" do
    input = """
    Enum.map_join(list, fn x -> Integer.to_string(x) end)
    """

    expected = """
    Enum.join(list, "")
    """

    assert fix(PreferJoinOverMapJoinWithIntegerToString, input) == expected
  end

  test "rewrites inside a module" do
    input = """
    defmodule Example do
      def example do
        list = [1, 0, 1, 0]
        Enum.map_join(list, fn x -> Integer.to_string(x) end)
      end
    end
    """

    expected = """
    defmodule Example do
      def example do
        list = [1, 0, 1, 0]
        Enum.join(list, "")
      end
    end
    """

    assert fix(PreferJoinOverMapJoinWithIntegerToString, input) == expected
  end

  test "rewrites multiple occurrences" do
    input = """
    Enum.map_join(a, fn x -> Integer.to_string(x) end)
    Enum.map_join(b, fn y -> Integer.to_string(y) end)
    """

    expected = """
    Enum.join(a, "")
    Enum.join(b, "")
    """

    assert fix(PreferJoinOverMapJoinWithIntegerToString, input) == expected
  end

  test "does not modify code that is already correct" do
    code = """
    Enum.join(list, "")
    """

    assert fix(PreferJoinOverMapJoinWithIntegerToString, code) == code
  end
end

