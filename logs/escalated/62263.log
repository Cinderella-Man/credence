    content: defmodule Credence.Pattern.PreferJoinOverMapJoinWithIntegerToStringEquivalenceTest do
  @moduledoc """
  Tier 1 (expression). `Enum.map_join(list, fn x -> Integer.to_string(x) end)`
  → `Enum.join(list, "")`.

  `Enum.join/2` calls `to_string/1` on each element, which for integers produces
  the same output as `Integer.to_string/1`. The empty-string separator is the
  default for `Enum.join/2`, matching the no-separator semantics of
  `Enum.map_join/2` (which concatenates without a separator).

  The input set covers empty/single/multi-element lists of integers, plus
  edge cases that could expose a type-change divergence.
  """
  use Credence.RuleCase, async: true

  import Credence.BehaviourEquivalence
  alias Credence.Pattern.PreferJoinOverMapJoinWithIntegerToString

  test "Enum.map_join(list, fn x -> Integer.to_string(x) end) → Enum.join(list, \"\") preserves the string" do
    assert_equivalent(
      """
      Enum.map_join(list, fn x -> Integer.to_string(x) end)
      """,
      rule: PreferJoinOverMapJoinWithIntegerToString,
      vars: [:list],
      inputs: [[], [1], [1, 2, 3], [0, 0, 0], [-1, 0, 1], Enum.to_list(1..20)]
    )
  end
end

