    content: defmodule Credence.Pattern.PreferJoinOverMapJoinWithIntegerToStringCheckTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferJoinOverMapJoinWithIntegerToString

  test "flags the anti-pattern" do
    assert flagged?(PreferJoinOverMapJoinWithIntegerToString, """
    Enum.map_join(list, fn x -> Integer.to_string(x) end)
    """)
  end

  test "flags the anti-pattern inside a module" do
    assert flagged?(PreferJoinOverMapJoinWithIntegerToString, """
    defmodule Example do
      def example do
        list = [1, 0, 1, 0]
        Enum.map_join(list, fn x -> Integer.to_string(x) end)
      end
    end
    """)
  end

  test "leaves good code alone" do
    assert clean?(PreferJoinOverMapJoinWithIntegerToString, """
    Enum.join(list, "")
    """)
  end

  test "leaves Enum.join with separator alone" do
    assert clean?(PreferJoinOverMapJoinWithIntegerToString, """
    Enum.join(list, ", ")
    """)
  end

  test "leaves Enum.map_join with different function alone" do
    assert clean?(PreferJoinOverMapJoinWithIntegerToString, """
    Enum.map_join(list, fn x -> to_string(x) end)
    """)
  end
end

