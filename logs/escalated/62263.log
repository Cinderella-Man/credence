    content: defmodule Credence.Pattern.PreferJoinOverMapJoinWithIntegerToString do
  @moduledoc """
  Detects `Enum.map_join(list, fn x -> Integer.to_string(x) end)` and
  rewrites it to `Enum.join(list, "")`.

  `Enum.join/2` is the idiomatic way to join a list of integers without a
  separator. Using `Enum.map_join/2` with an explicit `Integer.to_string/1`
  mapping function is verbose and unnecessary.

  ## Bad

      Enum.map_join(list, fn x -> Integer.to_string(x) end)

  ## Good

      Enum.join(list, "")
  """
  use Credence.Pattern.Rule
  alias Credence.Issue

  @impl true
  def check(ast, _opts) do
    {_ast, issues} =
      Macro.prewalk(ast, [], fn
        node, issues ->
          case match_map_join_pattern(node) do
            {:ok, meta} -> {node, [build_issue(meta) | issues]}
            :error -> {node, issues}
          end
      end)

    Enum.reverse(issues)
  end

  @impl true
  def fix_patches(ast, _opts) do
    Credence.RuleHelpers.patches_from_postwalk(ast, fn
      node ->
        case match_map_join_pattern(node) do
          {:ok, _meta} ->
            {{:., [], [{:__aliases__, [], [:Enum]}, :join]}, [],
             [
               get_list_arg(node),
               {:__block__, [delimiter: "\""], [""]}
             ]}

          :error ->
            node
        end
    end)
  end

  # Matches: Enum.map_join(list, fn x -> Integer.to_string(x) end)
  defp match_map_join_pattern(
         {{:., meta, [{:__aliases__, _, [:Enum]}, :map_join]}, _,
          [
            _list,
            {:fn, _,
             [
               {:->, _,
                [
                  [{var_name, _, nil}],
                  {{:., _}, _,
                   [
                     {:__aliases__, _, [:Integer]},
                     :to_string
                   ]} = _to_string_call
                ]}
             ]}
          ]}
       ) do
    # Verify the Integer.to_string call uses the same variable
    case node do
      {{:., _}, _, [{var_name2, _, nil}]} when var_name2 == var_name -> {:ok, meta}
      _ -> :error
    end
  end

  defp match_map_join_pattern(
         {{:., meta, [{:__aliases__, _, [:Enum]}, :map_join]}, _,
          [
            _list,
            {:fn, _,
             [
               {:->, _,
                [
                  [{var_name, _, nil}],
                  {{:., _},
                   _,
                   [
                     {:__aliases__, _, [:Integer]},
                     :to_string
                   ]},
                  [{var_name2, _, nil}]
                ]}
             ]}
          ]}
       )
       when var_name == var_name2 do
    {:ok, meta}
  end

  defp match_map_join_pattern(_), do: :error

  defp get_list_arg(
         {{:., _, [{:__aliases__, _, [:Enum]}, :map_join]}, _,
          [list | _]}
       ) do
    list
  end

  defp build_issue(meta) do
    %Issue{
      rule: :prefer_join_over_map_join_with_integer_to_string,
      message:
        "Use `Enum.join(list, \"\")` instead of `Enum.map_join(list, fn x -> Integer.to_string(x) end)`.",
      meta: %{line: Keyword.get(meta, :line)}
    }
  end
end

