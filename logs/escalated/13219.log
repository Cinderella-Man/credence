---REFERENCE---
defmodule Solution do
  @doc """
  Counts the number of valid pairs of brackets in the given string.
  """
  def count_valid_brackets(s) do
    s
    |> String.to_charlist()
    |> Enum.reduce({[], 0}, fn char, {stack, count} ->
      cond do
        char in [?(, ?[, ?{] ->
          {[char | stack], count}

        stack != [] and char == ?) and hd(stack) == ?( ->
          {tl(stack), count + 1}

        stack != [] and char == ?] and hd(stack) == ?[ ->
          {tl(stack), count + 1}

        stack != [] and char == ?} and hd(stack) == ?{ ->
          {tl(stack), count + 1}

        true ->
          {stack, count}
      end
    end)
    |> elem(1)
  end
end
