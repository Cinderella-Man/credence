---MODULE---
defmodule Solution do
  @doc """
  Counts the number of valid bracket pairs in a string.
  """
  @spec count_valid_brackets(String.t()) :: non_neg_integer()
  def count_valid_brackets("") do
    0
  end

  def count_valid_brackets(str) do
    {valid_pairs, stack} =
      String.codepoints(str)
      |> Enum.reduce_while({0, []}, fn char, {count, stack} ->
        case char do
          "(" ->
            {:cont, {count, ["("] ++ stack}}
          "[" ->
            {:cont, {count, ["["] ++ stack}}
          "{" ->
            {:cont, {count, ["{"] ++ stack}}
          ")" ->
            case stack do
              ["("] ++ rest -> {:cont, {count + 1, rest}}
              _ -> {:cont, {count, stack}}
            end
          "]" ->
            case stack do
              ["["] ++ rest -> {:cont, {count + 1, rest}}
              _ -> {:cont, {count, stack}}
            end
          "}" ->
            case stack do
              ["{"] ++ rest -> {:cont, {count + 1, rest}}
              _ -> {:cont, {count, stack}}
            end
          _ ->
            {:cont, {count, stack}}
        end
      end)

    valid_pairs
  end
end
