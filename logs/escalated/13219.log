    content: defmodule Credence.Pattern.PreferConsOverSingletonAppendEquivalenceTest do
  @moduledoc """
  Tier 1 (expression). `[elem] ++ list` → `[elem | list]` — the cons operator
  is the canonical way to prepend a single element. `[x] ++ xs` and `[x | xs]`
  produce the same list for every proper-list input (and both raise for
  non-list tails, since `++` requires a proper list on the right and cons
  does not constrain the tail).
  """
  use Credence.RuleCase, async: true

  import Credence.BehaviourEquivalence
  alias Credence.Pattern.PreferConsOverSingletonAppend

  test "[elem] ++ list → [elem | list] preserves the list" do
    assert_equivalent(
      "[1] ++ stack",
      rule: PreferConsOverSingletonAppend,
      vars: [:stack],
      inputs: [[], [2], [2, 3, 4], [:a, :b, :c], Enum.to_list(1..20)]
    )
  end
end

