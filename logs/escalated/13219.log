    content: defmodule Credence.Pattern.PreferConsOverSingletonAppend do
  @moduledoc """
  Detects `[elem] ++ list` and rewrites it to the idiomatic cons form
  `[elem | list]`.

  The cons operator `|` is the canonical Elixir idiom for prepending a single
  element to a list. Using `[elem] ++ list` allocates an intermediate
  single-element list and traverses it, which is both non-idiomatic and
  slightly less efficient.

  The rule fires in both value and pattern contexts — e.g. both
  `["("] ++ stack` (construction) and `["("] ++ rest` (case-match pattern).

  ## Bad

      ["("] ++ stack

      case stack do
        ["("] ++ rest -> rest
      end

  ## Good

      ["(" | stack]

      case stack do
        ["(" | rest] -> rest
      end
  """
  use Credence.Pattern.Rule
  alias Credence.RuleHelpers

  @impl true
  def check(ast, _opts) do
    {_ast, issues} =
      Macro.prewalk(ast, [], fn
        {:++, meta, [lhs, _rhs]} = node, issues ->
          case singleton_list_literal?(lhs) do
            {:ok, _elem, _wrapper} ->
              line = Keyword.get(meta, :line)
              {node, [build_issue(line) | issues]}

            :error ->
              {node, issues}
          end

        node, issues ->
          {node, issues}
      end)

    Enum.reverse(issues)
  end

  @impl true
  def fix_patches(ast, _opts) do
    RuleHelpers.patches_from_postwalk(ast, fn
      {:++, _meta, [lhs, rhs]} = node ->
        case singleton_list_literal?(lhs) do
          {:ok, elem, wrapper} ->
            RuleHelpers.rewrap_list(wrapper, [{:|, [], [elem, rhs]}])

          :error ->
            node
        end

      node ->
        node
    end)
  end

  # Returns `{:ok, single_element, wrapper}` when `lhs` is a list literal
  # containing exactly one element that is not itself a cons cell.
  # Returns `:error` otherwise.
  defp singleton_list_literal?(lhs) do
    case RuleHelpers.unwrap_list(lhs) do
      {:ok, [single], wrapper} ->
        if cons_cell?(single), do: :error, else: {:ok, single, wrapper}

      _ ->
        :error
    end
  end

  defp cons_cell?({:|, _, _}), do: true
  defp cons_cell?(_), do: false

  defp build_issue(line) do
    %Issue{
      rule: :prefer_cons_over_singleton_append,
      message:
        "Using `[elem] ++ list` instead of `[elem | list]` to prepend a single element " <>
          "is non-idiomatic. Use the cons operator `[elem | list]` instead.",
      meta: %{line: line}
    }
  end
end

