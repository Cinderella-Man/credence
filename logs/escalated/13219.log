defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "counts valid bracket pairs" do
    assert Solution.count_valid_brackets("()[]{}") == 3
    assert Solution.count_valid_brackets("()") == 1
    assert Solution.count_valid_brackets("({})[]") == 3
    assert Solution.count_valid_brackets(")(") == 0
    assert Solution.count_valid_brackets("{[]}") == 2
    assert Solution.count_valid_brackets("(]") == 0
  end
