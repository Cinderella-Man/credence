    content: defmodule Credence.Pattern.PreferConsOverSingletonAppendFixTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferConsOverSingletonAppend

  # ═══════════════════════════════════════════════════════════════════
  # BASIC FIXES — [elem] ++ list → [elem | list]
  # ═══════════════════════════════════════════════════════════════════

  describe "rewrites singleton list append to cons" do
    test "value context in a module" do
      input = """
      defmodule Bad do
        def process(stack) do
          ["("] ++ stack
        end
      end
      """

      expected = """
      defmodule Bad do
        def process(stack) do
          ["(" | stack]
        end
      end
      """

      confirm_fix(fix(PreferConsOverSingletonAppend, input), expected)
    end

    test "pattern context in a case match" do
      input = """
      defmodule Bad do
        def process(stack) do
          case stack do
            ["("] ++ rest -> rest
            _ -> stack
          end
        end
      end
      """

      expected = """
      defmodule Bad do
        def process(stack) do
          case stack do
            ["(" | rest] -> rest
            _ -> stack
          end
        end
      end
      """

      confirm_fix(fix(PreferConsOverSingletonAppend, input), expected)
    end

    test "both value and pattern context in same module" do
      input = """
      defmodule Bad do
        def process(char, stack) do
          case char do
            "(" ->
              ["("] ++ stack
            ")" ->
              case stack do
                ["("] ++ rest -> rest
                _ -> stack
              end
            _ ->
              stack
          end
        end
      end
      """

      expected = """
      defmodule Bad do
        def process(char, stack) do
          case char do
            "(" ->
              ["(" | stack]
            ")" ->
              case stack do
                ["(" | rest] -> rest
                _ -> stack
              end
            _ ->
              stack
          end
        end
      end
      """

      confirm_fix(fix(PreferConsOverSingletonAppend, input), expected)
    end

    test "integer element" do
      input = """
      defmodule Bad do
        def prepend(x, xs) do
          [x] ++ xs
        end
      end
      """

      expected = """
      defmodule Bad do
        def prepend(x, xs) do
          [x | xs]
        end
      end
      """

      confirm_fix(fix(PreferConsOverSingletonAppend, input), expected)
    end
  end

  # ═══════════════════════════════════════════════════════════════════
  # NO-OPS — must NOT modify
  # ═══════════════════════════════════════════════════════════════════

  describe "does not modify non-singleton patterns" do
    test "empty list ++ list unchanged" do
      input = """
      defmodule Safe do
        def prepend(list) do
          [] ++ list
        end
      end
      """

      confirm_fix(fix(PreferConsOverSingletonAppend, input), input)
    end

    test "multi-element list ++ list unchanged" do
      input = """
      defmodule Safe do
        def prepend(a, b, list) do
          [a, b] ++ list
        end
      end
      """

      confirm_fix(fix(PreferConsOverSingletonAppend, input), input)
    end

    test "variable ++ list unchanged" do
      input = """
      defmodule Safe do
        def concat(a, b) do
          a ++ b
        end
      end
      """

      confirm_fix(fix(PreferConsOverSingletonAppend, input), input)
    end

    test "list ++ [elem] unchanged" do
      input = """
      defmodule Safe do
        def append(list, x) do
          list ++ [x]
        end
      end
      """

      confirm_fix(fix(PreferConsOverSingletonAppend, input), input)
    end
  end

  # ═══════════════════════════════════════════════════════════════════
  # ROUND-TRIP — fixed code produces zero issues
  # ═══════════════════════════════════════════════════════════════════

  describe "round-trip" do
    test "fixed code produces zero issues" do
      code = """
      defmodule Bad do
        def process(char, stack) do
          case char do
            "(" ->
              ["("] ++ stack
            ")" ->
              case stack do
                ["("] ++ rest -> rest
                _ -> stack
              end
            _ ->
              stack
          end
        end
      end
      """

      assert check(PreferConsOverSingletonAppend, fix(PreferConsOverSingletonAppend, code)) == []
    end

    test "fixed code is valid Elixir" do
      code = """
      defmodule Bad do
        def process(stack) do
          ["("] ++ stack
        end
      end
      """

      assert valid_syntax?(fix(PreferConsOverSingletonAppend, code))
    end
  end
end

