    content: defmodule Credence.Pattern.PreferConsOverSingletonAppendCheckTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferConsOverSingletonAppend

  # ═══════════════════════════════════════════════════════════════════
  # POSITIVE — should flag
  # ═══════════════════════════════════════════════════════════════════

  describe "flags [elem] ++ list in value context" do
    test "singleton string element prepended to variable" do
      code = """
      defmodule Bad do
        def process(stack) do
          ["("] ++ stack
        end
      end
      """

      assert flagged?(PreferConsOverSingletonAppend, code)
    end

    test "singleton integer element prepended to variable" do
      code = """
      defmodule Bad do
        def prepend(x, xs) do
          [x] ++ xs
        end
      end
      """

      assert flagged?(PreferConsOverSingletonAppend, code)
    end

    test "singleton element prepended to function call result" do
      code = """
      defmodule Bad do
        def wrap(x, list) do
          [x] ++ tl(list)
        end
      end
      """

      assert flagged?(PreferConsOverSingletonAppend, code)
    end
  end

  describe "flags [elem] ++ list in pattern context" do
    test "singleton element in case match pattern" do
      code = """
      defmodule Bad do
        def process(stack) do
          case stack do
            ["("] ++ rest -> rest
            _ -> stack
          end
        end
      end
      """

      assert flagged?(PreferConsOverSingletonAppend, code)
    end
  end

  describe "flags multiple occurrences" do
    test "flags both value and pattern context in same module" do
      code = """
      defmodule Bad do
        def process(char, stack) do
          case char do
            "(" ->
              ["("] ++ stack
            ")" ->
              case stack do
                ["("] ++ rest -> rest
                _ -> stack
              end
            _ ->
              stack
          end
        end
      end
      """

      issues = check(PreferConsOverSingletonAppend, code)
      assert length(issues) == 2
    end
  end

  # ═══════════════════════════════════════════════════════════════════
  # NEGATIVE — must NOT flag
  # ═══════════════════════════════════════════════════════════════════

  describe "does not flag non-singleton left operand" do
    test "empty list ++ list" do
      code = """
      defmodule Safe do
        def prepend(list) do
          [] ++ list
        end
      end
      """

      assert clean?(PreferConsOverSingletonAppend, code)
    end

    test "multi-element list ++ list" do
      code = """
      defmodule Safe do
        def prepend(a, b, list) do
          [a, b] ++ list
        end
      end
      """

      assert clean?(PreferConsOverSingletonAppend, code)
    end
  end

  describe "does not flag non-list left operand" do
    test "variable ++ list" do
      code = """
      defmodule Safe do
        def concat(a, b) do
          a ++ b
        end
      end
      """

      assert clean?(PreferConsOverSingletonAppend, code)
    end

    test "function call ++ list" do
      code = """
      defmodule Safe do
        def concat(list) do
          Enum.to_list(1..3) ++ list
        end
      end
      """

      assert clean?(PreferConsOverSingletonAppend, code)
    end
  end

  describe "does not flag append (list on right)" do
    test "list ++ [singleton]" do
      code = """
      defmodule Safe do
        def append(list, x) do
          list ++ [x]
        end
      end
      """

      assert clean?(PreferConsOverSingletonAppend, code)
    end
  end

  describe "does not flag idiomatic cons" do
    test "[elem | list] is already correct" do
      code = """
      defmodule Safe do
        def prepend(x, list) do
          [x | list]
        end
      end
      """

      assert clean?(PreferConsOverSingletonAppend, code)
    end
  end

  describe "does not flag code without ++" do
    test "plain function" do
      code = """
      defmodule Safe do
        def identity(x), do: x
      end
      """

      assert clean?(PreferConsOverSingletonAppend, code)
    end
  end
end

