defmodule Solution do
  @doc """
  Returns the two songs with the highest play counts from the playlist.
  If the playlist contains fewer than two songs, returns the entire playlist unchanged.
  """
  @spec two_most_played_songs([{String.t(), integer()}]) :: [{String.t(), integer()}]
  def two_most_played_songs([]), do: []

  def two_most_played_songs([song]), do: [song]

  def two_most_played_songs(playlist) do
    playlist
    |> Enum.sort_by(fn {_genre, play_count} -> play_count end, :desc)
    |> Enum.take(2)
  end
end
