defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "two most played songs from multiple genres" do
    playlist = [{"pop", 15}, {"rock", 20}, {"pop", 10}, {"jazz", 30}]
    assert Solution.two_most_played_songs(playlist) == [{"jazz", 30}, {"rock", 20}]
  end

  test "two most played songs from same genre" do
    playlist = [{"classical", 5}, {"classical", 10}]
    assert Solution.two_most_played_songs(playlist) == [{"classical", 10}, {"classical", 5}]
  end

  test "single song playlist" do
    playlist = [{"folk", 1}]
    assert Solution.two_most_played_songs(playlist) == [{"folk", 1}]
  end
end
