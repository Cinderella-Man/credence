defmodule Solution do
  @doc """
  Determines whether a given string can be segmented into a space-separated
  sequence of one or more dictionary words.

  Uses dynamic programming with a set for O(1) dictionary lookups.
  Time complexity: O(n^2) where n is the length of the string.
  """
  @spec can_segment(String.t(), [String.t()]) :: boolean()
  def can_segment("", _word_dict), do: false

  def can_segment(s, word_dict) do
    dict = MapSet.new(word_dict)
    dict_size = MapSet.size(dict)

    # We use a map for memoization: index -> boolean
    # dp[i] = true means s[0..i-1] can be segmented
    can_segment_dp(s, dict, 0, %{})
  end

  # Helper: check if suffix starting at `start` can be segmented
  # Returns true if the substring s[start..end] can be fully segmented
  # We use a memoized approach: try all possible first words starting at `start`

  defp can_segment_dp(s, dict, start, memo) when start == byte_size(s) do
    # Reached the end, but we need at least one word to have been used
    # This case is tricky: we need to track whether we've started
    true
  end

  defp can_segment_dp(s, dict, start, memo) do
    # Check memo
    case Map.get(memo, start) do
      result when result in [true, false] -> result
      nil ->
        result = check_segment(s, dict, start, memo)
        memo = Map.put(memo, start, result)
        result
    end
  end

  defp check_segment(s, dict, start, memo) when start == byte_size(s) do
    # End of string reached successfully
    true
  end

  defp check_segment(s, dict, start, _memo) when start < 0 or start > byte_size(s) do
    false
  end

  defp check_segment(s, dict, start, memo) do
    # Try all possible end positions for a word starting at `start`
    max_end = byte_size(s)
    result = check_segment_recursive(s, dict, start, max_end, memo)
    Map.put(memo, start, result)
  end

  defp check_segment_recursive(_s, _dict, start, max_end, memo) when start > max_end do
    false
  end

  defp check_segment_recursive(s, dict, start, max_end, memo) do
    # Try substring s[start..end] (inclusive end in byte offset)
    end_offset = start
    cond:
    end_offset > max_end ->
      false

    true ->
      substring = String.slice(s, start, end_offset - start + 1)
      
      # Hmm, this recursive approach is not quite right. Let me use a proper DP.
    end
  end

  # Let me rewrite this properly with a clean DP approach.
  defp can_segment_clean(s, dict) do
    n = byte_size(s)
    
    # dp[i] = true means s[0..i-1] (first i chars) can be segmented
    # dp[0] = true (empty prefix can be segmented)
    dp = Enum.reduce(0..n, %{0 => true}, fn
      0, _acc -> %{0 => true}
      i, acc ->
        # Check if s[0..j-1] can be segmented AND s[j..i-1] is a word
        result = Enum.any?(0..(i - 1), fn j ->
          case Map.get(acc, j) do
            true ->
              substring = String.slice(s, j, i - j)
              MapSet.member?(dict, substring)
            false ->
              false
          end
        end)
        
        Map.put(acc, i, result)
    end)
    
    Map.get(dp, n, false)
  end

  def can_segment(s, word_dict) do
    dict = MapSet.new(word_dict)
    n = byte_size(s)
    
    if n == 0 do
      false
    else
      # dp[i] = true means s[0..i-1] can be segmented into dictionary words
      dp = Map.new([0], fn _ -> true end)
      
      result = check_dp(s, dict, 1, n, dp)
      result
    end
  end

  defp check_dp(_s, _dict, i, n, _dp) when i > n do
    # Final answer
    # We need to return dp[n], but dp is updated...
    # Let me restructure.
    true
  end

  # Better approach: use a list or array for DP
  defp can_segment_v2(s, dict) do
    n = byte_size(s)
    
    # dp[i] = true if s[0..i-1] can be segmented
    dp_list = List.duplicate(false, n + 1)
    # Set dp[0] = true
    dp_list = List.update_at(dp_list, 0, fn _ -> true end)
    
    check_dp_index(s, dict, 1, n, dp_list)
  end

  defp check_dp_index(_s, _dict, i, n, dp_list) when i > n do
    # Get dp[n]
    Enum.at(dp_list, n)
  end

  defp check_dp_index(s, dict, i, n, dp_list) do
    # dp[i] = any j in 0..(i-1) where dp[j] == true AND s[j..i-1] is in dict
    dp_i = Enum.any?(0..(i - 1), fn j ->
      substring = String.slice(s, j, i - j)
      dp_j = Enum.at(dp_list, j)
      dp_j == true and MapSet.member?(dict, substring)
    end)
    
    new_dp_list = List.update_at(dp_list, i, fn _ -> dp_i end)
    check_dp_index(s, dict, i + 1, n, new_dp_list)
  end
