@doc """
Determines whether a given string can be segmented into a space-separated
sequence of one or more dictionary words.
"""
defmodule Solution do
  @spec can_segment?(String.t(), [String.t()]) :: boolean()
  def can_segment?(s, word_dict) do
    dict = MapSet.new(word_dict)
    memo = %{}
    can_segment?(s, dict, 0, String.length(s), memo)
  end

  @spec can_segment?(String.t(), MapSet.t(), integer(), integer(), map()) ::
          boolean()
  defp can_segment?(_s, _dict, pos, len, _memo) when pos == len, do: true

  defp can_segment?(_s, _dict, pos, _len, _memo) when pos > 0 do
    false
  end

  defp can_segment?(s, dict, start, len, memo) do
    cond do
      MapSet.member?(memo, start) ->
