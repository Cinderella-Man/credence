# Test various scenarios
test_cases = [
  # Should NOT be flagged (cond/case/receive/try clauses)
  {"cond clause with >",
   """
   cond do
     number > 10 -> :large
     number > 0 -> :positive
     true -> :zero_or_negative
   end
   """, false},
  {"case clause",
   """
   case x do
     y -> y
     _ -> :default
   end
   """, false},
  {"single-line case",
   "case x do y -> y end",
   false},
  {"cond with complex expressions",
   """
   cond do
     is_atom(x) -> :atom
     x == 0 -> :zero
     length(list) > 0 -> :non_empty
   end
   """, false},

  # Should be flagged (bare lambdas)
  {"bare lambda in function call",
   "Enum.reduce(1..n, 1, acc -> acc * n)",
   true},
  {"multi-param lambda",
   "Enum.reduce(list, 0, x, acc -> x + acc)",
   true},
  {"bare lambda in assignment",
   "f = x -> x + 1",
   true},
]

for {desc, code, should_flag} <- test_cases do
  issues = PreferFnEndSyntax.analyze(code)
  flagged = issues != []
  
  if flagged == should_flag do
    IO.puts("✓ #{desc}")
  else
    IO.puts("✗ #{desc} (expected #{should_flag}, got #{flagged})")
    if flagged do
      IO.puts("  Issues: #{inspect(issues)}")
    end
  end
end

