    assert Solution.can_segment("", ["any"]) == false
  end
end

---REFERENCE---
defmodule Solution do
  @spec can_segment(String.t(), [String.t()]) :: boolean()
  def can_segment(s, word_dict) do
    n = String.length(s)
    if n == 0 do
      false
    else
      word_set = MapSet.new(word_dict)
      dp = :array.new(n + 1, default: false)
      dp = :array.set(0, true, dp)

      Enum.reduce(1..n, dp, fn i, dp_acc ->
        found =
          Enum.reduce_while(0..(i - 1), false, fn j, _acc ->
            if :array.get(j, dp_acc) and
                 MapSet.member?(word_set, String.slice(s, j, i - j)) do
              {:halt, true}
            else
              {:cont, false}
            end
          end)

        if found do
          :array.set(i, true, dp_acc)
        else
          dp_acc
        end
      end)
      |> (fn dp -> :array.get(n, dp) end).()
    end
  end
end

