    content: defmodule Credence.Syntax.PreferFnEndSyntax do
  @moduledoc """
  Detects Python-style lambda syntax and wraps with `fn ... end`.

  LLMs generating Elixir code from Python sometimes produce:

      acc -> acc * n

  instead of the correct Elixir syntax:

      fn acc, _i -> acc * n end

  The bare `->` outside `fn ... end` is a parse failure. This rule
  detects lines containing `->` that are not wrapped in `fn ... end`
  and repairs them.

  ## Detected patterns

      acc -> acc * n
      x, acc -> x + acc
      val -> val * 2

  ## Not flagged

      fn x -> x + 1 end        — already correct
      case x do y -> y end     — case/receive/cond/try arrows
  """
  use Credence.Syntax.Rule
  alias Credence.Issue

  # Pattern to match lambda parameters before ->
  # Matches: ident -> or ident, ident ->
  # Does NOT match things like 1..n where n would be falsely captured
  @lambda_params_pattern ~r/\b([a-z_]\w*(?:\s*,\s*[a-z_]\w*)*)\s*->/

  @impl true
  def analyze(source) do
    source
    |> String.split("\n")
    |> compute_block_context()
    |> Enum.flat_map(fn {line, line_no, in_block?} ->
      if has_bare_arrow?(line, in_block?), do: [build_issue(line_no)], else: []
    end)
  end

  @impl true
  def fix(source) do
    source
    |> String.split("\n")
    |> compute_block_context()
    |> Enum.map_join("\n", fn {line, _line_no, in_block?} ->
      if has_bare_arrow?(line, in_block?), do: fix_line(line), else: line
    end)
  end

  # Compute block context for each line. Returns [{line, line_no, in_block?}]
  # where in_block? indicates if the line is inside a cond/case/receive/try block.
  defp compute_block_context(lines) do
    {_block_stack, results} =
      lines
      |> Enum.with_index(1)
      |> Enum.reduce({[], []}, fn {line, line_no}, {block_stack, acc} ->
        # Check if this line opens a new block
        new_stack = cond do
          Regex.match?(~r/\bcond\b.*\bdo\b/, line) -> [:cond | block_stack]
          Regex.match?(~r/\bcase\b.*\bdo\b/, line) -> [:case | block_stack]
          Regex.match?(~r/\breceive\b.*\bdo\b/, line) -> [:receive | block_stack]
          Regex.match?(~r/\btry\b.*\bdo\b/, line) -> [:try | block_stack]
          true -> block_stack
        end

        # Check if this line closes a block (contains 'end')
        # We need to be careful not to match 'end' in strings or other contexts
        in_block? = new_stack != []
        
        updated_stack = if Regex.match?(~r/^\s*end\b/, line) and new_stack != [] do
          tl(new_stack)
        else
          new_stack
        end

        {updated_stack, [{line, line_no, in_block?} | acc]}
      end)

    Enum.reverse(results)
  end

  defp has_bare_arrow?(line, in_block?) do
    # Must have an arrow
    has_arrow = Regex.match?(~r/->/, line)
    # Must not already have fn
    has_fn = Regex.match?(~r/\bfn\b/, line)
    # Must not be a comment
    is_comment = Regex.match?(~r/^\s*#/, line)
    # Must not be part of case/receive/cond/try block clause
    # If we're inside a cond/case/receive/try block, this line is a clause
    is_case_clause = in_block? or oneline_case_clause?(line)
    
    has_arrow and not has_fn and not is_comment and not is_case_clause
  end

  # Check for case/receive/cond/try on the same line as ->
  defp oneline_case_clause?(line) do
    Regex.match?(~r/\b(case|receive|cond|try|fn)\b.*\bdo\b.*->/, line)
  end

  defp fix_line(line) do
    # Find the lambda pattern and wrap with fn ... end
    case Regex.run(@lambda_params_pattern, line, return: :index) do
      [{match_start, match_length}, {param_start, param_length}] ->
        params = binary_part(line, param_start, param_length)
        before = binary_part(line, 0, match_start)
        after_match = binary_part(line, match_start + match_length, byte_size(line) - match_start - match_length)
        
        # Find the body and any trailing content (like closing paren)
        {body, suffix} = split_body_and_suffix(after_match)
        
        before <> "fn " <> String.trim(params) <> " -> " <> String.trim(body) <> " end" <> suffix
      
      _ ->
        line
    end
  end

  defp split_body_and_suffix(after_match) do
    trimmed = String.trim(after_match)
    
    # If it ends with ), we want to put end before the )
    if String.ends_with?(trimmed, ")") do
      # Find the position of the last )
      last_paren_idx = find_last_paren(trimmed)
      if last_paren_idx >= 0 do
        {body, suffix} = String.split_at(trimmed, last_paren_idx)
        {body, suffix}
      else
        {trimmed, ""}
      end
    else
      {trimmed, ""}
    end
  end

  defp find_last_paren(str) do
    # Find the index of the last ) in the string
    str
    |> String.to_charlist()
    |> Enum.with_index()
    |> Enum.filter(fn {c, _} -> c == ?) end)
    |> Enum.map(fn {_, idx} -> idx end)
    |> List.last(-1)
  end

  defp build_issue(line_no) do
    %Issue{
      rule: :prefer_fn_end_syntax,
      message:
        "Python-style lambda syntax detected. " <>
          "Wrap with `fn ... end` for valid Elixir.",
      meta: %{line: line_no}
    }
  end
end

