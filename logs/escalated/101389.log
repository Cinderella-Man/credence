  test "single distinct characters each form their own partition" do
    assert Solution.partitionlabels("xyz") == [1, 1, 1]
  end

  test "all same characters form one partition" do
    assert Solution.partitionlabels("aaaa") == [4]
  end

  test "typical mixed string partitions correctly" do
    assert Solution.partitionlabels("ababcbacadefegdehijhklij") == [9, 7, 8]
  end
end
```

---REFERENCE---
```elixir
defmodule Solution do
  def partitionlabels(s) do
    last =
      s
      |> String.graphemes()
      |> Enum.with_index()
      |> Enum.reduce(%{}, fn {c, i}, acc -> Map.put(acc, c, i) end)

    {result, _left, _lo} =
      s
      |> String.graphemes()
      |> Enum.with_index()
      |> Enum.reduce({[], 0, 0}, fn {c, i}, {result, left, lo} ->
        left = max(left, Map.get(last, c))

        if i == left do
          {result ++ [left - lo + 1], left, i + 1}
        else
          {result, left, lo}
        end
      end)

    result
  end
end
```

