defmodule Solution do
  @doc """
  Partitions a string into as many parts as possible so that each letter
  appears in at most one part. Returns a list of the sizes of these partitions.
  """
  @spec partitionlabels(String.t()) :: list(non_neg_integer())
  def partitionlabels(s) when is_binary(s) do
    last_map =
      s
      |> String.codepoints()
      |> Enum.with_index()
      |> Enum.group_by(fn {char, _} -> char end, fn {_, idx} -> idx end)
      |> Enum.map(fn {char, indices} -> {char, List.last(indices)} end)
      |> Enum.into(%{})

    do_partition(String.codepoints(s), 0, 0, last_map, [])
    |> Enum.reverse()
  end

  defp do_partition([], current_start, _current_end, _last_map, acc) do
    [current_start - _current_end | acc]
    |> List.delete(current_start - _current_end)
  end

  # Base case: when the list is empty, we need to handle the last partition.
  # But actually, the logic below handles partitions by extending end_pos.
  # When we finish processing, if there's an open partition, we add its size.
  # Let's restructure to be cleaner.
  defp do_partition(chars, start, end_pos, last_map, acc) when start > end_pos and start < length(chars) do
    # This case shouldn't be reached with correct logic if we process correctly.
    # Let's use a different approach.
    do_partition_impl(chars, start, end_pos, last_map, acc)
  end

  defp do_partition_impl([], start, end_pos, last_map, acc) do
    # If we have a pending partition from start to end_pos
    if end_pos >= start do
      [end_pos - start + 1 | acc]
    else
      acc
    end
  end

  defp do_partition_impl([char | rest], start, end_pos, last_map, acc) do
    current_last = Map.get(last_map, char, end_pos)
    new_end_pos = max(end_pos, current_last)

    if end_pos == new_end_pos and Enum.empty?(rest) do
      # End of string and current partition ends here
      [end_pos - start + 1 | acc]
    else
      do_partition_impl(rest, start, new_end_pos, last_map, acc)
    end
  end
end

