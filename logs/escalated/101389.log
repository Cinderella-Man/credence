  @doc """
  Partitions a string into as many parts as possible so that each letter
  appears in at most one part. Returns a list of the sizes of these partitions.
  """
  @spec partitionlabels(String.t()) :: list(non_neg_integer())
  def partitionlabels(s) when is_binary(s) do
    last_map =
      s
      |> String.graphemes()
      |> Enum.with_index()
      |> Enum.group_by(fn {char, _} -> char end, fn {_, idx} -> idx end)
      |> Enum.map(fn {char, indices} -> {char, List.last(indices)} end)
      |> Map.new()

    do_partition(String.graphemes(s), 0, 0, last_map, [])
    |> Enum.reverse()
  end

  defp do_partition([], __start, end_pos, __last_map, acc) when end_pos >= 0 do
    [end_pos + 1 | acc]
  end
  defp do_partition([], __start, _end_pos, __last_map, acc) do
    acc
  end

  defp do_partition([char | rest], start, end_pos, last_map, acc) do
    current_last = Map.get(last_map, char, end_pos)
    new_end_pos = max(end_pos, current_last)

    if new_end_pos == end_pos and Enum.empty?(rest) do
      [end_pos - start + 1 | acc]
    else
      do_partition(rest, start, new_end_pos, last_map, acc)
    end
  end
end[0m
