    content: defmodule Credence.Syntax.NoUnclosedFnDelimiterFixTest do
  use ExUnit.Case

  import Credence.RuleCase, only: [valid_syntax?: 1]

  alias Credence.Syntax.NoUnclosedFnDelimiter

  defp analyze(code), do: NoUnclosedFnDelimiter.analyze(code)
  defp fix(code), do: NoUnclosedFnDelimiter.fix(code)

  test "fixes fn closed with ) by inserting end" do
    input = "Enum.map([1, 2], fn x -> x + 1)"
    expected = "Enum.map([1, 2], fn x -> x + 1 end)"

    assert fix(input) == expected
  end

  test "fixes fn with pattern-matching args" do
    input = "Enum.max_by(list, fn (_, {_, second}) -> second)"
    expected = "Enum.max_by(list, fn (_, {_, second}) -> second end)"

    assert fix(input) == expected
  end

  test "fixes indented line" do
    input = "    list |> Enum.map(fn x -> x + 1)"
    expected = "    list |> Enum.map(fn x -> x + 1 end)"

    assert fix(input) == expected
  end

  test "preserves already-correct fn...end)" do
    code = "Enum.map([1, 2], fn x -> x + 1 end)"
    assert fix(code) == code
  end

  test "preserves code without fn" do
    code = "Enum.map([1, 2], &(&1 + 1))"
    assert fix(code) == code
  end

  test "fixed output no longer flags" do
    assert analyze(
             fix("Enum.map([1, 2], fn x -> x + 1)")
           ) == []
  end

  test "fixed output is well-formed (parses)" do
    assert valid_syntax?(fix("Enum.map([1, 2], fn x -> x + 1)"))
  end

  test "fixes a multi-line module with unclosed fn" do
    input = """
    defmodule Solution do
      def run(list) do
        Enum.map(list, fn x -> x + 1)
      end
    end
    """

    expected = """
    defmodule Solution do
      def run(list) do
        Enum.map(list, fn x -> x + 1 end)
      end
    end
    """

    assert fix(input) == expected
  end
end

