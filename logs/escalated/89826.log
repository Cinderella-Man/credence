    content: defmodule Credence.Syntax.NoUnclosedFnDelimiterAnalyzeTest do
  use ExUnit.Case

  alias Credence.Issue
  alias Credence.Syntax.NoUnclosedFnDelimiter

  defp analyze(code), do: NoUnclosedFnDelimiter.analyze(code)

  test "flags a single-line fn closed with ) instead of end)" do
    assert [%Issue{rule: :no_unclosed_fn_delimiter, meta: %{line: 1}}] =
             analyze("Enum.map([1, 2], fn x -> x + 1)")
  end

  test "flags fn with pattern-matching args closed with )" do
    assert [%Issue{rule: :no_unclosed_fn_delimiter}] =
             analyze("Enum.max_by(list, fn (_, {_, second}) -> second)")
  end

  test "flags multiple lines independently" do
    code = """
    Enum.map([1], fn x -> x)
    Enum.map([2], fn x -> x)
    """

    issues = analyze(code)
    assert length(issues) == 2
    assert Enum.all?(issues, &(&1.rule == :no_unclosed_fn_delimiter))
  end

  test "leaves fn...end alone" do
    assert analyze("Enum.map([1, 2], fn x -> x + 1 end)") == []
  end

  test "leaves fn...end ) alone (end before paren)" do
    assert analyze("Enum.map([1, 2], fn x -> x + 1 end) |> IO.puts()") == []
  end

  test "leaves code without fn alone" do
    assert analyze("Enum.map([1, 2], &(&1 + 1))") == []
  end

  test "leaves fn without -> alone" do
    assert analyze("foo(fn)") == []
  end

  test "leaves line with fn in a non-matching position" do
    assert analyze("x = :fn") == []
  end
end

