    content: defmodule Credence.Syntax.NoUnclosedFnDelimiter do
  @moduledoc """
  Detects and fixes `fn` blocks closed with `)` instead of `end)`.

  LLMs repeatedly write `fn (args) -> body)` (close paren instead of `end`),
  causing `MismatchedDelimiterError`. The fix inserts the missing `end` keyword
  before the closing `)`.

  ## Bad (won't parse — MismatchedDelimiterError)

      list |> Enum.map(fn x -> x + 1)

  ## Good

      list |> Enum.map(fn x -> x + 1 end)
  """
  use Credence.Syntax.Rule
  alias Credence.Issue

  @impl true
  def analyze(source) do
    source
    |> String.split("\n")
    |> Enum.with_index(1)
    |> Enum.flat_map(fn {line, line_no} ->
      if unclosed_fn_delimiter?(line) do
        [
          %Issue{
            rule: :no_unclosed_fn_delimiter,
            message:
              "Unclosed `fn` block — missing `end` before `)`. " <>
                "Use `fn ... end)` instead of `fn ... )`.",
            meta: %{line: line_no}
          }
        ]
      else
        []
      end
    end)
  end

  @impl true
  def fix(source) do
    source
    |> String.split("\n")
    |> Enum.map_join("\n", &fix_line/1)
  end

  # A line has an unclosed fn delimiter when:
  #   1. It contains the `fn` keyword
  #   2. It contains `->` (the fn's arrow)
  #   3. It ends with `)`
  #   4. That `)` is NOT already preceded by `end`
  defp unclosed_fn_delimiter?(line) do
    Regex.match?(~r/\bfn\b/, line) and
      Regex.match?(~r/->/, line) and
      Regex.match?(~r/\)\s*$/, line) and
      not Regex.match?(~r/\bend\s*\)\s*$/, line)
  end

  defp fix_line(line) do
    if unclosed_fn_delimiter?(line) do
      Regex.replace(~r/\)\s*$/, line, "end)")
    else
      line
    end
  end
end

