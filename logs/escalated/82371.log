defmodule Solution do
  @moduledoc """
  Determines if the digits of a positive integer can be rearranged to form a power of two.
  """

  @doc """
  Returns true if the digits of `n` can be rearranged to form a power of two.
  """
  @spec rearranged_power_of_two?(pos_integer()) :: boolean()
  def rearranged_power_of_two?(n) when n > 0 do
    digits = extract_digits(n)
    sorted_digits = digits |> Enum.sort() |> Integer.to_list()
    power_of_two_sorted = @powers_of_two |> Enum.filter(fn p ->
      extract_digits(p) |> Enum.sort() |> Integer.to_list() == sorted_digits
    end) |> Enum.any?

    power_of_two_sorted
  end

  defp extract_digits(n) do
    n
    |> Integer.digits()
  end

  @powers_of_two = Enum.map(0..29, fn k ->
    :math.pow(2, k) |> round()
  end)
end
