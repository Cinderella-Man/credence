---REFERENCE---
defmodule Solution do
  @limit 1_000_000_000

  @powers_of_two_frequencies 1
                              |> Stream.iterate(&(&1 * 2))
                              |> Enum.take_while(&(&1 <= @limit))
                              |> Enum.map(fn n ->
                                n
                                |> Integer.to_string()
                                |> String.graphemes()
                                |> Enum.frequencies()
                              end)

  def rearranged_power_of_two?(n) when is_integer(n) and n > 0 do
    n_freq =
      n
      |> Integer.to_string()
      |> String.graphemes()
      |> Enum.frequencies()

    Enum.member?(@powers_of_two_frequencies, n_freq)
  end

  def rearranged_power_of_two?(_), do: false
end
