[22m06:20:05.357 [info] [ClaudeCode] step 35: Write
    content: defmodule Credence.Semantic.NoDefmoduleWithFunctionSig do
  @moduledoc """
  Matches compiler diagnostics caused by LLMs confusing `defmodule` with `def`
  when generating function definitions.

  When an LLM generates `defmodule function_name(args) do` instead of
  `def function_name(args) do`, the compiler reports a "token missing" /
  "missing terminator: end" error because the inner `defmodule` creates a
  malformed nested module structure.

  The fix replaces `defmodule` with `def` on lines where the keyword is
  followed by an identifier with parenthesized arguments (a function
  signature), leaving legitimate `defmodule` declarations untouched.
  """
  use Credence.Semantic.Rule

  alias Credence.Issue

  @impl true
  def match?(%{message: msg}) when is_binary(msg) do
    String.contains?(msg, "token missing") and
      String.contains?(msg, "missing terminator")
  end

  def match?(_), do: false

  @impl true
  def to_issue(diagnostic) do
    %Issue{
      rule: :no_defmodule_with_function_sig,
      message: "defmodule used instead of def for function definition",
      meta: %{line: line(diagnostic)}
    }
  end

  @impl true
  def fix(source, _diagnostic) do
    source
    |> String.split("\n")
    |> Enum.map(fn line ->
      Regex.replace(~r/\bdefmodule\b(?=\s+\w+\s*\()/, line, "def")
    end)
    |> Enum.join("\n")
  end

  defp line(%{position: {line, _col}}), do: line
  defp line(%{position: line}) when is_integer(line), do: line
end

