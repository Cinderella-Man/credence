defmodule Solution do
  @directions [{-1, 0}, {1, 0}, {0, -1}, {0, 1}]

  def shortest_bridge(grid) do
    rows = length(grid)
    cols = length(hd(grid))
    island = find_first_island(grid, rows, cols)
    bfs(grid, MapSet.to_list(island), island, rows, cols, 0)
  end

  defp find_first_island(grid, rows, cols) do
    Enum.reduce_while(0..(rows-1), nil, fn row, _acc ->
      Enum.reduce_while(0..(cols-1), nil, fn col, _acc ->
        if (grid |> Enum.at(row) |> Enum.at(col)) == 1 do
          {:halt, {row, col}}
        else
          {:cont, nil}
        end
      end)
      |> case do
        nil -> {:cont, nil}
        coord -> {:halt, coord}
      end
    end)
    |> case do
      nil -> MapSet.new()
      coord -> dfs(grid, coord, rows, cols)
    end
  end

  defp dfs(grid, start, rows, cols) do
    stack = [start]
    visited = MapSet.new()
    dfs_loop(stack, grid, visited, rows, cols)
  end

  defp dfs_loop([], _grid, visited, _rows, _cols), do: visited
  defp dfs_loop([{row, col} | rest], grid, visited, rows, cols) do
    if row < 0 or row >= rows or col < 0 or col >= cols or
       (grid |> Enum.at(row) |> Enum.at(col)) == 0 or
       MapSet.member?(visited, {row, col}) do
      dfs_loop(rest, grid, visited, rows, cols)
    else
      visited = MapSet.put(visited, {row, col})
      neighbors = [{row-1, col}, {row+1, col}, {row, col-1}, {row, col+1}]
      dfs_loop(neighbors ++ rest, grid, visited, rows, cols)
    end
  end

  defp bfs(_grid, [], _visited, _rows, _cols, _distance), do: :error
  defp bfs(grid, queue, visited, rows, cols, distance) do
    {next_queue, visited, found} = process_level(queue, grid, visited, rows, cols)
    if found do
      distance
    else
      bfs(grid, next_queue, visited, rows, cols, distance+1)
    end
  end

  defp process_level([], _grid, visited, _rows, _cols), do: {[], visited, false}
  defp process_level([{row, col} | rest], grid, visited, rows, cols) do
    {acc_queue, acc_visited, found} = process_neighbors(row, col, grid, visited, rows, cols)
    if found do
      {acc_queue, acc_visited, true}
    else
      {rest_queue, rest_visited, rest_found} = process_level(rest, grid, acc_visited, rows, cols)
      {acc_queue ++ rest_queue, rest_visited, rest_found}
    end
  end

  defp process_neighbors(row, col, grid, visited, rows, cols) do
    Enum.reduce(@directions, {[], visited, false}, fn {dr, dc}, {acc_queue, acc_visited, found} ->
      if found do
        {acc_queue, acc_visited, true}
      else
        nr = row + dr
        nc = col + dc
        if nr >= 0 and nr < rows and nc >= 0 and nc < cols and not MapSet.member?(acc_visited, {nr, nc}) do
          acc_visited = MapSet.put(acc_visited, {nr, nc})
          if (grid |> Enum.at(nr) |> Enum.at(nc)) == 1 do
            {acc_queue, acc_visited, true}
          else
            {[{nr, nc} | acc_queue], acc_visited, false}
          end
        else
          {acc_queue, acc_visited, false}
        end
      end
    end)
  end
end

