@doc """
Counts how many times a given character (string of length 1) appears in a string.
The count is case-sensitive.
"""
@spec count_char_case_sensitive(String.t(), String.t()) :: non_neg_integer()
def count_char_case_sensitive(str, char)

def count_char_case_sensitive(_str, ""), do: 0
def count_char_case_sensitive(_str, char) when byte_size(char) != 1, do: 0
def count_char_case_sensitive(str, char) do
  str
  |> String.codepoints()
  |> Enum.count(&(&1 == char))
end
