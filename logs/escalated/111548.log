---INSTRUCTION---
Write a function `count_char_case_sensitive/2` that takes two arguments: a string and a character (a string of length 1). The function returns the count of how many times the given character appears in the string. The count is case-sensitive. If the character is an empty string, the function returns 0. If the character is longer than 1, the function returns 0. The function should handle empty strings by returning 0.
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "counts uppercase H" do
    assert Solution.count_char_case_sensitive("Hello World", "H") == 1
  end

  test "counts lowercase l" do
    assert Solution.count_char_case_sensitive("Hello World", "l") == 3
  end

  test "counts case-sensitive (no match for lowercase h)" do
    assert Solution.count_char_case_sensitive("Hello World", "h") == 0
  end
end
---REFERENCE---
defmodule Solution do
  @spec count_char_case_sensitive(String.t(), String.t()) :: non_neg_integer()
  def count_char_case_sensitive(text, char) do
    cond do
      String.length(char) != 1 -> 0
      text == "" -> 0
      true ->
        text
        |> String.graphemes()
        |> Enum.count(fn grapheme -> grapheme == char end)
    end
  end
end
---END---[0m
