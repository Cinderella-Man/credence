---INSTRUCTION---
Write a function `pascal_triangle_row/1` that takes a non-negative integer `n` and returns the n-th row of Pascal's Triangle as a list. The 0th row is `[1]`. For n > 0, each row has n+1 elements, with the first and last being 1, and each interior element being the sum of the two elements above it from the previous row. The function must handle n=0 and return `[1]`.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "pascal_triangle_row(0)" do
    assert Solution.pascal_triangle_row(0) == [1]
  end

  test "pascal_triangle_row(1)" do
    assert Solution.pascal_triangle_row(1) == [1, 1]
  end

  test "pascal_triangle_row(2)" do
    assert Solution.pascal_triangle_row(2) == [1, 2, 1]
  end

  test "pascal_triangle_row(3)" do
    assert Solution.pascal_triangle_row(3) == [1, 3, 3, 1]
  end

  test "pascal_triangle_row(4)" do
    assert Solution.pascal_triangle_row(4) == [1, 4, 6, 4, 1]
  end

  test "pascal_triangle_row(5)" do
    assert Solution.pascal_triangle_row(5) == [1, 5, 10, 10, 5, 1]
  end
end

---REFERENCE---
defmodule Solution do
  def pascal_triangle_row(0), do: [1]

  def pascal_triangle_row(n) when n > 0 do
    prev_row = pascal_triangle_row(n - 1)
    interior =
      prev_row
      |> Enum.chunk_every(2, 1)
      |> Enum.map(fn [a, b] -> a + b end)

    [1 | interior] ++ [1]
  end
end

