assert pascal_triangle_row(1) == [1, 1]
assert pascal_triangle_row(4) == [1, 4, 6, 4, 1]
assert pascal_triangle_row(3) == [1, 3, 3, 1]
assert pascal_triangle_row(5) == [1, 5, 10, 10, 5, 1]

