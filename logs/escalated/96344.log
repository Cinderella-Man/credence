defmodule Solution do
  @doc """
  Finds the first equilibrium index in a list of integers.
  An equilibrium index is where the sum of elements at lower indexes
  equals the sum of elements at higher indexes.
  """
  @spec find_equilibrium_index(list(integer())) :: integer()
  def find_equilibrium_index([]), do: -1

  def find_equilibrium_index([_ | _] = nums) do
    total = Enum.sum(nums)
    find_equilibrium_index(nums, total, 0)
  end

  defp find_equilibrium_index([], _total, _left_sum), do: -1

  defp find_equilibrium_index([_ | _] = nums, _total, left_sum) do
    {left_sum, right_sum, idx} =
      Enum.reduce_while(
        nums,
        {0, _total, 0},
        fn
          val, {acc_left, acc_total, i} when acc_left == acc_total - acc_left - val ->
            :halt({acc_left, acc_total, i})

          val, {acc_left, acc_total, i} when acc_left != acc_total - acc_left - val ->
            :cont({acc_left + val, acc_total, i + 1})
        end
      )

    case idx do
      nil -> -1
      _ -> idx
    end
  end
end
