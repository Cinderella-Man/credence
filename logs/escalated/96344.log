defmodule Solution do
  @doc """
  Finds the first equilibrium index in a list of integers.
  An equilibrium index is where the sum of elements at lower indexes
  equals the sum of elements at higher indexes.
  """
  @spec find_equilibrium_index(list(integer())) :: integer()
  def find_equilibrium_index([]), do: -1

  def find_equilibrium_index([_ | _] = nums) do
    total = Enum.sum(nums)
    do_find_equilibrium_index(nums, total, 0, 0)
  end

  defp do_find_equilibrium_index([], _total, _left_sum, _index), do: -1

  defp do_find_equilibrium_index([head | tail], total, left_sum, index) do
    right_sum = total - left_sum - head

    if left_sum == right_sum do
      index
    else
      do_find_equilibrium_index(tail, total, left_sum + head, index + 1)
    end
  end
end
---TEST---
