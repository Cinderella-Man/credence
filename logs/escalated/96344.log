  end

  test "find_equilibrium_index of [1,100,50,-51,1,1] is 1" do
    assert Solution.find_equilibrium_index([1,100,50,-51,1,1]) == 1
  end

  test "find_equilibrium_index of [20,10,-80,10,10,15,35] is 0" do
    assert Solution.find_equilibrium_index([20,10,-80,10,10,15,35]) == 0
  end

  test "find_equilibrium_index of empty list returns -1" do
    assert Solution.find_equilibrium_index([]) == -1
  end

  test "find_equilibrium_index of [1,2,3] returns -1" do
    assert Solution.find_equilibrium_index([1,2,3]) == -1
  end
end
