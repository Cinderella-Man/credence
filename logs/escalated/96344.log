defmodule Solution do
  @doc """
  Finds the equilibrium index of a list.
  Returns the first index where the sum of elements before it equals the sum after it, or -1 if none.
  """
  def find_equilibrium_index(list) do
    total = Enum.sum(list)
    find_eq_index(list, 0, 0, total)
  end

  defp find_eq_index([], _index, _left_sum, _total_sum), do: -1
  defp find_eq_index([head | tail], index, left_sum, total_sum) do
    right_sum = total_sum - head
    if left_sum == right_sum do
      index
    else
      find_eq_index(tail, index + 1, left_sum + head, right_sum)
    end
  end
end
