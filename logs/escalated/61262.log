defmodule Solution do
  @spec add_binary_strings(String.t(), String.t()) :: String.t()
  def add_binary_strings(num1, num2) do
    list1 = num1 |> String.graphemes() |> Enum.map(&String.to_integer/1) |> Enum.reverse()
    list2 = num2 |> String.graphemes() |> Enum.map(&String.to_integer/1) |> Enum.reverse()

    do_add(list1, list2, 0, [])
    |> Enum.join()
  end

  defp do_add([], [], 0, acc), do: acc
  defp do_add([], [], carry, acc), do: [carry | acc]
  defp do_add([], [h2 | t2], carry, acc) do
    sum = h2 + carry
    {new_carry, digit} = {div(sum, 2), rem(sum, 2)}
    do_add([], t2, new_carry, [digit | acc])
  end
  defp do_add([h1 | t1], [], carry, acc) do
    sum = h1 + carry
    {new_carry, digit} = {div(sum, 2), rem(sum, 2)}
    do_add(t1, [], new_carry, [digit | acc])
  end
  defp do_add([h1 | t1], [h2 | t2], carry, acc) do
    sum = h1 + h2 + carry
    {new_carry, digit} = {div(sum, 2), rem(sum, 2)}
    do_add(t1, t2, new_carry, [digit | acc])
  end
end

