  import Credence.RuleCase, only: [valid_syntax?: 1]

  alias Credence.Semantic.PreferSigilCharlist

  @message "using single-quoted strings to represent charlists is deprecated."

  defp fix(source, message \\ @message, line \\ 1) do
    PreferSigilCharlist.fix(source, %{severity: :warning, message: message, position: {line, 1}})
  end

  test "replaces a single charlist literal with sigil_c" do
    input = """
    defmodule Solution do
      @spec charlist_example :: [charlist]
      def charlist_example do
        ['1']
      end
    end
    """

    expected = """
    defmodule Solution do
      @spec charlist_example :: [charlist]
      def charlist_example do
        [~c"1"]
      end
    end
    """

    assert fix(input) == expected
  end

  test "handles multiple charlists on the same line" do
    input = "['a', 'b', 'c']"
    expected = "[~c\"a\", ~c\"b\", ~c\"c\"]"
    assert fix(input) == expected
  end

  test "handles empty charlist" do
    input = "['']"
    expected = "[~c\"\"]"
    assert fix(input) == expected
  end

  test "handles charlist with escaped single quote" do
    input = ~s|['don\\'t']|
    expected = ~s|[~c"don't"]|
    assert fix(input) == expected
  end

  test "handles charlist with escaped backslash" do
    input = ~s|['\\\\']|
    expected = ~s|[~c"\\\\"]|
    assert fix(input) == expected
  end

  test "handles Unicode charlist" do
    input = "['é']"
    expected = "[~c\"é\"]"
    assert fix(input) == expected
  end

  test "handles multi-line source with charlists on multiple lines" do
    input = """
    defmodule Example do
      def greeting do
        ['H', 'i']
      end

      def farewell do
        ['B', 'y', 'e']
      end
    end
    """

    expected = """
    defmodule Example do
      def greeting do
        [~c"H", ~c"i"]
      end

      def farewell do
        [~c"B", ~c"y", ~c"e"]
      end
    end
    """

    assert fix(input) == expected
  end

  test "returns source unchanged when no charlist literals present" do
    input = """
    defmodule Clean do
      def hello, do: :ok
    end
    """

    assert fix(input) == input
  end

  test "fixed output is well-formed (parses)" do
    input = """
    defmodule Solution do
      @spec charlist_example :: [charlist]
      def charlist_example do
        ['1']
      end
    end
    """

    assert valid_syntax?(fix(input))
  end
end

