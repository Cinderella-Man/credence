    content: # Test the fix function with full source examples
defmodule TestFix do
  @regex ~r/'((?:[^'\\]|\\.)*)'/

  def fix(source) do
    Regex.replace(@regex, source, fn _match, content ->
      # Step 1: Convert single-quote escapes to placeholder
      converted = content
      |> String.replace("\\'", "__SINGLE_QUOTE__")
      
      # Step 2: Escape double quotes that aren't already escaped
      converted = converted
      |> String.replace("\\\"", "__ALREADY_ESCAPED__")
      |> String.replace("\"", "\\\"")
      |> String.replace("__ALREADY_ESCAPED__", "\\\"")
      
      # Step 3: Restore single quotes
      converted = String.replace(converted, "__SINGLE_QUOTE__", "'")
      
      "~c\"#{converted}\""
    end)
  end
end

# Test with full module source
input = """
defmodule Solution do
  @spec charlist_example :: [charlist]
  def charlist_example do
    ['1']
  end
end
"""

expected = """
defmodule Solution do
  @spec charlist_example :: [charlist]
  def charlist_example do
    [~c"1"]
  end
end
"""

result = TestFix.fix(input)
IO.puts("Match: #{result == expected}")
if result != expected do
  IO.puts("Expected:\n#{expected}")
  IO.puts("Got:\n#{result}")
end

# Test with multiple charlists
input2 = "['a', 'b']"
expected2 = "[~c\"a\", ~c\"b\"]"
result2 = TestFix.fix(input2)
IO.puts("Multi: #{result2 == expected2}")

# Test with empty charlist
input3 = "['']"
expected3 = "[~c\"\"]"
result3 = TestFix.fix(input3)
IO.puts("Empty: #{result3 == expected3}")

# Test with escaped single quote
input4 = ~s|['don\\'t']|
expected4 = ~s|[~c"don't"]|
result4 = TestFix.fix(input4)
IO.puts("Escaped single: #{result4 == expected4}")

# Test with escaped backslash
input5 = ~s|['\\\\']|
expected5 = ~s|[~c"\\\\"]|
result5 = TestFix.fix(input5)
IO.puts("Escaped backslash: #{result5 == expected5}")

# Test with escaped double quote
input6 = ~s|['\\"']|
expected6 = ~s|[~c"\\""]|
result6 = TestFix.fix(input6)
IO.puts("Escaped double: #{result6 == expected6}")
if result6 != expected6 do
  IO.puts("  input: #{inspect(input6)}")
  IO.puts("  expected: #{inspect(expected6)}")
  IO.puts("  got: #{inspect(result6)}")
end

# Test with double quote in charlist (not escaped)
input7 = "[~c\"\\\"\"]"  # This is the result, not input
# Let me test: a charlist containing a double quote
input7_raw = "[']"  # This won't work
# Actually, you can't have a bare " in a single-quoted string
# because the string is delimited by '
# The only way to have " in a charlist is as-is: ['"'] but that's ['"']
# which the regex would capture as content '"'

# Test regex matching
regex = ~r/'((?:[^'\\]|\\.)*)'/
test_match = ~s|['"']|  # charlist containing double quote
case Regex.run(regex, test_match) do
  [match, capture] ->
    IO.puts("Match: #{inspect(match)}, Capture: #{inspect(capture)}")
  _ ->
    IO.puts("No match")
end

# Verify output syntax
IO.puts("\nVerifying output syntax...")
input8 = """
defmodule TestSigil do
  def hello do
    ['1']
  end
end
"""
output = TestFix.fix(input8)
case Code.string_to_quoted(output) do
  {:ok, _} -> IO.puts("✓ Output is valid Elixir syntax")
  {:error, {line, error, token}} -> IO.puts("✗ Syntax error at line #{line}: #{error} #{token}")
end

IO.puts("\nOutput:\n#{output}")

