defmodule VerifyFix do
  @regex ~r/'"'"'((?:[^'"'"'\\\\]|\\\\.)*)'"'"'/

  def fix(source) do
    Regex.replace(@regex, source, fn _match, content ->
      converted = content
      |> String.replace("\\'"'"'", "__SINGLE_QUOTE__")
      converted = converted
      |> String.replace("\\\\\"", "__ALREADY_ESCAPED__")
      |> String.replace("\"", "\\\\\"")
      |> String.replace("__ALREADY_ESCAPED__", "\\\\\"")
      converted = String.replace(converted, "__SINGLE_QUOTE__", "'"'"'")
      "~c\"" <> converted <> "\""
    end)
  end
end

input = """
defmodule Solution do
  @spec charlist_example :: [charlist]
  def charlist_example do
    ['1']
  end
end
"""

output = VerifyFix.fix(input)
