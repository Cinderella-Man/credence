    content: # Test the fix function with full source examples
defmodule TestFix do
  @regex ~r/'((?:[^'\\]|\\.)*)'/

  def fix(source) do
    Regex.replace(@regex, source, fn _match, content ->
      # Step 1: Convert single-quote escapes to placeholder
      converted = content
      |> String.replace("\\'", "__SINGLE_QUOTE__")
      
      # Step 2: Escape double quotes that aren't already escaped
      # We need to handle \\" (escaped backslash followed by quote)
      # First, protect already-escaped quotes
      converted = converted
      |> String.replace("\\\"", "__ALREADY_ESCAPED__")
      |> String.replace("\"", "\\\"")
      |> String.replace("__ALREADY_ESCAPED__", "\\\"")
      
      # Step 3: Restore single quotes
      converted = String.replace(converted, "__SINGLE_QUOTE__", "'")
      
      "~c\"#{converted}\""
    end)
  end
end

# Test cases
test_cases = [
  # Basic
  {"['1']", "[~c\"1\"]"},
  {"['hello']", "[~c\"hello\"]"},
  # Empty
  {"['']", "[~c\"\"]"},
  # Escaped single quote
  {"['don\\'t']", "[~c\"don't\"]"},
  # Escaped backslash
  {"['\\\\']", "[~c\"\\\\\"]"},
  # Double quote in charlist
  {'["' <> ~s("]') <> "]", "[~c\"\\\"\"]"},
  # Escaped double quote
  {"['\\\"']", "[~c\"\\\"\"]"},
  # Multiple charlists
  {"['a', 'b']", "[~c\"a\", ~c\"b\"]"},
  # Unicode
  {"['é']", "[~c\"é\"]"},
  # Full module
  {"""
  defmodule Solution do
    @spec charlist_example :: [charlist]
    def charlist_example do
      ['1']
    end
  end
  """,
  """
  defmodule Solution do
    @spec charlist_example :: [charlist]
    def charlist_example do
      [~c"1"]
    end
  end
  """},
]

Enum.each(test_cases, fn {input, expected} ->
  result = TestFix.fix(input)
  status = if result == expected, do: "✓", else: "✗"
  if status == "✗" do
    IO.puts("#{status} FAILED")
    IO.puts("  input:    #{inspect(input)}")
    IO.puts("  result:   #{inspect(result)}")
    IO.puts("  expected: #{inspect(expected)}")
  else
    IO.puts("#{status} #{String.trim(input) |> String.slice(0, 50)}")
  end
end)

