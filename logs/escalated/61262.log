defmodule Solution do
  @doc """
  Adds two binary numbers represented as strings.
  """
  @spec add_binary_strings(binary_string :: String.t(), binary_string :: String.t()) :: String.t()
  def add_binary_strings(binary_string_a, binary_string_b) do
    char_a = to_charlist(binary_string_a)
    char_b = to_charlist(binary_string_b)
    {result, _carry} = add_bits(char_a, char_b, 0)
    result_string = to_string(result)

    if result_string == "" do
      "0"
    else
      result_string
    end
  end

  defp add_bits([], [], 0) do
    {[], 0}
  end

  defp add_bits([], [], 1) do
    {['1'], 0}
  end

  defp add_bits([], [char_b | rest_b], carry) do
    bit_b = char_b - ?0
    sum = bit_b + carry
    new_bit = rem(sum, 2) + ?0
    new_carry = div(sum, 2)
    {result, _} = add_bits([], rest_b, new_carry)
    {[new_bit | result], new_carry}
  end

  defp add_bits([char_a | rest_a], [], carry) do
    bit_a = char_a - ?0
    sum = bit_a + carry
    new_bit = rem(sum, 2) + ?0
    new_carry = div(sum, 2)
    {result, _} = add_bits(rest_a, [], new_carry)
    {[new_bit | result], new_carry}
  end

  defp add_bits([char_a | rest_a], [char_b | rest_b], carry) do
    bit_a = char_a - ?0
    bit_b = char_b - ?0
    sum = bit_a + bit_b + carry
    new_bit = rem(sum, 2) + ?0
    new_carry = div(sum, 2)
    {result, _} = add_bits(rest_a, rest_b, new_carry)
    {[new_bit | result], new_carry}
  end
end
