]

regex = ~r/'((?:[^'\\]|\\.)*)'/

Enum.each(test_cases, fn {input, expected} ->
  result = Regex.replace(regex, input, fn _match, content ->
    # Convert single-quote escapes to bare chars, then escape for double-quoted
    converted = content
    |> String.replace("\\'", "'")
    
    # Escape double quotes that aren't already escaped
    converted = Regex.replace(~r/(?<!\\)"/, converted, "\\\"")
    
    "~c\"#{converted}\""
  end)
  
  status = if result == expected, do: "✓", else: "✗"
  IO.puts("#{status} #{inspect(input)} => #{inspect(result)} (expected: #{inspect(expected)})")
end)

