# Verify the values are the same
IO.puts("\n=== Value comparison ===")
Code.compile_string(input)
IO.puts("Original: #{inspect(Solution.charlist_example())}")
Code.compile_string(output)
IO.puts("Fixed:    #{inspect(Solution.charlist_example())}")
