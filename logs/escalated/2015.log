defmodule Solution do
  @doc """
  Finds the extra integer in the longer list by sorting both lists
  and comparing them element by element.
  """
  @spec solution(list(integer()), list(integer())) :: integer()
  def solution(long_list, short_list)

  def solution(long_list, short_list) when length(long_list) == length(short_list) + 1 do
    sorted_long = Enum.sort(long_list)
    sorted_short = Enum.sort(short_list)
    find_extra(sorted_long, sorted_short)
  end

  def solution(short_list, long_list) when length(long_list) == length(short_list) + 1 do
    sorted_long = Enum.sort(long_list)
    sorted_short = Enum.sort(short_list)
    find_extra(sorted_long, sorted_short)
  end

  defp find_extra([], _short), do: nil

  defp find_extra(long, []) do
    # The extra element is the first element of the long list
    hd(long)
  end

  defp find_extra([h_long | t_long], [h_short | t_short]) do
    if h_long == h_short do
      find_extra(t_long, t_short)
    else
      h_long
    end
  end

  defp find_extra([extra | _], []) do
    extra
  end
end
