---REFERENCE---
defmodule Solution do
  def max_unique_concat(arr) do
    n = length(arr)
    Enum.reduce(1..(2 ** n - 1), 0, fn bitmask, max_len ->
      {strs, _} =
        Enum.reduce(arr, {[], 0}, fn s, {acc, i} ->
          if Bitwise.band(Bitwise.bsr(bitmask, i), 1) == 1 do
            {[s | acc], i + 1}
          else
            {acc, i + 1}
          end
        end)
      concat = Enum.join(Enum.reverse(strs))
      if length(String.to_charlist(concat)) == length(Enum.uniq(String.to_charlist(concat))) do
        max(max_len, String.length(concat))
      else
        max_len
      end
    end)
  end
end

