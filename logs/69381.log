defmodule Solution do
  @doc """
  Finds the minimum number of coins required to make a given amount using given coin denominations.

  ## Parameters
    - coins: A list of integers representing the coin denominations.
    - amount: An integer representing the target amount.

  ## Returns
    - The minimum number of coins needed, or -1 if it is not possible to make the amount.
  """
  @spec minimumcoins(non_neg_integer, list(non_neg_integer)) :: non_neg_integer
  def minimumcoins(coins, amount) when is_list(coins) and is_integer(amount) do
    minimumcoins_helper(amount, Enum.sort(coins))
  end

  defp minimumcoins_helper(0, _coins) do
    0
  end

  defp minimumcoins_helper(amount, coins) when amount > 0 do
    max_val = amount + 1
    dp = for _ <- 0..amount, into: %{}, do: {_, max_val}
    dp = Map.put(dp, 0, 0)

    {_, result} =
      Enum.reduce(coins, {dp, max_val}, fn coin, {dp_acc, _max_val} ->
        Enum.reduce(coin..amount, {dp_acc, max_val}, fn current_amount, {dp_inner, max_val_inner} ->
          prev_amount = current_amount - coin
          prev_count = Map.get(dp_inner, prev_amount, max_val)
          new_count = prev_count + 1

          if new_count < Map.get(dp_inner, current_amount, max_val_inner) do
            dp_inner = Map.put(dp_inner, current_amount, new_count)
            {dp_inner, max_val_inner}
          else
            {dp_inner, max_val_inner}
          end
        end)
      end)

    final_count = Map.get(dp, amount, max_val)
    if final_count > amount do
      -1
    else
      final_count
    end
  end
end
