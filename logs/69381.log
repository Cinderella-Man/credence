@spec minimumcoins(non_neg_integer, list(non_neg_integer)) :: non_neg_integer
def minimumcoins(coins, amount) when is_list(coins) and is_integer(amount) do
  minimumcoins_helper(amount, Enum.uniq(coins))
end

defp minimumcoins_helper(amount, coins) when amount == 0 do
  0
end

defp minimumcoins_helper(amount, coins) when amount > 0 do
  max_val = amount + 1
  dp = for _ <- 0..amount, into: %{}, do: {_key, max_val}
  dp = Map.put(dp, 0, 0)

  {dp_final, _} =
    Enum.reduce(coins, {dp, max_val}, fn coin, {dp_acc, _max_val} ->
      Enum.reduce(coin..amount, {dp_acc, max_val}, fn current_amount, {dp_inner, max_val_inner} ->
        prev_amount = current_amount - coin
        prev_count = Map.get(dp_inner, prev_amount, max_val_inner)
        new_count = prev_count + 1

        if new_count < Map.get(dp_inner, current_amount, max_val_inner) do
          dp_inner = Map.put(dp_inner, current_amount, new_count)
          {dp_inner, max_val_inner}
        else
          {dp_inner, max_val_inner}
        end
      end)
    end)

  final_count = Map.get(dp_final, amount, max_val)
  if final_count > amount do
    -1
  else
    final_count
  end
end
