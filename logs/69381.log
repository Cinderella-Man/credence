  end
end
---REFERENCE---
defmodule Solution do
  def minimumcoins(coins, amount) do
    dp = for i <- 0..amount, into: %{} do
      if i == 0, do: {0, 0}, else: {i, amount + 1}
    end

    Enum.reduce(coins, dp, fn coin, acc ->
      Enum.reduce(coin..amount, acc, fn x, inner_acc ->
        new_val = min(Map.get(inner_acc, x), Map.get(inner_acc, x - coin) + 1)
        Map.put(inner_acc, x, new_val)
      end)
    end)
    |> then(fn dp_map ->
      val = Map.get(dp_map, amount)
      if val > amount, do: -1, else: val
    end)
  end
end
