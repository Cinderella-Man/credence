defmodule Solution do
  @mod 10007

  def count_domino_arrangements(0), do: 1
  def count_domino_arrangements(1), do: 1

  def count_domino_arrangements(n) do
    {result, _} =
      Enum.reduce(2..n, {1, 1}, fn _i, {prev1, prev2} ->
        {rem(prev1 + prev2, @mod), prev1}
      end)

    result
  end
end
