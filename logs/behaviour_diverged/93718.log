@moduledoc """
Counts the number of ways to tile a 2xn board with dominoes.

The number of ways to tile a 2xn board with dominoes follows the Fibonacci sequence:
- f(0) = 1
- f(1) = 1
- f(2) = 2
- f(n) = f(n-1) + f(n-2) for n >= 2

Returns the result modulo 10007.
Uses O(n) time and O(1) space by iterating iteratively.
"""
defmodule Solution do
  @doc """
  Counts the number of ways to tile a 2xn board with dominoes.

  ## Parameters
    - n: A non-negative integer representing the width of the board.

  ## Returns
    The number of distinct tilings modulo 10007.
  """
  @spec count_domino_arrangements(non_neg_integer()) :: non_neg_integer()
  def count_domino_arrangements(0), do: 1
  def count_domino_arrangements(1), do: 1

  def count_domino_arrangements(n) when is_integer(n) and n > 1 do
    do_count(n, 1, 1)
  end

  defp do_count(0, prev2, _prev1), do: rem(prev2, 10007)
  defp do_count(1, _prev2, prev1), do: rem(prev1, 10007)

  defp do_count(n, prev2, prev1) do
    current = rem(prev2 + prev1, 10007)
    do_count(n - 1, prev1, current)
  end
end
