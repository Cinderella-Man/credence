@doc """
Finds the largest integer that can be formed by rearranging the digits of the input.

## Examples

    iex> Solution.find_largestnum(13245)
    54321

    iex> Solution.find_largestnum(0)
    0

    iex> Solution.find_largestnum(5)
    5
"""
@spec find_largestnum(integer()) :: integer()
def find_largestnum(number) when is_integer(number) and number >= 0 do
  digits = number |> Integer.digits() |> Enum.reverse()
  digits_to_integer(digits)
end

defp digits_to_integer([]), do: 0

defp digits_to_integer([0 | _rest] = digits) do
  # If the largest digit is 0, all digits are 0
  hd(digits)
  |> case do
    0 -> 0
    _ -> _build_from_sorted(digits)
  end
end

defp digits_to_integer(digits), do: _build_from_sorted(digits)

defp _build_from_sorted(digits) do
  digits
  |> Enum.sort(:desc)
  |> Enum.reduce(0, fn digit, acc -> acc * 10 + digit end)
end
