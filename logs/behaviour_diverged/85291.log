defmodule Example do
  def digits_equal?(x) do
    sorted_codepoints = Integer.to_string(x) |> String.codepoints() |> Enum.sort()
    
    sorted_codepoints == (Integer.to_string(2 * x) |> String.codepoints() |> Enum.sort()) &&
    sorted_codepoints == (Integer.to_string(3 * x) |> String.codepoints() |> Enum.sort())
  end
end
===AFTER===
defmodule Example do
  def digits_equal?(x) do
    sorted_digits = Integer.digits(x) |> Enum.sort()
    
    sorted_digits == (Integer.digits(2 * x) |> Enum.sort()) &&
    sorted_digits == (Integer.digits(3 * x) |> Enum.sort())
  end
end
===ASSUMPTIONS===
===RATIONALE===
For comparing digit composition of non-negative integers, using Integer.digits/1 is more direct and idiomatic than converting to string and codepoints.
