defmodule Solution do
  @moduledoc """
  Find the smallest positive integer x such that 2x, 3x, 4x, 5x, and 6x
  contain the same digits in some order.
  """

  @doc """
  Returns the smallest positive integer with the property that 2x, 3x, 4x, 5x, and 6x
  are digit permutations of x. The argument `n` is ignored.
  """
  def smallest_equal_digit(_n) do
    find(1)
  end

  defp find(x) do
    digits = digit_set(x)
    if Enum.all?(2..6, fn m -> digit_set(x * m) == digits end) do
      x
    else
      find(x + 1)
    end
  end

  defp digit_set(n) do
    n
    |> Integer.digits()
    |> Enum.sort()
  end
end

