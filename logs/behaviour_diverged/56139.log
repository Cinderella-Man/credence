  test "first perfect number" do
    assert Solution.perfect_numbers(1) == [6]
  end

  test "first two perfect numbers" do
    assert Solution.perfect_numbers(2) == [6, 28]
  end

  test "first three perfect numbers" do
    assert Solution.perfect_numbers(3) == [6, 28, 496]
  end

  test "first four perfect numbers" do
    assert Solution.perfect_numbers(4) == [6, 28, 496, 8128]
  end

  test "zero perfect numbers" do
    assert Solution.perfect_numbers(0) == []
  end
end

---REFERENCE---
defmodule Solution do
  @spec perfect_numbers(non_neg_integer) :: [pos_integer]
  def perfect_numbers(n) do
    do_perfect_numbers(n, 2, [])
  end

  defp do_perfect_numbers(0, _candidate, acc), do: Enum.reverse(acc)
  defp do_perfect_numbers(n, candidate, acc) do
    if perfect?(candidate) do
      do_perfect_numbers(n - 1, candidate + 1, [candidate | acc])
    else
      do_perfect_numbers(n, candidate + 1, acc)
    end
  end

  defp perfect?(num) when num < 2, do: false
  defp perfect?(num) do
    limit = trunc(:math.sqrt(num))
    sum =
      Enum.reduce(2..limit, 1, fn i, acc ->
        if rem(num, i) == 0 do
          pair = div(num, i)
          if i == pair do
            acc + i
          else
            acc + i + pair
          end
        else
          acc
        end
      end)

    sum == num
  end
end

