---MODULE---
defmodule Solution do
  @moduledoc """
  Functions for working with perfect numbers.
  """

  @doc """
  Returns a list containing the first `n` perfect numbers, sorted in increasing order.

  ## Examples

      iex> Solution.perfect_numbers(1)
      [6]

      iex> Solution.perfect_numbers(2)
      [6, 28]

      iex> Solution.perfect_numbers(0)
      []
  """
  @spec perfect_numbers(non_neg_integer()) :: list(pos_integer())
  def perfect_numbers(0), do: []

  def perfect_numbers(n) when is_integer(n) and n > 0 do
    find_perfect_numbers(n, 6)
  end

  defp find_perfect_numbers(count, candidate) do
    result = collect_perfect_numbers(count, candidate, [])
    Enum.reverse(result)
  end

  defp collect_perfect_numbers(0, _candidate, acc), do: acc

  defp collect_perfect_numbers(remaining, candidate, acc) do
    if is_perfect?(candidate) do
      collect_perfect_numbers(remaining - 1, candidate + 1, [candidate | acc])
    else
      collect_perfect_numbers(remaining, candidate + 1, acc)
    end
  end

  defp is_perfect?(number) do
    sum = sum_of_proper_divisors(number)
    sum == number
  end

  defp sum_of_proper_divisors(number) do
    max_divisor = trunc(number / 2)
    if max_divisor == 0 do
      0
    else
      1..max_divisor
      |> Enum.filter(fn divisor -> rem(number, divisor) == 0 end)
      |> Enum.sum()
    end
  end
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "first perfect number" do
    assert Solution.perfect_numbers(1) == [6]
  end

  test "first two perfect numbers" do
    assert Solution.perfect_numbers(2) == [6, 28]
  end

  test "first three perfect numbers" do
    assert Solution.perfect_numbers(3) == [6, 28, 496]
  end

  test "first four perfect numbers" do
    assert Solution.perfect_numbers(4) == [6, 28, 496, 8128]
  end

  test "zero perfect numbers" do
    assert Solution.perfect_numbers(0) == []
  end
end
