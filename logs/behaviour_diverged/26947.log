  end

  test "element-wise addition with second list longer" do
    assert Solution.add_lists([1, 2], [4, 5, 6]) == [5, 7, 6]
  end

  test "element-wise addition with equal length lists" do
    assert Solution.add_lists([1, 2, 3], [4, 5, 6]) == [5, 7, 9]
  end
end
