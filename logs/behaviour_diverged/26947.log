defmodule Solution do
  @doc """
  Performs element-wise addition of two lists.

  If the lists are of unequal lengths, adds corresponding elements up to the
  length of the shorter list and then appends the remaining elements of the
  longer list to the result.
  """
  @spec add_lists(list(integer), list(integer)) :: list(integer)
  def add_lists(list1, list2) do
    {shorter, longer} = determine_lists(list1, list2)
    common_length = length(shorter)

    added = do_add(shorter, longer, common_length)
    remaining = drop_longer(longer, common_length)

    Enum.map(added, fn x -> x end) ++ remaining
  end

  @spec determine_lists(list(integer), list(integer)) :: {list(integer), list(integer)}
  defp determine_lists(list1, list2) do
    if length(list1) <= length(list2) do
      {list1, list2}
    else
      {list2, list1}
    end
  end

  @spec do_add(list(integer), list(integer), non_neg_integer) :: list(integer)
  defp do_add([], [], _remaining_length), do: []
  defp do_add([], _remainder, 0), do: []

  defp do_add([h1 | tail1], [h2 | tail2], remaining) when remaining > 0 do
    [h1 + h2 | do_add(tail1, tail2, remaining - 1)]
  end

  @spec drop_longer(list(integer), non_neg_integer) :: list(integer)
  defp drop_longer(list, 0), do: list

  defp drop_longer([_h | t], count) do
    drop_longer(t, count - 1)
  end
end
