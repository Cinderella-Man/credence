---MODULE---
defmodule Solution do
  @doc """
  Performs element-wise addition of two lists.

  If the lists are of unequal lengths, adds corresponding elements up to the
  length of the shorter list and then appends the remaining elements of the
  longer list to the result.
  """
  @spec add_lists(list(integer), list(integer)) :: list(integer)
  def add_lists(list1, list2) do
    {shorter, longer, same_len} = determine_lists(list1, list2)

    common_length = length(shorter)

    {added, remaining} = do_add(shorter, longer, common_length, [])

    Enum.reverse(added ++ remaining)
  end

  @spec determine_lists(list(integer), list(integer)) :: {list(integer), list(integer), integer}
  defp determine_lists(list1, list2) do
    len1 = length(list1)
    len2 = length(list2)

    if len1 <= len2 do
      {list1, list2, len1}
    else
      {list2, list1, len2}
    end
  end

  @spec do_add(list(integer), list(integer), non_neg_integer, list()) :: {list(), list()}
  defp do_add([], [], _remaining_length, acc), do: {acc, []}

  defp do_add([h1 | tail1], [h2 | tail2], remaining, acc) when remaining > 0 do
    do_add(tail1, tail2, remaining - 1, [h1 + h2 | acc])
  end

  defp do_add([], remaining_longer, _remaining_length, acc) do
    {acc, remaining_longer}
  end

  defp do_add([h1 | tail1], [], _remaining_length, acc) do
    {acc, [h1 | tail1]}
  end
end
