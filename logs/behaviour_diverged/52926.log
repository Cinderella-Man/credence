defmodule Solution do
  @doc """
  Converts a string of comma-separated values into a list of integers.
  Only segments that consist entirely of digit characters are converted.
  Non-numeric segments are ignored.
  """
  @spec convert_to_int_list(String.t()) :: [integer()]
  def convert_to_int_list(input_string) do
    input_string
    |> String.split(",")
    |> Enum.filter(&valid_integer_segment?/1)
    |> Enum.map(&String.to_integer/1)
  end

  defp valid_integer_segment?(segment) do
    segment =~ ~r/^\d+$/
  end
end
===AFTER===
defmodule Solution do
  @doc """
  Converts a string of comma-separated values into a list of integers.
  Only segments that consist entirely of digit characters are converted.
  Non-numeric segments are ignored.
  """
  @spec convert_to_int_list(String.t()) :: [integer()]
  def convert_to_int_list(input_string) do
    input_string
    |> String.split(",")
    |> Enum.flat_map(fn segment ->
      case Integer.parse(segment) do
        {int, ""} -> [int]
        _ -> []
      end
    end)
  end
end
