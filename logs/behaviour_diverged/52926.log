@moduledoc """
Solutions for converting comma-separated strings to lists of integers.
"""

defmodule Solution do
  @doc """
  Converts a string of comma-separated values into a list of integers.
  Only segments that consist entirely of digit characters are converted.
  Non-numeric segments are ignored.

  ## Examples

      iex> Solution.convert_to_int_list("10,20,30")
      [10, 20, 30]

      iex> Solution.convert_to_int_list("1,2,a,b,3")
      [1, 2, 3]

  """
  @spec convert_to_int_list(String.t()) :: [integer()]
  def convert_to_int_list(input_string) do
    input_string
    |> String.split(",")
    |> Enum.filter(&is_valid_integer_segment/1)
    |> Enum.map(&String.to_integer/1)
  end

  @doc false
  @spec is_valid_integer_segment(String.t()) :: boolean()
  defp is_valid_integer_segment(segment) do
    segment =~ ~r/^\d+$/
  end
end
---TEST---
