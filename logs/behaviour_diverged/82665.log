---MODULE---
@moduledoc """
Generates all possible n-digit binary numbers as strings.
"""

defmodule Solution do
  @doc """
  Returns a list of all possible n-digit binary numbers as strings.

  Each string has exactly n characters, using leading zeros when necessary.
  The order follows the recursive pattern of prepending "0" to all (n-1)-digit
  strings, then "1" to all (n-1)-digit strings.

  ## Examples

      iex> Solution.binary_numbers(1)
      ["0", "1"]

      iex> Solution.binary_numbers(2)
      ["00", "01", "10", "11"]
  """
  @spec binary_numbers(pos_integer()) :: [String.t()]
  def binary_numbers(n) when is_integer(n) and n >= 1 do
    generate(n)
  end

  # Base case: when n is 1, return the two single-digit binary strings.
  defp generate(1), do: ["0", "1"]

  # Recursive case: get all (n-1)-digit strings, then prepend "0" and "1".
  defp generate(n) do
    prev = generate(n - 1)

    # Prepend "0" to all previous strings, then "1" to all previous strings.
    # This naturally produces the correct order: 0... followed by 1...
    Enum.concat(
      Enum.map(prev, &"0" <> &1),
      Enum.map(prev, &"1" <> &1)
    )
  end
end
---TEST---
