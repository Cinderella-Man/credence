  use ExUnit.Case, async: false

  test "binary_numbers(1)" do
    assert Solution.binary_numbers(1) == ["0", "1"]
  end

  test "binary_numbers(3)" do
    assert Solution.binary_numbers(3) == ["000", "001", "010", "011", "100", "101", "110", "111"]
  end

  test "binary_numbers(2)" do
    assert Solution.binary_numbers(2) == ["00", "01", "10", "11"]
  end
end
