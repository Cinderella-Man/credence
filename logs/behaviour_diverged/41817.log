@doc """
Given a list of integers, returns the largest integer divisible by 3.
Returns nil if no such integer exists or the list is empty.
Traverses the list in a single pass.
"""
@spec find_largest_divisible_by_three([integer()]) :: integer() | nil
def find_largest_divisible_by_three(numbers) do
  case Enum.find(numbers, &rem(&1, 3) == 0) do
    nil ->
      nil
    _ ->
      numbers
      |> Enum.filter(fn num -> rem(num, 3) == 0 end)
      |> Enum.max()
  end
end
