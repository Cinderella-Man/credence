---MODULE---
defmodule Solution do
  @doc """
  Determines the minimum eating speed (bananas per hour) required to finish
  all banana piles within the given number of hours.
  """
  @spec minimum_eating_speed(non_neg_integer(), pos_integer()) :: non_neg_integer()
  def minimum_eating_speed(piles, h) when is_list(piles) and is_integer(h) do
    if Enum.empty?(piles) do
      0
    else
      max_pile = Enum.max(piles)
      low = 1
      high = max_pile

      low
      |> find_minimum_speed(piles, h, high)
      |> ensure_at_least_one(piles)
    end
  end

  @spec find_minimum_speed(non_neg_integer(), list(non_neg_integer()), pos_integer(), non_neg_integer()) ::
          non_neg_integer()
  defp find_minimum_speed(low, _piles, _h, high) when low == high do
    low
  end

  defp find_minimum_speed(low, piles, h, high) do
    mid = div(low + high, 2)

    if can_finish_within_hours?(piles, h, mid) do
      find_minimum_speed(low, piles, h, mid)
    else
      find_minimum_speed(mid + 1, piles, h, high)
    end
  end

  @spec can_finish_within_hours?(list(non_neg_integer()), pos_integer(), non_neg_integer()) :: boolean()
  defp can_finish_within_hours?(_piles, _h, speed) when speed <= 0 do
    false
  end

  defp can_finish_within_hours?(piles, h, speed) do
    total_hours = Enum.reduce(piles, 0, fn pile, acc ->
      acc + ceil_div(pile, speed)
    end)

    total_hours <= h
  end

  @spec ceil_div(non_neg_integer(), non_neg_integer()) :: non_neg_integer()
  defp ceil_div(_numerator, 0), do: 0

  defp ceil_div(numerator, denominator) when denominator > 0 do
    div(numerator + denominator - 1, denominator)
  end

  @spec ensure_at_least_one(non_neg_integer(), list(non_neg_integer())) :: non_neg_integer()
  defp ensure_at_least_one(0, piles) when is_list(piles) and not Enum.empty?(piles) do
    1
  end

  defp ensure_at_least_one(speed, _piles) do
    speed
  end
end

---TEST---
