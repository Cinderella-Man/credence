---INSTRUCTION---
Write an Elixir function that determines the minimum constant integer eating speed (bananas per hour) required for an animal to finish all banana piles within a given number of hours. The function takes a list of non-negative integers representing the number of bananas in each pile and a positive integer representing the total available hours. Each hour, the animal can eat at most the specified speed from a single pile, and it must eat an integer number of bananas per hour. The function should return the smallest integer speed that allows all piles to be eaten within the given hours.

The function must be named `minimum_eating_speed` and must accept two arguments: a list of integers `piles` and an integer `h`. It must return an integer.

If the list is empty, return 0. If the required hours exceed the given hours for all possible speeds up to the maximum pile, the function should still return the minimum speed that satisfies the condition (which will be at least 1 for non-empty lists).

The solution should have a time complexity of O(n log m), where n is the length of the piles list and m is the maximum value in piles.
---TEST---
defmodule Test do
  use ExUnit.Case, async: false

  test "example 1" do
    assert Solution.minimum_eating_speed([3, 6, 7, 11], 8) == 4
  end

  test "example 2" do
    assert Solution.minimum_eating_speed([30, 11, 23, 4, 20], 6) == 23
  end

  test "example 3" do
    assert Solution.minimum_eating_speed([30, 11, 23, 4, 20], 5) == 30
  end

  test "single pile" do
    assert Solution.minimum_eating_speed([10], 5) == 2
  end

  test "hours equal to number of piles" do
    assert Solution.minimum_eating_speed([3, 4, 5], 3) == 5
  end

  test "empty list" do
    assert Solution.minimum_eating_speed([], 10) == 0
  end

  test "all piles equal" do
    assert Solution.minimum_eating_speed([5, 5, 5], 6) == 3
  end

  test "large hours" do
    assert Solution.minimum_eating_speed([1, 1, 1, 1], 100) == 1
  end
end
---REFERENCE---
defmodule Solution do
  def minimum_eating_speed([], _h), do: 0

  def minimum_eating_speed(piles, h) do
    max_pile = Enum.max(piles)
    binary_search(1, max_pile, piles, h)
  end

  defp binary_search(left, right, _piles, _h) when left >= right, do: left

  defp binary_search(left, right, piles, h) do
    mid = div(left + right, 2)
    hours_needed = total_hours(piles, mid)

    if hours_needed > h do
      binary_search(mid + 1, right, piles, h)
    else
      binary_search(left, mid, piles, h)
    end
  end

  defp total_hours(piles, speed) do
    Enum.reduce(piles, 0, fn pile, acc ->
      acc + div(pile + speed - 1, speed)
    end)
  end
end
