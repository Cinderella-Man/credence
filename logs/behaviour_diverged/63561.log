defmodule Solution do
  @doc """
  Given a list of integers where every element appears an even number of times
  except for one element which appears an odd number of times, find and return
  that element.
  """
  @spec odd_occurrence([integer()]) :: integer()
  def odd_occurrence(list) do
    list
    |> Enum.group_by(& &1)
    |> Enum.filter(fn {_, values} ->
      rem(length(values), 2) == 1
    end)
    |> Enum.map(fn {key, _} -> key end)
    |> List.first()
  end
end
===AFTER===
defmodule Solution do
  @doc """
  Given a list of integers where every element appears an even number of times
  except for one element which appears an odd number of times, find and return
  that element.
  """
  @spec odd_occurrence([integer()]) :: integer()
  def odd_occurrence(list) do
    Enum.reduce(list, %{}, fn x, acc ->
      Map.update(acc, x, 1, &(&1 + 1))
    end)
    |> Enum.find_value(fn {key, count} ->
      if rem(count, 2) == 1, do: key
    end)
  end
end
===RATIONALE===
The group_by/filter/map/first pattern is less efficient and idiomatic than a single reduce with a frequency map plus find_value.
