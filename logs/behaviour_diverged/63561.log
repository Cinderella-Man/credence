defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "single odd element among pairs" do
    assert Solution.odd_occurrence([9, 7, 9, 7, 9]) == 9
  end

  test "odd element is unique" do
    assert Solution.odd_occurrence([4, 1, 2, 2, 5, 1, 4]) == 5
  end

  test "odd element appears three times" do
    assert Solution.odd_occurrence([1, 2, 3, 2, 3, 1, 3]) == 3
  end
end
---REFERENCE---
defmodule Solution do
  @doc """
  Returns the element that occurs an odd number of times in the given list.
  Uses the XOR-based approach: XORing all elements cancels out pairs,
  leaving only the element with the odd count.
  """
  def odd_occurrence(list) do
    Enum.reduce(list, 0, fn x, acc -> Bitwise.bxor(acc, x) end)
  end
end
