defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "palindrome_pairs with bat, tab, cat" do
    result = Solution.palindrome_pairs(["bat", "tab", "cat"])
    # Order may vary, so sort to compare
    assert Enum.sort(result) == Enum.sort([{0, 1}, {1, 0}])
  end

  test "palindrome_pairs with a and empty string" do
    result = Solution.palindrome_pairs(["a", ""])
    assert Enum.sort(result) == Enum.sort([{0, 1}, {1, 0}])
  end

  test "palindrome_pairs with abcd, dcba, ll" do
    result = Solution.palindrome_pairs(["abcd", "dcba", "ll"])
    assert Enum.sort(result) == Enum.sort([{0, 1}, {1, 0}])
  end
