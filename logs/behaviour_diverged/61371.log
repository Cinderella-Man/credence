defmodule Solution do
  @doc """
  Given a list of words, return a list of distinct index pairs (i, j) where
  i != j and the concatenation of word at index i followed by word at index j
  forms a palindrome.
  """
  @spec palindrome_pairs([String.t()]) :: [{non_neg_integer(), non_neg_integer()}]
  def palindrome_pairs(words) do
    n = length(words)

    for i <- 0..(n - 1),
        j <- 0..(n - 1),
        i != j,
        palindrome?(concatenate(words, i, j)) do
      {i, j}
    end
  end

  defp concatenate(words, i, j) do
    Enum.at(words, i) <> Enum.at(words, j)
  end

  defp palindrome?(binary) do
    binary == reverse_binary(binary)
  end

  defp reverse_binary(<<>>), do: <<>>
  defp reverse_binary(<<head, tail::binary>>), do: reverse_binary(tail) <> <<head>>
end
