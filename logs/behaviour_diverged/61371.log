---REFERENCE---
defmodule Solution do
  @spec palindrome_pairs([String.t()]) :: [{integer, integer}]
  def palindrome_pairs(words) do
    indexed = Enum.with_index(words)
    for {word1, i} <- indexed,
        {word2, j} <- indexed,
        i != j,
        is_palindrome?(word1 <> word2) do
      {i, j}
    end
  end

  defp is_palindrome?(str) do
    str == String.reverse(str)
  end
end

