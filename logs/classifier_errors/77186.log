defmodule Solution do
  @spec has_duplicate_chars(String.t()) :: boolean()
  def has_duplicate_chars(s) do
    s
    |> String.graphemes()
    |> do_has_duplicate?(MapSet.new())
  end

  defp do_has_duplicate?([], _seen), do: false
  defp do_has_duplicate?([char | rest], seen) do
    if MapSet.member?(seen, char) do
      true
    else
      do_has_duplicate?(rest, MapSet.put(seen, char))
    end
  end
end
