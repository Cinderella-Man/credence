---MODULE---
@moduledoc """
Provides functionality to find the most frequent string in a list.
"""

defmodule Solution do
  @doc """
  Returns the string that appears most frequently in the given list of strings.

  If multiple strings have the same maximum frequency, any one of them is returned.

  ## Parameters
    - strings: A non-empty list of strings.

  ## Returns
    A string that appears most frequently in the list.

  ## Complexity
    O(n) time complexity where n is the length of the input list.
  """
  @spec max_freq_char([String.t()]) :: String.t()
  def max_freq_char(strings) do
    counts = Enum.reduce(strings, %{}, fn str, acc ->
      Map.update(acc, str, 1, &(&1 + 1))
    end)

    counts
    |> Enum.max_by(fn {_str, count} -> count end)
    |> elem(0)
  end
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "returns the most frequent string from a mixed list" do
    assert Solution.max_freq_char(["hello", "world", "hello", "python", "world", "python", "python"]) == "python"
  end

  test "returns the most frequent string from a list of single characters" do
    assert Solution.max_freq_char(["a", "b", "c", "a", "b", "a"]) == "a"
  end

  test "returns the most frequent string from a list of words" do
    assert Solution.max_freq_char(["apple", "banana", "apple", "cherry", "banana", "cherry", "cherry"]) == "cherry"
  end
end
