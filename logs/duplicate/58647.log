@doc """
Returns the product of all distinct even numbers in the list.
If no even numbers are present, returns 1.
Zero is included if present (making the product zero).
Time complexity: O(n).
"""
@spec product_of_even([integer()]) :: integer()
def product_of_even(numbers) do
  numbers
  |> Enum.filter(&even?/1)
  |> Enum.uniq()
  |> Enum.reduce(1, fn num, acc ->
    acc * num
  end)
end

