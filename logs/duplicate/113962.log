  |> String.graphemes()
  |> Enum.map(&shift_char/1)
  |> IO.iodata_to_string()
end

defp shift_char(<<char::utf8>>) when char in ?a..?y do
  <<char + 1::utf8>>
end

defp shift_char("z") do
  "a"
end

defp shift_char(<<char::utf8>>) when char in ?A..?Y do
  <<char + 1::utf8>>
end

defp shift_char("Z") do
  "A"
end

defp shift_char(char) do
