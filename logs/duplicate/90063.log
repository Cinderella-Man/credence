---INSTRUCTION---
Write a function `find_top_n_items/2` in the `Solution` module that takes a map and an integer `n` and returns a list of the `n` key-value pairs with the largest values. The result must be a list of two-element tuples, sorted in descending order by value. If `n` is larger than the number of items, return all items sorted by value. The function should handle empty maps by returning an empty list.

---TEST---
defmodule Test do
  use ExUnit.Case, async: false

  test "returns top n items by value" do
    map = %{"apple" => 5, "banana" => 2, "cherry" => 3, "date" => 1}
    assert Solution.find_top_n_items(map, 3) == [{"apple", 5}, {"cherry", 3}, {"banana", 2}]
  end

  test "returns top n when values are larger" do
    map = %{"a" => 10, "b" => 20, "c" => 30, "d" => 40}
    assert Solution.find_top_n_items(map, 2) == [{"d", 40}, {"c", 30}]
  end

  test "returns single top item" do
    map = %{"x" => 100, "y" => 200, "z" => 300}
    assert Solution.find_top_n_items(map, 1) == [{"z", 300}]
  end

  test "returns all items when n exceeds map size" do
    map = %{"a" => 1}
    assert Solution.find_top_n_items(map, 5) == [{"a", 1}]
  end

  test "returns empty list for empty map" do
    assert Solution.find_top_n_items(%{}, 3) == []
  end

  test "returns empty list for n zero" do
    map = %{"a" => 1, "b" => 2}
    assert Solution.find_top_n_items(map, 0) == []
  end
end

---REFERENCE---
defmodule Solution do
  def find_top_n_items(map, n) when n <= 0 do
    []
  end

  def find_top_n_items(map, n) do
    map
    |> Map.to_list()
    |> Enum.sort_by(fn {_key, value} -> value end, :desc)
    |> Enum.take(n)
  end
end

