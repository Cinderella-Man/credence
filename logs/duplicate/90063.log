@doc """
Given a map with string keys and integer values, and an integer `n`,
return a list of `{key, value}` tuples containing the `n` entries with
the largest values, sorted in descending order by value.
"""
@spec find_top_n_items(map, non_neg_integer) :: list({String.t(), integer})
def find_top_n_items(_map, 0) do
  []
end

def find_top_n_items(map, n) do
  map
  |> Map.entries()
  |> Enum.sort_by(fn {_key, value} -> value end, :desc)
  |> Enum.take(n)
end[0m
