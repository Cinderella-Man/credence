defmodule Solution do
  @doc """
  Returns the maximum integer in a non-empty list of integers using recursion.
  """
  @spec find_max_recursive([integer]) :: integer
  def find_max_recursive([head | tail]) do
    do_find_max(tail, head)
  end

  defp do_find_max([], current_max), do: current_max

  defp do_find_max([head | tail], current_max) do
    new_max = if head > current_max, do: head, else: current_max
    do_find_max(tail, new_max)
  end
end
