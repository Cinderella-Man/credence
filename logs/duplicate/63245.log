---MODULE---
defmodule Solution do
  @doc """
  Multiplies two binary strings and returns the result as a binary string.
  """
  @spec binary_multiplication(binary(), binary()) :: binary()
  def binary_multiplication("0", _binary_b), do: "0"
  def binary_multiplication(_binary_a, "0"), do: "0"

  def binary_multiplication(binary_a, binary_b) do
    dec_a = binary_to_decimal(binary_a)
    dec_b = binary_to_decimal(binary_b)
    product = dec_a * dec_b
    decimal_to_binary(product)
  end

  @spec binary_to_decimal(binary()) :: non_neg_integer()
  defp binary_to_decimal(binary) do
    binary
    |> String.to_charlist()
    |> Enum.map(&(&1 - ?0))
    |> Enum.reduce(0, &(&1 * 2 + &2))
  end

  @spec decimal_to_binary(non_neg_integer()) :: binary()
  defp decimal_to_binary(0), do: "0"

  defp decimal_to_binary(decimal) when decimal > 0 do
    decimal
    |> Integer.digits(2)
    |> Enum.map(&Integer.to_string/1)
    |> Enum.join()
  end
end

