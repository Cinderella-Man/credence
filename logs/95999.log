@spec find_majority_element(list(integer())) :: integer()
def find_majority_element(nums) when is_list(nums) and length(nums) > 0 do
  nums
  |> Enum.reduce(Map.new(), &update_count/2)
  |> find_majority_from_map()
end

defp update_count(num, acc_map) do
  Map.update(acc_map, num, 1, &(&1 + 1))
end

