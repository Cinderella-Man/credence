  target_threshold = calculate_target_threshold(count_map)

  count_map
  |> Enum.find_value(fn {element, count} ->
    if count > target_threshold, do: element
  end)
end

defp calculate_target_threshold(count_map) do
  total = Enum.sum(Map.values(count_map))
  div(total, 2)
end
