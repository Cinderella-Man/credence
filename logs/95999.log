defmodule Solution do
  def find_majority_element([head | tail]) do
    {candidate, _count} =
      Enum.reduce(tail, {head, 1}, fn num, {candidate, count} ->
        if count == 0 do
          {num, 1}
        else
          if num == candidate do
            {candidate, count + 1}
          else
            {candidate, count - 1}
          end
        end
      end)

    candidate
  end

  # Handle empty list case? The problem says non-empty, but for safety:
  def find_majority_element([]), do: nil
end

