    content: defmodule Credence.Pattern.NoDuplicateModuleDefinitionCheckTest do
  use Credence.RuleCase, async: true

  alias Credence.Issue
  alias Credence.Pattern.NoDuplicateModuleDefinition

  describe "does not flag" do
    test "single module definition" do
      assert clean?(NoDuplicateModuleDefinition, """
             defmodule Solution do
               def foo, do: 1
             end
             """)
    end

    test "two modules with different names" do
      assert clean?(NoDuplicateModuleDefinition, """
             defmodule Foo do
               def foo, do: 1
             end

             defmodule Bar do
               def bar, do: 2
             end
             """)
    end

    test "empty file" do
      assert clean?(NoDuplicateModuleDefinition, ":ok")
    end

    test "single expression, no modules" do
      assert clean?(NoDuplicateModuleDefinition, "1 + 2")
    end
  end

  describe "flags" do
    test "two defmodule blocks with the same name" do
      issues =
        check(NoDuplicateModuleDefinition, """
        defmodule Solution do
          def foo, do: 1
        end

        defmodule Solution do
          def foo, do: 2
        end
        """)

      assert length(issues) == 1
      issue = hd(issues)
      assert %Issue{} = issue
      assert issue.rule == :no_duplicate_module_definition
      assert issue.message =~ "Duplicate"
      assert issue.message =~ "Solution"
      assert issue.meta.line != nil
    end

    test "three defmodule blocks with the same name" do
      issues =
        check(NoDuplicateModuleDefinition, """
        defmodule Solution do
          def foo, do: 1
        end

        defmodule Solution do
          def foo, do: 2
        end

        defmodule Solution do
          def foo, do: 3
        end
        """)

      assert length(issues) == 2
    end

    test "duplicate with different bodies" do
      issues =
        check(NoDuplicateModuleDefinition, """
        defmodule Solution do
          @doc "old"
          def len_of_longest_str(list) when is_list(list) do
            list
            |> Enum.map(&String.length/1)
            |> Enum.max()
            |> safe_max()
          end
        end

        defmodule Solution do
          @doc "new"
          def len_of_longest_str([]), do: 0
          def len_of_longest_str(list) when is_list(list) do
            list
            |> Enum.map(&String.length/1)
            |> Enum.max()
          end
        end
        """)

      assert length(issues) == 1
    end
  end
end

