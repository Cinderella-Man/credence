    content: defmodule Credence.Pattern.NoDuplicateModuleDefinitionFixTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.NoDuplicateModuleDefinition

  test "removes earlier duplicate, keeps last definition" do
    input = """
    defmodule Solution do
      def foo, do: 1
    end

    defmodule Solution do
      def foo, do: 2
    end
    """

    expected = """
    defmodule Solution do
      def foo, do: 2
    end
    """

    confirm_fix(fix(NoDuplicateModuleDefinition, input), expected)
  end

  test "removes multiple earlier duplicates" do
    input = """
    defmodule Solution do
      def foo, do: 1
    end

    defmodule Solution do
      def foo, do: 2
    end

    defmodule Solution do
      def foo, do: 3
    end
    """

    expected = """
    defmodule Solution do
      def foo, do: 3
    end
    """

    confirm_fix(fix(NoDuplicateModuleDefinition, input), expected)
  end

  test "leaves code without duplicates unchanged" do
    code = """
    defmodule Solution do
      def foo, do: 1
    end
    """

    confirm_fix(fix(NoDuplicateModuleDefinition, code), code)
  end

  test "leaves different module names unchanged" do
    code = """
    defmodule Foo do
      def foo, do: 1
    end

    defmodule Bar do
      def bar, do: 2
    end
    """

    confirm_fix(fix(NoDuplicateModuleDefinition, code), code)
  end

  test "keeps non-module statements intact" do
    input = """
    defmodule Solution do
      def foo, do: 1
    end

    IO.puts("hello")

    defmodule Solution do
      def foo, do: 2
    end
    """

    expected = """
    IO.puts("hello")

    defmodule Solution do
      def foo, do: 2
    end
    """

    confirm_fix(fix(NoDuplicateModuleDefinition, input), expected)
  end
end

