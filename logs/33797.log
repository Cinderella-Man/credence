    content: defmodule Credence.Pattern.NoDuplicateModuleDefinition do
  @moduledoc """
  Detects duplicate `defmodule Name` blocks at file level.

  In Elixir, when multiple `defmodule Name` blocks appear at the top level,
  the last one silently overwrites all prior definitions — earlier blocks are
  entirely dead code. This rule detects such duplicates and removes all but
  the last definition of each module name.

  ## Bad

      defmodule Solution do
        def foo, do: 1
      end

      defmodule Solution do
        def foo, do: 2
      end

  ## Good

      defmodule Solution do
        def foo, do: 2
      end
  """

  use Credence.Pattern.Rule
  alias Credence.Issue
  alias Credence.RuleHelpers

  @impl true
  def check(ast, _opts) do
    top_modules = collect_top_level_modules(ast)

    top_modules
    |> Enum.group_by(& &1.name)
    |> Enum.flat_map(fn {_name, defs} ->
      # All but the last are dead code — flag each earlier one
      Enum.take(defs, length(defs) - 1)
    end)
    |> Enum.sort_by(& &1.line)
    |> Enum.map(&to_issue/1)
  end

  @impl true
  def fix_patches(ast, opts) do
    source = Keyword.get(opts, :source, "")

    RuleHelpers.patches_from_ast_transform(ast, source, fn ast ->
      remove_duplicate_modules(ast)
    end)
  end

  # ── Analysis ──────────────────────────────────────────────────────

  # Collect top-level defmodule nodes with their names and line numbers.
  defp collect_top_level_modules(ast) do
    top_stmts = top_level_stmts(ast)

    Enum.flat_map(top_stmts, fn
      {:defmodule, meta, [{:__aliases__, _, name_parts} | _]} ->
        [%{name: Module.concat(name_parts), line: Keyword.get(meta, :line), node: {:defmodule, meta, nil}}]

      _ ->
        []
    end)
  end

  # Extract the list of top-level statements from the AST.
  defp top_level_stmts({:__block__, _, stmts}), do: stmts
  defp top_level_stmts(single), do: [single]

  defp to_issue(%{name: name, line: line}) do
    %Issue{
      rule: :no_duplicate_module_definition,
      message:
        "Duplicate `defmodule #{inspect(name)}` definition. " <>
          "The earlier definition is dead code — only the last one takes effect.",
      meta: %{line: line}
    }
  end

  # ── Transformation ────────────────────────────────────────────────

  # Remove all but the last defmodule for each module name from the AST.
  defp remove_duplicate_modules({:__block__, meta, stmts}) do
    # Walk backwards: for each module name, keep only the last occurrence
    seen = :ets.new(:seen_modules, [:set, :private])

    kept =
      stmts
      |> Enum.reverse()
      |> Enum.filter(fn
        {:defmodule, _, [{:__aliases__, _, name_parts} | _]} ->
          name = Module.concat(name_parts)

          case :ets.lookup(seen, name) do
            [] ->
              :ets.insert(seen, {name, true})
              true

            _ ->
              false
          end

        _ ->
          true
      end)
      |> Enum.reverse()

    :ets.delete(seen)

    case kept do
      [single] -> single
      _ -> {:__block__, meta, kept}
    end
  end

  defp remove_duplicate_modules(single), do: single
end

