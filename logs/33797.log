    content: defmodule Credence.Pattern.NoDuplicateModuleDefinitionEquivalenceTest do
  @moduledoc """
  Tier 3b (unconstructible). The fix removes earlier `defmodule Name` blocks that
  are dead code — the runtime only uses the last definition. The behaviour-equivalence
  harness (`assert_equivalent_module`) compiles the "before" source and calls a
  function on it, but with two `defmodule Solution` blocks, the first gets renamed
  (to a unique name) while the second keeps the original name. The harness therefore
  calls the *first* (dead) definition, not the live one. There is no way to make the
  harness call the last definition of the original while comparing against the fix's
  single-definition output, so no self-contained callable example is constructible.
  """
  use Credence.RuleCase, async: true

  import Credence.BehaviourEquivalence

  test "duplicate_module_definition: unconstructible — harness cannot test dead code" do
    assert :ok =
             mark_equivalence_unconstructible(
               "The 'before' source has two defmodule blocks with the same name. " <>
                 "The test harness renames only the first, so it evaluates the dead " <>
                 "definition rather than the live last one — no valid comparison."
             )
  end
end

