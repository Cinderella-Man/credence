defmodule Solution do
  @spec newton_raphson_sqrt(number, float, non_neg_integer) :: float
  def newton_raphson_sqrt(n, tolerance \\ 1.0e-10, max_iterations \\ 100)
  def newton_raphson_sqrt(0, _tolerance, _max_iterations), do: 0.0
  def newton_raphson_sqrt(n, tolerance, max_iterations) when is_number(n) and n > 0 do
    iterate(n, n, tolerance, max_iterations, 0)
  end

  defp iterate(current, _n, _tolerance, max_iterations, max_iterations), do: current
  defp iterate(current, n, tolerance, max_iterations, iteration) do
    next = (current + n / current) / 2.0
    if abs(next - current) < tolerance do
      next
    else
      iterate(next, n, tolerance, max_iterations, iteration + 1)
    end
  end
end
