    assert Solution.newton_raphson_sqrt(25) == 5.0
  end

  test "sqrt of 2 is approximately 1.414213562373095" do
    assert_in_delta Solution.newton_raphson_sqrt(2), 1.414213562373095, 1.0e-10
  end
end
