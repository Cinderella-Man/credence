---MODULE---
@doc """
Computes an approximate square root of a non-negative number using the Newton-Raphson method.

## Parameters

  - `n` - The non-negative number to compute the square root of.
  - `tolerance` - The optional tolerance for convergence (default: 1.0e-10).
  - `max_iterations` - The optional maximum number of iterations (default: 100).

## Returns

  A float representing the approximate square root.
"""
@spec newton_raphson_sqrt(number(), float(), non_neg_integer()) :: float()
def newton_raphson_sqrt(n, tolerance \\ 1.0e-10, max_iterations \\ 100) when is_number(n) and n >= 0 do
  if n == 0 do
    0.0
  else
    initial_guess = to_float(n)
    do_newton_raphson(n, initial_guess, tolerance, max_iterations, max_iterations)
  end
end

defp to_float(n) when is_integer(n), do: to_float(:float.from_float(n))
defp to_float(n) when is_float(n), do: n
defp to_float(_), do: :erlang.float(n)

defp do_newton_raphson(_n, _guess, _tolerance, 0, _max_iterations) do
  # This case shouldn't normally be reached if max_iterations > 0, but as a safeguard
  # we return the last guess converted to float
  0.0
end

defp do_newton_raphson(n, guess, tolerance, remaining, _max_iterations) do
  next_guess = (guess + n / guess) / 2.0
  diff = abs(next_guess - guess)

  if diff < tolerance do
    next_guess
  else
    do_newton_raphson(n, next_guess, tolerance, remaining - 1, max_iterations)
  end
end
