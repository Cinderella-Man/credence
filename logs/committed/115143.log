          # There is overlap; only add the non-overlapping portion
          acc.total + (end_time - acc.last_end)
        else
          # No overlap; add full duration
          acc.total + (end_time - start_time)
        end

      %{acc | total: new_total, last_end: end_time}
    end)
    |> Map.fetch!(:total)
  end
end
