---MODULE---
defmodule Solution do
  @doc """
  Calculates the total time a character is poisoned based on attack times and poison duration.

  Overlapping poison durations from consecutive attacks do not stack; only the non-overlapping
  portions count. If the list of attack times is empty, returns 0.

  ## Examples

      iex> Solution.find_poisoned_duration([], 2)
      0

      iex> Solution.find_poisoned_duration([5], 3)
      3

      iex> Solution.find_poisoned_duration([1, 2], 2)
      3

      iex> Solution.find_poisoned_duration([1, 4], 2)
      4

      iex> Solution.find_poisoned_duration([1, 2, 3, 4, 5], 1)
      5
  """
  @spec find_poisoned_duration([pos_integer()], pos_integer()) :: non_neg_integer()
  def find_poisoned_duration([], _duration), do: 0

  def find_poisoned_duration(attacks, duration) when is_list(attacks) and is_integer(duration) do
    Enum.reduce(attacks, %{total: 0, last_end: 0}, fn attack_time, acc ->
      start = attack_time
      end = attack_time + duration

      if start < acc.last_end do
        # There is overlap; only add the non-overlapping portion
        new_total = acc.total + (end - acc.last_end)
        %{acc | total: new_total, last_end: end}
      else
        # No overlap; add full duration
        new_total = acc.total + (end - start)
        %{acc | total: new_total, last_end: end}
      end
    end)
    |> Map.fetch!(:total)
  end
end
