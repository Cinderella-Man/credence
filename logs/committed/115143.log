---INSTRUCTION---
Write a function in Elixir that calculates the total time a character is poisoned based on the times they were attacked and the duration of the poison effect. The function should accept a list of integers representing the times of each attack and an integer representing the duration of the poison effect. It should return the total time the character is poisoned, where overlapping poison durations from consecutive attacks do not stack (only the non-overlapping portions count). If the list is empty, return 0.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "empty list returns 0" do
    assert Solution.find_poisoned_duration([], 2) == 0
  end

  test "single attack" do
    assert Solution.find_poisoned_duration([5], 3) == 3
  end

  test "consecutive attacks with overlap" do
    assert Solution.find_poisoned_duration([1, 2], 2) == 3
  end

  test "consecutive attacks without overlap" do
    assert Solution.find_poisoned_duration([1, 4], 2) == 4
  end

  test "multiple attacks with overlap and non-overlap" do
    assert Solution.find_poisoned_duration([1, 2, 3, 4, 5], 1) == 5
  end
end

---REFERENCE---
defmodule Solution do
  @spec find_poisoned_duration(list(integer), integer) :: integer
  def find_poisoned_duration([], _duration), do: 0
  def find_poisoned_duration([_first | _rest] = time_series, duration) do
    time_series
    |> Enum.chunk_every(2, 1, :discard)
    |> Enum.reduce(0, fn [t1, t2], acc ->
         acc + min(duration, t2 - t1)
       end)
    |> Kernel.+(duration)
  end
end

