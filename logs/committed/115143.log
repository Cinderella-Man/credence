    content: defmodule Credence.Syntax.NoEndKeywordVariable do
  @moduledoc """
  Detects and renames `end` used as a variable name.

  LLMs sometimes generate code where `end` is used as a variable name,
  e.g. `end = a + b` followed by a bare `end` return. Since `end` is
  a reserved keyword in Elixir (used to close `do`/`fn`/`if`/etc. blocks),
  this causes a parse failure.

  This rule renames the variable `end` to `result`.

  ## Bad (won't parse)

      def calc(a, b) do
        end = a + b
        end
      end

  ## Good

      def calc(a, b) do
        result = a + b
        result
      end
  """
  use Credence.Syntax.Rule
  alias Credence.Issue

  # Matches `end` used as a variable name in assignment: `end = ...`
  @assignment_pattern ~r/^\s*end\s*=/

  # Matches a bare `end` on its own line (variable reference, not keyword)
  @bare_end_pattern ~r/^\s*end\s*$/

  @impl true
  def analyze(source) do
    if has_end_variable?(source) do
      source
      |> String.split("\n")
      |> Enum.with_index(1)
      |> Enum.flat_map(fn {line, line_no} ->
        if Regex.match?(@assignment_pattern, line) do
          [build_issue(line_no)]
        else
          []
        end
      end)
    else
      []
    end
  end

  @impl true
  def fix(source) do
    if has_end_variable?(source) do
      source
      |> String.split("\n")
      |> Enum.map_join("\n", &fix_line/1)
    else
      source
    end
  end

  # Check if `end` is used as a variable name by looking for assignment pattern
  defp has_end_variable?(source) do
    source
    |> String.split("\n")
    |> Enum.any?(&Regex.match?(@assignment_pattern, &1))
  end

  # Fix a single line: replace variable `end` with `result`
  defp fix_line(line) do
    cond do
      # Assignment: `end = expr` -> `result = expr`
      Regex.match?(@assignment_pattern, line) ->
        Regex.replace(~r/\bend\b/, line, "result")

      # Bare `end` on its own line -> `result`
      Regex.match?(@bare_end_pattern, line) ->
        Regex.replace(~r/\bend\b/, line, "result")

      true ->
        line
    end
  end

  defp build_issue(line_no) do
    %Issue{
      rule: :no_end_keyword_variable,
      message:
        "`end` is a reserved keyword in Elixir and cannot be used as a variable name. " <>
          "Use `result` instead.",
      meta: %{line: line_no}
    }
  end
end

