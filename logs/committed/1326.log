---REFERENCE---
defmodule Solution do
  @spec find_majority_element(list(integer())) :: integer()
  def find_majority_element([]), do: -1

  def find_majority_element(list) do
    n = length(list)

    # First pass: find a candidate using the Boyer-Moore Voting Algorithm
    {candidate, _count} =
      Enum.reduce(list, {nil, 0}, fn x, {cand, cnt} ->
        cond do
          cnt == 0 -> {x, 1}
          x == cand -> {cand, cnt + 1}
          true -> {cand, cnt - 1}
        end
      end)

    # Second pass: verify the candidate appears more than n/2 times
    candidate_count = Enum.count(list, fn x -> x == candidate end)

    if candidate_count > div(n, 2) do
      candidate
    else
      -1
    end
  end
end

