    content: defmodule Credence.Syntax.CloseUnclosedDocHeredoc do
  @moduledoc """
  Detects and fixes unclosed `@doc """` heredocs where the LLM jumps
  straight into function code without ever closing the triple-quote block.

  LLMs frequently emit `@doc """` and then immediately write a `def`
  on the next non-blank line without a closing `"""` in between. This
  causes a `TokenMissingError` (missing terminator: `"""`). The fix
  inserts a closing `"""` line — indented to match the `@doc` line —
  immediately before the `def` line.

  ## Bad (won't parse — TokenMissingError)

      defmodule Solution do
        @doc """
        def find_min_max(list) do
          Enum.min_max(list)
        end
      end

  ## Good

      defmodule Solution do
        @doc """
        """
        def find_min_max(list) do
          Enum.min_max(list)
        end
      end
  """
  use Credence.Syntax.Rule

  alias Credence.Issue

  @doc_heredoc_open ~r/^(\s*)@doc\s+"""\s*$/

  @impl true
  def analyze(source) do
    lines = String.split(source, "\n")

    lines
    |> Enum.with_index(1)
    |> Enum.flat_map(fn {line, line_no} ->
      if unclosed_doc_heredoc?(line, line_no, lines) do
        [
          %Issue{
            rule: :close_unclosed_doc_heredoc,
            message:
              "Unclosed `@doc \"\"\"` heredoc — the closing `\"\"\"` is missing before the next `def`.",
            meta: %{line: line_no}
          }
        ]
      else
        []
      end
    end)
  end

  @impl true
  def fix(source) do
    lines = String.split(source, "\n")

    lines
    |> insert_missing_doc_closes()
    |> Enum.join("\n")
  end

  defp unclosed_doc_heredoc?(line, line_no, lines) do
    case Regex.run(@doc_heredoc_open, line) do
      [_, _indent] ->
        remaining = Enum.drop(lines, line_no)
        next_nonblank_is_def?(remaining) and not closed_before_def?(remaining)

      _ ->
        false
    end
  end

  defp next_nonblank_is_def?(lines) do
    Enum.find_value(lines, false, fn next_line ->
      cond do
        String.trim(next_line) == "" -> nil
        Regex.match?(~r/^\s*def/, next_line) -> true
        true -> false
      end
    end)
  end

  defp closed_before_def?(lines) do
    Enum.find_value(lines, false, fn next_line ->
      cond do
        String.trim(next_line) == "" -> nil
        Regex.match?(~r/^\s*"""/, next_line) -> true
        Regex.match?(~r/^\s*def/, next_line) -> false
        true -> false
      end
    end)
  end

  defp insert_missing_doc_closes(lines) do
    lines
    |> Enum.with_index()
    |> Enum.reduce([], fn {line, idx}, acc ->
      case Regex.run(@doc_heredoc_open, line) do
        [_, indent] ->
          remaining = Enum.drop(lines, idx + 1)

          if next_nonblank_is_def?(remaining) and not closed_before_def?(remaining) do
            # Find the index of the next non-blank line (which is a def)
            insert_idx = find_next_nonblank_offset(remaining) + idx + 1
            close_line = indent <> ~s(""")
            {before, after_insert} = Enum.split(acc, length(acc) - (length(acc) - insert_idx + idx + 1))

            # Rebuild: everything up to insert_idx, then the closing """, then the rest
            # Simpler approach: build the full list with the insertion
            all_lines = acc ++ [line]
            remaining_after_acc = Enum.drop(lines, idx + 1)
            insert_at = find_next_nonblank_offset(remaining_after_acc)

            {head, tail} = split_at(all_lines, remaining_after_acc, insert_at, indent, idx)
            head ++ tail
          else
            acc ++ [line]
          end

        _ ->
          acc ++ [line]
      end
    end)
  end

  # Insert a closing `"""` line before the next non-blank line.
  defp split_at(acc_lines, remaining, insert_offset, indent, _original_idx) do
    # remaining is lines after the current @doc line
    # insert_offset is how many lines into `remaining` the first non-blank (def) line is
    {blank_lines, rest} = Enum.split(remaining, insert_offset)

    new_lines = acc_lines ++ blank_lines ++ [indent <> ~s(""") ]
    {new_lines, rest}
  end

  defp find_next_nonblank_offset(lines) do
    Enum.find_index(lines, fn line -> String.trim(line) != "" end) || length(lines)
  end
end

