        new_binding = {:{}, [], Enum.drop(bind_elems, -1)}
        new_assignment = {:=, [], [new_binding, transformed_call]}

        # 3. Build the case expression
        case_expr = build_case_expr()

        # 4. Build pipe: reduce_while(...) |> case do ... end
        piped = {:|>, [], [new_assignment, case_expr]}

        # 5. Reconstruct block: everything before + piped, skip old assignment + flag var
        before = Enum.take(stmts, idx)
        after_flag = Enum.drop(stmts, idx + 2)

