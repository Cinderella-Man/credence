defmodule Solution do
  @doc """
  Determines if there exists a contiguous subarray that sums to zero.

  Uses a prefix sum approach with O(n) time complexity.
  If we see the same prefix sum twice, the subarray between those indices sums to zero.
  Also, if the prefix sum itself is zero, the subarray from the start to that index sums to zero.

  ## Examples

      iex> Solution.check_zero_subarray([1, 2, -3, 4, 2])
      true

      iex> Solution.check_zero_subarray([5, 7, 1, 2, -1])
      false

      iex> Solution.check_zero_subarray([0])
      true
  """
  @spec check_zero_subarray(list(integer())) :: boolean()
  def check_zero_subarray([]), do: false

  def check_zero_subarray(list) do
    # Use Enum.reduce_with_acc to track prefix sums and seen sums
    # We start with prefix_sum = 0 and seen_sums = MapSet.new([0])
    # If current prefix_sum is in seen_sums, we found a zero-sum subarray
    {_, found?} = Enum.reduce(list, {0, MapSet.new([0])}, fn
      num, {prefix_sum, seen_sums} ->
        new_sum = prefix_sum + num

        if MapSet.member?(seen_sums, new_sum) do
          # Found a duplicate prefix sum, meaning a zero-sum subarray exists
          {:halted, {new_sum, seen_sums}}
        else
          # Add the new sum to seen sums and continue
          {:cont, {new_sum, MapSet.put(seen_sums, new_sum)}}
        end
    end)

    # If the reduction was halted due to finding a duplicate, found? will be {:halted, ...}
    # Otherwise it's just the final {prefix_sum, seen_sums}
    found?
  end

  # Override the above for clarity - let's rewrite more cleanly
  @doc false
  @spec check_zero_subarray_clean(list(integer())) :: boolean()
  def check_zero_subarray_clean([]), do: false

  def check_zero_subarray_clean(list) do
    {found?, _} = Enum.reduce_while(list, {false, 0, MapSet.new([0])}, fn
      num, {found, prefix_sum, seen_sums} ->
        if found do
          {:halt, {true, prefix_sum, seen_sums}}
        else
          new_sum = prefix_sum + num
          if MapSet.member?(seen_sums, new_sum) do
            {:halt, {true, new_sum, seen_sums}}
          else
            {:cont, {false, new_sum, MapSet.put(seen_sums, new_sum)}}
          end
        end
    end)

    found?
  end
end

