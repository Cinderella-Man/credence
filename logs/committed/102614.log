defmodule Solution do
  def max_palindromic_subsequence(s) do
    n = String.length(s)
    if n == 0, do: 0

    # Initialize a tuple of tuples with zeros
    initial_dp = Tuple.duplicate(Tuple.duplicate(0, n), n)

    # Set diagonal elements to 1 (each character is a palindrome of length 1)
    dp =
      for i <- 0..(n - 1), reduce: initial_dp do
        acc ->
          row = elem(acc, i)
          new_row = put_elem(row, i, 1)
          put_elem(acc, i, new_row)
      end

    # Fill the DP table bottom-up
    dp =
      for i <- (n - 2)..0, reduce: dp do
        acc ->
          for j <- (i + 1)..(n - 1), reduce: acc do
            acc ->
              row_i = elem(acc, i)
              row_i1 = elem(acc, i + 1)

              if String.at(s, i) == String.at(s, j) do
                new_val = elem(row_i1, j - 1) + 2
                new_row_i = put_elem(row_i, j, new_val)
                put_elem(acc, i, new_row_i)
              else
                new_val = max(elem(row_i1, j), elem(row_i, j - 1))
                new_row_i = put_elem(row_i, j, new_val)
                put_elem(acc, i, new_row_i)
              end
          end
      end

    elem(elem(dp, 0), n - 1)
  end
end

