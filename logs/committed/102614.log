defmodule Solution do
  @doc """
  Returns the length of the longest palindromic subsequence in the given string.

  ## Examples

      iex> Solution.max_palindromic_subsequence("bbbab")
      4

      iex> Solution.max_palindromic_subsequence("a")
      1

      iex> Solution.max_palindromic_subsequence("cbbd")
      2

      iex> Solution.max_palindromic_subsequence("")
      0
  """
  @spec max_palindromic_subsequence(String.t()) :: non_neg_integer()
  def max_palindromic_subsequence(""), do: 0

  def max_palindromic_subsequence(string) do
    chars = String.to_charlist(string)
    length = length(chars)

    # dp[i][j] = length of longest palindromic subsequence in chars[i..j]
    # We use a 2D list (list of lists) for efficient random access.
    dp = for _i <- 1..length, do: for _j <- 1..length, do: 0

    # Fill DP table for substrings of increasing length
    # len is the length of the substring we're considering
    Enum.reduce(1..length, dp, fn len, _dp ->
      # i is the start index (1-based)
      # j is the end index (1-based)
      # We want to fill dp[i][j] for all valid i, j where j - i + 1 = len
      # i ranges from 1 to length - len + 1
      # j = i + len - 1
      Enum.reduce(1..(length - len + 1), nil, fn i, _ ->
        j = i + len - 1
        case len do
          1 ->
            # A single character is always a palindrome of length 1
            put_in(dp, [Access.at(i - 1), Access.at(j - 1)], 1)

          _ ->
            if Enum.at(chars, i - 1) == Enum.at(chars, j - 1) do
              # Characters match: add 2 to the inner subsequence
              inner_value = if len == 2 do
                0
              else
                # Access dp[i+1][j-1]
                # Since indices are 0-based in the list but we're using 1-based logic
                # dp list is 0-indexed, so dp[i][j] corresponds to dp[i-1][j-1] in 0-based list
                # inner is dp[i+1-1][j-1-1] = dp[i][j-2] in 0-based? Let's be careful.
                # i and j are 1-based.
                # dp list is 0-indexed.
                # dp[i][j] is stored at dp[i-1][j-1]
                # Inner is dp[i+1][j-1], which is dp[i][j-2] in 0-based? No.
                # i+1 (1-based) -> index i
                # j-1 (1-based) -> index j-2
                # So inner_value = List.at(List.at(dp, i), j - 2)
                inner = List.at(List.at(dp, i), j - 2)
                inner || 0
              end
              put_in(dp, [Access.at(i - 1), Access.at(j - 1)], inner_value + 2)
            else
              # Characters don't match: max of excluding start or end
              val_without_start = List.at(List.at(dp, i), j - 1)
              val_without_end = List.at(List.at(dp, i - 1), j - 2)
              max_val = max(val_without_start, val_without_end)
              put_in(dp, [Access.at(i - 1), Access.at(j - 1)], max_val || 0)
            end
        end
      end)
    end)
    |> List.at(0)
    |> List.at(length - 1)
  end
end
