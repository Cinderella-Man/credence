@moduledoc """
Solves the Longest Palindromic Subsequence problem.

Given a string, returns the length of the longest palindromic subsequence.
Uses dynamic programming with O(n^2) time and space complexity.
"""
defmodule Solution do
  @doc """
  Returns the length of the longest palindromic subsequence in the given string.

  ## Examples

      iex> Solution.max_palindromic_subsequence("bbbab")
      4

      iex> Solution.max_palindromic_subsequence("a")
      1

      iex> Solution.max_palindromic_subsequence("cbbd")
      2

      iex> Solution.max_palindromic_subsequence("")
      0
  """
  @spec max_palindromic_subsequence(String.t()) :: non_neg_integer()
  def max_palindromic_subsequence(""), do: 0

  def max_palindromic_subsequence(string) do
    chars = String.to_charlist(string)
    length = length(chars)
    dp = for _i <- 0..(length - 1), _j <- 0..(length - 1), do: 0

    # Fill DP table for substrings of length 1 to n
    # len is the length of the substring
    {_, dp} =
      Enum.reduce(1..length, {dp, 0}, fn len, {dp, _counter} ->
        # i is the start index
        {dp, _} =
          Enum.reduce(0..(length - len), {dp, 0}, fn i, {dp, _counter} ->
            j = i + len - 1

            dp =
              case len do
                1 ->
                  put_in(dp, [i, j], 1)

                _ ->
                  if Enum.at(chars, i) == Enum.at(chars, j) do
                    # Match: add 2 to inner LPS
                    if len == 2 do
                      put_in(dp, [i, j], 2)
                    else
                      inner = Enum.at(Enum.at(dp, i + 1), j - 1)
                      put_in(dp, [i, j], inner + 2)
                    end
                  else
                    # No match: max of excluding start or end char
                    val_from_i = Enum.at(Enum.at(dp, i + 1), j)
                    val_from_j = Enum.at(Enum.at(dp, i), j - 1)
                    max_val = max(val_from_i, val_from_j)
                    put_in(dp, [i, j], max_val)
                  end
              end

            {dp, counter}
          end)

        {dp, counter}
      end)

    case Enum.at(Enum.at(dp, 0), length - 1) do
      nil -> 0
      val -> val
    end
  end
end[0m
