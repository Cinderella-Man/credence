---MODULE---
@moduledoc """
Solves the Longest Palindromic Subsequence problem.

Given a string, returns the length of the longest palindromic subsequence.
Uses dynamic programming with O(n^2) time and space complexity.
"""
defmodule Solution do
  @doc """
  Returns the length of the longest palindromic subsequence in the given string.

  ## Examples

      iex> Solution.max_palindromic_subsequence("bbbab")
      4

      iex> Solution.max_palindromic_subsequence("a")
      1

      iex> Solution.max_palindromic_subsequence("cbbd")
      2

      iex> Solution.max_palindromic_subsequence("")
      0
  """
  @spec max_palindromic_subsequence(String.t()) :: non_neg_integer()
  def max_palindromic_subsequence(""), do: 0

  def max_palindromic_subsequence(string) do
    chars = String.to_charlist(string)
    length = length(chars)

    # dp[i][j] represents the length of the longest palindromic subsequence
    # in the substring from index i to j (inclusive)
    # We use a 2D array (list of lists) for the DP table.
    dp =
      for _i <- 0..(length - 1),
          _j <- 0..(length - 1),
          do: 0

    # Fill the DP table
    # We iterate over substring lengths from 1 to n
    for len <- 1..length do
      # i is the starting index of the substring
      for i <- 0..(length - len) do
        j = i + len - 1

        case len do
          1 ->
            # Set the base case: single characters have LPS length of 1
            put_in(dp, [i, j], 1)

          _when len > 1 ->
            # Get the LPS values for smaller subproblems
            {inner_max, updated} =
              case Enum.at(Enum.at(dp, i + 1), j) do
                nil ->
                  {Enum.at(Enum.at(dp, i), j - 1), dp}

                val ->
                  {val, dp}
              end

            {upper_right, table1} =
              case Enum.at(Enum.at(dp, i + 1), j) do
                nil ->
                  {inner_max, dp}

                val ->
                  {val, dp}
              end

            {lower_left, table2} =
              case Enum.at(Enum.at(table1, i), j - 1) do
                nil ->
                  {inner_max, table1}

                val ->
                  {val, table1}
              end

            char_i = Enum.at(chars, i)
            char_j = Enum.at(chars, j)

            if char_i == char_j do
              # If characters match, add 2 to the inner LPS
              inner_len =
                case len - 2 do
                  0 ->
                    0

                  _ ->
                    case Enum.at(Enum.at(dp, i + 1), j - 1) do
                      nil ->
                        0

                      val ->
                        val
                    end
                end

              put_in(dp, [i, j], inner_len + 2)
            else
              # If characters don't match, take the max of excluding either character
              max(inner_max, lower_left)
              |> put_in([i, j])
            end
        end
      end
    end

    # The answer is the LPS length for the full string (from index 0 to length-1)
    case Enum.at(Enum.at(dp, 0), length - 1) do
      nil -> 0
      val -> val
    end
  end
end
