---MODULE---
defmodule Solution do
  @doc """
  Counts the number of times a substring appears in a string, including overlapping occurrences.
  """
  @spec sub_count(String.t(), String.t()) :: non_neg_integer()
  def sub_count(text, substr) do
    case substr do
      "" ->
        String.length(text)

      _ ->
        text
        |> String.codepoints()
        |> count_occurrences(substr, 0)
    end
  end

  defp count_occurrences([], _, acc), do: acc

  defp count_occurrences(chars, substr, acc) do
    remaining = Enum.join(chars)
    count = count_in(remaining, substr, 0)

    count_occurrences(Enum.tail(chars), substr, acc + count)
  end

  defp count_in("", _, acc), do: acc

  defp count_in(str, substr, acc) do
    case :binary.match(str, substr, {:first, :all}) do
      {pos, len} ->
        count_in(String.slice(str, pos + len, nil), substr, acc + 1)

      [] ->
        acc
    end
  end
end

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "count single characters" do
    assert Solution.sub_count("hello", "l") == 2
  end

  test "count overlapping occurrences" do
    assert Solution.sub_count("abababa", "aba") == 3
  end

  test "count non-overlapping but with overlaps allowed" do
    assert Solution.sub_count("banana", "na") == 2
  end
end
