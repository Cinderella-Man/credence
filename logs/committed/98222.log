merge_pairs = fn
  merge_pairs_fn ->
    fn
      [] -> []
      [single] -> [single]
      [first = {:defp, _, [head1, _]}, second = {:defp, _, [head2, _]} | rest] ->
        info1 = fun_info.(head1)
        info2 = fun_info.(head2)
        has_guard? = match?({:when, _, _}, head1)
        has_remote? = if has_guard?, do: guard_has_remote_call?(elem(head1, 2) |> Enum.at(1)), else: false
        
        if info1 == info2 and info1 != nil and has_guard? and has_remote? do
          {:when, _, [call_head, guard]} = head1
          {:defp, meta1, [_, body1_kw]} = first
          {:defp, _, [_, body2_kw]} = second
          
          {{:__block__, do1_meta, [:do]}, body1} = hd(body1_kw)
          {{:__block__, _, [:do]}, body2} = hd(body2_kw)
          
          if_expr = {:if, [do: [line: 1, column: 1], end: [line: 1, column: 1]], [guard, [
            {{:__block__, [line: 1, column: 1], [:do]}, body1},
            {{:__block__, [line: 1, column: 1], [:else]}, body2}
          ]]}
          
          new_defp = {:defp, meta1, [call_head, [{{:__block__, do1_meta, [:do]}, if_expr}]]}
          [new_defp | merge_pairs_fn.(merge_pairs_fn).(rest)]
        else
          [first | merge_pairs_fn.(merge_pairs_fn).([second | rest])]
        end
      [first | rest] -> [first | merge_pairs_fn.(merge_pairs_fn).(rest)]
    end
end

