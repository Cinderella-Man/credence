defmodule Solution do
  @moduledoc """
  Provides functionality to calculate the maximum number of connected components
  obtainable by removing at most one edge from a graph.
  """

  @doc """
  Returns the maximum number of connected components that can be obtained
  by removing at most one edge from the graph.
  """
  @spec max_connected_components(non_neg_integer(), list(list(integer()))) :: integer()
  def max_connected_components(0, _edges), do: 0
  def max_connected_components(1, _edges), do: 1

  def max_connected_components(n, edges) when n > 1 do
    initial_count = count_components(n, edges)

    max_after_removal =
      Enum.reduce(edges, initial_count, fn [u, v], max_acc ->
        # Remove the current edge and count components
        remaining_edges = List.delete(edges, [u, v])
        count = count_components(n, remaining_edges)
        if count > max_acc, do: count, else: max_acc
      end)

    max_after_removal
  end

  @spec count_components(non_neg_integer(), list(list(integer()))) :: integer()
  defp count_components(n, _edges) when n == 0, do: 0
  defp count_components(1, _edges), do: 1

  defp count_components(n, edges) do
    adj = build_adjacency(n, edges)

    # We need to track visited nodes to count components
    # Start with all nodes as unvisited
    all_nodes = MapSet.new(1..n)

    count_components_dfs(adj, all_nodes, MapSet.new(), 0)
  end

  @spec count_components_dfs(map(), MapSet.t(), MapSet.t(), integer()) :: integer()
  defp count_components_dfs(_adj, unvisited, _visited, count) when MapSet.size(unvisited) == 0 do
    count
  end

  defp count_components_dfs(adj, unvisited, _visited, count) do
    # Get any node from unvisited to start a new component
    start_node = MapSet.first(unvisited)

    # Find all nodes in this component
    {_visited_new, component_nodes} = dfs_collect(adj, start_node, MapSet.new([start_node]), MapSet.new([start_node]))

    new_unvisited = MapSet.difference(unvisited, component_nodes)

    count_components_dfs(adj, new_unvisited, MapSet.new(), count + 1)
  end

  @spec dfs_collect(map(), integer(), MapSet.t(), MapSet.t()) :: {MapSet.t(), MapSet.t()}
  defp dfs_collect(_adj, _current, visited, stack) when MapSet.empty?(stack) do
    {visited, visited}
  end

  defp dfs_collect(adj, current, visited, stack) do
    {current, new_stack} = MapSet.pop(stack)

    if MapSet.member?(visited, current) do
      dfs_collect(adj, current, visited, new_stack)
    else
      visited = MapSet.put(visited, current)

      neighbors = Map.get(adj, current, [])

      new_stack =
        Enum.reduce(neighbors, new_stack, fn neighbor, stk ->
          if MapSet.member?(visited, neighbor) or MapSet.member?(stk, neighbor) do
            stk
          else
            MapSet.put(stk, neighbor)
          end
        end)

      dfs_collect(adj, current, visited, new_stack)
    end
  end

  @spec build_adjacency(non_neg_integer(), list(list(integer()))) :: map()
  defp build_adjacency(n, edges) do
    adj =
      1..n
      |> Enum.reduce(%{}, fn node, acc ->
        Map.put(acc, node, [])
      end)

    Enum.reduce(edges, adj, fn [u, v], acc ->
      acc
      |> Map.update!(u, fn neighbors -> [v | neighbors] end)
      |> Map.update!(v, fn neighbors -> [u | neighbors] end)
    end)
  end
end[0m
