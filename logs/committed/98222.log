# Full fix flow test
source = """
defmodule Example do
  defp count_components_dfs(_adj, unvisited, _visited, count) when MapSet.size(unvisited) == 0 do
    count
  end

  defp count_components_dfs(adj, unvisited, _visited, count) do
    count + 1
  end
end
"""

ast = Sourceror.parse_string!(source)

# Helper to detect remote function calls in a guard
guard_has_remote_call? = fn guard ->
  Macro.prewalk(guard, false, fn
    {{:., _, [{:__aliases__, _, [_mod]}, _fun]}, _, _} = node, _acc -> {node, true}
    node, acc -> {node, acc}
  end) |> elem(1)
end

# Helper to extract function name and arity from a call head
fun_info = fn
  {:when, _, [call, _guard]} -> fun_info.(call)
  {name, _, args} when is_list(args) -> {name, length(args)}
  _ -> nil
end

# Walk the AST to find and merge consecutive defp pairs
transform = fn transform ->
  fn
    {:__block__, meta, stmts} = node, _acc ->
      new_stmts = Enum.reduce(stmts, [], fn stmt, acc ->
        case acc do
          [prev | rest] ->
            case {prev, stmt} do
              {{:defp, _, [head1, _body1_kw]}, {:defp, _, [head2, _body2_kw]}} ->
                info1 = fun_info.(head1)
                info2 = fun_info.(head2)
                has_guard? = match?({:when, _, _}, head1)
                has_remote? = if has_guard?, do: guard_has_remote_call?(elem(head1, 2) |> Enum.at(1)), else: false
                
                if info1 == info2 and info1 != nil and has_guard? and has_remote? do
                  # Merge!
                  {:when, _, [call_head, guard]} = head1
                  {:defp, meta1, [_, body1_kw]} = prev
                  {:defp, _, [_, body2_kw]} = stmt
                  
                  {{:__block__, do1_meta, [:do]}, body1} = hd(body1_kw)
                  {{:__block__, _, [:do]}, body2} = hd(body2_kw)
                  
                  if_expr = {:if, [do: [line: 1, column: 1], end: [line: 1, column: 1]], [guard, [
                    {{:__block__, [line: 1, column: 1], [:do]}, body1},
                    {{:__block__, [line: 1, column: 1], [:else]}, body2}
                  ]]}
                  
                  new_defp = {:defp, meta1, [call_head, [{{:__block__, do1_meta, [:do]}, if_expr}]]}
                  [new_defp | rest]
                else
                  [stmt, prev | rest]
                end
              _ ->
                [stmt, prev | rest]
            end
          [] ->
            [stmt]
        end
      end) |> Enum.reverse()
      
      {{:__block__, meta, new_stmts}, :ok}
    
    node, acc -> {node, acc}
  end
end

