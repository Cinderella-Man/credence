defmodule Solution do
  @doc """
  Returns the maximum number of connected components that can be obtained
  by removing at most one edge from the graph.
  """
  @spec max_connected_components(integer, [[integer]]) :: integer
  def max_connected_components(_n, []), do: 1

  def max_connected_components(n, edges) do
    # Calculate the initial number of connected components (removing 0 edges)
    initial_count = count_components(n, edges)

    # If there are no edges, we can't remove any, so return initial count
    if Enum.empty?(edges) do
      initial_count
    else
      # Calculate the number of components after removing each edge
      max_after_removal =
        Enum.reduce(edges, initial_count, fn edge, max_acc ->
          remaining_edges = List.delete(edges, edge)
          count = count_components(n, remaining_edges)
          if count > max_acc, do: count, else: max_acc
        end)

      max_after_removal
    end
  end

  defp count_components(n, edges) do
    # Build adjacency list
    adj = build_adjacency(n, edges)

    # Count connected components using BFS/DFS with a visited set
    all_nodes = MapSet.new(1..n)
    count_components_helper(adj, all_nodes, MapSet.new(), 0)
  end

  defp build_adjacency(n, edges) do
    adj =
      1..n
      |> Enum.reduce(%{}, fn node, acc ->
        Map.put(acc, node, [])
      end)

    Enum.reduce(edges, adj, fn [u, v], acc ->
      acc
      |> Map.update!(u, fn neighbors -> [v | neighbors] end)
      |> Map.update!(v, fn neighbors -> [u | neighbors] end)
    end)
  end

  defp count_components_helper(_adj, unvisited, _visited, count) when is_nil(MapSet.pop_first(unvisited)) do
    count
  end

  defp count_components_helper(adj, unvisited, _visited, count) do
    # Get the first unvisited node
    [start_node | rest_unvisited] = MapSet.to_list(unvisited)

    # Perform DFS to find all nodes in this component
    visited_nodes = dfs_collect(adj, start_node, MapSet.new(), MapSet.new())
    
    # Remove visited nodes from unvisited
    new_unvisited = MapSet.difference(unvisited, visited_nodes)
    
    count_components_helper(adj, new_unvisited, _visited, count + 1)
  end

  defp dfs_collect(_adj, current, visited, stack) do
    if MapSet.member?(visited, current) do
      visited
    else
      visited = MapSet.put(visited, current)
      
      neighbors = Map.get(_adj, current, [])
      
      new_stack =
        Enum.reduce(neighbors, stack, fn neighbor, stk ->
          if MapSet.member?(visited, neighbor) do
            stk
          else
            [neighbor | stk]
          end
        end)
      
      dfs_collect(_adj, current, visited, new_stack)
    end
  end
end[0m
