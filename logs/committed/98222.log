defmodule Solution do
  @doc """
  Returns the maximum number of connected components that can be obtained
  by removing at most one edge from the graph.
  """
  @spec max_connected_components(integer, [[integer]]) :: integer
  def max_connected_components(_n, edges) when length(edges) == 0, do: 1

  def max_connected_components(n, edges) do
    # Calculate the initial number of connected components (removing 0 edges)
    initial_count = count_components(n, edges)

    # Calculate the number of components after removing each edge
    max_after_removal =
      edges
      |> Enum.map(fn edge ->
        remaining_edges = List.delete(edges, edge)
        count_components(n, remaining_edges)
      end)
      |> Enum.max()

    max(initial_count, max_after_removal)
  end

  defp count_components(n, edges) do
    # Build adjacency list
    adj = build_adjacency(n, edges)

    # Count connected components using BFS/DFS
    visited = MapSet.new()
    {count, _visited} = count_components_helper(adj, n, visited, 0)
    count
  end

  defp build_adjacency(n, edges) do
    1..n
    |> Enum.map(fn node -> {node, []} end)
    |> Enum.into(%{})
    |> Enum.reduce(fn {node, _}, adj ->
      adj
    end)
    |> Enum.reduce(edges, fn edge, adj ->
      [u, v] = edge
      adj
      |> Map.update!(u, fn neighbors -> [v | neighbors] end)
      |> Map.update!(v, fn neighbors -> [u | neighbors] end)
    end)
  end

  defp count_components_helper(adj, n, visited, count) do
    unvisited = MapSet.difference(MapSet.new(1..n), visited)

    if MapSet.size(unvisited) == 0 do
      {count, visited}
    else
      # Start a new component from an unvisited node
      [start_node | _rest] = MapSet.to_list(unvisited)
      {new_visited, _} = bfs(adj, start_node, visited)
      count_components_helper(adj, n, new_visited, count + 1)
    end
  end

  defp bfs(adj, start, visited) do
    queue = [start]
    bfs_helper(adj, queue, MapSet.put(visited, start))
  end

  defp bfs_helper(_adj, [], visited), do: visited

  defp bfs_helper(adj, queue, visited) do
    {node, remaining_queue} = List.pop_at(queue, 0)
    neighbors = adj[node]

    {new_visited, new_queue} =
      Enum.reduce(neighbors, {visited, remaining_queue}, fn neighbor, {vis, q} ->
        if MapSet.member?(vis, neighbor) do
          {vis, q}
        else
          MapSet.put(vis, neighbor)
          [neighbor | q]
        end
      end)

    bfs_helper(adj, new_queue, new_visited)
  end
end
