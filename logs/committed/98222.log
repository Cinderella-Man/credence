## Python Instruction
Write a python function to find the maximum number of connected components that can be made equal by removing at most one edge from the graph.

## Python Solution
```python
from collections import defaultdict

def max_connected_components(n, edges):
    def dfs(node, visited, graph):
        visited.add(node)
        for neighbor in graph[node]:
            if neighbor not in visited:
                dfs(neighbor, visited, graph)

    graph = defaultdict(list)
    for u, v in edges:
        graph[u].append(v)
        graph[v].append(u)

    visited = set()
    max_components = 0
    for u, v in edges:
        graph[u].remove(v)
        graph[v].remove(u)

        components = 0
        for i in range(1, n+1):
            if i not in visited:
                dfs(i, visited, graph)
                components += 1

        max_components = max(max_components, components)
        graph[u].append(v)
        graph[v].append(u)

    return max_components
```

