defmodule Solution do
  def max_connected_components(n, edges) do
    graph = build_graph(n, edges)
    initial = count_components(graph, n)
    Enum.reduce(edges, initial, fn [u, v], acc_max ->
      modified_graph = remove_edge(graph, u, v)
      current = count_components(modified_graph, n)
      max(acc_max, current)
    end)
  end

  defp build_graph(n, edges) do
    base = Map.new(1..n, fn x -> {x, []} end)
    Enum.reduce(edges, base, fn [u, v], acc ->
      acc
      |> Map.update!(u, &[v | &1])
      |> Map.update!(v, &[u | &1])
    end)
  end

  defp remove_edge(graph, u, v) do
    graph
    |> Map.update!(u, &List.delete(&1, v))
    |> Map.update!(v, &List.delete(&1, u))
  end

  defp count_components(graph, n) do
    visited = MapSet.new()
    {count, _} =
      Enum.reduce(1..n, {0, visited}, fn node, {count, visited} ->
        if MapSet.member?(visited, node) do
          {count, visited}
        else
          new_visited = dfs(node, graph, visited)
          {count + 1, new_visited}
        end
      end)
    count
  end

  defp dfs(node, graph, visited) do
    if MapSet.member?(visited, node) do
      visited
    else
      visited = MapSet.put(visited, node)
      neighbors = Map.get(graph, node, [])
      Enum.reduce(neighbors, visited, fn neighbor, acc_visited ->
        dfs(neighbor, graph, acc_visited)
      end)
    end
  end
end

