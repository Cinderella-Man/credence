"""
@spec longest_palindrome_subseq(String.t()) :: non_neg_integer()
def longest_palindrome_subseq(string) do
  chars = String.to_charlist(string)
  length_chars = length(chars)
  memo = Array.new(length_chars * length_chars, 0)

  solve(chars, 0, length_chars - 1, memo)
end

defp solve(chars, left, right, memo) do
  cond do
    left > right -> 0
    left == right -> 1
    true ->
      idx = left * length(chars) + right
      case Array.get(memo, idx) do
        0 ->
          result = do_solve(chars, left, right, memo)
          memo = Array.put(memo, idx, result)
          result
        val ->
          val
      end
  end
end

defp do_solve(chars, left, right, memo) do
  left_char = Enum.at(chars, left)
  right_char = Enum.at(chars, right)

  if left_char == right_char do
    if left + 1 > right - 1 do
      case left + 1 == right - 1 do
        true -> 1 + 1
        false -> 2
      end
    else
      2 + solve(chars, left + 1, right - 1, memo)
    end
  else
    max(
      solve(chars, left + 1, right, memo),
      solve(chars, left, right - 1, memo)
