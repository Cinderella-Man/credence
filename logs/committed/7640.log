source = """
defmodule Solution do
  def calculate do
    max(3, 5)
  end

  defp max(a, b) when a >= b, do: a
  defp max(a, b) when b > a, do: b
end
"""

# Method 1: AST transformation
ast = Sourceror.parse_string!(source)
transformed = Macro.prewalk(ast, fn
  {:__block__, meta, stmts} when is_list(stmts) ->
    filtered = Enum.reject(stmts, fn
      {:defp, _, _} -> true
      _ -> false
    end)
    {:__block__, meta, filtered}
  node -> node
end)

result1 = Sourceror.to_string(transformed) <> "\n"

# Method 2: Regex removal
lines = String.split(source, "\n")
filtered = Enum.reject(lines, fn line -> Regex.match?(~r/^\s*defp\s+max\b/, line) end)
result2 = Enum.join(filtered, "\n")
result2 = Regex.replace(~r/\n{3,}/, result2, "\n\n")

expected = """
defmodule Solution do
  def calculate do
    max(3, 5)
  end
end
"""

