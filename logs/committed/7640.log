@doc """
Returns the length of the longest palindromic subsequence in the given string.
"""
@spec longest_palindrome_subseq(String.t()) :: non_neg_integer()
def longest_palindrome_subseq(<<>>) do
  0
end

def longest_palindrome_subseq(<<char>>) do
  1
end

def longest_palindrome_subseq(string) when is_binary(string) and byte_size(string) >= 2 do
  chars = String.codepoints(string)
  length = length(chars)
  solve(chars, 0, length - 1)
end

defp solve(chars, left, right) when left > right do
  0
end

defp solve(chars, left, right) when left == right do
  1
end

defp solve(chars, left, right) do
  case chars do
    [^left_char | rest] when left_char = Enum.at(chars, left) ->
      # We need to work with indices, so let's use a different approach
      solve_helper(chars, left, right)
  end
end

defp solve_helper(chars, left, right) when left >= right do
  if left == right, do: 1, else: 0
end

defp solve_helper(chars, left, right) do
  left_char = Enum.at(chars, left)
  right_char = Enum.at(chars, right)

  if left_char == right_char do
    2 + solve_helper(chars, left + 1, right - 1)
  else
    max(
      solve_helper(chars, left + 1, right),
      solve_helper(chars, left, right - 1)
    )
  end
end[0m
