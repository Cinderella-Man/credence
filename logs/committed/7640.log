@doc """
Returns the length of the longest palindromic subsequence in the given string.
"""
@spec longest_palindrome_subseq(String.t()) :: non_neg_integer()
def longest_palindrome_subseq(string) when is_binary(string) do
  chars = String.graphemes(string)
  n = length(chars)

  if n == 0 do
    0
  else
    memo = :ets.new(:lps_memo, [:set, :private, :read_write_concurrency])
    try do
      do_longest_palindrome_subseq(chars, 0, n - 1, memo)
    after
      :ets.delete(memo)
    end
  end
end

defp do_longest_palindrome_subseq(chars, left, right, memo) do
  cond do
    left > right ->
      0
    left == right ->
      1
    :ets.lookup(memo, {left, right}) |> length() > 0 ->
      {_, val} = hd(:ets.lookup(memo, {left, right}))
      val
    true ->
      result = calc(chars, left, right, memo)
      :ets.insert_new(memo, {{left, right}, result})
      result
  end
end

defp calc(chars, left, right, memo) do
  left_char = Enum.at(chars, left)
  right_char = Enum.at(chars, right)

  if left_char == right_char do
    2 + do_longest_palindrome_subseq(chars, left + 1, right - 1, memo)
  else
    max(
      do_longest_palindrome_subseq(chars, left + 1, right, memo),
      do_longest_palindrome_subseq(chars, left, right - 1, memo)
    )
  end
end

defp max(a, b) when a >= b, do: a
defp max(a, b) when b > a, do: b[0m
