defmodule Solution do
  def longest_palindrome_subseq(s) do
    n = String.length(s)
    if n == 0, do: 0, else: do_longest(s, n)
  end

  defp do_longest(s, n) do
    # Convert string to a list of characters for easy indexing
    chars = String.graphemes(s)
    # Initialize DP table as a map with default 0
    dp = %{}
    # Build DP table bottom-up
    for i <- (n - 1)..0, reduce: dp do
      acc ->
        acc = Map.put(acc, {i, i}, 1)
        for j <- (i + 1)..(n - 1), reduce: acc do
          dp ->
            if Enum.at(chars, i) == Enum.at(chars, j) do
              Map.put(dp, {i, j}, 2 + Map.get(dp, {i + 1, j - 1}, 0))
            else
              Map.put(dp, {i, j}, max(Map.get(dp, {i + 1, j}, 0), Map.get(dp, {i, j - 1}, 0)))
            end
        end
    end
    |> Map.get({0, n - 1}, 0)
  end
end

