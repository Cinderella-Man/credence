IO.inspect(result1)
IO.puts("Match expected? #{result1 == expected}")

IO.puts("\n=== Method 2 (Regex) ===")
IO.inspect(result2)
IO.puts("Match expected? #{result2 == expected}")

# Also verify valid_syntax? works
case Sourceror.parse_string(result1) do
  {:ok, _} -> IO.puts("Method 1: valid syntax")
  {:error, _} -> IO.puts("Method 1: INVALID syntax")
end
case Sourceror.parse_string(result2) do
  {:ok, _} -> IO.puts("Method 2: valid syntax")
  {:error, _} -> IO.puts("Method 2: INVALID syntax")
end
EOF
