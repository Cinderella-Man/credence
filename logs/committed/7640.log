---INSTRUCTION---
Write an Elixir function that, given a string, returns the length of the longest palindromic subsequence in that string. A palindromic subsequence is a sequence of characters (not necessarily contiguous) that reads the same forwards and backwards. The function must be named `longest_palindrome_subseq` and take a single string argument. The function should handle an empty string by returning 0. The time complexity should be O(n²) where n is the length of the string.

---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "longest palindromic subsequence for 'bbbab' is 4" do
    assert Solution.longest_palindrome_subseq("bbbab") == 4
  end

  test "longest palindromic subsequence for 'abac' is 3" do
    assert Solution.longest_palindrome_subseq("abac") == 3
  end

  test "longest palindromic subsequence for 'cbbd' is 2" do
    assert Solution.longest_palindrome_subseq("cbbd") == 2
  end
end

---REFERENCE---
defmodule Solution do
  @spec longest_palindrome_subseq(s :: String.t()) :: integer()
  def longest_palindrome_subseq(s) do
    n = String.length(s)
    s_tuple = String.to_tuple(s)

    dp =
      for i <- (n - 1)..0//-1,
          reduce: %{} do
        dp ->
          dp = Map.put(dp, {i, i}, 1)

          for j <- (i + 1)..(n - 1),
              reduce: dp do
            dp ->
              if elem(s_tuple, i) == elem(s_tuple, j) do
                val = if i + 1 <= j - 1, do: Map.get(dp, {i + 1, j - 1}, 0), else: 0
                Map.put(dp, {i, j}, 2 + val)
              else
                val1 = Map.get(dp, {i + 1, j}, 0)
                val2 = Map.get(dp, {i, j - 1}, 0)
                Map.put(dp, {i, j}, max(val1, val2))
              end
          end
      end

    Map.get(dp, {0, n - 1}, 0)
  end
end

