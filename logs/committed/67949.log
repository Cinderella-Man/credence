---REFERENCE---
```elixir
defmodule Solution do
  def longest_equal_zero_one(arr) do
    arr
    |> Enum.with_index()
    |> Enum.reduce({0, 0, %{0 => -1}}, fn {val, idx}, {sum, max_length, sum_map} ->
      new_sum = if val == 0, do: sum - 1, else: sum + 1

      new_max =
        case Map.get(sum_map, new_sum) do
          nil -> max_length
          prev_idx -> max(max_length, idx - prev_idx)
        end

      new_sum_map =
        case Map.has_key?(sum_map, new_sum) do
          true -> sum_map
          false -> Map.put(sum_map, new_sum, idx)
        end

      {new_sum, new_max, new_sum_map}
    end)
    |> elem(1)
  end
end
```

