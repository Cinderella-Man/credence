  end

  test "groups numbers by first digit, mixed lengths" do
    assert Solution.group_by_first_digit([111, 22, 3, 4444, 555, 66, 7, 888, 99]) == [[111], [22], [3], [4444], [555], [66], [7], [888], [99]]
