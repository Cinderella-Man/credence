---MODULE---
defmodule Solution do
  @doc """
  Groups a list of integers by their first digit.

  Each subgroup contains numbers that share the same first (most significant)
  digit. The result is a list of lists ordered by the first digit in ascending
  order (0 through 9), with only non-empty groups included.

  ## Examples

      iex> Solution.group_by_first_digit([12, 23, 34])
      [[12], [23], [34]]

      iex> Solution.group_by_first_digit([10, 11, 12, 20, 21])
      [[10, 11, 12], [20, 21]]
  """
  @spec group_by_first_digit([integer()]) :: [[integer()]]
  def group_by_first_digit(numbers) do
    groups =
      Enum.group_by(numbers, &first_digit/1)
      |> Map.to_list()
      |> Enum.sort()
      |> Enum.map(fn {_digit, values} -> values end)

    # Filter out any empty groups (shouldn't happen with non-empty input lists
    # grouped by a function that always returns a digit, but be safe)
    Enum.filter(groups, &(&1 != []))
  end

  @spec first_digit(integer()) :: non_neg_integer()
  defp first_digit(number) do
    number
    |> abs()
    |> to_string()
    |> String.first()
    |> String.to_integer()
  end
end
