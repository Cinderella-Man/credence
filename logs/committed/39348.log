```elixir
defmodule Solution do
  @moves [{1, 2}, {2, 1}, {-1, 2}, {-2, 1}, {1, -2}, {2, -1}, {-1, -2}, {-2, -1}]

  def knight_moves(x, y) do
    x = abs(x)
    y = abs(y)
    {x, y} = if x < y, do: {y, x}, else: {x, y}

    bfs(:queue.from_list([{0, 0, 0}]), MapSet.new([{0, 0}]), x, y)
  end

  defp bfs(queue, visited, tx, ty) do
    case :queue.out(queue) do
      {:empty, _} ->
        -1

      {{:value, {i, j, moves}}, rest} ->
        if i == tx and j == ty do
          moves
        else
          {new_queue, new_visited} =
            Enum.reduce(@moves, {rest, visited}, fn {dx, dy}, {q, v} ->
              ni = i + dx
              nj = j + dy

              if MapSet.member?(v, {ni, nj}) do
                {q, v}
              else
                {:queue.in({ni, nj, moves + 1}, q), MapSet.put(v, {ni, nj})}
              end
            end)

          bfs(new_queue, new_visited, tx, ty)
        end
    end
  end
end
```
