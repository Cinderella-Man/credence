defmodule Solution do
  @moduledoc """
  Provides functionality to calculate the minimum number of moves
  for a chess knight to travel from (0, 0) to a given destination (x, y).
  """

  @doc """
  Returns the minimum number of knight moves to reach (x, y) from (0, 0).
  """
  @spec knight_moves(integer(), integer()) :: non_neg_integer()
  def knight_moves(0, 0), do: 0

  def knight_moves(x, y) do
    # Normalize coordinates using symmetry.
    # The knight's movement is symmetric across both axes and the diagonal.
    # We can work with absolute values and ensure x >= y >= 0.
    abs_x = abs(x)
    abs_y = abs(y)

    {x, y} = normalize_coords(abs_x, abs_y)

    # BFS queue: {current_x, current_y, moves}
    # We use a Set for visited positions to avoid cycles and redundant processing.
    visited = MapSet.new([{0, 0}])
    queue = [{0, 0, 0}]

    bfs_step(queue, visited, x, y)
  end

  defp normalize_coords(abs_x, abs_y) when abs_x >= abs_y do
    {abs_x, abs_y}
  end

  defp normalize_coords(abs_x, abs_y) do
    {abs_y, abs_x}
  end

  # Should not happen
  defp bfs_step([], _visited, _target_x, _target_y), do: 0

  defp bfs_step([{cx, cy, moves} | rest], visited, target_x, target_y) do
    if cx == target_x and cy == target_y do
      moves
    else
      # Generate all 8 knight moves
      possible_moves = [
        {cx + 2, cy + 1},
        {cx + 2, cy - 1},
        {cx - 2, cy + 1},
        {cx - 2, cy - 1},
        {cx + 1, cy + 2},
        {cx + 1, cy - 2},
        {cx - 1, cy + 2},
        {cx - 1, cy - 2}
      ]

      # Pruning: We don't need to go too far beyond the target.
      # A reasonable bound is max(abs(target_x), abs(target_y)) + some margin.
      max_coord = max(target_x, target_y) + 5
      min_coord = -5

      new_moves =
        Enum.filter(possible_moves, fn {nx, ny} ->
          !MapSet.member?(visited, {nx, ny}) and
            nx >= min_coord and nx <= max_coord and
            ny >= min_coord and ny <= max_coord
        end)

      new_visited =
        Enum.reduce(new_moves, visited, fn {nx, ny}, acc ->
          MapSet.put(acc, {nx, ny})
        end)

      new_queue =
        rest ++
          Enum.map(new_moves, fn {nx, ny} ->
            {nx, ny, moves + 1}
          end)

      bfs_step(new_queue, new_visited, target_x, target_y)
    end
  end
end
