defmodule Solution do
  @moduledoc """
  Provides functionality to calculate the minimum number of moves
  for a chess knight to travel from (0, 0) to a given destination (x, y).
  """

  @doc """
  Returns the minimum number of knight moves to reach (x, y) from (0, 0).
  """
  @spec knight_moves(integer(), integer()) :: non_neg_integer()
  def knight_moves(0, 0), do: 0

  def knight_moves(x, y) do
    # Normalize coordinates using symmetry.
    # The knight's movement is symmetric across both axes and the diagonal.
    # We can work with absolute values and ensure x >= y >= 0.
    x = abs(x)
    y = abs(y)

    {x, y} = if x < y do
      {y, x}
    else
      {x, y}
    end

    # Now x >= y >= 0.
    # We use BFS conceptually, but for an infinite board, there are known
    # patterns and optimizations. However, given the test cases, a BFS is
    # safer and straightforward. Since the board is infinite, we bound the
    # search space reasonably. The max coordinate we might need to explore
    # is roughly proportional to the max(|x|, |y|).

    # For small distances, we can use direct formulas, but BFS is general.
    # Let's implement BFS.

    target_x = x
    target_y = y

    # BFS queue: {current_x, current_y, moves}
    # We use a Set for visited positions to avoid cycles and redundant processing.
    visited = MapSet.new()
    queue = [{0, 0, 0}]
    visited = MapSet.put(visited, {0, 0})

    bfs_step(queue, visited, target_x, target_y)
  end

  defp bfs_step([], _visited, _target_x, _target_y), do: 0 # Should not happen

  defp bfs_step([{cx, cy, moves} | rest], visited, target_x, target_y) do
    if cx == target_x and cy == target_y do
      moves
    else
      # Generate all 8 knight moves
      moves = [
        {cx + 2, cy + 1},
        {cx + 2, cy - 1},
        {cx - 2, cy + 1},
        {cx - 2, cy - 1},
        {cx + 1, cy + 2},
        {cx + 1, cy - 2},
        {cx - 1, cy + 2},
        {cx - 1, cy - 2}
      ]

      # Pruning: We don't need to go too far beyond the target.
      # A reasonable bound is max(abs(target_x), abs(target_y)) + some margin.
      # But since we normalized and the knight moves efficiently, we can use a
      # simpler bound: if the coordinates are too far in the negative direction
      # or too far beyond the target in a way that doesn't make sense.
      # Actually, BFS on an infinite grid requires bounding. Let's use a bound
      # of roughly 2 * max(|x|, |y|) + 5 or something similar.
      
      max_coord = max(target_x, target_y) + 5
      min_coord = -5 # We don't need to go too far negative since we normalized

      new_moves = Enum.filter(moves, fn {nx, ny} ->
        !MapSet.member?(visited, {nx, ny}) and
        nx >= min_coord and nx <= max_coord and
        ny >= min_coord and ny <= max_coord
      end)

      new_visited = Enum.reduce(new_moves, visited, fn {nx, ny}, acc ->
        MapSet.put(acc, {nx, ny})
      end)

      new_queue = rest ++ Enum.map(new_moves, fn {nx, ny} ->
        {nx, ny, moves + 1}
      end)

      bfs_step(new_queue, new_visited, target_x, target_y)
    end
  end
end[0m
