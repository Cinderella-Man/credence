  """
  @spec can_reorder_diff_one([integer()]) :: boolean()
  def can_reorder_diff_one([]), do: false

  def can_reorder_diff_one([_]), do: false

  def can_reorder_diff_one(list) do
    freqs = Enum.group_by(list, & &1) |> Map.new(fn {k, v} -> {k, length(v)} end)
    unique_sorted = Map.keys(freqs) |> Enum.sort()

    case unique_sorted do
      [] -> true
      _ ->
        min_val = hd(unique_sorted)
        max_val = List.last(unique_sorted)
        expected_length = max_val - min_val + 1

        # Check if all integers in range [min_val, max_val] are present
        if length(unique_sorted) != expected_length do
          false
        else
          # Check if the frequency counts allow for a valid consecutive arrangement.
          # A necessary condition for a valid arrangement on a line graph is that
          # at most two values have odd frequencies (the endpoints).
          # However, this is for Eulerian paths on undirected graphs.
          # For a simple consecutive arrangement a1, a2, ..., an where |ai - ai+1| = 1:
          # The multiset must form a contiguous range (checked above).
          # Additionally, we need to ensure the "flow" works.

          # Actually, the condition is simpler:
          # If we have a contiguous range of integers, a valid permutation always exists
          # IF AND ONLY IF the maximum frequency is not too large relative to the others.
          # Specifically, in a valid sequence, no element can appear more than ceil(n/2) times?
          # No, that's for non-adjacent duplicates.

          # Let's think about it: 1,2,3,2 -> counts: 1:1, 2:2, 3:1. Valid.
          # 2,1,2,3 -> counts: 1:1, 2:2, 3:1. Valid.
          # 1,2,3 -> counts: 1:1, 2:1, 3:1. Valid.
          # 2,2,2,3 -> counts: 2:3, 3:1. Can we do it? 2,3,2,2? No, last two are diff 0.
          # 2,2,3,2 -> 2-2 diff 0. No.
          # 3,2,2,2 -> No.
          # So 2,2,2,3 is invalid.

          # What's the condition?
          # In any valid sequence, between two occurrences of the same number x,
          # there must be at least one number. So if a number appears k times,
          # we need at least k-1 "separators" which are different numbers.
          # The total number of other elements is n - k.
          # We need n - k >= k - 1, so n + 1 >= 2k, or k <= (n + 1) / 2.

          # Let's verify:
          # [1,2,3,2]: n=4, max_freq=2. 2 <= (4+1)/2 = 2.5. True. Valid.
          # [2,2,2,3]: n=4, max_freq=3. 3 <= 2.5. False. Invalid. Correct!
          # [1,1]: n=2, max_freq=2. 2 <= 1.5. False. Invalid. Correct (diff is 0).
          # [1,2]: n=2, max_freq=1. 1 <= 1.5. True. Valid.
          # [1,2,2,3]: n=4, max_freq=2. 2 <= 2.5. True. Valid.

          # So the conditions are:
          # 1. All numbers form a contiguous range.
          # 2. max_frequency <= (length + 1) // 2

          n = length(list)
          max_freq = Enum.max(Map.values(freqs))
          max_freq <= div(n + 1, 2)
        end
    end
  end
end[0m
