defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "can reorder with consecutive difference of 1" do
    assert Solution.can_reorder_diff_one([1, 3, 2, 4]) == true
    assert Solution.can_reorder_diff_one([5, 4, 3, 2, 1]) == true
    assert Solution.can_reorder_diff_one([1, 3, 5, 7]) == false
  end

  test "cannot reorder with duplicates that are too frequent" do
    assert Solution.can_reorder_diff_one([2, 2, 2, 3]) == false
  end

  test "cannot reorder with duplicate single value" do
    assert Solution.can_reorder_diff_one([1, 1]) == false
  end

  test "can reorder with two different values" do
    assert Solution.can_reorder_diff_one([1, 2]) == true
  end

  test "can reorder with duplicate middle value" do
    assert Solution.can_reorder_diff_one([1, 2, 2, 3]) == true
  end
end
