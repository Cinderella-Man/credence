defmodule Solution do
  @doc """
  Given two lists, find the elements that appear in both lists, taking frequency into account.
  For each common element, the returned frequency should be the minimum of its count in the
  first list and its count in the second list. Return a list of two-element tuples
  `{element, frequency}` for every element that appears in both lists.
  """
  @spec common_elements_with_frequency(list(), list()) :: [{any(), non_neg_integer()}]
  def common_elements_with_frequency(lst1, lst2) do
    freq1 = Enum.frequencies(lst1)
    freq2 = Enum.frequencies(lst2)

    common_keys = Map.keys(freq1) |> MapSet.new() |> MapSet.intersection(MapSet.new(Map.keys(freq2))) |> MapSet.to_list()

    common_keys
    |> Enum.map(fn element ->
      count1 = Map.fetch!(freq1, element)
      count2 = Map.fetch!(freq2, element)
      {element, min(count1, count2)}
    end)
    |> Enum.sort()
  end
end
