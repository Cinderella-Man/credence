      count2 = Map.fetch!(freq2, element)
      {element, min(count1, count2)}
    end)
    |> Enum.sort()
  end
end
===AFTER===
defmodule Solution do
  @spec common_elements_with_frequency(list(), list()) :: [{any(), non_neg_integer()}]
  def common_elements_with_frequency(lst1, lst2) do
    freq1 = Enum.frequencies(lst1)
    freq2 = Enum.frequencies(lst2)

    freq1
    |> Map.intersect(freq2, fn _key, count1, count2 -> min(count1, count2) end)
    |> Enum.sort_by(fn {key, _value} -> key end)
  end
end
===ASSUMPTIONS===
===RATIONALE===
Map.intersect/3 (Elixir 1.14+) replaces a verbose MapSet.new → intersection → to_list → map pipeline with a single, clearer call.
