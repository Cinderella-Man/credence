defmodule Solution do
  @spec replace_zero(list(list(number))) :: list(list(number))
  def replace_zero(matrix) do
    Enum.map(matrix, fn row ->
      non_zero_values = Enum.filter(row, &(&1 != 0))
      min_val = if non_zero_values == [], do: 0, else: Enum.min(non_zero_values)

      Enum.map(row, fn x ->
        if x == 0, do: min_val, else: x
      end)
    end)
  end
end
