    content: defmodule Credence.Syntax.CloseUnclosedFnDelimiter do
  @moduledoc """
  Detects and fixes unclosed `fn` delimiters where the LLM writes
  `end)` (closing an inner block + the fn-call paren) without the
  matching `end` that should close the `fn` itself.

  LLMs frequently produce code like:

      Enum.map(row, fn element ->
        if element == 0 do min_value else element end)
      end

  where the `end` closes the `if` block and `)` closes the `Enum.map`
  call, but the `fn` body is never closed. The fix inserts the missing
  `end` before the closing paren:

      Enum.map(row, fn element ->
        if element == 0 do min_value else element end end)
      end
  """
  use Credence.Syntax.Rule

  alias Credence.Issue

  @end_paren ~r/end\)+$/

  @impl true
  def analyze(source) do
    lines = String.split(source, "\n")

    lines
    |> Enum.with_index(1)
    |> Enum.scan({0, nil}, fn {line, line_no}, {fn_depth, _prev} ->
      new_depth = fn_depth + count_fn(line) - count_end(line)
      {new_depth, {line, line_no, fn_depth}}
    end)
    |> Enum.flat_map(fn
      {_depth, nil} ->
        []

      {_depth, {line, line_no, fn_depth_before}} ->
        if fn_depth_before > 0 and
             Regex.match?(@end_paren, line) and
             fn_depth_stays_positive?(line, fn_depth_before) do
          [
            %Issue{
              rule: :close_unclosed_fn_delimiter,
              message:
                "Unclosed `fn` delimiter — the `fn` body is not closed before `)`.",
              meta: %{line: line_no}
            }
          ]
        else
          []
        end
    end)
  end

  @impl true
  def fix(source) do
    lines = String.split(source, "\n")

    {fixed_lines, _final_depth} =
      Enum.map_reduce(lines, 0, fn line, fn_depth ->
        new_depth = fn_depth + count_fn(line) - count_end(line)

        fixed =
          if fn_depth > 0 and
               Regex.match?(@end_paren, line) and
               fn_depth_stays_positive?(line, fn_depth) do
            String.replace(line, ~r/end\)/, "end end)", global: false)
          else
            line
          end

        {fixed, new_depth}
      end)

    Enum.join(fixed_lines, "\n")
  end

  # True when fn_depth never drops to 0 or below while scanning keywords
  # left-to-right on the line. When it stays positive, the `end)` is
  # closing an inner block (if/case/etc.), not the pre-existing fn.
  defp fn_depth_stays_positive?(line, initial_depth) do
    tokens = Regex.scan(~r/\bfn\b|\bend\b/, line) |> List.flatten()

    min_depth =
      Enum.reduce(tokens, initial_depth, fn
        "fn", depth -> depth + 1
        "end", depth -> min(depth, depth - 1)
      end)

    min_depth > 0
  end

  defp count_fn(line) do
    Regex.scan(~r/\bfn\b/, line) |> length()
  end

  defp count_end(line) do
    Regex.scan(~r/\bend\b/, line) |> length()
  end
end

