defmodule Before do
  def build_groups(acc, []) do
    [Enum.reverse(acc)]
  end
  def build_groups(acc, [next | rest]) do
    last = List.last(acc)
    if next == last + 1 do
      build_groups(acc ++ [next], rest)
    else
      [Enum.reverse(acc) | build_groups([next], rest)]
    end
  end
end

defmodule After do
  def build_groups(acc, []) do
    [acc]
  end
  def build_groups([head | _] = acc, [next | rest]) do
    if next == head + 1 do
      build_groups([next | acc], rest)
    else
      [acc | build_groups([next], rest)]
    end
  end
end

tests = [
  {[1], []},
  {[1], [2, 3, 4]},
  {[1], [2, 3, 5, 6, 7, 9]},
  {[10], [11, 12, 15, 16, 20]},
  {[-5], [-4, -3, -2, 0, 1, 2]},
  {[100], Enum.to_list(101..120)},
  {[5], [5]},
  {[1], [3, 5, 7]},
  {[], []}
]

all_pass = Enum.all?(tests, fn {acc, rest} ->
  b = Before.build_groups(acc, rest)
  a = After.build_groups(acc, rest)
  if b != a, do: IO.puts("MISMATCH: #{inspect({acc, rest})} => B: #{inspect(b)}, A: #{inspect(a)}")
  b == a
end)

IO.puts(if all_pass, do: "ALL TESTS PASS", else: "SOME TESTS FAILED")
