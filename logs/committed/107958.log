    IO.puts("params: #{inspect(params, limit: 5)}")
    
    # Check each param
    Enum.each(params, fn param ->
      case param do
        {var_name, _, ctx} when is_atom(var_name) and (is_nil(ctx) or is_atom(ctx)) ->
          IO.puts("  param #{var_name} is a bare var")
          ul = uses_list_last_test(body, var_name)
          ua = uses_append_test(body, var_name)
          IO.puts("  uses_list_last?(#{var_name}): #{ul}")
          IO.puts("  uses_append?(#{var_name}): #{ua}")
        _ ->
          IO.puts("  param #{inspect(param, limit: 3)} is NOT a bare var")
      end
    end)
    
    node
  node, acc -> {node, acc}
end)

defp uses_list_last_test(body, var_name) do
  {_, found} = Macro.prewalk(body, false, fn
    {{:., _, [{:__aliases__, _, [:List]}, :last]}, _, [{^var_name, _, _}]} = node, _ ->
      {node, true}
    node, acc -> {node, acc}
  end)
  found
end

defp uses_append_test(body, var_name) do
  {_, found} = Macro.prewalk(body, false, fn
    {:++, _, [{^var_name, _, _}, _]} = node, _ -> {node, true}
    {:++, _, [_, {^var_name, _, _}]} = node, _ -> {node, true}
    node, acc -> {node, acc}
  end)
  found
end
