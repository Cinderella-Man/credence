@doc """
Given a list of positive integers, returns a list of lists of consecutive
integers from the original list. Consecutive integers are those that follow
each other in order (each integer is one more than the previous).
"""
@spec consecutive_sublists([pos_integer()]) :: [[pos_integer()]]
def consecutive_sublists([]), do: []

def consecutive_sublists([first | rest]) do
  do_group([first], rest)
end

defp do_group(current_group, []) do
  [current_group]
end

defp do_group(current_group, [next | rest]) do
  head = hd(current_group)

  if next == head + 1 do
    do_group([next | current_group], rest)
  else
    [Enum.reverse(current_group) | do_group([next], rest)]
  end
end
