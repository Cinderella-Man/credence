defmodule Solution do
  def consecutive_sublists([]), do: []
  def consecutive_sublists([head | tail]) do
    {last_current, result} = do_consecutive(tail, [head], [])
    [last_current | result]
    |> Enum.reverse()
    |> Enum.map(&Enum.reverse/1)
  end

  defp do_consecutive([], current, result), do: {current, result}
  defp do_consecutive([next | rest], [last | _] = current, result) when next == last + 1 do
    do_consecutive(rest, [next | current], result)
  end
  defp do_consecutive([next | rest], current, result) do
    do_consecutive(rest, [next], [current | result])
  end
end

