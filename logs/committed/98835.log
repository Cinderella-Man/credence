defmodule Solution do
  @moduledoc false

  @doc """
  Sorts a list of strings alphabetically using bubble sort.
  """
  @spec bubble_sort_strings([String.t()]) :: [String.t()]
  def bubble_sort_strings(list) do
    n = length(list)
    do_bubble_sort(list, n)
  end

  defp do_bubble_sort(list, 0), do: list
  defp do_bubble_sort(list, n) when n > 0 do
    new_list = bubble_pass(list)
    do_bubble_sort(new_list, n - 1)
  end

  defp bubble_pass([]), do: []
  defp bubble_pass([x]), do: [x]
  defp bubble_pass([x, y | rest]) when x > y do
    [y | bubble_pass([x | rest])]
  end
  defp bubble_pass([x, y | rest]) do
    [x | bubble_pass([y | rest])]
  end
end
