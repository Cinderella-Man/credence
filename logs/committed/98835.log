             end
             """)
    end

    test "in multi-arg function" do
      assert flagged?(NoRedundantUnderscoreBind, """
             defmodule Example do
               def foo(a, _ = b, c), do: a + b + c
             end
             """)
    end

    test "in private function" do
      assert flagged?(NoRedundantUnderscoreBind, """
             defmodule Example do
               defp bar(_ = x), do: x * 2
             end
             """)
    end

    test "in case clause" do
      assert flagged?(NoRedundantUnderscoreBind, """
             case val do
               _ = x -> x + 1
             end
             """)
    end

    test "multiple occurrences" do
      code = """
