@doc """
Sorts a list of strings alphabetically using the bubble sort algorithm.
The function modifies the list in-place by swapping adjacent elements
until no more swaps are needed.
"""
@spec bubble_sort_strings(list(String.t())) :: list(String.t())
def bubble_sort_strings(list) do
  # Convert to list of characters for mutable-like operation using List.duplicate
  # and List.update_at, though Elixir lists are immutable.
  # We'll implement bubble sort on a list using index-based access via List.replace_at
  # or by converting to a list and using recursive swapping.

  case list do
    [] -> []
    [_] -> list
    _ -> do_bubble_sort(list)
  end
end

defp do_bubble_sort(list) do
  {sorted_list, swapped?} = bubble_pass(list, false, 0)

  if swapped? do
    do_bubble_sort(sorted_list)
  else
    sorted_list
  end
end

defp bubble_pass(list, swapped?, index) when index < length(list) - 1 do
  # Get current and next elements
  # We need to access index and index+1
  current_elem = Enum.at(list, index)
  next_elem = Enum.at(list, index + 1)

  if current_elem > next_elem do
    # Swap them
    new_list =
      list
      |> List.replace_at(index, next_elem)
      |> List.replace_at(index + 1, current_elem)

    bubble_pass(new_list, true, index + 1)
  else
    bubble_pass(list, swapped?, index + 1)
  end
end

defp bubble_pass(list, swapped?, _index) do
  {list, swapped?}
end
