@moduledoc """
Solution module for counting distinct non-empty subsequences.
"""

defmodule Solution do
  @moduledoc false

  @doc """
  Returns the number of distinct non-empty subsequences of the given string,
  modulo 1_000_000_007.

  ## Examples

      iex> Solution.number_of_distinct_subsequences("abc")
      7

      iex> Solution.number_of_distinct_subsequences("aaa")
      3

      iex> Solution.number_of_distinct_subsequences("aba")
      6
  """
  @spec number_of_distinct_subsequences(String.t()) :: non_neg_integer()
  def number_of_distinct_subsequences(string) when is_binary(string) do
    mod = 1_000_000_007

    # We process each character, maintaining:
    # - total: the number of distinct subsequences so far (including empty)
    # - last_seen: a map from character to the total count just before the previous
    #   occurrence of that character was processed

    # Start with total = 1 (empty subsequence)
    {total, _last_seen} =
      String.graphemes(string)
      |> Enum.reduce({1, %{}}, fn grapheme, {total_count, last_seen} ->
        # New subsequences = all existing subsequences + the current grapheme appended to each
        # So new_total = total_count * 2
        new_total = rem(total_count * 2, mod)

        # If the grapheme was seen before, we've double-counted the subsequences
        # that ended with the previous occurrence. Subtract the count that existed
        # just before that previous occurrence.
        case Map.get(last_seen, grapheme) do
          nil ->
            new_last_seen = Map.put(last_seen, grapheme, total_count)
            {new_total, new_last_seen}

          prev_total ->
            # Subtract the previous occurrence's "before" total
            corrected_total = rem(new_total - prev_total, mod)
            # Update last_seen for this character to the current total_count (before increment)
            new_last_seen = Map.put(last_seen, grapheme, total_count)
            {corrected_total, new_last_seen}
        end
      end)

    # total includes the empty subsequence, so subtract 1
    result = rem(total - 1, mod)
    if result < 0, do: result + mod, else: result
  end
end[0m
