defmodule Solution do
  def find_largestsumsubarray([head | tail]) do
    Enum.reduce(tail, {head, head}, fn x, {current, global} ->
      new_current = max(x, current + x)
      new_global = max(global, new_current)
      {new_current, new_global}
    end)
    |> elem(1)
  end
end
```

