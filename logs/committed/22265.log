---MODULE---
@doc """
  Finds the maximum number of overlapping intervals at any point.

  ## Examples

      iex> Solution.find_max_overlap([{1, 3}, {5, 8}, {4, 10}, {9, 12}])
      2

      iex> Solution.find_max_overlap([{0, 2}, {1, 5}, {2, 3}])
      2

      iex> Solution.find_max_overlap([{2, 5}, {3, 7}, {4, 6}, {6, 8}])
      3

      iex> Solution.find_max_overlap([])
      0
"""
@spec find_max_overlap(list({integer(), integer()})) :: non_neg_integer()
def find_max_overlap(intervals) do
  if Enum.empty?(intervals) do
    0
  else
    events =
      intervals
      |> Enum.flat_map(fn {start, end} ->
        [{start, :start}, {end, :end}]
      end)
      |> Enum.sort(&sort_events/2)

    max_overlap =
      events
      |> Enum.reduce({0, 0}, fn
        {_point, :start}, {current, max} ->
          {current + 1, max(max, current + 1)}
        {_point, :end}, {current, max} ->
          {current - 1, max}
      end)
      |> elem(1)

    max_overlap
  end
end

@spec sort_events({integer(), :start | :end}, {integer(), :start | :end}) :: boolean()
defp sort_events({_point1, :start}, {_point2, :end}), do: true
defp sort_events({_point1, :end}, {_point2, :start}), do: false
defp sort_events({point1, _type1}, {point2, _type2}), do: point1 < point2
