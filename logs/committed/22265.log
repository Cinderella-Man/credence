defmodule Solution do
  def find_max_overlap([]), do: 0
  def find_max_overlap(intervals) do
    {starts, ends} = Enum.unzip(intervals)
    starts = Enum.sort(starts)
    ends = Enum.sort(ends)
    find_max_overlap_recursive(starts, ends, 0, 0)
  end

  defp find_max_overlap_recursive([], _, _, max_overlap), do: max_overlap
  defp find_max_overlap_recursive(_, [], _, max_overlap), do: max_overlap
  defp find_max_overlap_recursive([s | rest_starts], [e | rest_ends], current, max_overlap) do
    if s < e do
      current = current + 1
      max_overlap = max(current, max_overlap)
      find_max_overlap_recursive(rest_starts, [e | rest_ends], current, max_overlap)
    else
      current = current - 1
      find_max_overlap_recursive([s | rest_starts], rest_ends, current, max_overlap)
    end
  end
end

