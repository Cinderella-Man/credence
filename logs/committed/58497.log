      # One is longer by 1. Check if we can insert one char into the shorter one
      # to match the longer one. This is equivalent to checking if the longer
      # string without one character matches the shorter string.
      shorter = if length(str1) < length(str2), do: str1, else: str2
      longer = if length(str1) > length(str2), do: str1, else: str2

      shorter_list = String.to_charlist(shorter)
      longer_list = String.to_charlist(longer)

      exactly_one_insert(shorter_list, longer_list)
  end
end

