---MODULE---
@doc """
Returns true if two strings are exactly one edit away from each other.

An edit is defined as inserting, deleting, or replacing a single character.
If the strings are identical (zero edits), returns false.
If the difference in length is more than one, returns false.

## Examples

    iex> Solution.one_edit_away("pale", "ple")
    true

    iex> Solution.one_edit_away("pales", "pale")
    true

    iex> Solution.one_edit_away("pale", "bale")
    true

    iex> Solution.one_edit_away("pale", "bake")
    false
"""
@spec one_edit_away(String.t(), String.t()) :: boolean()
def one_edit_away(str1, str2) do
  len1 = String.length(str1)
  len2 = String.length(str2)
  diff = len1 - len2

  cond do
    diff > 1 or diff < -1 ->
      false
    str1 == str2 ->
      false
    true ->
      one_edit_helper(str1, str2, 0, 0)
  end
end

@spec one_edit_helper(String.t(), String.t(), integer(), integer()) :: boolean()
defp one_edit_helper(_str1, _str2, edit_count, _max_edits) when edit_count > _max_edits do
  false
end

defp one_edit_helper(str1, str2, len1, len2) when len1 < len2 do
  one_edit_helper(str1, str2, len2, len1)
end

defp one_edit_helper(str1, str2, len1, len2) do
  # Ensure len1 <= len2, so str1 is the shorter or equal length string
  {short, long} = if len1 <= len2, do: {str1, str2}, else: {str2, str1}
  {s_short, s_long} = if len1 <= len2, do: {str1, str2}, else: {str2, str1}
  
  check_edit(s_short, s_long, 0)
end

defp check_edit(short, long, edit_count) do
  check_edit_helper(short, long, 0, 0, edit_count)
end

defp check_edit_helper(short, long, i, j, edit_count) when edit_count > 1 do
  false
end

defp check_edit_helper(_short, _long, i, j, edit_count) when i >= String.length(short) and j >= String.length(long) do
  # Both strings exhausted
  edit_count <= 1
end

defp check_edit_helper(short, long, i, j, edit_count) when i < String.length(short) and j < String.length(long) do
  char_short = String.at(short, i)
  char_long = String.at(long, j)

  if char_short == char_long do
    check_edit_helper(short, long, i + 1, j + 1, edit_count)
  else
    # One edit away: either insert/delete or replace
    # Since we ensure len(short) <= len(long), and they differ by at most 1 in length:
    # If lengths are equal, it's a replace
    # If len(long) = len(short) + 1, it's an insert into short (or delete from long)
    
    if byte_size(short) == byte_size(long) do
      # Replace: skip both characters
      check_edit_helper(short, long, i + 1, j + 1, edit_count + 1)
    else
      # Insert/Delete: skip only the character in the longer string
      check_edit_helper(short, long, i, j + 1, edit_count + 1)
    end
  end
end

defp check_edit_helper(short, long, i, j, edit_count) do
  # Handle cases where one string is exhausted
  case {i < String.length(short), j < String.length(long)} do
    {true, false} ->
      # Short has remaining characters but long is exhausted
      # This means there are still characters in short, so more than one edit if edit_count is already > 0
      # Actually, if short has characters left and long doesn't, and lengths differ by 1, 
      # we should have caught this. But let's be safe.
      edit_count + 1 <= 1 and i + (String.length(short) - i) == 1 + j

    {false, true} ->
      # Long has remaining characters but short is exhausted
      # This means there's one extra character in long, which is the insert
      edit_count + 1 <= 1

    {false, false} ->
      edit_count <= 1
  end
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "one edit away insert" do
    assert Solution.one_edit_away("pale", "ple") == true
  end

  test "one edit away delete" do
    assert Solution.one_edit_away("pales", "pale") == true
  end

  test "one edit away replace" do
    assert Solution.one_edit_away("pale", "bale") == true
  end

  test "two edits away" do
    assert Solution.one_edit_away("pale", "bake") == false
  end

  test "identical strings are not one edit away" do
    assert Solution.one_edit_away("same", "same") == false
  end

  test "empty strings" do
    assert Solution.one_edit_away("", "") == false
  end

  test "one character to empty string" do
    assert Solution.one_edit_away("a", "") == true
  end

  test "empty string to one character" do
    assert Solution.one_edit_away("", "a") == true
  end

  test "longer than one character difference" do
    assert Solution.one_edit_away("abc", "abcdef") == false
  end
end
