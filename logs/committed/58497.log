  test "one edit away insert" do
    assert Solution.one_edit_away("pale", "ple") == true
  end

  test "one edit away delete" do
    assert Solution.one_edit_away("pales", "pale") == true
  end

  test "one edit away replace" do
    assert Solution.one_edit_away("pale", "bale") == true
  end

  test "two edits away" do
    assert Solution.one_edit_away("pale", "bake") == false
  end
end

---REFERENCE---
defmodule Solution do
  @spec one_edit_away(String.t(), String.t()) :: boolean
  def one_edit_away(first, second) do
    a = String.to_charlist(first)
    b = String.to_charlist(second)
    {a, b} = if length(a) > length(b), do: {b, a}, else: {a, b}
    diff = length(b) - length(a)
    if diff > 1 do
      false
    else
      check(a, b, diff)
    end
  end

  defp check([], [], _diff), do: true
  defp check([], [_], _diff), do: true
  defp check([], _, _diff), do: false
  defp check([h1 | t1], [h2 | t2], diff) do
    if h1 == h2 do
      check(t1, t2, diff)
    else
      case diff do
        0 -> t1 == t2
        1 -> [h1 | t1] == t2
      end
    end
  end
end

