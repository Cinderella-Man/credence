@spec one_edit_away(String.t(), String.t()) :: boolean()
def one_edit_away(str1, str2) do
  case {String.length(str1), String.length(str2)} do
    {len1, len2} when abs(len1 - len2) > 1 ->
      false
    {len1, len2} when len1 == len2 ->
      str1 == str2 || exactly_one_replace(String.to_charlist(str1), String.to_charlist(str2))
