defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "one edit away insert" do
    assert Solution.one_edit_away("pale", "ple") == true
  end

  test "one edit away delete" do
    assert Solution.one_edit_away("pales", "pale") == true
  end

  test "one edit away replace" do
    assert Solution.one_edit_away("pale", "bale") == true
  end

  test "two edits away" do
    assert Solution.one_edit_away("pale", "bake") == false
  end

  test "identical strings are not one edit away" do
    assert Solution.one_edit_away("same", "same") == false
  end

  test "empty strings" do
    assert Solution.one_edit_away("", "") == false
  end

  test "one character to empty string" do
    assert Solution.one_edit_away("a", "") == true
  end

  test "empty string to one character" do
    assert Solution.one_edit_away("", "a") == true
  end

  test "longer than one character difference" do
    assert Solution.one_edit_away("abc", "abcdef") == false
  end
end
