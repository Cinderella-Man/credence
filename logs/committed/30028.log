  use ExUnit.Case, async: false

  test "all same characters" do
    assert Solution.count_equal_binary_substrings("1111") == 0
  end

  test "alternating characters" do
    assert Solution.count_equal_binary_substrings("10101") == 4
  end

  test "grouped pattern" do
    assert Solution.count_equal_binary_substrings("00110011") == 6
  end
end
