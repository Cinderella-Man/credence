      "0" -> 0
      "1" -> 1
      _ -> raise "Invalid binary string"
    end)

    # Use the running difference approach:
    # Treat '0' as -1 and '1' as +1
    # A substring has equal 0s and 1s iff the sum of transformed values is 0
    # We track the cumulative sum and count how many times each sum occurs.
    # For each position, if we've seen the same cumulative sum before, 
