  defp build_patch(node, %{name: name, param_name: param_name,
                            do_body: do_body, else_body: else_body}) do
    range = Sourceror.get_range(node)

    do_str = Sourceror.to_string(do_body)
    else_str = Sourceror.to_string(else_body)

    empty_clause = "def #{name}([]), do: #{do_str}"
    fallthrough = "def #{name}(#{param_name}) do\n  #{else_str}\nend"
    change = empty_clause <> "\n\n" <> fallthrough

    %{range: range, change: change}
  end
end

