defmodule Solution do
  @doc """
  Counts the number of substrings in a binary string that have an equal
  number of 0s and 1s.

  Runs in linear time using a running difference counter approach.
  """
  @spec count_equal_binary_substrings(String.t()) :: non_neg_integer()
  def count_equal_binary_substrings(<<>>) do
    0
  end

  def count_equal_binary_substrings(<<>>) when byte_size(<<>>) == 0, do: 0

  def count_equal_binary_substrings(binary) do
    # Convert string to list of integers (0 or 1)
    chars = binary |> String.graphics() |> Enum.map(fn
      "0" -> 0
      "1" -> 1
      _ -> raise "Invalid binary string"
    end)

    # Use the running difference approach:
    # Treat '0' as -1 and '1' as +1
    # A substring has equal 0s and 1s iff the sum of transformed values is 0
    # We track the cumulative sum and count how many times each sum occurs.
    # For each position, if we've seen the same cumulative sum before, 
    # the substring between those positions has sum 0.

    counts = chars
    |> Enum.reduce({0, %{}, 0}, fn char, {running_sum, freq, total} ->
      # Transform: 0 -> -1, 1 -> 1
      delta = if char == 0, do: -1, else: 1
      new_sum = running_sum + delta

      # Before updating, check how many times this new_sum has been seen
      # The initial sum 0 has been seen once (at the start, before any characters)
      # But we need to handle this carefully.

      # Actually, let's restructure:
      # Start with running_sum = 0, and frequency map with {0: 1}
      # For each character:
      #   update running_sum
      #   add freq[running_sum] to total
      #   increment freq[running_sum]
      {new_sum, freq, total}
    end)

    # Let me redo this properly
    do_count_equal_binary_substrings(chars, 0, %{0 => 1}, 0)
  end

  defp do_count_equal_binary_substrings([], _running_sum, _freq, total) do
    total
  end

  defp do_count_equal_binary_substrings([char | rest], running_sum, freq, total) do
    delta = if char == 0, do: -1, else: 1
    new_sum = running_sum + delta

    count = Map.get(freq, new_sum, 0)
    new_total = total + count

    new_freq = Map.update(freq, new_sum, 1, &(&1 + 1))

    do_count_equal_binary_substrings(rest, new_sum, new_freq, new_total)
  end
end

---TEST---
