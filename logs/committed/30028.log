---MODULE---
defmodule Solution do
  @doc """
  Counts the number of substrings in a binary string that have an equal
  number of 0s and 1s.

  The correct interpretation is that we look for contiguous substrings where
  the number of 0s equals the number of 1s. This is different from counting
  substrings with balanced prefix sums globally; it requires checking contiguous
  runs of identical characters and then finding valid transitions.

  Approach:
  1. Convert string to list of integers (0 and 1).
  2. Find all contiguous runs of identical characters, storing {length, value}.
  3. For each pair of adjacent runs with different values, the number of valid
     substrings spanning those two runs is min(len_left, len_right).
  4. Sum these up across all adjacent pairs.
  """
  @spec count_equal_binary_substrings(String.t()) :: non_neg_integer()
  def count_equal_binary_substrings(binary) do
    chars =
      binary
      |> String.graphemes()
      |> Enum.map(fn
        "0" -> 0
        "1" -> 1
        _ -> raise "Invalid binary string"
      end)

    if length(chars) == 0 do
      0
    else
      runs = group_into_runs(chars)
      count_substrings_from_runs(runs, 0)
    end
  end

  defp group_into_runs([]), do: []

  defp group_into_runs([first_char | rest]) do
    {run_length, remaining} = collect_run(rest, 1, first_char)
    [{run_length, first_char} | group_into_runs(remaining)]
  end

  defp collect_run([], length, _char), do: {length, []}

  defp collect_run([char | rest], length, char) do
    collect_run(rest, length + 1, char)
  end

  defp collect_run([other_char | rest], length, _char) do
    {length, [other_char | rest]}
  end

  defp count_substrings_from_runs(runs, total) when length(runs) < 2 do
    total
  end

  defp count_substrings_from_runs([{len_left, val_left}, {len_right, val_right} | rest], total) do
    if val_left != val_right do
      count = :erlang.min(len_left, len_right)
      new_total = total + count
      count_substrings_from_runs([{len_right, val_right} | rest], new_total)
    else
      # This case shouldn't happen if grouping is correct, but handle safely
      count_substrings_from_runs([{len_right, val_right} | rest], total)
    end
  end
end
