defmodule Solution do
  @doc """
  Returns a list of strings from the input that start and end with the same letter.

  The order of the strings is preserved from the input.

  ## Examples

      iex> Solution.get_strings(["racecar", "dog", "a", "banana"])
      ["racecar", "a"]

      iex> Solution.get_strings(["hello", "level", "world"])
      ["level"]

      iex> Solution.get_strings(["pop", "loop", "pip", "pip"])
      ["pop", "pip", "pip"]
  """
  @spec get_strings([String.t()]) :: [String.t()]
  def get_strings(strings) do
    Enum.filter(strings, fn string ->
      case String.split_at(string, 1) do
        {first_char, _rest} ->
          last_char = String.last(string)
          first_char == last_char
      end
    end)
  end
end
