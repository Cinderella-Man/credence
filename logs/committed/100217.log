defmodule Solution do
  @spec num_of_bits(integer) :: non_neg_integer
  def num_of_bits(n) when n < 0, do: num_of_bits(-n)
  def num_of_bits(0), do: 0
  def num_of_bits(n) when n > 0 do
    count_bits(n, 0)
  end

  defp count_bits(0, acc), do: acc
  defp count_bits(n, acc), do: count_bits(Bitwise.bsr(n, 1), acc + 1)
end
