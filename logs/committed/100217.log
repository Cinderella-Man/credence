defmodule Solution do
  @doc """
  Returns the number of bits required to represent a non-negative integer.
  For 0, returns 0.
  """
  @spec num_of_bits(integer()) :: non_neg_integer()
  def num_of_bits(0), do: 0
  def num_of_bits(n) when n > 0 do
    n
    |> :erlang.integer_to_binary(2)
    |> String.length()
  end
  def num_of_bits(n) when n < 0 do
    num_of_bits(-n)
  end
end
===ASSUMPTIONS===
===RATIONALE===
Uses floating-point arithmetic for integer bit counting, which is imprecise for large integers, and fails to handle negative integers as specified; rewrite uses built-in integer_to_binary for correctness and efficiency and adds negative-integer support.
