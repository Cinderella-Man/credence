---MODULE---
@doc """
Generates a list of all cell names within a given Excel-style range, in column-major order.

The input string is in the format "A1:B2" where A and B are columns and 1 and 2 are rows.
The returned list includes all cells from start to end, inclusive, ordered by column first,
then by row within each column.
"""
@spec cells_in_range(String.t()) :: [String.t()]
def cells_in_range(range_string) do
  <<col_start::binary-size(1)>> <> <<row_start::binary-size(1)>> <> ":" <>
    <<col_end::binary-size(1)>> <> <<row_end::binary-size(1)>> = range_string

  col_start_code = col_start |> String.to_charlist() |> hd()
  col_end_code = col_end |> String.to_charlist() |> hd()
  row_start_num = row_start |> String.to_integer()
  row_end_num = row_end |> String.to_integer()

  for col_code <- col_start_code..col_end_code,
      row <- row_start_num..row_end_num do
    col_letter = List.to_string([col_code])
    "#{col_letter}#{row}"
  end
end
---TEST---
