    content: defmodule Credence.Pattern.PreferStringAtForCharAccess do
  @moduledoc """
  Detects the anti-pattern of converting a single-character binary variable
  to a charlist, extracting the head (codepoint), storing it in an intermediate
  variable, then later converting it back to a string with `List.to_string/1`.

  This is a redundant round-trip: `String |> to_charlist |> hd` extracts the
  integer codepoint, and `List.to_string([codepoint])` converts it back to a
  one-character string. When the original variable is already a single-character
  binary, it can be used directly in a `for` range — Elixir's range operator
  on binaries yields codepoint integers, so the loop variable is the same
  integer codepoint that the charlist round-trip would produce. String
  interpolation handles both strings and integers identically via
  `Kernel.to_string/1`.

  ## Bad

      <<col_start::binary-size(1), ...>> = range_string
      col_start_code = col_start |> String.to_charlist() |> hd()
      col_end_code = col_end |> String.to_charlist() |> hd()
      for col_code <- col_start_code..col_end_code, ... do
        col_letter = List.to_string([col_code])
        "\#{col_letter}\#{row}"
      end

  ## Good

      <<col_start::binary-size(1), ...>> = range_string
      for col_code <- col_start..col_end, ... do
        "\#{col_code}\#{row}"
      end
  """
  use Credence.Pattern.Rule
  alias Credence.RuleHelpers

  @impl true
  def check(ast, _opts) do
    {_ast, issues} =
      Macro.prewalk(ast, [], fn
        node, issues ->
          case match_charlist_pipeline(node) do
            {:ok, _original_var, _code_var, meta} ->
              {node, [build_issue(meta) | issues]}

            :error ->
              {node, issues}
          end
      end)

    Enum.reverse(issues)
  end

  @impl true
  def fix_patches(ast, opts) do
    source = Keyword.fetch!(opts, :source)
    RuleHelpers.patches_from_ast_transform(ast, source, &transform_ast/1)
  end

  defp transform_ast(ast) do
    Macro.postwalk(ast, fn
      {:__block__, _meta, stmts} = node when is_list(stmts) ->
        case rewrite_block(stmts) do
          {:changed, new_stmts} -> {:__block__, [], new_stmts}
          :unchanged -> node
        end

      node ->
        node
    end)
  end

  defp rewrite_block(stmts) do
    # Scan all statements to find the patterns
    scan =
      Enum.reduce(stmts, %{charlist: %{}, body: %{}, to_remove: MapSet.new()}, fn stmt, acc ->
        case classify_statement(stmt) do
          {:charlist, original_var, code_var} ->
            acc
            |> Map.update!(:charlist, &Map.put(&1, code_var, original_var))
            |> Map.update!(:to_remove, &MapSet.put(&1, stmt))

          {:list_to_string, body_var, code_var} ->
            acc
            |> Map.update!(:body, &Map.put(&1, body_var, code_var))
            |> Map.update!(:to_remove, &MapSet.put(&1, stmt))

          :other ->
            acc
        end
      end)

    if MapSet.size(scan.to_remove) > 0 do
      new_stmts =
        stmts
        |> Enum.reject(&MapSet.member?(scan.to_remove, &1))
        |> Enum.map(fn stmt ->
          stmt
          |> replace_generator_bounds(scan.charlist)
          |> replace_body_vars(scan.body)
        end)

      {:changed, new_stmts}
    else
      :unchanged
    end
  end

  # Match: code_var = original_var |> String.to_charlist() |> hd()
  defp match_charlist_pipeline(
         {:=, _,
          [
            {code_var, code_meta, nil},
            {:|>, _,
             [
               {:|>, _,
                [
                  {original_var, _, nil},
                  {{:., _, [{:__aliases__, _, [:String]}, :to_charlist]}, _, []}
                ]},
               {:hd, _, []}
             ]}
          ]}
       )
       when is_atom(code_var) and is_atom(original_var) do
    {:ok, original_var, code_var, code_meta}
  end

  defp match_charlist_pipeline(_), do: :error

  # Classify a statement for the rewrite scan
  defp classify_statement(stmt) do
    case match_charlist_pipeline(stmt) do
      {:ok, original_var, code_var, _meta} ->
        {:charlist, original_var, code_var}

      :error ->
        case match_list_to_string(stmt) do
          {:ok, body_var, code_var} ->
            {:list_to_string, body_var, code_var}

          :error ->
            :other
        end
    end
  end

  # Match: body_var = List.to_string([code_var])
  defp match_list_to_string(
         {:=, _,
          [
            {body_var, _, nil},
            {{:., _, [{:__aliases__, _, [:List]}, :to_string]}, _,
             [{:__block__, _, [[{code_var, _, nil}]]}]}
          ]}
       )
       when is_atom(body_var) and is_atom(code_var) do
    {:ok, body_var, code_var}
  end

  defp match_list_to_string(_), do: :error

  # Replace code_var..code_var with original_var..original_var in for generators
  defp replace_generator_bounds(stmt, charlist_map) when map_size(charlist_map) == 0, do: stmt

  defp replace_generator_bounds(stmt, charlist_map) do
    Macro.prewalk(stmt, fn
      {:<-, arrow_meta,
       [
         {iter_var, iter_meta, nil},
         {:.., range_meta, [{start_var, start_meta, nil}, {end_var, end_meta, nil}]}
       ]}
      when is_atom(iter_var) and is_atom(start_var) and is_atom(end_var) ->
        new_start =
          case Map.get(charlist_map, start_var) do
            nil -> {start_var, start_meta, nil}
            original -> {original, start_meta, nil}
          end

        new_end =
          case Map.get(charlist_map, end_var) do
            nil -> {end_var, end_meta, nil}
            original -> {original, end_meta, nil}
          end

        {:<-, arrow_meta,
         [
           {iter_var, iter_meta, nil},
           {:.., range_meta, [new_start, new_end]}
         ]}

      node ->
        node
    end)
  end

  # Replace body_var with code_var throughout the AST
  defp replace_body_vars(stmt, body_map) when map_size(body_map) == 0, do: stmt

  defp replace_body_vars(stmt, body_map) do
    Macro.prewalk(stmt, fn
      {var, meta, nil} = node when is_atom(var) ->
        case Map.get(body_map, var) do
          nil -> node
          replacement -> {replacement, meta, nil}
        end

      node ->
        node
    end)
  end

  defp build_issue(meta) do
    %Issue{
      rule: :prefer_string_at_for_char_access,
      message:
        "Avoid the redundant `String.to_charlist() |> hd()` / `List.to_string/1` " <>
          "round-trip for single-character column letters. Use the binary variable " <>
          "directly in a range — Elixir's range operator on binaries yields codepoint " <>
          "integers, and string interpolation handles integers the same as strings.",
      meta: %{line: Keyword.get(meta, :line)}
    }
  end
end

