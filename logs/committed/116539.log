    content: defmodule Credence.Pattern.PreferStringAtForCharAccessCheckTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.PreferStringAtForCharAccess

  test "flags the anti-pattern: String.to_charlist |> hd round-trip" do
    assert flagged?(PreferStringAtForCharAccess, """
           defmodule M do
             def f(x) do
               code = x |> String.to_charlist() |> hd()
               code
             end
           end
           """)
  end

  test "flags multiple occurrences in one block" do
    assert flagged?(PreferStringAtForCharAccess, """
           defmodule M do
             def f(a, b) do
               ca = a |> String.to_charlist() |> hd()
               cb = b |> String.to_charlist() |> hd()
               {ca, cb}
             end
           end
           """)
  end

  test "leaves good code alone" do
    assert clean?(PreferStringAtForCharAccess, """
           defmodule M do
             def f(x) do
               String.to_charlist(x)
             end
           end
           """)
  end

  test "leaves code without hd() alone" do
    assert clean?(PreferStringAtForCharAccess, """
           defmodule M do
             def f(x) do
               x |> String.to_charlist() |> tl()
             end
           end
           """)
  end

  test "leaves List.to_string without preceding charlist alone" do
    assert clean?(PreferStringAtForCharAccess, """
           defmodule M do
             def f(x) do
               List.to_string([x])
             end
           end
           """)
  end
end

