  use ExUnit.Case, async: false

  test "basic range A1:B2" do
    assert Solution.cells_in_range("A1:B2") == ["A1", "A2", "B1", "B2"]
  end

  test "another range E5:F6" do
    assert Solution.cells_in_range("E5:F6") == ["E5", "E6", "F5", "F6"]
  end

  test "range C3:D4" do
    assert Solution.cells_in_range("C3:D4") == ["C3", "C4", "D3", "D4"]
  end

  test "single cell range" do
    assert Solution.cells_in_range("A1:A1") == ["A1"]
  end
end
