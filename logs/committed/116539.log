    content: defmodule Credence.Pattern.PreferStringAtForCharAccess do
  @moduledoc """
  Detects the anti-pattern of converting a single-character binary variable
  to a charlist, extracting the head (codepoint), storing it in an intermediate
  variable, then later converting it back to a string with `List.to_string/1`.

  This is a redundant round-trip: `String |> to_charlist |> hd` extracts the
  integer codepoint, and `List.to_string([codepoint])` converts it back to a
  one-character string. When the original variable is already a single-character
  binary, it can be used directly in a `for` range — Elixir's range operator
  on binaries yields codepoint integers, so the loop variable is the same
  integer codepoint that the charlist round-trip would produce. String
  interpolation handles both strings and integers identically via
  `Kernel.to_string/1`.

  ## Bad

      <<col_start::binary-size(1), ...>> = range_string
      col_start_code = col_start |> String.to_charlist() |> hd()
      col_end_code = col_end |> String.to_charlist() |> hd()
      for col_code <- col_start_code..col_end_code, ... do
        col_letter = List.to_string([col_code])
        "\#{col_letter}\#{row}"
      end

  ## Good

      <<col_start::binary-size(1), ...>> = range_string
      for col_code <- col_start..col_end, ... do
        "\#{col_code}\#{row}"
      end
  """
  use Credence.Pattern.Rule
  alias Credence.RuleHelpers

  @impl true
  def check(ast, _opts) do
    {_ast, issues} =
      Macro.prewalk(ast, [], fn
        node, issues ->
          case match_charlist_pipeline(node) do
            {:ok, _var, meta} -> {node, [build_issue(meta) | issues]}
            :error -> {node, issues}
          end
      end)

    Enum.reverse(issues)
  end

  @impl true
  def fix_patches(ast, opts) do
    source = Keyword.fetch!(opts, :source)
    RuleHelpers.patches_from_ast_transform(ast, source, &transform_ast/1)
  end

  defp transform_ast(ast) do
    Macro.postwalk(ast, fn
      {:__block__, meta, stmts} = node when is_list(stmts) ->
        case rewrite_block(stmts) do
          {:changed, new_stmts} -> {:__block__, meta, new_stmts}
          :unchanged -> node
        end

      node ->
        node
    end)
  end

  defp rewrite_block(stmts) do
    {charlist_assignments, body_assignments, code_vars, body_vars} =
      Enum.reduce(stmts, {MapSet.new(), MapSet.new(), %{}, %{}}, fn
        stmt, {ca, ba, cv, bv} ->
          case match_charlist_pipeline(stmt) do
            {:ok, code_var, _meta} ->
              {MapSet.put(ca, code_var), ba, cv, bv}

            :error ->
              case match_list_to_string(stmt) do
                {:ok, body_var, code_var} ->
                  {ca, MapSet.put(ba, body_var), cv, Map.put(cv, body_var, code_var)}

                :error ->
                  {ca, ba, cv,
                   case match_body_var_binding(stmt, code_vars) do
                     {:ok, body_var, code_var} -> Map.put(bv, body_var, code_var)
                     :error -> bv
                   end}
              end
          end
      end)

    # Build reverse mapping: code_var -> original_var (from charlist assignments)
    # We need to also collect original_var -> code_var from the for generators
    original_vars = find_original_vars_from_generators(stmts, code_vars)

    has_removals? = not MapSet.size(charlist_assignments |> MapSet.union(body_assignments)) == 0

    if has_removals? or map_size(original_vars) > 0 do
      new_stmts =
        stmts
        |> Enum.filter(fn stmt ->
          not removable_assignment?(stmt, charlist_assignments, body_assignments)
        end)
        |> Enum.map(fn stmt ->
          stmt
          |> replace_in_generators(original_vars)
          |> replace_body_vars(code_vars)
        end)

      {:changed, new_stmts}
    else
      :unchanged
    end
  end

  # Match: var |> String.to_charlist() |> hd()
  defp match_charlist_pipeline(
         {:=, _,
          [
            {code_var, _, nil},
            {:|>, _,
             [
               {:|>, _, [{_original_var, _, nil}, {{:., _, [{:__aliases__, _, [:String]}, :to_charlist]}, _, []}]},
               {:hd, _, []}
             ]}
          ]}
       )
       when is_atom(code_var) do
    {:ok, code_var, []}
  end

  defp match_charlist_pipeline(_), do: :error

  # Match: body_var = List.to_string([code_var])
  defp match_list_to_string(
         {:=, _,
          [
            {body_var, _, nil},
            {{:., _, [{:__aliases__, _, [:List]}, :to_string]}, _,
             [{:__block__, _, [[{code_var, _, nil}]]}]}
          ]}
       )
       when is_atom(body_var) and is_atom(code_var) do
    {:ok, body_var, code_var}
  end

  defp match_list_to_string(_), do: :error

  # Match: body_var = List.to_string([code_var]) for any var (not just simple)
  defp match_body_var_binding(
         {:=, _,
          [
            {body_var, _, nil},
            {{:., _, [{:__aliases__, _, [:List]}, :to_string]}, _,
             [{:__block__, _, [[{code_var, _, nil}]]}]}
          ]}
       )
       when is_atom(body_var) and is_atom(code_var) do
    {:ok, body_var, code_var}
  end

  defp match_body_var_binding(_, _), do: :error

  defp removable_assignment?(stmt, charlist_vars, body_vars) do
    case stmt do
      {:=, _, [{var, _, nil}, _]} when is_atom(var) ->
        MapSet.member?(charlist_vars, var) or MapSet.member?(body_vars, var)

      _ ->
        false
    end
  end

  # Find original_var -> code_var mapping from for generators
  # When we see `for code_var <- original_var..original_var2`, record both
  defp find_original_vars_from_generators(stmts, code_vars) do
    code_var_set = Map.keys(code_vars) |> MapSet.new()

    Enum.reduce(stmts, %{}, fn
      {:for, _, args}, acc when is_list(args) ->
        Enum.reduce(args, acc, fn
          {:<-, _,
           [
             {iter_var, _, nil},
             {:.., _, [{start_var, _, nil}, {end_var, _, nil}]}
           ]},
          inner_acc
          when is_atom(iter_var) and is_atom(start_var) and is_atom(end_var) ->
            inner_acc =
              if MapSet.member?(code_var_set, iter_var) do
                # This is a generator that iterates over a code variable
                # The range bounds are the original variables
                inner_acc
              else
                inner_acc
              end

            inner_acc

          _, inner_acc ->
            inner_acc
        end)

      _, acc ->
        acc
    end)
  end

  # Replace code_var with original_var in for generator ranges
  defp replace_in_generators(stmt, original_vars) when map_size(original_vars) == 0, do: stmt

  defp replace_in_generators(stmt, _original_vars) do
    # Walk the AST and replace code_var references in for generator ranges
    Macro.postwalk(stmt, fn
      {:for, meta, args} when is_list(args) ->
        new_args =
          Enum.map(args, fn
            {:<-, arrow_meta,
             [
               {iter_var, iter_meta, nil},
