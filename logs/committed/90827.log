---MODULE---
@moduledoc """
Solves the monotone increasing digits problem.

Given a non-negative integer N, returns the largest integer less than or equal to N
whose digits are in monotone increasing order (each digit is greater than or equal to the
previous digit).
"""

defmodule Solution do
  @doc """
  Returns the largest integer less than or equal to N whose digits are in
  monotone increasing order.
  """
  @spec monotone_increasing_digits(non_neg_integer()) :: non_neg_integer()
  def monotone_increasing_digits(0), do: 0

  def monotone_increasing_digits(n) when is_integer(n) and n > 0 do
    digits = Integer.digits(n)
    num_digits = length(digits)

    # Find the first index where digits[i] > digits[i+1]
    break_index = find_break_point(digits, 0)

    case break_index do
      nil ->
        # Already monotone increasing
        to_integer(digits)

      idx ->
        # We need to decrease digits[idx] by 1, but this might cause digits[idx-1] > digits[idx]
        # So we backtrack: decrease the previous digit and check again
        updated_digits = decrease_and_backtrack(digits, idx)
        # Set all remaining digits after the decreased position to 9
        fill_nines(updated_digits, idx)
        |> to_integer()
    end
  end

  # Find the first index i where digits[i] > digits[i+1]
  defp find_break_point(digits, idx) when idx >= length(digits) - 1 do
    nil
  end

  defp find_break_point(digits, idx) do
    if Enum.at(digits, idx) > Enum.at(digits, idx + 1) do
      idx
    else
      find_break_point(digits, idx + 1)
    end
  end

  # Decrease digits[idx] by 1, and if it violates monotonicity with previous digit,
  # recursively decrease the previous digit.
  defp decrease_and_backtrack(digits, idx) when idx >= length(digits) do
    digits
  end

  defp decrease_and_backtrack(digits, idx) do
    current = Enum.at(digits, idx)
    new_current = current - 1

    if idx == 0 do
      # Cannot go further back
      List.replace_at(digits, idx, new_current)
    else
      prev = Enum.at(digits, idx - 1)
      if new_current < prev do
        # Need to decrease the previous digit as well
        prev_new = prev - 1
        # Create intermediate state with previous decreased
        temp_digits = List.replace_at(digits, idx - 1, prev_new)
        # Recursively check if we need to go further back
        decrease_and_backtrack(temp_digits, idx - 1)
      else
        # Just decrease the current digit
        List.replace_at(digits, idx, new_current)
      end
    end
  end

  # Fill all digits from start_idx to end with 9
  defp fill_nines(digits, start_idx) when start_idx >= length(digits) do
    digits
  end

  defp fill_nines(digits, start_idx) do
    {prefix, _remainder} = Enum.split(digits, start_idx)
    remainder_count = length(digits) - start_idx
    prefix ++ List.duplicate(9, remainder_count)
  end

  defp to_integer(digits) do
    digits
    |> Enum.map(&Integer.to_string/1)
    |> Enum.join()
    |> String.to_integer()
  end
end
