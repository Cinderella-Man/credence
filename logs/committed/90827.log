defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "monotone_increasing_digits(100) returns 99" do
    assert Solution.monotone_increasing_digits(100) == 99
  end

  test "monotone_increasing_digits(1234) returns 1234" do
    assert Solution.monotone_increasing_digits(1234) == 1234
  end

  test "monotone_increasing_digits(10) returns 9" do
    assert Solution.monotone_increasing_digits(10) == 9
  end

  test "monotone_increasing_digits(101) returns 99" do
