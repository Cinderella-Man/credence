defmodule Solution do
  @spec monotone_increasing_digits(integer()) :: integer()
  def monotone_increasing_digits(n) do
    digits = Integer.digits(n)
    len = length(digits)
    indices = if len > 1, do: Enum.to_list((len - 1)..1), else: []

    {updated_digits, change_index} =
      Enum.reduce(indices, {digits, len}, fn i, {acc_digits, ci} ->
        if Enum.at(acc_digits, i) < Enum.at(acc_digits, i - 1) do
          new_digits = List.update_at(acc_digits, i - 1, &(&1 - 1))
          {new_digits, i}
        else
          {acc_digits, ci}
        end
      end)

    final_digits =
      Enum.with_index(updated_digits)
      |> Enum.map(fn {d, idx} -> if idx >= change_index, do: 9, else: d end)

    Integer.undigits(final_digits)
  end
end
