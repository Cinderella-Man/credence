@moduledoc """
Solves the monotone increasing digits problem.

Given a non-negative integer N, returns the largest integer less than or equal to N
whose digits are in monotone increasing order (each digit is greater than or equal to the
previous digit).
"""

defmodule Solution do
  @doc """
  Returns the largest integer less than or equal to N whose digits are in
  monotone increasing order.
  """
  @spec monotone_increasing_digits(non_neg_integer()) :: non_neg_integer()
  def monotone_increasing_digits(0), do: 0

  def monotone_increasing_digits(n) when is_integer(n) and n > 0 do
    digits = Integer.digits(n)
    case find_break_point(digits, 0) do
      nil ->
        Enum.join(digits) |> String.to_integer()
      break_idx ->
        updated_digits = decrease_at(digits, break_idx)
        final_digits = backtrack(updated_digits, break_idx)
        set_remaining_to_nine(final_digits, break_idx + 1)
        |> Enum.join()
        |> String.to_integer()
    end
  end

  # Find the first index i where digits[i] > digits[i+1]
  defp find_break_point(digits, idx) do
    if idx >= length(digits) - 1 do
      nil
    else
      case Enum.at(digits, idx) > Enum.at(digits, idx + 1) do
        true -> idx
        false -> find_break_point(digits, idx + 1)
      end
    end
  end

  # Decrease the digit at the given index by 1
  defp decrease_at(digits, idx) do
    digit = Enum.at(digits, idx)
    List.replace_at(digits, idx, digit - 1)
  end

  # Backtrack: if the digit at position idx became smaller than the previous one,
  # we need to decrease the previous digit and check again.
  defp backtrack(digits, idx) do
    if idx <= 0 do
      digits
    else
      prev_digit = Enum.at(digits, idx - 1)
      current_digit = Enum.at(digits, idx)

      if current_digit < prev_digit do
        # Decrease previous digit
        new_digits = List.replace_at(digits, idx - 1, prev_digit - 1)
        backtrack(new_digits, idx - 1)
      else
        digits
      end
    end
  end

  # Set all digits from start_idx to the end to 9
  defp set_remaining_to_nine(digits, start_idx) do
    {before_part, _remainder} = Enum.split(digits, start_idx)
    remainder_count = length(digits) - start_idx
    before_part ++ List.duplicate(9, remainder_count)
  end
end[0m
