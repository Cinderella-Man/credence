@moduledoc """
Solves the monotone increasing digits problem.

Given a non-negative integer N, returns the largest integer less than or equal to N
whose digits are in monotone increasing order (each digit is greater than or equal to the
previous digit).
"""

defmodule Solution do
  @doc """
  Returns the largest integer less than or equal to N whose digits are in
  monotone increasing order.
  """
  @spec monotone_increasing_digits(non_neg_integer()) :: non_neg_integer()
  def monotone_increasing_digits(0), do: 0

  def monotone_increasing_digits(n) when is_integer(n) and n >= 0 do
    digits = Integer.digits(n)
    n_digits = length(digits)

    # Convert to a list of integers for easier manipulation
    # We need to find the first "inflection" point where digits[i] > digits[i+1]
    # and then decrease digits[i] by 1, and set all subsequent digits to 9
    # But we may need to backtrack if decreasing causes a violation with previous digits

    digits
    |> find_break_point()
    |> adjust_and_convert(n_digits)
  end

  # Find the first index i where digits[i] > digits[i+1]
  # Return the index of the break point, or :none if no such point exists
  defp find_break_point(digits) do
    case digits do
      [] -> :none
      [_] -> :none
      [d1, d2 | _rest] when d1 > d2 -> 0
      [d1, d2 | _rest] when d1 <= d2 ->
        case find_break_point_shifted([d1, d2 | _rest], 1) do
          :none -> :none
          index -> index
        end
    end
  end

  defp find_break_point_shifted(digits, offset) do
    case digits do
      [] -> :none
      [_] -> :none
      [d1, d2 | _rest] when d1 > d2 -> offset
      [d1, d2 | _rest] when d1 <= d2 ->
        find_break_point_shifted([d1, d2 | _rest], offset + 1)
    end
  end

  # If no break point, the digits are already monotone increasing
  defp adjust_and_convert(:none, _n_digits) do
    # Already monotone increasing
    IO.iodata_to_integer(Integer.list_to_digit_list(digits_of_result(:none)))
  end

  # This helper is tricky. Let me rethink the approach.

  def monotone_increasing_digits_v2(n) when is_integer(n) and n >= 0 do
