    new_string:   @impl true
  def fix_patches(ast, _opts) do
    # Walk the AST manually and build patches directly rather than going
    # through `patches_from_postwalk` / `patches_from_ast_transform`.
    # Those helpers diff ASTs structurally, but `diff_patches` ignores
    # the metadata (middle) element of 3-tuples — so a change that only
    # adds `:delimiter` to the string block metadata is invisible to
    # them.  Building patches by hand lets us emit the correct range and
    # replacement text unconditionally.
    {_ast, patches} =
      Macro.prewalk(ast, [], fn
        {:@, _meta, [{attr, _, [{:__block__, str_meta, [value]}]}]} = node, acc
        when attr in @doc_attrs and is_binary(value) ->
          already_heredoc = Keyword.get(str_meta, :delimiter) == ~s(""")

          if not already_heredoc and (raw_multi_line?(value) or real_multi_line?(value)) do
            range = Sourceror.get_range(node)

            if range do
              fixed = fix_doc_node(node)
              change = RuleHelpers.render_replacement(fixed, range)
              {node, [%{range: range, change: change} | acc]}
            else
              {node, acc}
            end
          else
            {node, acc}
          end

        node, acc ->
          {node, acc}
      end)

    Enum.reverse(patches)
  end
