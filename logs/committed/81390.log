defmodule Solution do
  def even_upper_odd_lower(str) do
    str
    |> String.to_charlist()
    |> Enum.with_index()
    |> Enum.map(fn {char, index} ->
      if rem(index, 2) == 0 do
        String.upcase(<<char>>)
      else
        String.downcase(<<char>>)
      end
    end)
    |> Enum.join()
  end
end

