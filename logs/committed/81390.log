    file_path: /home/kly/projects/credence/lib/pattern/prefer_heredoc_for_multi_line_doc.ex
    new_string:   @impl true
  def fix_patches(ast, opts) do
    # Sourceror's AST preserves both shapes of multi-line doc strings:
    # `@doc "a\\nb"` keeps the literal `\\n` in the string value, while
    # `@doc """\na\nb\n"""` carries a `:delimiter` of `~s(""")` in the
    # block metadata. `fix_doc_node/1` handles both via `raw_multi_line?`
    # and `real_multi_line?`. The `:delimiter` check skips already-heredoc
    # strings — re-processing one through `Sourceror.to_string` corrupts
    # indentation.
    #
    # Uses `patches_from_ast_transform` (not `patches_from_postwalk`)
    # because the fix changes Sourceror metadata (`:delimiter`) without
    # always changing the string value.  `patches_from_postwalk` diffs
    # only the form and args of 3-tuples, ignoring the metadata middle
    # element — so a metadata-only change is invisible to its diff.
    # `patches_from_ast_transform` renders + re-parses, turning the
    # metadata change into a structural one the diff can detect.
    source = Keyword.get(opts, :source, "")

    RuleHelpers.patches_from_ast_transform(ast, source, fn ast ->
      Macro.postwalk(ast, &fix_doc_node/1)
    end)
  end
    old_string:   @impl true
