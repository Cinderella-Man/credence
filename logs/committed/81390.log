                if raw_multi_line?(value),
                  do: unescape_value(value) |> ensure_trailing_newline(),
                  else: ensure_trailing_newline(value)

              new_str_meta = Keyword.put(str_meta, :delimiter, ~s("""))
              fixed_str = {:__block__, new_str_meta, [content]}
              # Sourceror.patch_string consumes the byte immediately after
              # the patch range when re-indenting multi-line replacements.
              # For a heredoc the next byte is always a newline (the line
              # break before the next expression), so append one to the
              # replacement text to prevent it from being swallowed.
              change = RuleHelpers.render_replacement(fixed_str, range) <> "\n"
              {_node, [%{range: range, change: change} | acc]}
            else
              {_node, acc}
            end
          else
            {_node, acc}
          end

        node, acc ->
          {node, acc}
      end)

