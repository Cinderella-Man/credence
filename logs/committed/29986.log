    content: defmodule Credence.Syntax.FixTruncatedBinaryCloseFixTest do
  use ExUnit.Case

  import Credence.RuleCase, only: [valid_syntax?: 1]

  alias Credence.Syntax.FixTruncatedBinaryClose

  defp analyze(code), do: FixTruncatedBinaryClose.analyze(code)
  defp fix(code), do: FixTruncatedBinaryClose.fix(code)

  describe "fixes truncated binary close" do
    test "inside list constructor" do
      input = """
      [result | insert(char, <<first, rest::binary>)]\
      """

      expected = """
      [result | insert(char, <<first, rest::binary>>)]\
      """

      assert fix(input) == expected
    end

    test "in assignment" do
      input = """
      result = <<first, char, rest::binary>>\
      """

      expected = """
      result = <<first, char, rest::binary>>>\
      """

      assert fix(input) == expected
    end

    test "multiple occurrences" do
      input = """
      result = <<first, char, rest::binary>)
      [result | insert(char, <<first, rest::binary>)]\
      """

      expected = """
      result = <<first, char, rest::binary>>)
      [result | insert(char, <<first, rest::binary>>)]\
      """

      assert fix(input) == expected
    end
  end

  describe "leaves correct code unchanged" do
    test "properly closed binary" do
      code = """
      result = <<first, char, rest::binary>>\
      """

      assert fix(code) == code
    end

    test "plain code" do
      code = """
      foo(bar)\
      """

      assert fix(code) == code
    end
  end

  describe "fixed output no longer flags" do
    test "inside list constructor" do
      assert analyze(
               fix("""
               [result | insert(char, <<first, rest::binary>)]\
               """)
             ) == []
    end

    test "in assignment" do
      assert analyze(
               fix("""
               result = <<first, char, rest::binary>)\
               """)
             ) == []
    end
  end

  describe "fixed output is well-formed (parses)" do
    test "inside list constructor" do
      assert valid_syntax?(
               fix("""
               [result | insert(char, <<first, rest::binary>)]\
               """)
             )
    end

    test "in assignment" do
      assert valid_syntax?(
               fix("""
               result = <<first, char, rest::binary>)\
               """)
             )
    end
  end
end

