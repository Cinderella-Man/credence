defmodule Solution do
  def get_permutations(string) when is_binary(string) do
    string
    |> String.graphemes()
    |> do_permutations()
    |> Enum.map(&Enum.join/1)
  end

  defp do_permutations([char]), do: [[char]]

  defp do_permutations(list) do
    for {char, index} <- Enum.with_index(list),
        sub <- do_permutations(List.delete_at(list, index)) do
      [char | sub]
    end
  end
end
```

