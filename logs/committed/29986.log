@moduledoc """
  Generates all possible permutations of a given string containing unique characters.
  """
  defmodule Solution do
    @doc """
    Generates all possible permutations of a given string containing unique characters.

    ## Examples

        iex> Solution.get_permutations("abc")
        ["abc", "acb", "bac", "bca", "cab", "cba"]

        iex> Solution.get_permutations("ab")
        ["ab", "ba"]

        iex> Solution.get_permutations("a")
        ["a"]
    """
    @spec get_permutations(String.t()) :: [String.t()]
    def get_permutations(<<char>>) do
      [<<char>>]
    end

    def get_permutations(<<first, rest::binary>>) do
      sub_permutations = get_permutations(rest)

      for perm <- sub_permutations,
          insert <- insert_char_at_all_positions(first, perm),
          into: [] do
        insert
      end
    end

    defp insert_char_at_all_positions(_char, <<>>), do: []

    defp insert_char_at_all_positions(char, <<first_char, rest::binary>>) do
      char_inserted = insert_char_at_position(char, first_char, rest)
      [char_inserted | insert_char_at_all_positions(char, <<first_char, rest::binary>])]
    end

    defp insert_char_at_all_positions(char, <<last_char>>) do
      [<<last_char, char>>]
    end

    defp insert_char_at_position(char, first_char, rest) do
      <<first_char, char, rest::binary>>
    end
  end[0m
