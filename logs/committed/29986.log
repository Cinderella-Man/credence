defmodule Solution do
  @doc """
  Generates all possible permutations of a given string containing unique characters.

  ## Examples

      iex> Solution.get_permutations("abc")
      ["abc", "acb", "bac", "bca", "cab", "cba"]

      iex> Solution.get_permutations("ab")
      ["ab", "ba"]

      iex> Solution.get_permutations("a")
      ["a"]
  """
  @spec get_permutations(String.t()) :: [String.t()]
  def get_permutations(<<char>>) do
    [<<char>>]
  end

  def get_permutations(<<first, rest::binary>>) do
    sub_permutations = get_permutations(rest)

    for perm <- sub_permutations,
        do: insert_char_at_all_positions(first, perm)
    |> List.flatten()
  end

  defp insert_char_at_all_positions(_char, <<>>), do: []

  defp insert_char_at_all_positions(char, <<first_char, rest::binary>>) do
    char_inserted = insert_char_before(first_char, rest, char)
    [char_inserted | insert_char_at_all_positions(char, <<first_char, rest::binary>])]
  end

  defp insert_char_at_all_positions(_char, <<last_char>>),
    do: [<<last_char, char()>>]

  defp insert_char_at_all_positions(char, string) do
    chars = String.graphemes(string)
    do_insert(char, chars, 0)
  end

  defp do_insert(_char, [], _index), do: []

  defp do_insert(char, [_first | rest], index) do
    # This approach is tricky with binary pattern matching
    # Let's use a simpler recursive approach
    []
  end

  defp insert_char_before(char, <<>>), do: <<char>>

  defp insert_char_before(char, <<first, rest::binary>>) do
    <<first, char, rest::binary>>
  end
end

