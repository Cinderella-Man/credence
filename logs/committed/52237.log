  defp slide_window(_graphemes, _window_len, _start, _s1_freq, s2_len)
       when _window_len + _start > s2_len do
    false
  end

  defp slide_window(graphemes, window_len, start, s1_freq, _s2_len) do
    window_start = start
    window_end = start + window_len - 1
    window_graphemes = Enum.slice(graphemes, window_start, window_len)
    window_freq = build_freq(window_graphemes)

    if window_freq == s1_freq do
      true
    else
      slide_window(graphemes, window_len, start + 1, s1_freq, length(graphemes))
    end
  end
