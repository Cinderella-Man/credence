  @spec checkpermutation?(String.t(), String.t()) :: boolean()
  def checkpermutation?(s1, s2) do
    s1_len = String.length(s1)
    s2_len = String.length(s2)

    cond do
      s1_len == 0 ->
        false

      s1_len > s2_len ->
        false

      true ->
        s1_freq = build_freq(s1)
        first_window = String.slice(s2, 0, s1_len)
        window_freq = build_freq(first_window)

