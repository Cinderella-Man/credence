defmodule Solution do
  @doc """
  Determines whether `s1` is a permutation of any contiguous substring of `s2`.

  Returns `true` if such a substring exists, `false` otherwise.

  ## Examples

      iex> Solution.checkpermutation?("abc", "cbadef")
      true

      iex> Solution.checkpermutation?("abc", "def")
      false

  """
  @spec checkpermutation?(String.t(), String.t()) :: boolean()
  def checkpermutation?(s1, s2) do
    s1_graphemes = String.graphemes(s1)
    s2_graphemes = String.graphemes(s2)

    s1_len = length(s1_graphemes)
    s2_len = length(s2_graphemes)

    cond do
      s1_len == 0 ->
        false

      s1_len > s2_len ->
        false

      true ->
        s1_freq = build_freq(s1_graphemes)

        slide_window(s2_graphemes, s1_len, 0, s1_freq, s2_len)
    end
  end

  defp build_freq(graphemes) do
    Enum.reduce(graphemes, Map.new(), fn char, acc ->
      Map.update(acc, char, 1, &(&1 + 1))
    end)
  end

  defp slide_window(_graphemes, _window_len, _start, _s1_freq, s2_len)
       when _window_len + _start > s2_len do
    false
  end

  defp slide_window(graphemes, window_len, start, s1_freq, _s2_len) do
    # Build frequency map for the current window
    window_start = start
    window_end = start + window_len - 1
    window_graphemes = Enum.slice(graphemes, window_start, window_len)
    window_freq = build_freq(window_graphemes)

    if window_freq == s1_freq do
      true
    else
      slide_window(graphemes, window_len, start + 1, s1_freq, length(graphemes))
    end
  end
end[0m
