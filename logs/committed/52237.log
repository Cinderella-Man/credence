defmodule Solution do
  @spec checkpermutation(String.t(), String.t()) :: boolean
  def checkpermutation(s1, s2) do
    len1 = String.length(s1)
    len2 = String.length(s2)

    if len1 == 0 or len1 > len2 do
      false
    else
      target = char_frequencies(s1)
      initial = char_frequencies(String.slice(s2, 0, len1 - 1))
      do_check(target, initial, s1, s2, len1, len2, len1 - 1)
    end
  end

  defp do_check(target, current, s1, s2, len1, len2, right) when right < len2 do
    # Add the character at the right pointer
    new_char = String.at(s2, right)
    current = Map.update(current, new_char, 1, &(&1 + 1))

    # Compare with target frequencies
    if current == target do
      true
    else
      # Remove the character that falls out of the left side of the window
      left_char = String.at(s2, right - len1 + 1)
      current = Map.update(current, left_char, 0, &(&1 - 1))
      current = if current[left_char] == 0, do: Map.delete(current, left_char), else: current

      # Slide the window
      do_check(target, current, s1, s2, len1, len2, right + 1)
    end
  end

  defp do_check(_target, _current, _s1, _s2, _len1, _len2, _right), do: false

  defp char_frequencies(str) do
    str
    |> String.graphemes()
    |> Enum.frequencies()
  end
end
