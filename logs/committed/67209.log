  end

  test "compressed result same length returns original" do
    assert Solution.compressstring("aabbcc") == "aabbcc"
  end

  test "compressible string returns compressed form" do
    assert Solution.compressstring("aabcccccaaa") == "a2b1c5a3"
  end
end
