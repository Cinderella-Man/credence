---MODULE---
@doc """
Compresses a string by counting consecutive character occurrences.

If the compressed string is not smaller than the original, returns the original.
Returns the original string for empty strings or strings of length one.
"""
@spec compressstring(String.t()) :: String.t()
def compressstring(input) when is_binary(input) do
  length = String.length(input)

  if length <= 1 do
    input
  else
    compressed = compress(input)

    compressed_length = String.length(compressed)

    if compressed_length < length do
      compressed
    else
      input
    end
  end
end

defp compress(<<>>), do: ""

defp compress(input) do
  chars = String.graphemes(input)
  do_compress(chars, 0, "", hd(chars), 0)
end

defp do_compress([], _index, result, _current_char, count) do
  result <> Integer.to_string(count)
end

defp do_compress([current_char | rest], index, result, prev_char, count) do
  if current_char == prev_char do
    do_compress(rest, index + 1, result, prev_char, count + 1)
  else
    new_result = result <> prev_char <> Integer.to_string(count)
    do_compress(rest, index + 1, new_result, current_char, 1)
  end
end

---TEST---
