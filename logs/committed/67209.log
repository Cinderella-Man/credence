defmodule Solution do
  @spec compressstring(String.t()) :: String.t()
  def compressstring(s) do
    graphemes = String.graphemes(s)

    if length(graphemes) <= 1 do
      s
    else
      compressed =
        graphemes
        |> Enum.chunk_by(& &1)
        |> Enum.map(fn chunk -> List.first(chunk) <> to_string(length(chunk)) end)
        |> Enum.join()

      if byte_size(compressed) < byte_size(s) do
        compressed
      else
        s
      end
    end
  end
end

