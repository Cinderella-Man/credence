defmodule Solution do
  @doc """
  Compresses a string by counting consecutive character occurrences.

  If the compressed string is not smaller than the original, returns the original.
  Returns the original string for empty strings or strings of length one.
  """
  @spec compressstring(String.t()) :: String.t()
  def compressstring(input) when is_binary(input) do
    case input do
      "" ->
        ""

      <<_>> <> _ ->
        if byte_size(input) == 1, do: input, else: do_compress_string(input)

      _ ->
        do_compress_string(input)
    end
  end

  defp do_compress_string(input) do
    compressed = compress(input)
    if byte_size(compressed) < byte_size(input), do: compressed, else: input
  end

  defp compress(input) do
    chars = String.graphemes(input)
    # This branch won't be reached because we handle counts in the main reduce
    {_compressed, _} =
      Enum.reduce(chars, {"", 0}, fn
        _char, {acc, count} when count > 0 and acc != "" ->
          {acc, 1}

        # Start new sequence
        _char, {acc, count} ->
          {acc, count}
      end)

    compress_helper(String.graphemes(input))
  end

  defp compress_helper([]), do: ""

  defp compress_helper([char | rest]) do
    {count, remaining} = count_consecutive(char, rest, 1)
    "#{char}#{count}#{compress_helper(remaining)}"
  end

  defp count_consecutive(_char, [], count), do: {count, []}

  defp count_consecutive(char, [char | rest], count) do
    count_consecutive(char, rest, count + 1)
  end

  defp count_consecutive(char, [other | _rest] = remaining, count) when char != other do
    {count, remaining}
  end
end
