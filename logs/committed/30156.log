\n    end\n  end\nend", "oldText" => "defmodule Credence.Pattern.NoDefensiveTypeGuardClauseFixTest do\n  use Credence.RuleCase, async: true\n\n  alias Credence.Pattern.NoDefensiveTypeGuardClause\n\n  test \"rewrites the anti-pattern\" do\n    # TODO: replace input/expected with a real before/after pair\n    input = \"\"\"\n    foo(bar)\n    \"\"\"\n\n    expected = \"\"\"\n    baz(qux)\n    \"\"\"\n\n    assert fix(NoDefensiveTypeGuardClause, input) == expected\n  end\nend"}]
