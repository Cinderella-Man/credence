---MODULE---
defmodule Solution do
  @doc """
  Determines whether a given integer is a power of two.

  A power of two is a positive integer that can be expressed as 2^k
  for some non-negative integer k.

  0 and negative integers are not powers of two.

  This implementation runs in constant time using bitwise operations.
  """
  @spec check_power_of_two(integer()) :: boolean()
  def check_power_of_two(n) when not is_integer(n) do
    false
  end

  def check_power_of_two(n) when n <= 0 do
    false
  end

  def check_power_of_two(n) do
    # A power of two in binary has exactly one bit set.
    # n && (n-1) will be 0 if n is a power of two.
    # Example: 8 = 1000, 7 = 0111, 8 & 7 = 0
    # Example: 6 = 0110, 5 = 0101, 6 & 5 = 0100 != 0
    Bitwise.band(n, n - 1) == 0
  end
end
---TEST---
defmodule SolutionTest do
  use ExUnit.Case, async: false

  test "check_power_of_two" do
    assert Solution.check_power_of_two(18) == false
    assert Solution.check_power_of_two(1) == true
    assert Solution.check_power_of_two(16) == true
    assert Solution.check_power_of_two(1023) == false
    assert Solution.check_power_of_two(1024) == true
  end
end
