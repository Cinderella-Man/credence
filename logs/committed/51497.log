defmodule Solution do
  def my_sqrt(num) when num < 0 do
    raise ArgumentError, "Cannot calculate square root of negative number."
  end

  def my_sqrt(num) do
    if num == 0 do
      0.0
    else
      initial_guess = (num + 1) / 2.0
      iterate(num, initial_guess)
    end
  end

  defp iterate(num, guess) do
    new_guess = (guess + num / guess) / 2.0
    if abs(new_guess - guess) < 1.0e-7 do
      new_guess
    else
      iterate(num, new_guess)
    end
  end
end

