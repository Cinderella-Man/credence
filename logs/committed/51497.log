      def my_sqrt(number) when number >= 0 do
        guess = number / 2.0
        sqrt_iterate(number, guess)
      end

      defp sqrt_iterate(number, guess) do
        next = (guess + number / guess) / 2.0
        if abs(next - guess) < 1.0e-7 do
          next
        else
          sqrt_iterate(number, next)
        end
      end
    end
