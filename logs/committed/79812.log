---MODULE---
defmodule Solution do
  @doc "removes the last n elements"
  def remove_last_elements(list, n) do
  # If n is zero, return original list
  if n == 0 do
  list
  # If n >= length of list, return empty list
  else if n >= length(list) do
  []
  else
  # Otherwise, return the first (length - n) elements
  list |> List.take(length(list) - n)
  end
end
end
