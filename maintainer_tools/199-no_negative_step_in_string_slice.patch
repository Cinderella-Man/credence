index 0000000..e90cd5d
--- /dev/null
+++ b/lib/pattern/no_negative_step_in_string_slice.ex
@@ -0,0 +1,106 @@
+defmodule Credence.Pattern.NoNegativeStepInStringSlice do
+  @moduledoc """
+  Warning & future-proofing rule: Detects `String.slice(str, n..-1)` where the
+  range has no explicit step. In Elixir 1.19+, `n..-1` defaults to step -1
+  (descending), which triggers a deprecation warning and will become a hard
+  error in a future release.
+
+  The auto-fix adds `//1` to make the step explicit and positive:
+  `String.slice(str, n..-1)` → `String.slice(str, n..-1//1)`.
+
+  Only literal `-1` as the range endpoint is flagged (the idiomatic "suffix"
+  idiom). Other negative endpoints (e.g. `-2..-1`) or ranges with an explicit
+  step are left alone.
+
+  ## Bad
+
+      String.slice(str, n..-1)
+
+  ## Good
+
+      String.slice(str, n..-1//1)
+  """
+  use Credence.Pattern.Rule
+  alias Credence.Issue
+  alias Credence.RuleHelpers
+
+  @impl true
+  def check(ast, _opts) do
+    {_ast, issues} =
+      Macro.prewalk(ast, [], fn
+        # Direct call: String.slice(str, n..-1)
+        {{:., _, [{:__aliases__, _, [:String]}, :slice]}, _meta, args} = node, issues
+        when is_list(args) ->
+          case args do
+            [_, range] ->
+              if bare_neg_one_range?(range) do
+                line = get_line(range)
+                {node, [build_issue(line) | issues]}
+              else
+                {node, issues}
+              end
+
+            _ ->
+              {node, issues}
+          end
+
+        node, issues ->
+          {node, issues}
+      end)
+
+    Enum.reverse(issues)
+  end
+
+  @impl true
+  def fix_patches(ast, _opts) do
+    RuleHelpers.patches_from_postwalk(ast, fn
+      # Direct call: String.slice(str, n..-1) with 2 explicit args
+      {{:., _, [{:__aliases__, _, [:String]}, :slice]}, _, [str_arg, range]} = node ->
+        case range do
+          {:.., range_meta, [start, {:-, neg_meta, [{:__block__, lit_meta, [1]}]}]} ->
+            new_range =
+              {:..//, range_meta,
+               [start, {:-, neg_meta, [{:__block__, lit_meta, [1]}]}, {:__block__, [], [1]}]}
+
+            put_elem(node, 2, [str_arg, new_range])
+
+          _ ->
+            node
+        end
+
+      # Piped call: str |> String.slice(n..-1) with 1 explicit arg
+      {{:., _, [{:__aliases__, _, [:String]}, :slice]}, _, [range]} = node ->
+        case range do
+          {:.., range_meta, [start, {:-, neg_meta, [{:__block__, lit_meta, [1]}]}]} ->
+            new_range =
+              {:..//, range_meta,
+               [start, {:-, neg_meta, [{:__block__, lit_meta, [1]}]}, {:__block__, [], [1]}]}
+
+            put_elem(node, 2, [new_range])
+
+          _ ->
+            node
+        end
+
+      node ->
+        node
+    end)
+  end
+
+  # A range `start..-1` with NO explicit step.
+  defp bare_neg_one_range?({:.., _, [_start, {:-, _, [{:__block__, _, [1]}]}]}), do: true
+  defp bare_neg_one_range?(_), do: false
+
+  defp get_line({_, meta, _}) when is_list(meta), do: Keyword.get(meta, :line)
+  defp get_line(_), do: nil
+
+  defp build_issue(line) do
+    %Issue{
+      rule: :no_negative_step_in_string_slice,
+      message:
+        "`String.slice(str, n..-1)` uses a range with implicit step -1 in Elixir 1.19+. " <>
+          "Use `String.slice(str, n..-1//1)` to make the positive step explicit.",
+      meta: %{line: line}
+    }
+  end
+end
diff --git a/test/pattern/no_negative_step_in_string_slice_check_test.exs b/test/pattern/no_negative_step_in_string_slice_check_test.exs
