===RULE===
```
defmodule Credence.Pattern.AvoidDeadBinding do
  @moduledoc """
  Detects dead assignments to underscore-prefixed variables that are never
  referenced when followed by an assignment to the unprefixed variable.

  ## Bad

      _results = []
      results = [1, 2, 3]

  ## Good

      results = [1, 2, 3]
  """
  use Credence.Pattern.Rule

  @impl true
  def check(ast, _opts) do
    Credence.RuleHelpers.postwalk(ast, [], fn node, issues ->
      case node do
        {:__block__, meta, expressions} ->
          dead_assignments = find_dead_assignments(expressions)
          Enum.reduce(dead_assignments, issues, fn {assign_meta, _}, acc ->
            [%Issue{
              rule: :avoid_dead_binding,
              message: "Dead assignment to underscore-prefixed variable",
              meta: %{line: assign_meta[:line]}
            } | acc]
          end)

        _ ->
          issues
      end
    end)
  end

  @impl true
  def fix_patches(ast, _opts) do
    Credence.RuleHelpers.postwalk(ast, [], fn node, patches ->
      case node do
        {:__block__, meta, expressions} ->
          dead_assignments = find_dead_assignments(expressions)
          if dead_assignments == [] do
            patches
          else
            new_expressions =
              expressions
              |> Enum.reject(fn expr ->
                Enum.any?(dead_assignments, fn {_, dead_expr} -> dead_expr == expr end)
              end)

            patch = %Patch{
              action: :replace,
              range: meta[:range] || get_range(node),
              change: {:__block__, meta, new_expressions}
            }
            [patch | patches]
          end

        _ ->
          patches
      end
    end)
  end

  defp find_dead_assignments(expressions) do
    expressions
    |> Enum.with_index()
    |> Enum.flat_map(fn {expr, index} ->
      case expr do
        {:=, assign_meta, [{underscore_var, _, nil}, _value]} ->
          if is_underscore_var(underscore_var) do
            unprefixed_var = String.to_atom(String.trim_leading(Atom.to_string(underscore_var), "_"))
            if has_later_assignment?(expressions, index + 1, unprefixed_var) and
               not_variable_used?(expressions, index + 1, underscore_var) do
              [{assign_meta, expr}]
            else
              []
            end
          else
            []
          end
        _ ->
          []
      end
    end)
  end

  defp is_underscore_var(var) do
    var_str = Atom.to_string(var)
    String.starts_with?(var_str, "_") and String.length(var_str) > 1
  end

  defp has_later_assignment?(expressions, start_index, target_var) do
    expressions
    |> Enum.drop(start_index)
    |> Enum.any?(fn
      {:=, _, [{^target_var, _, nil}, _]} -> true
      _ -> false
    end)
  end

  defp not_variable_used?(expressions, start_index, var) do
    expressions
    |> Enum.drop(start_index)
    |> Enum.all?(fn expr ->
      not var_in_ast?(expr, var)
    end)
  end

  defp var_in_ast?(ast, var) do
    Credence.RuleHelpers.postwalk(ast, false, fn node, found ->
      if found do
        {node, found}
      else
        case node do
          {^var, _, nil} -> {node, true}
          _ -> {node, found}
        end
      end
    end) |> elem(1)
  end

  defp get_range(node) do
    case Sourceror.get_range(node) do
      %{start: start_pos, end: end_pos} ->
        %{start: start_pos, end: end_pos}
      _ ->
        %{start: {0, 0, 0}, end: {0, 0, 0}}
    end
  end
end
```

