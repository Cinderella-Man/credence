defmodule Credence.Pattern.AvoidDeadBindingCheckTest do
  use Credence.RuleCase, async: true

  alias Credence.Pattern.AvoidDeadBinding

  test "flags the anti-pattern" do
    assert flagged?(AvoidDeadBinding, """
           defmodule Solution do
             defp generate(current, left, right) do
               _results = []

               results =
                 if left > 0 do
                   generate(current <> "(", left - 1, right + 1)
                 else
                   []
                 end

               results2 =
                 if right > 0 do
                   generate(current <> ")", left, right - 1)
                 else
                   []
                 end

               results ++ results2
             end
           end
           """)
  end

  test "leaves good code alone" do
    assert clean?(AvoidDeadBinding, """
           defmodule Solution do
             defp generate(current, left, right) do
               results =
                 if left > 0 do
                   generate(current <> "(", left - 1, right + 1)
                 else
                   []
                 end

               results2 =
                 if right > 0 do
                   generate(current <> ")", left, right - 1)
                 else
                   []
                 end

               results ++ results2
             end
           end
           """)
  end

  test "does not flag when underscore variable is used later" do
    assert clean?(AvoidDeadBinding, """
           defmodule Example do
             def do_something do
               _temp = calculate_temp()
               temp = process(_temp)
               temp
             end
           end
           """)
  end

  test "does not flag when no unprefixed assignment follows" do
    assert clean?(AvoidDeadBinding, """
           defmodule Example do
             def do_something do
               _temp = calculate_temp()
               :ok
             end
           end
           """)
  end

  test "flags in nested blocks" do
    assert flagged?(AvoidDeadBinding, """
           defmodule Example do
             def do_something do
               if true do
                 _unused = []
                 unused = [:a, :b]
                 unused
               end
             end
           end
           """)
  end
end
