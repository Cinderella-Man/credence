---REFERENCE---
defmodule Solution do
  def generate_bracket_combinations(n) do
    backtrack([], 0, 0, n)
  end

  defp backtrack(current, left, right, n) do
    if left + right == 2 * n do
      [Enum.reverse(current) |> List.to_string()]
    else
      left_branch =
        if left < n do
          backtrack([?( | current], left + 1, right, n)
        else
          []
        end

      right_branch =
        if right < left do
          backtrack([?) | current], left, right + 1, n)
        else
          []
        end

      left_branch ++ right_branch
    end
  end
end

