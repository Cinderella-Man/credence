defmodule Solution do
  @doc """
  Generates all valid combinations of n pairs of parentheses.
  """
  @spec generate_bracket_combinations(non_neg_integer()) :: [String.t()]
  def generate_bracket_combinations(0), do: [""]

  def generate_bracket_combinations(n) when is_integer(n) and n > 0 do
    generate("", n, 0, [])
  end

  @doc false
  defp generate(current, left, right, acc) do
    cond do
      left == 0 and right == 0 ->
        [current | acc]

      left > 0 ->
        generate(
          current <> "(",
          left - 1,
          right + 1,
          acc
        )

      right > 0 ->
        generate(
          current <> ")",
          left,
          right - 1,
          acc
        )
    end
  end
end
